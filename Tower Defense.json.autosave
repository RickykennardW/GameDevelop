jectsFolderStructure":{"folderName":"__ROOT","children":[{"folderName":"CAMPAIGN","children":[{"objectName":"CampaignBackdrop"}]}]},"events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// One persistent campaign owner; only this namespaced storage key is written.","const campaignGame=runtimeScene.getGame();","if(!campaignGame.__campaign){"," const config=runtimeScene.getVariables().get('CampaignConfig').toJSObject(),known=new Map(config.Levels.map(l=>[l.Id,l]));"," let saved={};try{saved=JSON.parse(localStorage.getItem(config.StorageKey)||'{}')||{};}catch(e){}"," const completed={};for(const level of config.Levels){if(!saved.Completed?.[level.Id])break;completed[level.Id]=true;}"," const c=campaignGame.__campaign={config,known,active:null,chapter:1,selected:'1-1',writes:0,save:{...saved,Version:1,Completed:completed,SelectTutorialDone:saved.SelectTutorialDone===true,GameTutorialDone:saved.GameTutorialDone===true}};"," c.frontier=()=>Math.min(25,Object.keys(c.save.Completed).length+1);"," c.chapterUnlocked=n=>Number.isInteger(n)&&n>=1&&n<=5&&(n===1||!!c.save.Completed[(n-1)+'-5']);"," c.available=id=>known.has(id)&&known.get(id).Index<=c.frontier();"," c.persist=()=>{try{localStorage.setItem(config.StorageKey,JSON.stringify(c.save));c.storageOK=true;c.writes++;}catch(e){c.storageOK=false;}};"," c.launch=id=>{if(!c.available(id))return false;c.active=id;c.selected=id;c.chapter=known.get(id).Chapter;return true;};"," c.complete=run=>{","  if(!run||run!==run.scene.__campaignRun||run.level.Id!==c.active||!run.validVictory()||!c.available(c.active))return false;","  if(!c.save.Completed[c.active]){c.save.Completed[c.active]=true;c.persist();}return true;"," };"," c.tutorialDone=key=>{if(!c.save[key]){c.save[key]=true;c.persist();}};"," c.chapter=Math.ceil(c.frontier()/5);c.selected=config.Levels[c.frontier()-1].Id;","}","// PIXI is already the project's UI renderer. Text anchors are independent of","// decorative hover scaling, including at small physical viewport sizes.","if(!campaignGame.__campaignWidgets){"," campaignGame.__campaignWidgets=scene=>{","  const layer=scene.getLayer('CampaignUI'),root=new PIXI.Container();root.interactive=false;root.interactiveChildren=false;layer.getRenderer().getRendererObject().addChild(root);","  const u={scene,layer,root,down:scene.getGame().getInputManager().isMouseButtonPressed(0),pressed:'',hover:''};","  u.text=(value,size=14,color=0xc6c9e0,bold=false,parent=root)=>{const t=new PIXI.Text(value,{fontFamily:'Arial',fontSize:size,fill:color,fontWeight:bold?'bold':'normal',align:'center'});t.anchor.set(.5);parent.addChild(t);return t;};","  u.button=(id,label,parent=root)=>{const container=new PIXI.Container(),frame=new PIXI.Graphics();container.addChild(frame);parent.addChild(container);const text=u.text(label,14,0xe8e1d0,true,container);return{id,container,frame,text,enabled:true,visible:true};};","  u.place=(b,x,y,w,h,font=14)=>{b.container.position.set(x,y);b.rect={x:x-w/2,y:y-h/2,w,h};b.w=w;b.h=h;b.text.style.fontSize=font;b.text.position.set(0,0);};","  u.paint=(b,hot=false)=>{b.container.visible=b.visible!==false;const key=[b.w,b.h,hot,b.enabled].join(':');if(b.key===key)return;b.key=key;const g=b.frame;g.clear().lineStyle(1,hot?0xe4cf93:b.enabled?0x897658:0x3e3e55,.9).beginFill(hot?0x292343:0x11162b,b.enabled?.96:.65).drawRoundedRect(-b.w/2,-b.h/2,b.w,b.h,6).endFill();g.lineStyle(.7,0x747fae,.35).drawRoundedRect(-b.w/2+4,-b.h/2+4,b.w-8,b.h-8,3);b.text.alpha=b.enabled?1:.4;};","  u.input=buttons=>{const input=scene.getGame().getInputManager(),down=input.isMouseButtonPressed(0),x=gdjs.evtTools.input.getCursorX(scene,'CampaignUI',0),y=gdjs.evtTools.input.getCursorY(scene,'CampaignUI',0),hit=buttons.find(b=>b.visible!==false&&b.enabled!==false&&(b.hit?b.hit(x,y):b.rect&&x>=b.rect.x&&x<b.rect.x+b.rect.w&&y>=b.rect.y&&y<b.rect.y+b.rect.h));u.hover=hit?.id||'';if(down&&!u.down)u.pressed=u.hover;const action=!down&&u.down&&u.pressed===u.hover?u.hover:'';if(!down)u.pressed='';u.down=down;return action;};","  u.screen=()=>{const g=scene.getGame(),W=g.getGameResolutionWidth(),H=g.getGameResolutionHeight(),rect=g.getRenderer().getCanvas().getBoundingClientRect(),display=Math.max(.01,rect.width/W);return{W,H,s:Math.min(W/1280,H/720,1.5),display};};","  u.dispose=()=>{if(!root.destroyed)root.destroy({children:true,texture:false,baseTexture:false});};return u;"," };","}"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Five chapters / one persistent service; all UI nodes are allocated once.","const scene=runtimeScene,game=scene.getGame(),C=game.__campaign,input=game.getInputManager();","let ui=scene.__levelsUI;","if(!ui){"," const u=game.__campaignWidgets(scene),destroyUI=u.dispose;ui=scene.__levelsUI=Object.assign(u,{age:0,chapter:C.chapter,selected:C.selected,stage:C.save.SelectTutorialDone?-1:0,transition:null,disposed:false,bgMix:1,notice:'',noticeAge:0});C.active=null;"," ui.bg=[scene.createObject('CampaignBackdrop'),scene.createObject('CampaignBackdrop')];ui.bg.forEach((o,i)=>{o.setLayer('');o.setZOrder(i);o.setAnimationName('Chapter'+ui.chapter);});ui.bgFront=0;"," ui.title=ui.text('GALACTIC CAMPAIGN',32,0xeee4c7,true);ui.subtitle=ui.text('STARFALL BASTION  /  CELESTIAL DEFENSE COMMAND',11,0xa8b9d3);"," ui.chapterTitle=ui.text('',25,0xe7dcbd,true);ui.description=ui.text('',13,0xb8bed8);ui.links=new PIXI.Graphics();ui.root.addChild(ui.links);"," ui.tabs=C.config.Chapters.map(ch=>{const b=ui.button('chapter'+ch.Id,'');b.name=ui.text(ch.ShortName.toUpperCase(),12,0xd2d4ea,true,b.container);return b;});"," ui.nodes=C.config.Levels.slice(0,5).map((_,i)=>{const container=new PIXI.Container(),frame=new PIXI.Graphics();container.addChild(frame);ui.root.addChild(container);const number=ui.text('',24,0xf0e5c8,true,container),state=ui.text('',10,0xb8b6db,false,container),boss=ui.text('BOSS',10,0xe6bc91,true,container);return{id:'level'+(i+1),container,frame,number,state,boss,enabled:true,visible:true};});"," ui.detailPanel=new PIXI.Graphics();ui.root.addChild(ui.detailPanel);ui.mission=ui.text('',19,0xe6ddc8,true);ui.details=ui.text('',12,0xb6c9e4);ui.hint=ui.text('',12,0xc0b8d3);"," ui.launch=ui.button('launch','LAUNCH MISSION');ui.back=ui.button('back','BACK');ui.progress=ui.text('',11,0xb8b3d0);ui.progressLine=new PIXI.Graphics();ui.root.addChild(ui.progressLine);ui.noticeText=ui.text('',12,0xf0c7a1);"," ui.coach=new PIXI.Container();ui.root.addChild(ui.coach);ui.shade=new PIXI.Graphics();ui.coach.addChild(ui.shade);ui.coachPanel=new PIXI.Graphics();ui.coach.addChild(ui.coachPanel);ui.coachTitle=ui.text('',17,0xf2e2b8,true,ui.coach);ui.coachBody=ui.text('',13,0xc7cbe0,false,ui.coach);ui.next=ui.button('next','CONTINUE',ui.coach);ui.skip=ui.button('skip','SKIP TUTORIAL',ui.coach);"," const gameplay=game.getSceneAndExtensionsData(C.config.GameplayScene).sceneData,conf=new gdjs.VariablesContainer(gameplay.variables).get('AudioConfig').toJSObject();ui.audioConfig=conf;ui.sound=scene.getSoundManager();ui.music=null;ui.unlocked=false;"," let saved=game.__celestialAudioSettings;try{if(!saved)saved=JSON.parse(localStorage.getItem(conf.StorageKey)||'null');}catch(e){}ui.settings=game.__celestialAudioSettings={Master:conf.Master,Music:conf.MusicVolume,UI:conf.UIVolume,SFX:conf.SFXVolume,MuteMusic:false,MuteSFX:false,...saved};"," ui.unlock=()=>{if(ui.disposed||ui.unlocked)return;if(typeof Howler!=='undefined')Howler.volume();const ctx=typeof Howler!=='undefined'?Howler.ctx:null;Promise.resolve(ctx?.state==='suspended'?ctx.resume():null).then(()=>{if(ui.disposed||!ctx||ctx.state!=='running')return;ui.unlocked=true;const s=ui.settings;if(!s.MuteMusic){ui.sound.playSoundOnChannel(conf.Music.SacredVoidTemple.File,1000,true,s.Master*s.Music/100,1);ui.music=ui.sound.getSoundOnChannel(1000);}}).catch(()=>{});};"," ui.cue=key=>{const s=ui.settings,d=conf.SFX[key];if(ui.unlocked&&!s.MuteSFX&&d)ui.sound.playSoundOnChannel(d.File,1020,false,s.Master*(key==='UIClick'?s.UI:s.SFX)/100*d.Gain,1);};"," document.addEventListener('pointerdown',ui.unlock);document.addEventListener('touchstart',ui.unlock,{passive:true});document.addEventListener('keydown',ui.unlock);if(game.__starfallMenuAudioReady)ui.unlock();"," ui.go=(target,id)=>{if(ui.transition)return false;if(id&&!C.launch(id))return false;ui.cue('UIClick');ui.transition={target,age:0};return true;};"," ui.chooseChapter=n=>{if(!C.chapterUnlocked(n)){ui.notice='Complete '+(n-1)+'-5 to unlock Chapter '+n;ui.noticeAge=3;ui.cue('InvalidAction');return false;}if(ui.chapter!==n){ui.chapter=C.chapter=n;ui.selected=C.config.Levels.find(l=>l.Chapter===n&&C.available(l.Id))?.Id||n+'-1';ui.bgFront=1-ui.bgFront;const o=ui.bg[ui.bgFront];o.setAnimationName('Chapter'+n);o.setZOrder(1);ui.bg[1-ui.bgFront].setZOrder(0);ui.bgMix=0;}return true;};"," ui.chooseLevel=id=>{if(!C.available(id)){ui.notice='Complete the previous mission to unlock '+id;ui.noticeAge=3;ui.cue('InvalidAction');return false;}ui.selected=C.selected=id;if(ui.stage===2)ui.stage=3;ui.cue('UIClick');return true;};"," ui.dispose=()=>{if(ui.disposed)return;ui.disposed=true;if(ui.transition)game.__starfallMenuAudioReady=ui.unlocked;document.removeEventListener('pointerdown',ui.unlock);document.removeEventListener('touchstart',ui.unlock);document.removeEventListener('keydown',ui.unlock);ui.music?.stop();destroyUI();const canvas=game.getRenderer().getCanvas();if(canvas)canvas.style.cursor='default';};"," if(!gdjs.__campaignSceneCallbacks){gdjs.__campaignSceneCallbacks=true;gdjs.callbacksRuntimeSceneUnloading.push(s=>{s.__levelsUI?.dispose();s.__campaignRun?.dispose();});}","}","const dt=Math.min(.1,Math.max(0,scene.getTimeManager().getElapsedTime()/1000));ui.age+=dt;ui.noticeAge=Math.max(0,ui.noticeAge-dt);ui.bgMix=Math.min(1,ui.bgMix+dt/.5);","const vw=Math.round(gdjs.RuntimeGameRenderer.getWindowInnerWidth()),vh=Math.round(gdjs.RuntimeGameRenderer.getWindowInnerHeight());if(game.getAdaptGameResolutionAtRuntime())game.setAdaptGameResolutionAtRuntime(false);","if(Number.isFinite(vw)&&Number.isFinite(vh)&&vw>=64&&vh>=64&&!document.hidden){const factor=Math.max(1,960/vw,540/vh),w=Math.round(vw*factor),h=Math.round(vh*factor);if(game.getGameResolutionWidth()!==w||game.getGameResolutionHeight()!==h){game.setGameResolutionSize(w,h);scene.onGameResolutionResized();}}","const {W,H,s,display}=ui.screen(),oy=(H-720*s)/2,cx=W/2,font=(n,min=9)=>Math.max(n*s,min/display),content=Math.min(W-64*s,1160*s),chapter=C.config.Chapters[ui.chapter-1],level=C.known.get(ui.selected),key=[W,H,display,ui.chapter,ui.selected,C.frontier(),ui.stage].join(':');","for(const name of ['','CampaignUI']){const l=scene.getLayer(name);l.setCameraZoom(1);l.setCameraX(cx);l.setCameraY(H/2);}","for(const [i,o]of ui.bg.entries()){o.setScale(1);o.setScale(Math.max(W/o.getWidth(),H/o.getHeight())*1.01);o.setPosition((W-o.getWidth())/2+Math.sin(ui.age*.035)*2,(H-o.getHeight())/2);o.setOpacity(255*(i===ui.bgFront?ui.bgMix:1));}","if(ui.key!==key){"," ui.key=key;ui.title.position.set(cx,oy+56*s);ui.title.style.fontSize=font(32,18);ui.subtitle.position.set(cx,oy+86*s);ui.subtitle.style.fontSize=font(11,7);"," ui.place(ui.back,32*s+52*s,oy+52*s,104*s,Math.max(38*s,28/display),font(12));"," const tabW=(content-4*12*s)/5;ui.tabs.forEach((b,i)=>{ui.place(b,cx-content/2+tabW/2+i*(tabW+12*s),oy+150*s,tabW,Math.max(68*s,34/display),font(10,8));b.text.text='CHAPTER 0'+(i+1)+(C.chapterUnlocked(i+1)?'':'  [LOCKED]');b.text.position.y=-12*s;b.name.position.set(0,12*s);b.name.style.fontSize=font(12,8);});"," ui.chapterTitle.text='CHAPTER '+ui.chapter+'  /  '+chapter.Name.toUpperCase();ui.chapterTitle.style.fontSize=font(24,13);ui.chapterTitle.position.set(cx,oy+235*s);ui.description.text=chapter.Description;ui.description.style.fontSize=font(13,9);ui.description.style.wordWrap=true;ui.description.style.wordWrapWidth=content;ui.description.position.set(cx,oy+267*s);"," ui.links.clear();let last;"," ui.nodes.forEach((n,i)=>{const x=cx+(i-2)*190*s,y=oy+(365+[0,-24,12,-24,0][i])*s,r=62*s,id=ui.chapter+'-'+(i+1),available=C.available(id),done=!!C.save.Completed[id],selected=ui.selected===id;const pts=[];for(let k=0;k<6;k++)pts.push(Math.cos(k*Math.PI/3)*r,Math.sin(k*Math.PI/3)*r);n.polygon=new PIXI.Polygon(pts);n.x=x;n.y=y;n.container.position.set(x,y);n.hit=(a,b)=>n.polygon.contains(a-x,b-y);n.levelId=id;n.rect={x:x-r,y:y-r,w:2*r,h:2*r};n.number.text=id;n.number.style.fontSize=font(25,13);n.number.position.set(0,-6*s);n.state.text=done?'COMPLETED':available?'AVAILABLE':'LOCKED';n.state.style.fontSize=font(10,7);n.state.position.set(0,24*s);n.boss.visible=i===4;n.boss.style.fontSize=font(10,8);n.boss.position.set(0,-34*s);n.enabled=true;n.style={r,available,done,selected,boss:i===4};if(last){ui.links.lineStyle(1.5*s,available?0xc1aa72:0x464365,.6).moveTo(last.x,last.y).lineTo(x,y);}last={x,y};});"," ui.detailPanel.clear().lineStyle(1,0x82714f,.5).beginFill(0x090e20,.8).drawRoundedRect(cx-420*s,oy+462*s,840*s,104*s,8*s).endFill();ui.mission.text=level.Id+'  /  '+level.Name.toUpperCase();ui.mission.position.set(cx,oy+487*s);ui.mission.style.fontSize=font(18,11);ui.details.text=level.Waves.length+' WAVES   /   '+level.StartingGold+' GOLD   /   '+level.StartingLives+' LIVES';ui.details.position.set(cx,oy+518*s);ui.details.style.fontSize=font(12,9);ui.hint.text=level.Boss?'BOSS: '+chapter.Boss.Name+'  /  MUST BE DEFEATED':'Deploy, upgrade and hold the Finish. Replays preserve your archive.';ui.hint.position.set(cx,oy+544*s);ui.hint.style.fontSize=font(11,8);"," ui.place(ui.launch,cx,oy+622*s,280*s,Math.max(52*s,32/display),font(14,10));ui.launch.enabled=C.available(ui.selected);ui.progress.text=Object.keys(C.save.Completed).length+' / 25 MISSIONS COMPLETE'+(C.save.Completed['5-5']?'  /  CAMPAIGN COMPLETE':'');ui.progress.position.set(cx,H-25*s);ui.progress.style.fontSize=font(11,8);ui.progressLine.clear();for(let i=0;i<25;i++)ui.progressLine.beginFill(i<Object.keys(C.save.Completed).length?0xccb66f:0x3f3c58,.8).drawRect(cx-150*s+i*12*s,H-45*s,9*s,3*s).endFill();"," ui.noticeText.position.set(cx,oy+585*s);ui.noticeText.style.fontSize=font(12,9);","}","const buttons=[ui.back,...ui.tabs,...ui.nodes,ui.launch];ui.coach.visible=ui.stage>=0;ui.noticeText.text=ui.noticeAge>0?ui.notice:'';","if(ui.stage>=0){"," const captions=[['WELCOME, COMMANDER','Your journey begins here. Complete missions, discover threats, and defend the cosmos.'],['CHAPTER 1 - STELLAR FRONTIER','Your first missions begin at the edge of known space.'],['MISSION 1-1 - FIRST CONTACT','Select the highlighted mission to begin your training.'],['MISSION SELECTED','Prepare your defenses, Commander.']][ui.stage];const panelW=Math.min(W-40*s,620*s),panelH=Math.max(148*s,90/display),bottom=H-22*s,top=bottom-panelH;"," ui.shade.clear().beginFill(0x030512,.68).drawRect(0,0,W,H);const target=ui.stage<2?ui.tabs[0].rect:ui.nodes[0].rect;ui.shade.beginHole().drawRoundedRect(target.x-7*s,target.y-7*s,target.w+14*s,target.h+14*s,10*s).endHole().endFill();"," ui.coachPanel.clear().lineStyle(1,0xc6ab6c,.9).beginFill(0x10142b,.98).drawRoundedRect(cx-panelW/2,top,panelW,panelH,9*s).endFill();ui.coachTitle.text=captions[0];ui.coachTitle.style.fontSize=font(17,12);ui.coachTitle.position.set(cx,top+panelH*.19);ui.coachBody.text=captions[1];ui.coachBody.style.fontSize=font(13,9);ui.coachBody.style.wordWrap=true;ui.coachBody.style.wordWrapWidth=panelW-30*s;ui.coachBody.position.set(cx,top+panelH*.48);"," ui.place(ui.next,cx+panelW*.19,bottom-panelH*.16,panelW*.48,Math.max(28*s,23/display),font(11,9));ui.next.text.text=ui.stage===3?'LAUNCH MISSION':'CONTINUE';ui.next.visible=ui.stage!==2;"," ui.place(ui.skip,cx-panelW*.29,bottom-panelH*.16,panelW*.27,Math.max(28*s,23/display),font(10,8));","}","const allowed=ui.transition?[]:ui.stage<0?buttons:ui.stage===2?[ui.nodes[0],ui.skip]:[ui.next,ui.skip];const action=ui.input(allowed);","for(const b of [ui.back,ui.launch,...ui.tabs,ui.next,ui.skip])ui.paint(b,ui.hover===b.id);","for(const n of ui.nodes){const a=n.style,hot=ui.hover===n.id&&a.available,g=n.frame,r=a.r;g.clear().lineStyle((a.selected?2:1)*s,a.boss?0xe1b079:a.selected||hot?0xd3c48a:a.available?0x768db9:0x45415f,a.available?1:.7).beginFill(a.available?hot?0x282448:0x151c37:0x101123,.96).drawPolygon(n.polygon.points).endFill();if(a.selected)g.lineStyle(1,0x90c6e7,.4).drawCircle(0,0,r*1.12);if(!a.available){const lx=a.boss?30*s:0,ly=a.boss?-8*s:-r*.65;g.lineStyle(1.5*s,0x8d8b9d,.7).arc(lx,ly,r*.12,Math.PI,0).drawRoundedRect(lx-r*.16,ly,r*.32,r*.23,2*s);}if(a.done){g.lineStyle(2*s,0xe2c77b,1).moveTo(-8*s,-34*s).lineTo(-2*s,-28*s).lineTo(9*s,-40*s);}n.number.alpha=a.available?1:.42;n.state.alpha=a.available?.85:.5;}","if(action==='back'||ui.stage<0&&!ui.transition&&gdjs.evtTools.input.wasKeyJustPressed(scene,'Escape'))ui.go(C.config.MenuScene);","else if(action==='skip'){C.tutorialDone('SelectTutorialDone');ui.stage=-1;ui.cue('UIClick');}","else if(action==='next'){if(ui.stage===3){C.tutorialDone('SelectTutorialDone');ui.go(C.config.GameplayScene,'1-1');}else{ui.stage++;ui.cue('UIClick');}}","else if(action==='launch')ui.go(C.config.GameplayScene,ui.selected);","else if(action.startsWith('chapter')){ui.chooseChapter(Number(action.slice(7)));ui.cue('UIClick');}","else if(action.startsWith('level'))ui.chooseLevel(ui.nodes[Number(action.slice(5))-1].levelId);","if(ui.transition){ui.transition.age+=dt;ui.root.alpha=Math.max(0,1-ui.transition.age/.3);if(ui.music)ui.music.setVolume(ui.settings.Music/100*ui.settings.Master/100*ui.root.alpha);if(ui.transition.age>=.3&&!ui.transition.requested){ui.transition.requested=true;gdjs.evtTools.runtimeScene.replaceScene(scene,ui.transition.target,false);}}","const canvas=game.getRenderer().getCanvas();if(canvas)canvas.style.cursor=ui.hover&&!ui.transition?'pointer':'default';"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"layers":[{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"","renderingType":"","visibility":true,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0.0,"viewportBottom":1.0,"viewportLeft":0.0,"viewportRight":1.0,"viewportTop":0.0,"width":0.0}],"effects":[]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"CampaignUI","renderingType":"","visibility":true,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0.0,"viewportBottom":1.0,"viewportLeft":0.0,"viewportRight":1.0,"viewportTop":0.0,"width":0.0}],"effects":[]}],"behaviorsSharedData":[]}],"externalEvents":[],"tests":[{"description":"Star Cannon selection toggles the single placement builder.","lastRunAt":0.0,"lastRunDurationMs":370.0,"lastRunFramesExecuted":20,"lastRunStatus":"not-run","name":"Picking Star Cannon","type":"gameplay","source":["// Picking a tile type in the toolbar shows what is about to be placed.","await harness.goToScene('Game Scene');","harness.watch('TilePlacement_Indicator');","","const getIndicator = () => harness.getObjects('TilePlacement_Indicator')[0];","await harness.stepFrames(5);","","harness.assert(","  getIndicator().hidden === true,","  'Nothing is about to be placed before a tile type is picked.'",");","","const buttons = harness.getObjects('TileType_Button');","harness.assert(buttons.length > 0, 'The toolbar has tile types to pick from.');","harness.assert(buttons.length === 1, \"Only Star Cannon is available.\");","const button = buttons[0];","console.log(","  'buttons=' + JSON.stringify(buttons.map((one) => one.animation)) +","    ' layer=' + JSON.stringify(button.layer)",");","","/** Click on a position of a layer. */","const clickAt = async (x, y, layerName) => {","  harness.setMousePosition(x, y, layerName);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false);","  await harness.stepFrames(3);","};","","await clickAt(button.centerX, button.centerY, button.layer);","const selected = getIndicator();","console.log(","  'afterPicking: hidden=' + selected.hidden + ' animation=' + JSON.stringify(selected.animation)",");","harness.assert(","  selected.hidden === false,","  'Picking a tile type shows what is about to be placed.'",");","harness.assert(","  selected.animation === button.animation,","  'What is about to be placed is the tile type that was picked (the indicator shows \"' +","    selected.animation + '\", the button is \"' + button.animation + '\").'",");","","// Picking it again turns it off.","await clickAt(button.centerX, button.centerY, button.layer);","console.log('afterPickingAgain: hidden=' + getIndicator().hidden);","harness.assert(","  getIndicator().hidden === true,","  'Picking the same tile type again stops placing.'",");"]}],"eventsFunctionsExtensions":[{"author":"@4ian","category":"Game mechanic","dimension":"","extensionNamespace":"","fullName":"Health points and damage","gdevelopVersion":">=5.5.222","helpPath":"","iconUrl":"data:image/svg+xml;base64,","name":"Health","previewIconUrl":"https://resources.gdevelop-app.com/assets/Icons/heart-half-full.svg","shortDescription":"Health/life system: damage, shield, armor, regeneration, cooldown, and over-healing.","version":"0.4.0","description":["Manage health (life) points, shield and armor of instances of an object. ","","It handles:","- Damage cooldown","- Health and shield regeneration","- Over healing","","It can be used on:","- Players","- Enemies","- NPCs","- Inanimate objects (for insance breakable doors or mining rocks)","","The top-down RPG example uses t