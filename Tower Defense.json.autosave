hArmor=enemy=>{","  const rec=scene.__voidGolem?.fort.members.get(enemy.getUniqueId());","  if(rec){scene.__voidGolem.fort.armor(rec);return;}","  const v=enemy.getVariables(),base=sv.get('EnemyTypes').toJSObject()[v.get('EnemyType').getAsString()]?.Armor??v.get('BaseArmor').getAsNumber();","  const armor=Math.max(0,base-star.fractureReduction(enemy));v.get('EffectiveArmor').setNumber(armor);v.get('Armor').setNumber(armor);enemy.getBehavior('Health').SetFlatDamageReduction(armor);"," };"," star.endFracture=(rec,visual=true)=>{","  const point=rec.icon?[rec.icon.getCenterXInScene(),rec.icon.getCenterYInScene()]:[rec.enemy.getCenterXInScene(),rec.enemy.getCenterYInScene()];","  scene.__enemyStatusIcons?.remove(rec.enemy,'ArmorFracture',rec.id);","  star.fractures.delete(rec.id);if(rec.icon&&rec.icon.getUniqueId()===rec.iconId&&get('StarCannonImpact').includes(rec.icon))rec.icon.deleteFromScene();","  if(rec.enemy.getUniqueId()===rec.id){","   const s=rec.enemy.getVariables().get('StatusEffects').getChild('ArmorFracture');s.getChild('Active').setBoolean(false);s.getChild('ExpiresAt').setNumber(0);s.getChild('ArmorReduction').setNumber(0);","   star.refreshArmor(rec.enemy);if(visual&&!rec.enemy.getBehavior('Health').IsDead())star.effect('Stabilize',...point,18);","   rec.enemy.unregisterDestroyCallback(rec.cleanup);","  }"," };"," star.fracture=enemy=>{","  const id=enemy.getUniqueId();let rec=star.fractures.get(id);","  if(!rec){","   const type=enemy.getVariables().get('EnemyType').getAsString(),fort=scene.__voidGolem?.fort.ensure(enemy);","   rec={id,enemy,baseArmor:fort?.baseArmor??sv.get('EnemyTypes').toJSObject()[type]?.Armor??enemy.getBehavior('Health').FlatDamageReduction()};","   rec.cleanup=()=>star.endFracture(rec,false);enemy.registerDestroyCallback(rec.cleanup);star.fractures.set(id,rec);","   const size=sv.get('EnemyStatusIconConfig').getChild('ArmorFractureSize').getAsNumber();","   rec.icon=star.effect('FractureIcon',enemy.getCenterXInScene(),enemy.getCe