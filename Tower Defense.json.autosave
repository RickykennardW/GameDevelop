","ShotgunTower.CenterX()","ShotgunTower.CenterY()","Bullet","ShotgunTower.Angle() - 16","450",""]}]},{"aiGeneratedEventId":"01M48XJ30W5DBNV9XJVAY8N90T","type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"Distance"},"parameters":["RocketTower","Enemy","300",""]},{"type":{"value":"NumberVariable"},"parameters":["GameOver","=","0"]},{"type":{"value":"CompareObjectTimer"},"parameters":["RocketTower","\"shoot\"",">","2"]}],"actions":[{"type":{"value":"PickNearest"},"parameters":["Enemy","RocketTower.CenterX()","RocketTower.CenterY()"]},{"type":{"value":"SetAngle"},"parameters":["RocketTower","=","RocketTower.AngleToPosition(Enemy.CenterX(), Enemy.CenterY())"]},{"type":{"value":"ResetObjectTimer"},"parameters":["RocketTower","\"shoot\""]},{"type":{"value":"FireBullet::FireBullet::FireTowardObject"},"parameters":["RocketTower","FireBullet","RocketTower.CenterX()","RocketTower.CenterY()","RocketBullet","Enemy","250",""]}]},{"aiGeneratedEventId":"01M48XJ30W5DBNV9XJVAY8N90T","type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"CollisionNP"},"parameters":["Bullet","Enemy","","",""]}],"actions":[{"type":{"value":"Health::Health::Hit"},"parameters":["Enemy","Health","15","no","no",""]},{"type":{"value":"Delete"},"parameters":["Bullet",""]}]},{"aiGeneratedEventId":"01M48XJ30W5DBNV9XJVAY8N90T","type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"CollisionNP"},"parameters":["RocketBullet","Enemy","","",""]}],"actions":[{"type":{"value":"PickAllInstances"},"parameters":["","Enemy"]}],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"Distance"},"parameters":["Enemy","RocketBullet","100",""]}],"actions":[{"type":{"value":"Health::Health::Hit"},"parameters":["Enemy","Health","40","no","no",""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"Delete"},"parameters":["RocketBullet",""]}]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"Health::Health::IsDead"},"parameters":["Enemy","Health",""]}],"actions":[{"type":{"value":"Delete"},"parameters":["Enemy",""]},{"type":{"value":"SetNumberVariable"},"parameters":["Money","+","KillReward"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BooleanVariable"},"parameters":["WaveActive","True",""]},{"type":{"value":"NumberVariable"},"parameters":["EnemiesToSpawn","=","0"]},{"type":{"value":"SceneInstancesCount"},"parameters":["","Enemy","=","0"]}],"actions":[{"type":{"value":"SetBooleanVariable"},"parameters":["WaveActive","False",""]}],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["Wave",">=","5"]}],"actions":[{"type":{"value":"SetBooleanVariable"},"parameters":["GameOver","True",""]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["MessageText","Text","=","\"YOU WIN!\""]},{"type":{"value":"Show"},"parameters":["MessageText",""]}]},{"type":"BuiltinCommonInstructions::Else","conditions":[],"actions":[{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["MessageText","Text","=","\"Wave cleared! Press SPACE\""]},{"type":{"value":"Show"},"parameters":["MessageText",""]}]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["Lives","<=","0"]},{"type":{"value":"BooleanVariable"},"parameters":["GameOver","False",""]}],"actions":[{"type":{"value":"SetBooleanVariable"},"parameters":["GameOver","True",""]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["MessageText","Text","=","\"GAME OVER\""]},{"type":{"value":"Show"},"parameters":["MessageText",""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["MoneyText","Text","=","\"Money: \" + ToString(Money)"]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["LivesText","Text","=","\"Lives: \" + ToString(Lives)"]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["WaveText","Text","=","\"Wave: \" + ToString(Wave) + \"/5\""]}]}],"parameters":[]}],"layers":[{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"","renderingType":"","visibility":true,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0.0,"viewportBottom":1.0,"viewportLeft":0.0,"viewportRight":1.0,"viewportTop":0.0,"width":0.0}],"effects":[]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"UI","renderingType":"","visibility":true,"cameras":[],"effects":[]}],"behaviorsSharedData":[{"name":"Animation","type":"AnimatableCapability::AnimatableBehavior"},{"name":"ButtonFSM","type":"ButtonStates::ButtonFSM"},{"name":"ButtonScaleTween","type":"ButtonStates::ButtonScaleTween"},{"name":"Effect","type":"EffectCapability::EffectBehavior"},{"name":"FireBullet","type":"FireBullet::FireBullet"},{"name":"Flippable","type":"FlippableCapability::FlippableBehavior"},{"name":"Health","type":"Health::Health"},{"name":"Opacity","type":"OpacityCapability::OpacityBehavior"},{"name":"Resizable","type":"ResizableCapability::ResizableBehavior"},{"name":"Scale","type":"ScalableCapability::ScalableBehavior"},{"name":"Text","type":"TextContainerCapability::TextContainerBehavior"},{"name":"TileMap","type":"TileMap::TileMapBehavior"},{"name":"Tween","type":"Tween::TweenBehavior"}]}],"externalEvents":[],"tests":[{"description":"Picking a tile type in the toolbar shows what is about to be placed, and picking it again stops placing.","lastRunAt":1791301007400.0,"lastRunDurationMs":435.0,"lastRunFramesExecuted":20,"lastRunStatus":"passed","name":"Picking a tile type","type":"gameplay","source":["// Picking a tile type in the toolbar shows what is about to be placed.","await harness.goToScene('Game Scene');","harness.watch('TilePlacement_Indicator');","","const getIndicator = () => harness.getObjects('TilePlacement_Indicator')[0];","await harness.stepFrames(5);","","harness.assert(","  getIndicator().hidden === true,","  'Nothing is about to be placed before a tile type is picked.'",");","","const buttons = harness.getObjects('TileType_Button');","harness.assert(buttons.length > 0, 'The toolbar has tile types to pick from.');","const button = buttons[0];","console.log(","  'buttons=' + JSON.stringify(buttons.map((one) => one.animation)) +","    ' layer=' + JSON.stringify(button.layer)",");","","/** Click on a position of a layer. */","const clickAt = async (x, y, layerName) => {","  harness.setMousePosition(x, y, layerName);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false);","  await harness.stepFrames(3);","};","","await clickAt(button.centerX, button.centerY, button.layer);","const selected = getIndicator();","console.log(","  'afterPicking: hidden=' + selected.hidden + ' animation=' + JSON.stringify(selected.animation)",");","harness.assert(","  selected.hidden === false,","  'Picking a tile type shows what is about to be placed.'",");","harness.assert(","  selected.animation === button.animation,","  'What is about to be placed is the tile type that was picked (the indicator shows \"' +","    selected.animation + '\", the button is \"' + button.animation + '\").'",");","","// Picking it again turns it off.","await clickAt(button.centerX, button.centerY, button.layer);","console.log('afterPickingAgain: hidden=' + getIndicator().hidden);","harness.assert(","  getIndicator().hidden === true,","  'Picking the same tile type again stops placing.'",");"]},{"description":"With a tile type picked, clicking a buildable cell places that tile on the grid, and clicking it again does not stack a second one.","lastRunAt":1791301031988.0,"lastRunDurationMs":544.0,"lastRunFramesExecuted":27,"lastRunStatus":"passed","name":"Placing a tile on the board","type":"gameplay","source":["await harness.goToScene('Game Scene');","harness.watch('TilePlacement_Indicator');","const getIndicator = () => harness.getObjects('TilePlacement_Indicator')[0];","const placedTiles = () => ['Tower','ShotgunTower','RocketTower'].reduce((t,n)=>t+harness.getObjects(n).length,0);","await harness.stepFrames(5);","// Pick cheapest affordable tower (Tower 100) so starting Money 200 always allows placement","let button = harness.getObjects('TileType_Button').find(b=>b.animation==='Tower') || harness.getObjects('TileType_Button')[0];","const tileType = button.animation;","harness.assert(placedTiles()===0, 'The board starts empty.');","const clickAt = async (x,y,layer)=>{ harness.setMousePosition(x,y,layer); await harness.stepFrames(2); harness.setMouseButtonPressed(true); await harness.stepFrames(2); harness.setMouseButtonPressed(false); await harness.stepFrames(3); };","await clickAt(button.centerX, button.centerY, button.layer);","harness.assert(getIndicator().hidden===false, 'A tile type is picked ('+tileType+').');","let placedAtX=null, placedAtY=null;","for(let x=320;x<=960 && placedAtX===null;x+=64){ for(let y=192;y<=448 && placedAtX===null;y+=64){ await clickAt(x,y,''); if(placedTiles()>0){placedAtX=x;placedAtY=y;} } }","console.log('placedAt='+placedAtX+','+placedAtY+' tiles='+placedTiles());","harness.assert(placedAtX!==null, 'Clicking a buildable cell of the board places the picked tile there.');","harness.assert(harness.getObjects(tileType).length===1, 'Placed type matches picked type');","const placed = harness.getObjects(tileType)[0];","harness.assert(placed.x%64===0 && placed.y%64===0, 'Tile placed on grid at '+Math.round(placed.x)+','+Math.round(placed.y));","await clickAt(placedAtX,placedAtY,'');","console.log('afterSecondClick: tiles='+placedTiles());","harness.assert(placedTiles()===1, 'Clicking occupied cell does not stack ('+placedTiles()+' tiles)');"]},{"description":"Place a basic tower, start wave 1, verify towers auto-shoot and kill all enemies.","lastRunAt":1791300966761.0,"lastRunDurationMs":1252.0,"lastRunFramesExecuted":645,"lastRunStatus":"passed","name":"TowerDefenseCore","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(5);","const money0 = harness.getSceneVariable('Money')?.value;","harness.assert(money0 === 200, 'Money starts at 200, got '+money0);","const btns = harness.getObjects('TileType_Button');","const towerBtn = btns.find(b=>b.animation==='Tower');","harness.assert(!!towerBtn, 'Tower button exists');","const clickAt = async (x,y,layer)=>{ harness.setMousePosition(x,y,layer); await harness.stepFrames(2); harness.setMouseButtonPressed(true); await harness.stepFrames(2); harness.setMouseButtonPressed(false); await harness.stepFrames(3); };","await clickAt(towerBtn.centerX, towerBtn.centerY, towerBtn.layer);","let ind = harness.getObjects('TilePlacement_Indicator')[0];","harness.assert(ind.hidden===false, 'Indicator visible after Tower pick');","// find buildable cell","let px=null, py=null;","for(let x=320;x<=960 && px===null;x+=64){ for(let y=192;y<=448 && px===null;y+=64){ await clickAt(x,y,''); if(harness.getObjects('Tower').length>0){px=x;py=y;} } }","harness.assert(px!==null, 'Tower placed on buildable cell');","harness.assert(harness.getSceneVariable('Money')?.value===100, 'Money 200-100=100 after Tower, got '+harness.getSceneVariable('Money')?.value);","harness.setKeyPressed('Space', true); await harness.stepFrames(2); harness.setKeyPressed('Space', false); await harness.stepFrames(2);","harness.assert(harness.getSceneVariable('Wave')?.value===1, 'Wave 1 started');","const moneyBeforeWave = harness.getSceneVariable('Money')?.value;","const killed = await harness.stepUntil(()=>harness.getObjects('Enemy').length===0 && harness.getSceneVariable('EnemiesToSpawn')?.value===0, {maxFrames:2400});","harness.assert(killed, 'Wave 1 enemies all killed by towers');","harness.assert(harness.getSceneVariable('Money')?.value>moneyBeforeWave, 'Money increased from kills (+15 each)');","harness.assert(harness.getSceneVariable('WaveActive')?.value===false, 'Wave ended');","harness.takeScreenshot && await harness.takeScreenshot('core-done');"]},{"description":"Shotgun placement and cost, rocket cost gate, S-path movement, wave cleared by shotgun.","lastRunAt":1791300990517.0,"lastRunDurationMs":1224.0,"lastRunFramesExecuted":781,"lastRunStatus":"passed","name":"TowerTypesAndSPath","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(5);","const btns = harness.getObjects('TileType_Button');","const sgBtn = btns.find(b=>b.animation==='ShotgunTower');","harness.assert(!!sgBtn, 'Shotgun button exists');","const clickAt = async (x,y,layer)=>{ harness.setMousePosition(x,y,layer); await harness.stepFrames(2); harness.setMouseButtonPressed(true); await harness.stepFrames(2); harness.setMouseButtonPressed(false); await harness.stepFrames(3); };","await clickAt(sgBtn.centerX, sgBtn.centerY, sgBtn.layer);","let ind = harness.getObjects('TilePlacement_Indicator')[0];","harness.assert(ind.hidden===false, 'Indicator visible after shotgun pick');","await clickAt(600,192,'');","// if blocked (path), scan for a free cell","if(harness.getObjects('ShotgunTower').length===0){"," for(let x=320;x<=960 && harness.getObjects('ShotgunTower').length===0;x+=64){ for(let y=192;y<=448 && harness.getObjects('ShotgunTower').length===0;y+=64){ await clickAt(x,y,''); } }","}","harness.assert(harness.getObjects('ShotgunTower').length===1, 'ShotgunTower placed');","harness.assert(harness.getSceneVariable('Money')?.value===50, 'Money 200-150=50 after shotgun, got '+harness.getSceneVariable('Money')?.value);","const rkBtn = harness.getObjects('TileType_Button').find(b=>b.animation==='RocketTower');","await clickAt(rkBtn.centerX, rkBtn.centerY, rkBtn.layer);","await clickAt(300,380,'');","harness.assert(harness.getObjects('RocketTower').length===0, 'Rocket too expensive with 50g');","harness.setKeyPressed('Space', true); await harness.stepFrames(2); harness.setKeyPressed('Space', false); await harness.stepFrames(2);","await harness.stepFrames(80);","const enemies = harness.getObjects('Enemy');","harness.assert(enemies.length>0, 'Enemies spawned');","const e = enemies[0];","harness.assert(e.y<160, 'Enemy on top path segment, y='+e.y);","harness.assert(e.x>-40, 'Enemy moving right, x='+e.x);","const cleared = await harness.stepUntil(()=>harness.getObjects('Enemy').length===0 && harness.getSceneVariable('EnemiesToSpawn')?.value===0, {maxFrames:2500});","harness.assert(cleared, 'Wave cleared by shotgun tower');","harness.assert(harness.getSceneVariable('Lives')?.value===10, 'No lives lost');"]},{"description":"Check map visuals and placement.","lastRunAt":1791302337473.0,"lastRunDurationMs":656.0,"lastRunFramesExecuted":32,"lastRunStatus":"passed","name":"PathPlaceCheck","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(10);","await harness.takeScreenshot('green-base-dirt-path');","const btns=harness.getObjects('TileType_Button');","const towerBtn=btns.find(b=>b.animation==='Tower');","const clickAt=async(x,y,layer)=>{harness.setMousePosition(x,y,layer);await harness.stepFrames(2);harness.setMouseButtonPressed(true);await harness.stepFrames(2);harness.setMouseButtonPressed(false);await harness.stepFrames(3);};","await clickAt(towerBtn.centerX,towerBtn.centerY,towerBtn.layer);","await clickAt(320,192,'');","harness.assert(harness.getObjects('Tower').length===1,'tower places on grass');","const n0=harness.getObjects('Tower').length;","await clickAt(320,96,'');","harness.assert(harness.getObjects('Tower').length===n0,'dirt path blocked');","await harness.takeScreenshot('placement-fixed');"]}],"eventsFunctionsExtensions":[{"author":"","category":"User interface","dimension":"2D","extensionNamespace":"","fullName":"Button states and effects","gdevelopVersion":">=5.5.222","helpPath":"/objects/button","iconUrl":"data:image/svg+xml;base64,","name":"ButtonStates","previewIconUrl":"https://asset-resources.gdevelop.io/public-resources/Icons/753a9a794bd885058159b7509f06f5a8f67f72decfccb9a1b0efee26f41c3c4c_gesture-tap-button.svg","shortDescription":"Use any object as a button and change appearance according to user interactions.","version":"1.4.1","description":["Use the \"Button states\" behavior to track user interactions with an object, including:","","- Hovered","- Pressed","- Clicked","- Idle","","Add additional behaviors to make juicy buttons with animated responses to user input:","","- Size","- Color","- Animation","- Object effects"],"origin":{"identifier":"ButtonStates","name":"gdevelop-extension-store"},"tags":["ui","button"],"authorIds":["IWykYNRvhCZBN3vEgKEbBPOR3Oc2","gqDaZjCfevOOxBYkK6zlhtZnXCg1"],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[],"eventsFunctionsFolderStructure":{"folderName":"__ROOT"},"eventsBasedBehaviors":[{"description":"Use objects as buttons.","fullName":"Button states","helpPath":"","iconUrl":"","name":"ButtonFSM","objectType":"","previewIconUrl":"","eventsFunctions":[{"fullName":"","functionType":"Action","name":"doStepPreEvents","sentence":"","events":[{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"name":"Finite state machine","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r