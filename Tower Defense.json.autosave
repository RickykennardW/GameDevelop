ard"}]}]},{"folderName":"08_EFFECTS","children":[{"folderName":"VoidFortification","children":[{"objectName":"VoidFortificationVFX"},{"objectName":"VoidFortificationCastPulse"}]}]}]},"events":[{"colorB":109,"colorG":143,"colorR":90,"creationTime":0,"name":"Responsive tower shop layout and input","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Responsive two-column shop with one official Star Cannon. All purchase and wave actions stay in the native events below.","const scene = runtimeScene;","const variables = scene.getVariables();","// Independent world presentation controls; combat stats are deliberately separate.","const style=scene.__worldStyle || (scene.__worldStyle={road:88,star:2.5,"," enemy:1.55,spawn:5.2,base:2.15,"," props:{Crystal:1.65,Rock:1.75,Ruin:2.30,Shrub:1.65},"," footprints:{StarCannonTower:46},cliffUnit:.32});","if(!scene.__worldStyleInitialized){"," for(const [name,radius] of Object.entries(style.footprints)){","  const v=variables.get('TowerFootprints').getChild(name);v.getChild('Radius').setNumber(radius);","  v.getChild('RenderScale').setNumber(style.star);"," }"," scene.__worldStyleInitialized=true;","}","const get = name => scene.getObjects(name);","const first = name => get(name)[0];","const number = name => variables.get(name).getAsNumber();","const boolean = name => variables.get(name).getAsBoolean();","const mode = () => variables.get(\"WaveMode\").getAsString();","// One authoritative state: Waiting(0), Manual(1), ManualFast(2), Auto(3), AutoFast(4).","const autoMode = () => mode() === \"Auto\" || mode() === \"AutoFast\";","const fastMode = () => mode() === \"ManualFast\" || mode() === \"AutoFast\";","const syncWaveControl = () => {","  const valid = [\"Waiting\",\"Manual\",\"ManualFast\",\"Auto\",\"AutoFast\"];","  if (!valid.includes(mode())) variables.get(\"WaveMode\").setString(boolean(\"WaveActive\") ? \"Manual\" : \"Waiting\");","  const manager = scene.__waveManager;","  const spawningDone = !manager || manager.index >= manager.queue.length;","  const finished = !boolean(\"WaveActive\") && number(\"EnemiesToSpawn\") === 0 && get(\"Enemy\").length === 0 && spawningDone;","  if (boolean(\"GameOver\") || number(\"Lives\") <= 0) variables.get(\"WaveMode\").setString(\"Waiting\");","  else if (!autoMode() && finished) variables.get(\"WaveMode\").setString(\"Waiting\");","  else if (mode() === \"Waiting\" && boolean(\"WaveActive\")) variables.get(\"WaveMode\").setString(\"Manual\");","  const scale = scene.__fusion?.active ? scene.__fusion.config.FusionTimeScale : fastMode() ? 2 : 1;","  const time = scene.getTimeManager();","  if (time.getTimeScale() !== scale) time.setTimeScale(scale);","};","syncWaveControl();","const modal = boolean(\"IndexOpen\") || boolean(\"AudioUIConsumesClick\") || boolean(\"FusionActive\");","let ui = scene.__towerShopUI;","if (!ui || ui.root !== first(\"TowerShopBox\")) {","  ui = scene.__towerShopUI = { root: first(\"TowerShopBox\"), cards: [], wasDown: false, pressedCard: -1, pressedControl: \"\", dragging: false };","  ui.ensure = (name, index) => {","    let object = get(name).find(object => object.getVariables().get(\"ShopIndex\").getAsNumber() === index);","    if (!object) { object = scene.createObject(name); object.getVariables().get(\"ShopIndex\").setNumber(index); }","    object.setLayer(\"TowerShopList\");","    return object;","  };","  const container = scene.getLayer(\"TowerShopList\").getRenderer().getRendererObject();","  ui.mask = new PIXI.Graphics();","  container.addChild(ui.mask);","  container.mask = ui.mask;","}","// One resize owner. A bounded design canvas scales once through the renderer,","// never from an object's previous size or zoom. Retain the last valid canvas","// while minimized/hidden: native adaptWidth otherwise divides by window height.","const game = scene.getGame();","const viewportWidth = Math.round(gdjs.RuntimeGameRenderer.getWindowInnerWidth());","const viewportHeight = Math.round(gdjs.RuntimeGameRenderer.getWindowInnerHeight());","const viewport = game.__celestialViewport || (game.__celestialViewport = {minWidth:960,minHeight:540,revision:0});","if(game.getAdaptGameResolutionAtRuntime())game.setAdaptGameResolutionAtRuntime(false);","const validViewport=Number.isFinite(viewportWidth)&&Number.isFinite(viewportHeight)&&viewportWidth>=64&&viewportHeight>=64&&!(typeof document!=='undefined'&&document.hidden);","if (validViewport && (viewport.width!==viewportWidth || viewport.height!==viewportHeight)) {","  const factor=Math.max(1,viewport.minWidth/viewportWidth,viewport.minHeight/viewportHeight);","  viewport.width=viewportWidth;viewport.height=viewportHeight;","  viewport.logicalWidth=Math.round(viewportWidth*factor);viewport.logicalHeight=Math.round(viewportHeight*factor);","  viewport.revision++;","}","if(viewport.logicalWidth && (game.getGameResolutionWidth()!==viewport.logicalWidth || game.getGameResolutionHeight()!==viewport.logicalHeight)){","  game.setGameResolutionSize(viewport.logicalWidth,viewport.logicalHeight);","  scene.onGameResolutionResized();","}","const width = game.getGameResolutionWidth();","const height = game.getGameResolutionHeight();","// UI uses a stable logical shop X outside the buildable world area. Its camera anchors it to screen right.","const sidebarMargin = 8, mapSidebarGap = 10;","const sidebarScreenX = width - 224 - sidebarMargin;","const gameAreaRight = Math.max(1, sidebarScreenX - mapSidebarGap);","const offsetX = 1376 + sidebarMargin - width;","for (const layerName of [\"UI\", \"TowerShopList\"]) {","  const layer = scene.getLayer(layerName);","  layer.setCameraZoom(1, 0);","  layer.setCameraX(width / 2 + offsetX, 0);","  layer.setCameraY(height / 2, 0);","}","// One reference world, independent of monitor resolution. Fullscreen changes the","// world camera, not route density. World units, footprints and combat ranges stay intact.","const map = scene.getLayer(\"\");","const compactHUD = gameAreaRight < 348;","const hudHeight = compactHUD ? 104 : 44;","const safeTop = 16 + hudHeight + 20;","// HUD overlays the empty upper cliff margin; its input guard remains authoritative.","// On narrow portrait windows reserve the taller HUD band explicitly.","const frameTop = compactHUD ? safeTop : 16;","const mapFrame = { left: 16, top: frameTop, right: Math.max(17,gameAreaRight-16), bottom: Math.max(frameTop+1,height-24) };","const layoutKey = \"celestial-four-lane-88\";","if (!ui.level) {","  // Four broad lanes preserve total travel distance (7128 vs 7168 world units),","  // while allowing wider roads and larger sprites without shrinking build pockets.","  const cell=style.road,left=cell,right=cell*19,firstY=cell*2;","  const rows = [2,5,8,11].map(row=>row*cell);","  const corners = [[left,rows[0]]];","  rows.forEach((y,i)=>{if(i)corners.push([corners[corners.length-1][0],y]);corners.push([i%2===0?right:left,y]);});","  const positions = [corners[0]];","  for (const [tx,ty] of corners.slice(1)) {","    let [x,y] = positions[positions.length-1];","    while (x!==tx || y!==ty) { x+=Math.sign(tx-x)*cell;y+=Math.sign(ty-y)*cell;positions.push([x,y]); }","  }","  const tiles = get(\"Monster_Path\").slice().sort((a,b)=>a.getVariables().get(\"PathOrder\").getAsNumber()-b.getVariables().get(\"PathOrder\").getAsNumber());","  positions.forEach(([x,y],i)=>{","    const tile = tiles[i] || scene.createObject(\"Monster_Path\");","    tile.setLayer(\"\");tile.setZOrder(0);tile.setWidth(cell);tile.setHeight(cell);tile.setPosition(x,y);tile.setAnimationName(\"Surface\");tile.getVariables().get(\"PathOrder\").setNumber(i);","  });","  tiles.slice(positions.length).forEach(tile=>tile.deleteFromScene());","  const spawnPoint=[left+cell/2,firstY+cell/2],last=positions.at(-1),basePoint=[last[0]+cell/2,last[1]+cell/2];","  const spawn = first(\"SpawnMarker\"), base=first(\"BaseMarker\");","  spawn.setPosition(spawnPoint[0]-16,spawnPoint[1]-16);spawn.setWidth(32);spawn.setHeight(32);spawn.setZOrder(0);","  base.setPosition(basePoint[0]-40,basePoint[1]-40);base.setWidth(80);base.setHeight(80);","  const trees = get(\"Ground_Decoration\");","  const middle=(left+right)/2;","  const treePoints=[];","  // Asymmetric floor clusters: keep generous bend pockets and multiple open strips.","  const compositions=[[.24,.32,.60,.67],[.72,.64,.30,.39],[.35,.43,.72,.79]];","  for(let band=0;band<3;band++){","    const y=(rows[band]+cell+rows[band+1])/2-32;","    for(const t of compositions[band])treePoints.push([left+(right-left)*t-32,y]);","  }","  trees.forEach((tree,i)=>{tree.setPosition(...treePoints[i%12]);tree.getVariables().get('LocalScale').setNumber(1);tree.getVariables().get('Kind').setString(['Crystal','Rock','Ruin','Shrub'][i%4]);});","  // Smaller satellites enrich floor clusters without adding another large obstruction.","  for(const [kind,t,band,dy,size] of [","    ['Rock',.21,0,40,.42],['Shrub',.29,0,46,.56],","    ['Crystal',.75,1,42,.46],['Shrub',.67,1,50,.53],","    ['Rock',.69,2,44,.43],['Shrub',.39,2,48,.56],","    ['Crystal',.48,-1,0,.80],['Shrub',.54,-1,20,.72]]){","      const o=scene.createObject('Ground_Decoration');o.setLayer('');o.getVariables().get('Kind').setString(kind);o.getVariables().get('LocalScale').setNumber(size);","      const y=band<0?firstY-72:(rows[band]+cell+rows[band+1])/2+dy;","      o.setPosition(left+(right-left)*t-32,y-32);","  }","  // Exact outer extent of the proportional perimeter in island-map-runtime.js,","  // plus 12 world px breathing room. All frame pieces fit, including hanging rock.","  ui.mapBounds={left:left-16-225*style.cliffUnit-12,top:firstY-112-180*style.cliffUnit-12,","    right:right+cell+16+225*style.cliffUnit+12,bottom:rows.at(-1)+cell+16+206*style.cliffUnit+12};","  ui.level={key:layoutKey,rows,left,right,spawn:spawnPoint,base:basePoint,tileCount:positions.length,length:(positions.length-1)*cell};","  variables.get(\"MapRouteDirty\").setBoolean(true);","}","const bounds = {...ui.mapBounds};","// Fixed gameplay framing depends only on static map geometry, never on towers/ghosts.","ui.fittedBounds=bounds;","const zoom = Math.max(0.001,Math.min((mapFrame.right-mapFrame.left)/(bounds.right-bounds.left),(mapFrame.bottom-mapFrame.top)/(bounds.bottom-bounds.top)));","map.setCameraZoom(zoom,0);","map.setCameraX((bounds.left+bounds.right)/2-((mapFrame.left+mapFrame.right)/2-width/2)/zoom,0);","map.setCameraY((bounds.top+bounds.bottom)/2-((mapFrame.top+mapFrame.bottom)/2-height/2)/zoom,0);","// The original grass texture tiles naturally across ALL visible gameplay pixels.","const ground = first(\"Ground_Map\");","const min = map.convertCoords(0,0,0,[0,0]), max=map.convertCoords(gameAreaRight,height,0,[0,0]);","ground.setPosition(min[0],min[1]);ground.setWidth(max[0]-min[0]);ground.setHeight(max[1]-min[1]);","if (!ui.mapMask) {","  const container=map.getRenderer().getRendererObject();ui.mapMask=new PIXI.Graphics();container.addChild(ui.mapMask);container.mask=ui.mapMask;","}","const maskKey=[width,height,gameAreaRight,zoom,map.getCameraX(),map.getCameraY()].join(\",\");","if(ui.mapMaskKey!==maskKey){ui.mapMask.clear().beginFill(0xffffff).drawRect(min[0],min[1],max[0]-min[0],max[1]-min[1]).endFill();ui.mapMaskKey=maskKey;}","ui.gameArea={left:0,top:0,right:gameAreaRight,bottom:height,sidebarX:sidebarScreenX,gap:mapSidebarGap,margin:sidebarMargin,frame:mapFrame};","","ui.geometry = { rootX: 1152, rootY: sidebarMargin, panelHeight: height - sidebarMargin * 2, listX: 1168, listY: 72 + sidebarMargin, listWidth: 176 };","const geometry = ui.geometry;","geometry.bottom = geometry.rootY + geometry.panelHeight;","geometry.listHeight = Math.max(1, geometry.bottom - geometry.listY - 88);","geometry.playY = geometry.bottom - 72;","geometry.trackX = 1350;","const rect = (name, x, y, w, h) => { const o = first(name); o.setPosition(x, y); if (w !== undefined) o.setWidth(w); if (h !== undefined) o.setHeight(h); };","rect(\"TowerShopBox\", 1152, geometry.rootY, 224, geometry.panelHeight);","rect(\"ShopHeaderPlaque\", 1166, geometry.rootY + 10, 196, 48);","rect(\"ShopFooterFrame\", 1160, geometry.playY - 4, 208, 72);","rect(\"AssetPanelTitle\", 1168, geometry.rootY + 16, 192, 24);","rect(\"AssetPanelSubtitle\", 1168, geometry.rootY + 37, 192, 16);","rect(\"ShopIndexButton\", 1168, geometry.playY, 92, 60);","","rect(\"ShopPlayButton\", 1268, geometry.playY, 92, 60);","rect(\"ShopPlayIcon\", 1302, geometry.playY + 8, 24, 24);","rect(\"ShopPlayLabel\", 1268, geometry.playY + 36, 92, 20);","rect(\"ShopSpeedBadge\", 1332, geometry.playY + 8, 20, 14);","rect(\"ShopScrollTrack\", geometry.trackX, geometry.listY, 8, geometry.listHeight);","","// Keep the original HUD artwork. On narrow windows only its row arrangement changes.","const hudWidth = compactHUD ? Math.max(1, Math.min(196, gameAreaRight - 32)) : 316;","rect(\"HUDPanel\", offsetX + 16, 16, hudWidth, hudHeight);","get(\"HUDIcon\").forEach((o, i) => { o.setPosition(offsetX + (compactHUD ? 28 : [28,148,230][i]), compactHUD ? 26 + i * 30 : 26); o.setWidth(24); o.setHeight(24); });","for (const [i,name] of [\"MoneyText\",\"LivesText\",\"WaveText\"].entries()) {","  rect(name, offsetX + (compactHUD ? 60 : [60,180,262][i]), compactHUD ? 25 + i * 30 : 25, compactHUD ? Math.max(1,hudWidth-52) : [80,40,62][i], 28);","}","const message = first(\"MessageText\");","message.setWidth(Math.max(1, gameAreaRight - 32));","message.setPosition(offsetX + 16, height / 2 - 20);","// Prices have exactly one source: the existing costs migrated unchanged into TowerShopCatalog.","const catalog = variables.get(\"TowerShopCatalog\").toJSObject();","for (const name of [\"AssetCardPanel\", \"TileType_Button\", \"AssetTowerLabel\", \"AssetTowerPrice\", \"ShopCoin\"]) {","  get(name).slice().forEach(object => {","    if (object.getVariables().get(\"ShopIndex\").getAsNumber() >= catalog.length) object.deleteFromScene(scene);","  });","}","ui.cards.length = catalog.length;","for (let i = 0; i < catalog.length; i++) {","  const item = catalog[i];","  if (!ui.cards[i]) {","    const card = ui.cards[i] = { background: ui.ensure(\"AssetCardPanel\", i), icon: ui.ensure(\"TileType_Button\", i), name: ui.ensure(\"AssetTowerLabel\", i), price: ui.ensure(\"AssetTowerPrice\", i), coin: ui.ensure(\"ShopCoin\", i) };","    ","    if (card.icon.hasBehavior(\"Effect\")) card.icon.getBehavior(\"Effect\").enableEffect(\"Outline\", false);","    card.icon.setAnimationName(item.IconAnimation || item.Type);","    const ratio = card.icon.getWidth() / Math.max(1, card.icon.getHeight());","    const iconSize = item.Type === \"StarCannonTower\" ? 64 : 56;","    card.iconWidth = ratio > 1 ? iconSize : iconSize * ratio;","    card.iconHeight = ratio > 1 ? iconSize / ratio : iconSize;","  }","  const card = ui.cards[i];","  card.item = item;","  card.icon.getVariables().get(\"TowerType\").setString(item.Type);","  card.icon.getVariables().get(\"Cost\").setNumber(item.Cost);","  card.name.setString(item.Name);","  card.name.setCharacterSize(11);card.name.setWrapping(true);card.name.setWrappingWidth(76);card.name.setTextAlignment(\"center\");","  card.price.setCharacterSize(13);card.price.setWrapping(true);card.price.setWrappingWidth(46);card.price.setTextAlignment(\"center\");","  card.price.setString(String(item.Cost));","}","const contentHeight = Math.ceil(catalog.length / 2) * 120 - 8;","const maxScroll = Math.max(0, contentHeight - geometry.listHeight);","let scroll = Math.max(0, Math.min(maxScroll, number(\"TowerShopScroll\")));","const input = scene.getGame().getInputManager();","const mx = gdjs.evtTools.input.getCursorX(scene, \"UI\", 0);","const my = gdjs.evtTools.input.getCursorY(scene, \"UI\", 0);","const inside = (x,y,w,h) => mx >= x && mx < x+w && my >= y && my < y+h;","const shopVisible = !modal;","const inList = inside(geometry.listX, geometry.listY, geometry.listWidth, geometry.listHeight);","const inTrack = inside(geometry.trackX - 3, geometry.listY, 14, geometry.listHeight);","variables.get(\"TowerShopPointerInside\").setBoolean(shopVisible && inList);","variables.get(\"TowerShopRequestedType\").setString(\"\");","variables.get(\"PlayWaveRequested\").setBoolean(false);","if (shopVisible && (inList || inTrack)) scroll = Math.max(0, Math.min(maxScroll, scroll - Math.sign(input.getMouseWheelDelta()) * 48));","const hoveredIndex = () => {","  if (!shopVisible || !inList) return -1;","  const x = mx - geometry.listX, y = my - geometry.listY + scroll;","  const col = Math.floor(x / 92), row = Math.floor(y / 120), index = row * 2 + col;","  return col < 2 && x % 92 < 84 && y % 120 < 112 && index < catalog.length ? index : -1;","};","const ready = !boolean(\"WaveActive\") && !boolean(\"GameOver\") && number(\"Wave\") < (number(\"MaximumWave\")||45);","const overIndex = !modal && inside(1168, geometry.playY, 92, 60);","const overPlay = !modal && inside(1268, geometry.playY, 92, 60);","const down = input.isMouseButtonPressed(0);","let hovered = hoveredIndex();","if (down && !ui.wasDown) {","  ui.pressedCard = hovered;","  ui.pressedControl = overIndex ? \"Index\" : overPlay ? \"Play\" : \"\";","  if (inTrack && maxScroll > 0 && shopVisible) { ui.dragging = true; ui.dragStartY = my; ui.dragStartScroll = scroll; ui.pressedCard = -1; }","}","const thumbHeight = maxScroll > 0 ? Math.max(22, geometry.listHeight * geometry.listHeight / contentHeight) : geometry.listHeight;","if (ui.dragging && down) scroll = Math.max(0, Math.min(maxScroll, ui.dragStartScroll + (my - ui.dragStartY) * maxScroll / Math.max(1, geometry.listHeight - thumbHeight)));","if (!down && ui.wasDown) {","  if (ui.pressedControl === \"Index\" && overIndex) ui.indexRequested = true;","  if (ui.pressedControl === \"Play\" && overPlay && !boolean(\"GameOver\")) {","    if (mode() === \"Waiting\") {","      if (ready) variables.get(\"PlayWaveRequested\").setBoolean(true);","    } else {","      const cycle = [\"Manual\",\"ManualFast\",\"Auto\",\"AutoFast\"];","      variables.get(\"WaveMode\").setString(cycle[(cycle.indexOf(mode()) + 1) % cycle.length]);","      // Cancelling AUTO between waves returns to waiting; an active wave never pauses.","      syncWaveControl();","    }","  }","  if (!ui.dragging && ui.pressedCard >= 0 && ui.pressedCard === hovered) variables.get(\"TowerShopRequestedType\").setString(catalog[hovered].Type);","  ui.pressedCard = -1; ui.pressedControl = \"\"; ui.dragging = false;","}","ui.wasDown = down;","variables.get(\"TowerShopScroll\").setNumber(scroll);","hovered = hoveredIndex();","const listMaskKey=[geometry.listX,geometry.listY,geometry.listWidth,geometry.listHeight].join(':');","if(ui.listMaskKey!==listMaskKey){ui.mask.clear().beginFill(0xffffff).drawRect(geometry.listX,geometry.listY,geometry.listWidth,geometry.listHeight).endFill();ui.listMaskKey=listMaskKey;}","ui.cards.forEach((card, i) => {","  const x = geometry.listX + (i % 2) * 92, y = geometry.listY + Math.floor(i / 2) * 120 - scroll;","  card.background.setPosition(x, y); card.background.setWidth(84); card.background.setHeight(112);","  const pressed = down && ui.pressedCard === i && hovered === i;","  const scale = pressed ? 0.94 : hovered === i ? 1.04 : 1;","  card.icon.setWidth(card.iconWidth * scale); card.icon.setHeight(card.iconHeight * scale);","  card.icon.setPosition(x + 42 - card.icon.getWidth()/2, y + (card.item.Type === \"StarCannonTower\" ? 57 : 51) - card.icon.getHeight()/2);","  card.name.setPosition(x + 4, y + 5); card.name.setWidth(76); card.name.setHeight(18);","  card.coin.setPosition(x + 13, y + 91); card.coin.setWidth(15); card.coin.setHeight(15);","  card.price.setPosition(x + 31, y + 91); card.price.setWidth(46); card.price.setHeight(20);","});","rect(\"ShopScrollThumb\", geometry.trackX, geometry.listY + (maxScroll > 0 ? scroll / maxScroll * (geometry.listHeight - thumbHeight) : 0), 8, thumbHeight);","ui.scrollMax = maxScroll; ui.hovered = hovered; ui.ready = ready; ui.overPlay = overPlay;","ui.refresh = () => {","  const selectedTower = number(\"SelectedTower\") > 0;","  const fusion = boolean('FusionActive');","  scene.getLayer(\"TowerShopList\").show(!fusion);","  first('AssetPanelTitle').setString(fusion ? 'FUSION' : 'TOWERS');","  first('AssetPanelSubtitle').setString(fusion ? 'TACTICAL  /  '+scene.getTimeManager().getTimeScale()+'\\u00d7' : 'BUILD DEFENSE');","  first('ShopScrollTrack').hide(fusion);first('ShopScrollThumb').hide(fusion);","  const indicator = first(\"TilePlacement_Indicator\");","  ui.cards.forEach((card, i) => {","    const affordable = number(\"Money\") >= card.item.Cost;","    const selected = !indicator.isHidden() && indicator.getAnimationName() === card.item.Type;","    const pressed = ui.wasDown && ui.pressedCard === i && ui.hovered === i;","    card.background.setColor(selected ? \"188;237;255\" : pressed ? \"184;152;232\" : ui.hovered === i ? \"218;199;255\" : \"235;224;255\");","    if (card.background.hasBehavior(\"Effect\")) card.background.getBehavior(\"Effect\").enableEffect(\"Outline\", selected);","    card.background.setOpacity(affordable ? 255 : 220);","    card.icon.setOpacity(affordable ? 255 : 190);","    card.price.setColor(affordable ? \"244;232;255\" : \"255;120;155\");","    card.name.setColor(affordable ? \"245;233;255\" : \"173;150;203\");","    for (const part of [card.background,card.icon,card.name,card.price,card.coin]) part.hide(fusion);","  });","  syncWaveControl();","  const ended = boolean(\"GameOver\"), current = mode();","  const isAuto = autoMode(), isFast = fastMode();","  const isManual = current === \"Manual\" || current === \"ManualFast\";","  first(\"ShopPlayButton\").setOpacity(ended ? 155 : 255);","  first(\"ShopPlayButton\").setColor(isFast ? \"149;234;255\" : ui.overPlay ? \"207;194;255\" : \"240;228;255\");","  if (first(\"ShopPlayButton\").hasBehavior(\"Effect\")) first(\"ShopPlayButton\").getBehavior(\"Effect\").enableEffect(\"Outline\", isFast && !ended);","  first(\"ShopPlayIcon\").hide(ended || isAuto);","  first(\"ShopPlayIcon\").setAnimationName(isManual ? \"Manual\" : \"Play\");","  first(\"ShopPlayLabel\").setCharacterSize(ended ? 12 : 14);","  first(\"ShopPlayLabel\").setString(ended ? (number(\"Lives\") > 0 ? \"COMPLETE\" : \"GAME OVER\") : isAuto ? \"AUTO\" : isManual ? \"MANUAL\" : \"PLAY\");","  first(\"ShopPlayLabel\").setY(geometry.playY + (ended || isAuto ? 22 : 36));","  first(\"ShopSpeedBadge\").hide(!isFast || ended);","  first(\"ShopIndexButton\").setColor(overIndex ? \"207;194;255\" : \"255;255;255\");","  const indexIcon = first(\"Index_logo\"), indexButton = first(\"ShopIndexButton\");","  const iconScale = overIndex ? (ui.wasDown && ui.pressedControl === \"Index\" ? 0.95 : 1.05) : 1;","  const iconSize = Math.min(indexButton.getWidth(), indexButton.getHeight()) * 0.90 * iconScale;","  indexIcon.setWidth(iconSize); indexIcon.setHeight(iconSize);","  indexIcon.setPosition(indexButton.getX() + (indexButton.getWidth() - iconSize) / 2, indexButton.getY() + (indexButton.getHeight() - iconSize) / 2);","  first(\"ShopScrollThumb\").setOpacity(maxScroll > 0 ? 255 : 110);","};"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Directional skins reuse the same road instances, centers, masks and PathOrder.","const scene=runtimeScene,get=n=>scene.getObjects(n),sv=scene.getVariables();","const roads=get(\"Monster_Path\").slice().sort((a,b)=>a.getVariables().get(\"PathOrder\").getAsNumber()-b.getVariables().get(\"PathOrder\").getAsNumber());","const side=(o,n)=>n.getX()>o.getX()?\"E\":n.getX()<o.getX()?\"W\":n.getY()>o.getY()?\"S\":\"N\";","roads.forEach((o,i)=>{","  const sides=[i?side(o,roads[i-1]):null,i<roads.length-1?side(o,roads[i+1]):null].filter(Boolean);","  let skin;","  if(sides.length===1)skin=\"Cap_\"+sides[0];","  else if(sides.includes(\"E\")&&sides.includes(\"W\"))skin=\"H\";","  else if(sides.includes(\"N\")&&sides.includes(\"S\"))skin=\"V\";","  else skin=(sides.includes(\"N\")?\"N\":\"S\")+(sides.includes(\"E\")?\"E\":\"W\");","  if(o.getAnimationName()!==skin)o.setAnimationName(skin);","  o.pauseAnimation();o.setAnimationFrame((skin===\"H\"||skin===\"V\")?i%4:0);","});","const kinds=[\"Crystal\",\"Rock\",\"Ruin\",\"Shrub\"];","get(\"Ground_Decoration\").forEach((o,i)=>{","  const kind=o.getVariables().get(\"Kind\").getAsString()||kinds[i%4];if(o.getAnimationName()!==kind)o.setAnimationName(kind);","  o.setWidth(64);o.setHeight(64);o.getVariables().get(\"Blocking\").setBoolean(kind!==\"Shrub\");o.getVariables().get(\"Kind\").setString(kind);","});","let backdrop=scene.__voidBackdrop;","if(!backdrop)backdrop=scene.__voidBackdrop=scene.createObject(\"VoidBackdrop\");","const ground=get(\"Ground_Map\")[0];backdrop.setLayer(\"\");backdrop.setZOrder(ground.getZOrder()-10);","backdrop.setPosition(ground.getX(),ground.getY());backdrop.setWidth(ground.getWidth());backdrop.setHeight(ground.getHeight());","// Compose the existing frame as proportionally scaled perimeter pieces outside the road.","// No full-frame stretch, no rocky art laid beneath the bottom road.","if(scene.__islandCliffFrame){scene.__islandCliffFrame.deleteFromScene();scene.__islandCliffFrame=null;}","const left=Math.min(...roads.map(o=>o.getX()))-16,right=Math.max(...roads.map(o=>o.getX()+o.getWidth()))+16;","const top=Math.min(...roads.map(o=>o.getY()))-112,bottom=Math.max(...roads.map(o=>o.getY()+o.getHeight()))+16;","const unit=scene.__worldStyle.cliffUnit,L=225,R=225,T=180,B=206,W=1448,H=1086,lw=L*unit,rw=R*unit,th=T*unit,bh=B*unit;","const pieces=[];","const add=(sx,sy,sw,sh,x,y,w,h)=>pieces.push({sx,sy,sw,sh,x,y,w,h});","add(0,0,L,T,left-lw,top-th,lw,th);add(W-R,0,R,T,right,top-th,rw,th);","add(0,H-B,L,B,left-lw,bottom,lw,bh);add(W-R,H-B,R,B,right,bottom,rw,bh);","// Repeat long edges at uniform scale and crop the final piece, keeping rock proportions.","for(let x=left;x<right-.001;){const width=Math.min((W-L-R)*unit,right-x);add(L,0,width/unit,T,x,top-th,width,th);add(L,H-B,width/unit,B,x,bottom,width,bh);x+=width;}","for(let y=top;y<bottom-.001;){const height=Math.min((H-T-B)*unit,bottom-y);add(0,T,L,height/unit,left-lw,y,lw,height);add(W-R,T,R,height/unit,right,y,rw,height);y+=height;}","// One native owner keeps the correct world layer/Z-order; its PIXI children use","// cropped textures at uniform scale without changing GDevelop's frame-size calculations.","let holder=scene.__cliffOwner;if(!holder)holder=scene.__cliffOwner=scene.createObject('IslandCliffFrame');","holder.setLayer('');holder.setZOrder(-7);holder.updatePreRender(scene);","const root=holder.getRendererObject();if(!scene.__cliffBaseTexture)scene.__cliffBaseTexture=root.texture.baseTexture;","root.texture=PIXI.Texture.EMPTY;root.anchor.set(0);root.position.set(0,0);root.scale.set(1,1);","let edges=scene.__islandEdges;if(!edges)edges=scene.__islandEdges=[];","while(edges.length>pieces.length){const e=edges.pop();root.removeChild(e.sprite);e.sprite.destroy();e.texture.destroy(false);}","let shadows=scene.__environmentShadows;","if(!shadows){shadows=scene.__environmentShadows=new PIXI.Graphics();root.addChildAt(shadows,0);}","shadows.clear();","for(const o of get('Ground_Decoration')){"," const kind=o.getVariables().get('Kind').getAsString(),scale=(scene.__worldStyle.props[kind]||1)*(o.getVariables().get('LocalScale').getAsNumber()||1),w=o.getWidth()*scale;"," const x=o.getCenterXInScene(),y=o.getCenterYInScene()+w*.30;"," shadows.beginFill(0x100c25,kind==='Shrub'?.16:.30).drawEllipse(x,y,w*.34,w*.08).endFill();","}","const regions=[];","for(const [i,d] of pieces.entries()){"," let e=edges[i];if(!e){e=edges[i]={sprite:new PIXI.Sprite()};root.addChild(e.sprite);}"," const key=[d.sx,d.sy,d.sw,d.sh].join(',');"," if(e.key!==key){if(e.texture)e.texture.destroy(false);e.texture=new PIXI.Texture(scene.__cliffBaseTexture,new PIXI.Rectangle(d.sx,d.sy,d.sw,d.sh));e.key=key;}"," e.sprite.texture=e.texture;e.sprite.anchor.set(0);e.sprite.position.set(d.x,d.y);e.sprite.scale.set(unit,unit);"," regions.push([[d.x,d.y],[d.x+d.w,d.y],[d.x+d.w,d.y+d.h],[d.x,d.y+d.h]]);","}","scene.__islandRockRegions=regions;","// Buildable top surface is separate from the rocky frame. Terrain extends UNDER the","// inner fringe so transparent pockets in the edge sprites cannot expose accidental holes.","scene.__islandSurfacePolygon=[left,top,right,top,right,bottom,left,bottom];","const drawable=ground.getRendererObject();","if(!scene.__islandSurfaceMask){scene.__islandSurfaceMask=new PIXI.Graphics();scene.getLayer('').getRenderer().getRendererObject().addChild(scene.__islandSurfaceMask);drawable.mask=scene.__islandSurfaceMask;}","const underlap=32,mask=scene.__islandSurfaceMask,key=[left,top,right,bottom].join(',');","if(scene.__islandSurfaceKey!==key){mask.clear().beginFill(0xffffff).drawRoundedRect(left-underlap,top-underlap,right-left+underlap*2,bottom-top+underlap*2,20).endFill();scene.__islandSurfaceKey=key;}","ground.setColor(\"192;195;218\");"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Archive state is presentation-only. The sole unlock caller is the native wave spawn.","const scene=runtimeScene,game=scene.getGame(),sv=scene.getVariables();","let d=scene.__monsterDiscovery;","if(!d){"," const types=sv.get('EnemyTypes').toJSObject(),definition=game.getSceneAndExtensionsData(scene.getName()).sceneData.objects.find(o=>o.name==='IndexMonsterImage');"," const animations=new Map(definition.animations.map(a=>[a.name,a.directions[0].sprites[0].image]));"," const ids=definition.animations.flatMap(animation=>Object.keys(types).filter(id=>types[id].Animation===animation.name));"," let session=game.__celestialMonsterDiscoverySession;"," if(!session){","  session=game.__celestialMonsterDiscoverySession={found:new Set(),queue:[],active:null,revision:0,stats:{unlocks:0,shown:0,sounds:0,completed:0}};","  // Explicit Restart/New Game calls this; ordinary scene changes do not.","  session.resetForNewGame=()=>{session.found.clear();session.queue.length=0;session.active=null;session.revision++;for(const key of Object.keys(session.stats))session.stats[key]=0;for(const key of game.__celestialDiscoveryOrder?.tickets.keys()||[])if(key.startsWith('monster:'))game.__celestialDiscoveryOrder.tickets.delete(key);};","  delete game.__celestialMonsterDiscovery;","  // Ignore all legacy discovery data. Remove only its old key, never settings.","  try{localStorage.removeItem('celestialVoidMonsterDiscovery.v1');}catch(e){}"," }"," d=scene.__monsterDiscovery={scope:'session',ids,types,session,found:session.found,queue:session.queue,get active(){return session.active;},set active(value){session.active=value;},get revision(){return session.revision;},ready:false,disposed:false,outlines:new Map(),indexPortraits:new Map(),textures:new Map(),ownedTextures:new Set(),portraits:sv.get('MonsterPortraitConfig').toJSObject(),stats:session.stats};"," d.ready=true;"," d.has=id=>d.found.has(id);"," d.resetForNewGame=session.resetForNewGame;"," d.onWaveSpawn=(enemy,id)=>{","  const wave=scene.__waveManager;","  if(d.disposed||!ids.includes(id)||d.has(id)||!sv.get('WaveActive').getAsBoolean()||sv.get('GameOver').getAsBoolean()||!wave||wave.queue[wave.index-1]!==id||!scene.getObjects('Enemy').includes(enemy)||enemy.getVariables().get('EnemyType').getAsString()!==id||enemy.getBehavior('Health').IsDead())return false;","  d.found.add(id);session.revision++;d.stats.unlocks++;d.queue.push(id);scene.__discoveryToast?.enqueue('monster',id);return true;"," };"," d.texture=id=>{","  if(d.textures.has(id))return d.textures.get(id);","  const meta=d.portraits[id],base=game.getImageManager().getPIXITexture(meta?.Image||animations.get(types[id].Animation));","  // Only atlases need frame extraction; individual PNGs remain shared unchanged.","  const texture=meta?.Frame?new PIXI.Texture(base.baseTexture,new PIXI.Rectangle(...meta.Frame)):base;","  if(meta?.Frame)d.ownedTextures.add(texture);","  if(texture)d.textures.set(id,texture);return texture;"," };"," d.fitPortrait=(sprite,id,x,y,width,height)=>{","  const texture=d.texture(id),bounds=d.portraits[id]?.VisualBounds||[0,0,texture.width,texture.height];sprite.texture=texture;","  sprite.anchor.set((bounds[0]+bounds[2]/2)/texture.width,(bounds[1]+bounds[3]/2)/texture.height);","  sprite.scale.set(Math.min(width/bounds[2],height/bounds[3]));sprite.position.set(x,y);sprite.rotation=0;"," };"," // One compact presentation style for every existing archive queue. Unlock and"," // persistence remain with their original owners; presentation never discovers."," const layer=scene.getLayer('DiscoveryUI'),parent=layer.getRenderer().getRendererObject();"," const toast=scene.__discoveryToast={duration:3.2};"," // FIFO presentation across the existing independent discovery/save systems."," // Tickets live only in this RuntimeGame, not in archive persistence."," const order=game.__celestialDiscoveryOrder||(game.__celestialDiscoveryOrder={next:0,tickets:new Map()});"," const ticket=(kind,event)=>kind+':'+(typeof event==='string'?event:event.id+':'+event.variant);"," toast.enqueue=(kind,event)=>{const key=ticket(kind,event);if(!order.tickets.has(key))order.tickets.set(key,++order.next);return order.tickets.get(key);};"," toast.take=(kind,event)=>order.tickets.delete(ticket(kind,event));"," toast.canBegin=kind=>{","  const monster=d.queue[0],fusion=game.__fusionArchive?.queue[0];","  const m=monster?toast.enqueue('monster',monster):Infinity,f=fusion?toast.enqueue('fusion',fusion):Infinity;","  return kind==='monster'?m<=f:f<m;"," };"," toast.geometry=()=>{","  const area=scene.__towerShopUI.gameArea,hud=scene.getObjects('HUDPanel')[0];","  const top=scene.getLayer('UI').convertInverseCoords(hud.getX(),hud.getY(),0,[0,0]);","  const w=272,h=60;return{x:area.right-12-w,y:Math.max(4,top[1]-8),w,h,scale:1};"," };"," toast.create=z=>{","  const root=new PIXI.Container(),mask=new PIXI.Graphics();root.interactive=false;root.interactiveChildren=false;root.visible=false;root.zIndex=z;mask.zIndex=z-1;mask.interactive=false;parent.addChild(mask,root);root.mask=mask;","  const panel=new PIXI.Graphics();root.addChild(panel);","  panel.lineStyle(1,0xc5ab72,.9).beginFill(0x181027,.97).drawRoundedRect(0,0,272,60,7).endFill();","  panel.lineStyle(1,0x8bb9e9,.3).moveTo(53,10).lineTo(53,50);","  panel.lineStyle(1,0x8d70bb,.45).beginFill(0x100b22).drawRoundedRect(7,9,40,42,5).endFill();","  const text=(value,x,y,size,color,bold=false)=>{const t=new PIXI.Text(value,{fontFamily:'Arial',fontSize:size,fill:color,fontWeight:bold?'bold':'normal',wordWrap:true,wordWrapWidth:198});t.position.set(x,y);root.addChild(t);return t;};","  const heading=text('NEW DISCOVERY',63,7,9,0xaacdf3,true),name=text('',63,21,13,0xf3e8ff,true),detail=text('Monster Archive Updated',63,41,9,0xaf9fc6);","  const icon=new PIXI.Sprite();icon.anchor.set(.5);icon.position.set(27,30);root.addChild(icon);","  const stars=[];for(let i=0;i<3;i++){const star=new PIXI.Graphics();star.beginFill(i%2?0xcaa1ff:0xa4dcff).drawPolygon([0,-2,1,-1,2,0,1,1,0,2,-1,1,-2,0,-1,-1]).endFill();root.addChild(star);stars.push(star);}","  return{root,mask,icon,heading,name,detail,stars};"," };"," toast.paint=(view,age)=>{","  const g=toast.geometry(),smooth=x=>{x=Math.max(0,Math.min(1,x));return x*x*(3-2*x);},enter=smooth(age/.2),exit=smooth((age-2.9)/.3),reveal=smooth((age-.2)/.45);","  view.screenRect=g;const key=[g.x,g.y,g.w,g.h].join(':');if(view.maskKey!==key){view.mask.clear().beginFill(0xffffff).drawRect(g.x,g.y,g.w,g.h).endFill();view.maskKey=key;}","  view.mask.visible=true;view.root.visible=true;view.root.alpha=enter*(1-exit);view.root.scale.set(1);view.root.position.set(g.x,g.y-(1-enter)*8-exit*8);","  const c=Math.round(255*reveal);view.icon.tint=(c<<16)|(c<<8)|c;view.name.alpha=smooth((age-.65)/.2);","  view.stars.forEach((star,i)=>{star.position.set(27+Math.cos(age+i*2.1)*20,30+Math.sin(age+i*2.1)*20);star.alpha=reveal*.3*Math.sin(age*2+i)**2;});"," };"," const view=d.toast=toast.create(100),{root,mask,icon,name}=view;d.root=root;d.mask=mask;d.icon=icon;d.nameText=name;d.stars=view.stars;"," d.geometry=toast.geometry;"," d.bindPortrait=id=>{","  if(!d.texture(id))return false;","  name.text=types[id].Name||id;name.scale.set(1);name.scale.set(Math.min(1,198/Math.max(1,name.width),18/Math.max(1,name.height)));","  d.fitPortrait(icon,id,27,30,38,40);d.boundPortrait=id;return true;"," };"," d.begin=id=>{","  if(!d.bindPortrait(id))return false;toast.take('monster',id);d.active={id,age:0};d.stats.shown++;","  if(scene.__audio?.play('DiscoveryUnlock'))d.stats.sounds++;return true;"," };"," d.paint=()=>{","  if(!d.active){root.visible=false;mask.visible=false;return;}","  if(d.boundPortrait!==d.active.id)d.bindPortrait(d.active.id);","  // geometry remains replaceable by native click-through validation fixtures.","  const geometry=toast.geometry;toast.geometry=d.geometry;toast.paint(view,d.active.age);toast.geometry=geometry;"," };"," d.paintIndex=()=>{","  const index=scene.__unitIndex,visible=sv.get('IndexOpen').getAsBoolean()&&index?.category==='Monsters';","  for(const outline of d.outlines.values())if(!outline.destroyed)outline.destroy({texture:false,baseTexture:false});d.outlines.clear();","  for(const portrait of d.indexPortraits.values())portrait.root.visible=false;","  if(!visible)return;","  for(const {sprite:object} of index.monsterCards||index.cards){","   const frame=object.__discoveryPortrait;if(!frame||object.isHidden())continue;","   // The native object is a bounded UI handle, never a second visible artwork.","   object.__archivePortraitOwned=true;object.setOpacity(0);const native=object.getRendererObject();native.alpha=0;native.visible=false;","   if(object.__golemPortraitRig)object.__golemPortraitRig.visible=false;","   let portrait=d.indexPortraits.get(object);","   if(!portrait){","    const root=new PIXI.Container(),mask=new PIXI.Graphics(),sprite=new PIXI.Sprite();root.interactive=false;root.interactiveChildren=false;mask.interactive=false;sprite.interactive=false;sprite.mask=mask;root.addChild(mask,sprite);","    portrait={root,mask,sprite,frameKey:''};d.indexPortraits.set(object,portrait);object.__archivePortrait=portrait;","    const cleanup=()=>{sprite.mask=null;if(!root.destroyed)root.destroy({children:true,texture:false,baseTexture:false});d.indexPortraits.delete(object);delete object.__archivePortrait;object.unregisterDestroyCallback(cleanup);};object.registerDestroyCallback(cleanup);","   }","   const {root,mask,sprite}=portrait,parent=scene.getLayer(object.getLayer()).getRenderer().getRendererObject();if(root.parent!==parent)parent.addChild(root);","   root.zIndex=object.getZOrder();root.position.set(0);root.scale.set(1);root.rotation=0;root.alpha=1;root.visible=true;","   d.fitPortrait(sprite,frame.id,frame.x,frame.y,frame.w,frame.h);","   // Read encounter state afresh. A new unlock stays black until the matching text refresh.","   const locked=!d.has(frame.id)||object.__discoveryLocked;sprite.tint=locked?0x000000:0xffffff;sprite.alpha=1;sprite.visible=true;sprite.blendMode=PIXI.BLEND_MODES.NORMAL;portrait.id=frame.id;portrait.locked=locked;","   const frameKey=[frame.x,frame.y,frame.w,frame.h].join(':');if(portrait.frameKey!==frameKey){mask.clear().beginFill(0xffffff).drawRect(frame.x-frame.w/2,frame.y-frame.h/2,frame.w,frame.h).endFill();portrait.frameKey=frameKey;}","  }"," };"," d.update=()=>{","  if(d.disposed)return;","  const uiLayer=scene.getLayer('DiscoveryUI');uiLayer.setCameraZoom(1);uiLayer.setCameraX(game.getGameResolutionWidth()/2);uiLayer.setCameraY(game.getGameResolutionHeight()/2);","  // Keep queued announcements intact while the encyclopedia owns the screen.","  if(sv.get('IndexOpen').getAsBoolean()||!d.active&&(game.__fusionArchive?.active||!toast.canBegin('monster'))){root.visible=false;mask.visible=false;d.paintIndex();return;}","  const dt=Math.max(0,scene.getTimeManager().getElapsedTime()/Math.max(.001,scene.getTimeManager().getTimeScale())/1000);","  if(d.active){d.active.age+=dt;if(d.active.age>=toast.duration){d.active=null;d.stats.completed++;}}","  if(!d.active&&d.queue.length&&toast.canBegin('monster')){if(d.begin(d.queue[0]))d.queue.shift();}","  d.paint();d.paintIndex();"," };"," d.dispose=()=>{if(d.disposed)return;d.disposed=true;for(const portrait of d.indexPortraits.values()){portrait.sprite.mask=null;if(!portrait.root.destroyed)portrait.root.destroy({children:true,texture:false,baseTexture:false});}d.indexPortraits.clear();for(const outline of d.outlines.values())if(!outline.destroyed)outline.destroy({texture:false,baseTexture:false});d.outlines.clear();d.textures.clear();root.mask=null;root.destroy({children:true,texture:false,baseTexture:false});mask.destroy();for(const texture of d.ownedTextures)texture.destroy(false);d.ownedTextures.clear();};"," if(!gdjs.__celestialDiscoveryCallbacks){gdjs.__celestialDiscoveryCallbacks=true;gdjs.callbacksRuntimeScenePostEvents.push(s=>s.__monsterDiscovery?.update());gdjs.callbacksRuntimeSceneUnloading.push(s=>s.__monsterDiscovery?.dispose());}","}"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Transactional Pure Fusion. Original towers remain alive until valid placement.","const scene=runtimeScene,sv=scene.getVariables(),game=scene.getGame(),get=n=>scene.getObjects(n),p=scene.__freePlacement,star=scene.__starCannon;","if(!p||!star)return;","let f=scene.__fusion;","if(!f){"," const config=sv.get('StarburstConfig').toJSObject(),layer=scene.getLayer('FusionUI');"," const archive=game.__fusionArchive;if(!archive?.persistent)return;"," f=scene.__fusion={config,archive,active:false,stage:'idle',objects:{},markers:new Map(),footprints:new Map(),obstacleFootprints:new Map(),wasDown:false,pressed:'',error:'',disposed:false};"," f.graphics=new PIXI.Graphics();layer.getRenderer().getRendererObject().addChild(f.graphics);f.graphics.zIndex=0;"," // One reusable batch above the dimmer; clip world hints away from all sidebar UI."," f.worldGraphics=new PIXI.Graphics();f.worldMask=new PIXI.Graphics();f.worldGraphics.zIndex=1;f.worldGraphics.interactive=false;f.worldMask.interactive=false;f.worldGraphics.mask=f.worldMask;layer.getRenderer().getRendererObject().addChild(f.worldMask,f.worldGraphics);"," f.hudGraphics=new PIXI.Graphics();f.hudGraphics.zIndex=5;f.hudGraphics.interactive=false;layer.getRenderer().getRendererObject().addChild(f.hudGraphics);"," f.ensure=(key,name,z=2)=>{if(!f.objects[key]){const o=scene.createObject(name);o.setLayer('FusionUI');o.setZOrder(z);f.objects[key]=o;}return f.objects[key];};"," f.ghost=f.ensure('ghost','StarburstGhost',3);f.ghost.hide();"," f.hudSlot=height=>{","  const rect=o=>{const l=scene.getLayer(o.getLayer()),a=l.convertInverseCoords(o.getX(),o.getY(),0,[0,0]),b=l.convertInverseCoords(o.getX()+o.getWidth(),o.getY()+o.getHeight(),0,[0,0]);return{x:a[0],y:a[1],w:b[0]-a[0],h:b[1]-a[1]};};","  const box=rect(get('TowerShopBox')[0]),header=rect(get('ShopHeaderPlaque')[0]),footer=rect(get('ShopFooterFrame')[0]),x=box.x+12,w=box.w-24;","  let gaps=[[header.y+header.h+10,footer.y-10]];","  const occupied=[...scene.__towerShopUI.cards.map(c=>rect(c.background)),scene.__selectedPanel?.screenRect,scene.__obstaclePanel?.screenRect,...(scene.__audio?.ui.open?[scene.__audio.geometry().panel]:[])].filter(Boolean);","  for(const r of occupied)if(r.x<x+w&&r.x+r.w>x)gaps=gaps.flatMap(([a,b])=>r.y>=b||r.y+r.h<=a?[[a,b]]:[[a,Math.min(b,r.y-10)],[Math.max(a,r.y+r.h+10),b]].filter(([a,b])=>b>a));","  gaps.sort((a,b)=>(b[1]-b[0])-(a[1]-a[0]));const gap=gaps[0];if(!gap)return null;","  const scale=Math.min(1,w/200,(gap[1]-gap[0])/height);return{x:x+(w-200*scale)/2,y:gap[0],w:200*scale,h:height*scale,scale};"," };"," // One contextual body replaces shop content; it never adds a second sidebar frame."," const sidebar=f.sidebar={root:new PIXI.Container(),mask:new PIXI.Graphics(),graphics:new PIXI.Graphics(),texts:new Map(),portraits:new Map(),scroll:0,phase:'',sourceEntries:[],result:null};"," sidebar.root.zIndex=4;sidebar.root.interactive=false;sidebar.root.interactiveChildren=false;sidebar.mask.interactive=false;sidebar.root.mask=sidebar.mask;sidebar.root.addChild(sidebar.graphics);layer.getRenderer().getRendererObject().addChild(sidebar.mask,sidebar.root);sidebar.root.visible=false;"," const portraitCatalog=sv.get('IndexPortraitCatalog').toJSObject(),sceneData=game.getSceneAndExtensionsData(scene.getName()).sceneData;"," f.sourceInfo=t=>{","  if(!t)return null;const v=t.getVariables(),variant=v.get('TowerType').getAsString(),catalog=sv.get('TowerShopCatalog').toJSObject(),type=portraitCatalog[variant]||archive.definition(variant)||catalog.some(c=>c.Type===variant)?variant:t.getName(),shop=catalog.find(c=>c.Type===type);","  return{type,name:v.get('TowerName').getAsString()||shop?.Name||type,path1:v.get('Path1Level').getAsNumber(),path2:v.get('Path2Level').getAsNumber()};"," };"," f.renderSidebar=()=>{","  const toScreen=o=>{const l=scene.getLayer(o.getLayer()),a=l.convertInverseCoords(o.getX(),o.getY(),0,[0,0]),b=l.convertInverseCoords(o.getX()+o.getWidth(),o.getY()+o.getHeight(),0,[0,0]);return{x:a[0],y:a[1],w:b[0]-a[0],h:b[1]-a[1]};};","  const box=toScreen(get('TowerShopBox')[0]),header=toScreen(get('ShopHeaderPlaque')[0]),footer=toScreen(get('ShopFooterFrame')[0]),x=box.x+12,y=header.y+header.h+12,w=box.w-24;","  const placement=f.stage==='placement',phase=placement?'PREVIEW_PLACEMENT':'SELECT_PARTNER',natural=placement?254:174,bodyHeight=Math.max(1,Math.min(natural,footer.y-y-60));","  if(sidebar.phase!==phase){sidebar.scroll=0;sidebar.phase=phase;}","  const cursorX=gdjs.evtTools.input.getCursorX(scene,'FusionUI',0),cursorY=gdjs.evtTools.input.getCursorY(scene,'FusionUI',0);","  sidebar.maxScroll=Math.max(0,natural-bodyHeight);if(cursorX>=x&&cursorX<x+w&&cursorY>=y&&cursorY<y+bodyHeight)sidebar.scroll-=Math.sign(game.getInputManager().getMouseWheelDelta())*30;sidebar.scroll=Math.max(0,Math.min(sidebar.maxScroll,sidebar.scroll));","  sidebar.screenRect={x,y,w,h:bodyHeight};sidebar.root.position.set(x,y-sidebar.scroll);sidebar.root.visible=true;","  const maskKey=[x,y,w,bodyHeight].join(':');if(sidebar.maskKey!==maskKey){sidebar.mask.clear().beginFill(0xffffff).drawRect(x,y,w,bodyHeight).endFill();sidebar.maskKey=maskKey;}","  const g=sidebar.graphics;g.clear();for(const t of sidebar.texts.values())t.visible=false;for(const p of sidebar.portraits.values())p.sprite.visible=false;","  const text=(key,value,tx,ty,width,size=12,color=0xece4fa,bold=false)=>{","   let t=sidebar.texts.get(key);if(!t){t=new PIXI.Text('',{fontFamily:'Arial'});t.interactive=false;sidebar.root.addChild(t);sidebar.texts.set(key,t);}","   t.text=value;t.style.fontSize=size;t.style.fill=color;t.style.fontWeight=bold?'bold':'normal';t.style.wordWrap=true;t.style.wordWrapWidth=width;t.style.breakWords=true;t.position.set(tx,ty);t.visible=true;return t;","  };","  const image=(key,type,animation,frame,locked=false)=>{","   const meta=portraitCatalog[type],fallback=sceneData.objects.find(o=>o.name==='IndexTowerImage')?.animations.find(a=>a.name===animation||a.name===type),resource=meta?.Image||fallback?.directions[0].sprites[0].image;","   let rec=sidebar.portraits.get(key);if(!rec){const sprite=new PIXI.Sprite();sprite.interactive=false;sidebar.root.addChild(sprite);rec={sprite};sidebar.portraits.set(key,rec);}","   if(!resource){rec.sprite.visible=false;return false;}","   const texture=game.getImageManager().getPIXITexture(resource),bounds=meta?.VisualBounds||[0,0,texture.width,texture.height],sprite=rec.sprite;","   sprite.texture=texture;sprite.anchor.set((bounds[0]+bounds[2]/2)/texture.width,(bounds[1]+bounds[3]/2)/texture.height);sprite.scale.set(Math.min(frame.w/bounds[2],frame.h/bounds[3]));sprite.position.set(frame.x+frame.w/2,frame.y+frame.h/2);sprite.rotation=0;sprite.alpha=1;sprite.tint=locked?0x000000:0xffffff;sprite.blendMode=PIXI.BLEND_MODES.NORMAL;sprite.visible=true;Object.assign(rec,{resource,type,frame,locked});return true;","  };","  text('sources','SOURCE TOWERS',0,0,w,10,0xc9b785,true);","  sidebar.sourceEntries=[f.sourceInfo(f.a),f.sourceInfo(f.b)];const cw=(w-24)/2;","  sidebar.sourceEntries.forEach((entry,i)=>{","   const sx=i*(cw+24);g.lineStyle(1,0x655276,.55).beginFill(0x19142c,.85).drawRoundedRect(sx,17,cw,106,8).endFill();text('sourceId'+i,i?'B':'A',sx+8,23,12,9,0xc9b785,true);","   if(entry){if(!image('source'+i,entry.type,entry.type,{x:sx+17,y:25,w:cw-34,h:43}))text('sourceFallback'+i,'?',sx+cw/2-7,35,22,25,0xa698c4);text('sourceName'+i,entry.name,sx+6,73,cw-12,12,0xece4fa,true);text('sourcePath'+i,entry.path1+' - '+entry.path2,sx+cw/2-17,104,50,12,0xcab884,true);}","   else{text('sourceQuestion'+i,'?',sx+cw/2-8,35,24,28,0xa698c4);text('sourceName'+i,'Select',sx+cw/2-18,77,60,12,0xb2a4ca);}","  });","  text('plus','+',cw+6,54,20,22,0xc9b785);","  sidebar.result=null;","  if(placement){","   const resolved=archive.resolve([f.a,f.b]),definition=resolved&&archive.definition(resolved.id),locked=!definition||!archive.has(definition.Id);","   sidebar.result={id:definition?.Id||'',name:locked?'???':definition.Name,locked,cost:config.FusionCost};","   g.lineStyle(1,0x655276,.55).moveTo(0,133).lineTo(w,133);text('evolution','EVOLUTION',0,140,w,10,0xc9b785,true);","   g.beginFill(0x332448,.7).drawRoundedRect(0,158,64,64,9).endFill();if(!image('result',definition?.Id,definition?.Animation,{x:4,y:162,w:56,h:56},locked))text('resultFallback','?',24,174,26,24,0xa698c4);","   text('resultName',sidebar.result.name,74,160,w-74,14,0xeee6ff,true);if(locked)text('resultLock','UNDISCOVERED',74,180,w-74,9,0xa799bb);","   text('cost',config.FusionCost+' Gold',74,201,w-74,13,0xe3ca8d,true);","   let status=f.preview&&!f.preview.valid?f.message(f.preview.reason):f.error||'Place near either source tower';","   if(f.preview?.reason==='obstacle'){","    const radius=p.config('StarCannonTower').Radius,hit=p.blockers.find(c=>Math.hypot(f.preview.x-c.x,f.preview.y-c.y)<=radius+c.r+1e-6);","    const kind=hit?.owner.getVariables().get('Kind').getAsString();status=kind==='Ruin'?'Blocked by Ruins':kind==='Rock'?'Blocked by Rock':kind==='Crystal'?'Blocked by Crystal':f.message('obstacle');","   }","   sidebar.status=status;text('status',status,0,226,w,12,f.preview?.valid?0xafdace:0xeea1b2);","  }else{sidebar.status=f.error||'Select a Max-Level Tower';text('status',sidebar.status,0,143,w,14,f.error?0xeea1b2:0xece4fa,true);}","  // Fixed large hit target stays available even when a short viewport needs body scrolling.","  const cy=y+bodyHeight+10,button=f.ensure('cancel','SelectedPanelPlaque',4);button.setPosition(x,cy);button.setWidth(w);button.setHeight(40);button.setColor('210;190;248');button.hide(false);","  const label=f.ensure('cancelText','IndexText',5);label.setString('Cancel / ESC');label.setCharacterSize(14);label.setBold(true);label.setTextAlignment('center');label.setWrapping(true);label.setWrappingWidth(w);label.setColor('246;235;255');label.setPosition(x,cy+11);label.hide(false);","  f.cancelRect={x,y:cy,w,h:40};f.bannerRect={x,y,w,h:bodyHeight+50};f.hudGraphics.clear();","  f.hudGraphics.lineStyle(1,0xd8ba7d,.95).moveTo(header.x+13,header.y+21).lineTo(header.x+18,header.y+15).lineTo(header.x+23,header.y+21).lineTo(header.x+18,header.y+27).closePath();","  if(sidebar.maxScroll)f.hudGraphics.lineStyle(2,0xb9a0d6,.6).moveTo(x+w+5,y+3).lineTo(x+w+5,y+bodyHeight-3);"," };"," f.eligible=t=>!!t&&get('StarCannonTower').includes(t)&&!star.isFusion(t)&&((t.getVariables().get('Path1Level').getAsNumber()===5&&t.getVariables().get('Path2Level').getAsNumber()===2)||(t.getVariables().get('Path1Level').getAsNumber()===2&&t.getVariables().get('Path2Level').getAsNumber()===5));"," f.pair=(a,b)=>f.eligible(a)&&f.eligible(b)&&a!==b&&a.getVariables().get('Path1Level').getAsNumber()!==b.getVariables().get('Path1Level').getAsNumber();"," f.alive=(t,id)=>!!t&&t.getUniqueId()===id&&get('StarCannonTower').includes(t);"," f.message=reason=>({region:'Outside Fusion Zone',path:'Path blocked',tower:'Occupied',obstacle:'Blocked by obstacle',bounds:'Outside build area','rocky-edge':'Outside build area',gold:'Insufficient Gold',ui:'Move onto the map',pair:'Choose a compatible tower'}[reason]||'Choose a clear spot');"," f.finish=()=>{","  f.active=false;f.stage='idle';f.a=null;f.b=null;f.aId=0;f.bId=0;f.preview=null;f.error='';f.pressed='';sv.get('FusionActive').setBoolean(false);","  f.graphics.clear();f.worldGraphics.clear();f.worldMask.clear();f.worldMaskKey='';f.hudGraphics.clear();f.footprints.clear();f.obstacleFootprints.clear();for(const m of f.markers.values())m.destroy();f.markers.clear();Object.values(f.objects).forEach(o=>o.hide());f.bannerRect=null;f.cancelRect=null;layer.show(false);","  sidebar.root.visible=false;sidebar.scroll=0;sidebar.phase='';sidebar.sourceEntries=[];sidebar.result=null;","  scene.getTimeManager().setTimeScale(f.previousScale||1);f.previousScale=undefined;"," };"," f.cancel=()=>{if(!f.active)return false;f.finish();scene.__audio?.play('UIClick');return true;};"," f.begin=t=>{","  if(f.active||!f.eligible(t)||sv.get('GameOver').getAsBoolean()||sv.get('IndexBlocksInput').getAsBoolean())return false;","  f.previousScale=scene.getTimeManager().getTimeScale();f.active=true;f.stage='partner';f.a=t;f.aId=t.getUniqueId();f.b=null;f.error='';f.wasDown=game.getInputManager().isMouseButtonPressed(0);f.pressed='';","  sv.get('FusionActive').setBoolean(true);sv.get('SelectedTower').setNumber(0);sv.get('IndexOpen').setBoolean(false);scene.__obstaclePanel?.close();p.stop();","  if(scene.__audio){scene.__audio.ui.open=false;scene.__audio.ui.pressed='';}scene.getTimeManager().setTimeScale(config.FusionTimeScale);scene.__audio?.play('UIClick');return true;"," };"," f.choose=t=>{if(!f.active||f.stage!=='partner'||!f.pair(f.a,t)){f.error=f.message('pair');scene.__audio?.play('InvalidAction');return false;}f.b=t;f.bId=t.getUniqueId();f.stage='placement';f.error='';scene.__audio?.play('TowerSelect');return true;};"," f.validate=(x,y)=>{","  if(!f.active||f.stage!=='placement'||!f.alive(f.a,f.aId)||!f.alive(f.b,f.bId)||!f.pair(f.a,f.b))return{valid:false,reason:'pair'};","  if(![f.a,f.b].some(t=>{const c=p.center(t);return Math.hypot(x-c[0],y-c[1])<=config.RegionalRadius;}))return{valid:false,reason:'region'};","  const point=scene.getLayer('').convertInverseCoords(x,y,0,[0,0]);","  if([f.bannerRect,f.cancelRect].some(r=>r&&point[0]>=r.x&&point[0]<r.x+r.w&&point[1]>=r.y&&point[1]<r.y+r.h))return{valid:false,reason:'ui'};","  return p.validate('StarCannonTower',x,y,{ignoreTowers:new Set([f.a,f.b]),cost:config.FusionCost});"," };"," f.confirm=(x,y)=>{","  const valid=f.validate(x,y);if(!valid.valid){f.error=f.message(valid.reason);scene.__audio?.play('InvalidAction');return false;}","  const a=f.a,b=f.b,t=scene.createObject('StarCannonTower');if(!t){f.error='Unable to create tower';return false;}","  const v=t.getVariables(),av=a.getVariables(),bv=b.getVariables(),cost=config.FusionCost,investment=av.get('TotalInvestment').getAsNumber()+bv.get('TotalInvestment').getAsNumber()+cost;","  const id=Math.max(sv.get('NextTowerId').getAsNumber(),...get('StarCannonTower').map(o=>o.getVariables().get('TowerId').getAsNumber()))+1;","  for(const [name,value]of Object.entries({TowerId:id,PurchasePrice:investment,TotalInvestment:investment,DamageDealt:av.get('DamageDealt').getAsNumber()+bv.get('DamageDealt').getAsNumber(),Path1Level:5,Path2Level:2,FootprintX:x,FootprintY:y,FootprintRadius:p.config('StarCannonTower').Radius,FootprintOffsetX:0,FootprintOffsetY:0,ShotCounter:0}))v.get(name).setNumber(value);","  v.get('TowerType').setString('StarburstCannon');v.get('TowerName').setString(config.Name);t.setLayer('');","  try{if(!star.apply(t))throw Error('Invalid fusion stats');}catch(e){t.deleteFromScene();f.error='Fusion could not be completed';return false;}","  const discovery=archive.resolve([a,b]);","  sv.get('NextTowerId').setNumber(id);sv.get('Money').sub(cost);a.deleteFromScene();b.deleteFromScene();if(discovery)archive.discover(discovery.id,discovery.variant);","  f.finish();sv.get('SelectedTower').setNumber(id);scene.__audio?.play('TowerMajorUpgrade');return t;"," };"," f.render=()=>{","  const w=game.getGameResolutionWidth(),h=game.getGameResolutionHeight();layer.setCameraZoom(1);layer.setCameraX(w/2);layer.setCameraY(h/2);layer.show(f.active);if(!f.active)return;","  const g=f.worldGraphics,map=scene.getLayer(''),zoom=map.getCameraZoom(),screen=t=>map.convertInverseCoords(...p.center(t),0,[0,0]),area=scene.__towerShopUI.gameArea;","  f.graphics.clear().beginFill(0x09051b,config.OverlayOpacity).drawRect(area.left,area.top,area.right-area.left,area.bottom-area.top).endFill();g.clear();","  const maskKey=[area.left,area.top,area.right,area.bottom].join(':');if(f.worldMaskKey!==maskKey){f.worldMask.clear().beginFill(0xffffff).drawRect(area.left,area.top,area.right-area.left,area.bottom-area.top).endFill();f.worldMaskKey=maskKey;}","  const markerIds=new Set(),footprintIds=new Set(),obstacleIds=new Set();","  if(f.stage==='placement')for(const collider of p.blockers){","   // These are the exact circles tested by p.validate, including Spawn and Base.","   const {owner,x,y,r}=collider,id=owner.getUniqueId(),point=map.convertInverseCoords(x,y,0,[0,0]),radius=r*zoom,color=0xf2b866;","   g.lineStyle(1.5,color,.85).beginFill(color,.055).drawCircle(point[0],point[1],radius).endFill();","   const top=point[1]-radius;g.lineStyle(1,color,.95).beginFill(0x271a30,.85).drawPolygon([point[0],top-3,point[0]+3,top,point[0],top+3,point[0]-3,top]).endFill();","   const record=f.obstacleFootprints.get(id)||{};Object.assign(record,{id,owner,shape:'circle',x,y,r,screenX:point[0],screenY:point[1],screenRadius:radius,color});f.obstacleFootprints.set(id,record);obstacleIds.add(id);","  }","  for(const id of f.obstacleFootprints.keys())if(!obstacleIds.has(id))f.obstacleFootprints.delete(id);","  for(const t of p.towers()){","   const v=t.getVariables(),max=Math.max(v.get('Path1Level').getAsNumber(),v.get('Path2Level').getAsNumber())===5&&!star.isFusion(t);","   const id=t.getUniqueId(),[x,y]=screen(t),valid=f.pair(f.a,t),selected=t===f.a||t===f.b;","   if(f.stage==='placement'){","    const radius=p.radius(t),color=selected?0x9de8f0:0xf49ab1;","    g.lineStyle(2,color,.95).beginFill(color,selected ? .025 : .045).drawCircle(x,y,radius*zoom).endFill();","    const record=f.footprints.get(id)||{};Object.assign(record,{id,x,y,radius,screenRadius:radius*zoom,color,ignored:selected});f.footprints.set(id,record);footprintIds.add(id);","   }else if(max){const color=selected?0xf5d58d:valid?0x9df1ff:0x8a75aa;g.lineStyle(selected||valid?3:1,color,selected||valid?.95:.4).drawCircle(x,y,(p.radius(t)+5)*zoom);}","   if(!(f.stage==='partner'?max:selected))continue;","   markerIds.add(id);const color=selected?0xf5d58d:valid?0x9df1ff:0x8a75aa;","   let marker=f.markers.get(id);if(!marker){marker=new PIXI.Text('FUSION',{fontFamily:'Arial',fontSize:10,fontWeight:'bold',fill:color,stroke:0x211236,strokeThickness:3});marker.anchor.set(.5,1);marker.zIndex=2;layer.getRenderer().getRendererObject().addChild(marker);f.markers.set(id,marker);}marker.position.set(x,y-(p.radius(t)+8)*zoom);marker.style.fill=color;","  }","  for(const [id,m]of f.markers)if(!markerIds.has(id)){m.destroy();f.markers.delete(id);}","  for(const id of f.footprints.keys())if(!footprintIds.has(id))f.footprints.delete(id);","  if(f.stage==='placement'){","   for(const t of [f.a,f.b]){const [x,y]=screen(t);g.lineStyle(2,0xbfa0ff,.5).beginFill(0x9470d0,.07).drawCircle(x,y,config.RegionalRadius*zoom).endFill();}","   const [x,y]=p.cursor(),result=f.validate(x,y),point=map.convertInverseCoords(x,y,0,[0,0]);if(f.preview&&(f.preview.x!==x||f.preview.y!==y))f.error='';f.preview={x,y,...result};","   const size=88*zoom;f.ghost.setWidth(size);f.ghost.setHeight(size);f.ghost.setPosition(point[0]-size/2,point[1]-size/2);f.ghost.setOpacity(185);f.ghost.setColor(result.valid?'180;255;230':'255;80;105');f.ghost.hide(false);","   g.lineStyle(2,result.valid?0x9aedd5:0xff5b79,.95).drawCircle(...point,p.config('StarCannonTower').Radius*zoom);","  }","  f.renderSidebar();"," };"," f.dispose=()=>{if(f.disposed)return;if(f.active)f.finish();for(const o of Object.values(f.objects))o.deleteFromScene();f.objects={};f.worldGraphics.mask=null;f.worldGraphics.destroy();f.worldMask.destroy();sidebar.root.mask=null;sidebar.root.destroy({children:true,texture:false,baseTexture:false});sidebar.mask.destroy();sidebar.texts.clear();sidebar.portraits.clear();f.hudGraphics.destroy();f.graphics.destroy();f.disposed=true;};"," if(!gdjs.__starburstFusionCallbacks){gdjs.__starburstFusionCallbacks=true;gdjs.callbacksRuntimeSceneUnloading.push(s=>s.__fusion?.dispose());}","}","const input=game.getInputManager(),down=input.isMouseButtonPressed(0);","if(f.active){"," if(!f.alive(f.a,f.aId)||!f.eligible(f.a)||(f.b&&(!f.alive(f.b,f.bId)||!f.pair(f.a,f.b)))||sv.get('GameOver').getAsBoolean())f.cancel();"," else if(gdjs.evtTools.input.wasKeyJustPressed(scene,'Escape'))f.cancel();"," else{","  f.render();const x=gdjs.evtTools.input.getCursorX(scene,'FusionUI',0),y=gdjs.evtTools.input.getCursorY(scene,'FusionUI',0),r=f.cancelRect,cancel=!!r&&x>=r.x&&x<r.x+r.w&&y>=r.y&&y<r.y+r.h;","  if(down&&!f.wasDown)f.pressed=cancel?'cancel':f.stage;","  if(!down&&f.wasDown){","   if(cancel&&f.pressed==='cancel')f.cancel();","   else if(f.pressed===f.stage){const [wx,wy]=p.cursor(),area=scene.__towerShopUI.gameArea,screen=scene.getLayer('').convertInverseCoords(wx,wy,0,[0,0]);","    if(screen[0]>=area.left&&screen[0]<area.right&&screen[1]>=area.top&&screen[1]<area.bottom){","     if(f.stage==='partner'){const target=p.towers().filter(t=>scene.__worldSelection.towerHit(t,wx,wy)).sort((a,b)=>b.getZOrder()-a.getZOrder())[0];f.choose(target);}","     else f.confirm(wx,wy);","    }","   }","   f.pressed='';","  }"," }","}","f.wasDown=down;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// One permanent Fusion discovery source for notification, variants and Index.","// Storage follows the existing audio-settings mechanism; monster session state stays separate.","const scene=runtimeScene,game=scene.getGame(),sv=scene.getVariables(),catalog=sv.get('FusionCatalog').toJSObject();","let archive=game.__fusionArchive;","if(!archive?.persistent){"," const oldFound=[...(archive?.found||[])],key='celestialVoidFusionDiscovery.v1';let state={version:1,entries:{}},storageOK=true,saveNeeded=false;"," try{const raw=JSON.parse(localStorage.getItem(key)||'null');if(raw&&typeof raw==='object'&&!Array.isArray(raw)){state={...raw,entries:raw.entries&&typeof raw.entries==='object'&&!Array.isArray(raw.entries)?raw.entries:{}};state.version=raw.version||1;}}catch(e){storageOK=false;}"," archive=game.__fusionArchive={persistent:true,storageKey:key,state,storageOK,catalog,found:new Set(),revision:0,queue:[],active:null,stats:{unlockedVariants:0,shown:0,completed:0,sounds:0,writes:0}};"," const a=archive;"," a.definition=id=>a.catalog.find(d=>d.Id===id);"," a.recipeKey=parts=>parts.map(p=>{","  if(p?.getVariables){const v=p.getVariables();return(v.get('TowerType').getAsString()==='StarburstCannon'?'StarburstCannon':p.getName())+':'+v.get('Path1Level').getAsNumber()+'-'+v.get('Path2Level').getAsNumber();}","  return p.Type+':'+p.Path1+'-'+p.Path2;"," }).sort().join('|');"," a.resolve=parts=>{const k=a.recipeKey(parts);for(const d of a.catalog)for(const v of d.Variants||[])if(a.recipeKey(v.Recipe)===k)return{id:d.Id,variant:v.Id};return null;};"," a.record=id=>{let r=a.state.entries[id];if(!r||typeof r!=='object'||Array.isArray(r)){r={discovered:r===true,variants:{}};a.state.entries[id]=r;}if(!r.variants||typeof r.variants!=='object'||Array.isArray(r.variants))r.variants={};return r;};"," a.has=id=>a.found.has(id);"," a.hasVariant=(id,variant)=>a.state.entries[id]?.variants?.[variant]===true;"," a.progress=id=>{const d=a.definition(id),variants=d?.Variants||[];return{found:variants.filter(v=>a.hasVariant(id,v.Id)).length,total:variants.length};};"," a.save=()=>{try{localStorage.setItem(key,JSON.stringify(a.state));a.storageOK=true;a.stats.writes++;return true;}catch(e){a.storageOK=false;return false;}};"," const legacy=[...oldFound,...(Array.isArray(state.found)?state.found:[])];"," for(const id of legacy)if(typeof id==='string'){a.record(id).discovered=true;saveNeeded=true;}"," for(const id of Object.keys(state.entries)){","  const r=a.record(id),d=a.definition(id);if(r.discovered===true||Object.values(r.variants).some(v=>v===true)){","   a.found.add(id);r.discovered=true;","   // A legacy Pure unlock implies its sole variant. Hybrid progress never fans out.","   if(d?.Kind==='Pure'&&d.Variants?.length===1&&!Object.keys(r.variants).length){r.variants[d.Variants[0].Id]=true;saveNeeded=true;}","  }"," }"," a.discover=(id,variant)=>{","  const d=a.definition(id);if(!d)return false;","  variant=variant||(d.Kind==='Pure'&&d.Variants.length===1?d.Variants[0].Id:'');","  if(!d.Variants.some(v=>v.Id===variant)||a.hasVariant(id,variant))return false;","  const first=!a.has(id),r=a.record(id);r.discovered=true;r.variants[variant]=true;a.found.add(id);a.revision++;a.stats.unlockedVariants++;a.save();a.queue.push({id,variant,first});scene.__discoveryToast?.enqueue('fusion',a.queue.at(-1));return true;"," };"," a.discoverRecipe=parts=>{const r=a.resolve(parts);return r?{...r,unlocked:a.discover(r.id,r.variant)}:null;};"," if(saveNeeded)a.save();","}","let view=scene.__fusionDiscovery;","if(!view){"," // Refresh definitions on scene reload; records and queue remain one shared source."," archive.catalog=catalog;"," view=scene.__fusionDiscovery={archive,disposed:false};"," const layer=scene.getLayer('DiscoveryUI'),shared=scene.__discoveryToast;"," const visual=shared.create(204);Object.assign(view,visual);const {root,mask}=visual;"," view.bind=event=>{","  const def=archive.definition(event.id),object=game.getSceneAndExtensionsData(scene.getName()).sceneData.objects.find(o=>o.name==='IndexTowerImage'),animation=object.animations.find(a=>a.name===def.Animation);","  const texture=game.getImageManager().getPIXITexture(animation.directions[0].sprites[0].image);view.icon.texture=texture;view.icon.scale.set(Math.min(38/texture.width,40/texture.height));","  view.heading.text=event.first?'NEW DISCOVERY':'NEW VARIANT';view.name.text=event.first?def.Name:def.Variants.find(v=>v.Id===event.variant)?.Name||def.Name;view.name.scale.set(1);view.name.scale.set(Math.min(1,18/Math.max(1,view.name.height),198/Math.max(1,view.name.width)));view.detail.text=def.Kind+' Fusion Archive Updated';view.bound=event;"," };"," view.update=()=>{","  if(view.disposed)return;","  if(sv.get('IndexOpen').getAsBoolean()||scene.__monsterDiscovery?.active||!archive.active&&!shared.canBegin('fusion')){root.visible=false;mask.visible=false;return;}","  const dt=Math.max(0,scene.getTimeManager().getElapsedTime()/Math.max(.001,scene.getTimeManager().getTimeScale())/1000);","  if(archive.active){archive.active.age+=dt;if(archive.active.age>=shared.duration){archive.active=null;archive.stats.completed++;}}","  if(!archive.active&&archive.queue.length&&shared.canBegin('fusion')){const event=archive.queue.shift();shared.take('fusion',event);archive.active={...event,age:0};archive.stats.shown++;if(scene.__audio?.play('DiscoveryUnlock'))archive.stats.sounds++;}","  const active=archive.active;if(!active){root.visible=false;mask.visible=false;return;}if(view.bound!==active)view.bind(active);","  layer.setCameraZoom(1);layer.setCameraX(game.getGameResolutionWidth()/2);layer.setCameraY(game.getGameResolutionHeight()/2);","  shared.paint(view,active.age);"," };"," view.dispose=()=>{if(view.disposed)return;view.disposed=true;root.mask=null;root.destroy({children:true,texture:false,baseTexture:false});mask.destroy();};"," if(!gdjs.__fusionArchiveCallbacks){gdjs.__fusionArchiveCallbacks=true;gdjs.callbacksRuntimeScenePostEvents.push(s=>s.__fusionDiscovery?.update());gdjs.callbacksRuntimeSceneUnloading.push(s=>s.__fusionDiscovery?.dispose());}","}"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[]},{"colorB":109,"colorG":143,"colorR":90,"creationTime":0,"name":"Unit INDEX modal","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Galactic Archives is presentation-only. Combat and discovery owners stay authoritative.","const scene=runtimeScene,sv=scene.getVariables(),game=scene.getGame(),input=game.getInputManager();","const width=game.getGameResolutionWidth(),height=game.getGameResolutionHeight(),data=game.getSceneAndExtensionsData(scene.getName()).sceneData;","let index=scene.__unitIndex;","if(!index){"," index=scene.__unitIndex={objects:{},cards:[],monsterCards:[],category:'Towers',selected:{},scroll:0,collectionScroll:0,wasDown:false,pressed:'',dragging:null,disposed:false};"," index.ensure=(key,name,layer,z)=>{let o=index.objects[key];if(!o){o=scene.createObject(name);o.setLayer(layer);o.setZOrder(z);index.objects[key]=o;}return o;};"," index.graphics={};index.masks={};"," for(const name of ['IndexUI','IndexList','IndexDetail']){","  const parent=scene.getLayer(name).getRenderer().getRendererObject(),g=new PIXI.Graphics();g.zIndex=-10;g.interactive=false;parent.addChild(g);index.graphics[name]=g;","  if(name!=='IndexUI'){const mask=new PIXI.Graphics();mask.zIndex=-20;parent.addChild(mask);parent.mask=mask;index.masks[name]=mask;}"," }"," index.select=id=>{index.selected[index.category]=id;index.scroll=0;index.renderKey=null;};"," index.dispose=()=>{if(index.disposed)return;index.disposed=true;for(const name of ['IndexUI','IndexList','IndexDetail']){scene.getLayer(name).getRenderer().getRendererObject().mask=null;index.graphics[name].destroy();index.masks[name]?.destroy();}};"," if(!gdjs.__indexShowcaseCallbacks){gdjs.__indexShowcaseCallbacks=true;gdjs.callbacksRuntimeSceneUnloading.push(s=>s.__unitIndex?.dispose());}","}","for(const name of ['IndexUI','IndexList','IndexDetail']){const l=scene.getLayer(name);l.setCameraZoom(1);l.setCameraX(width/2);l.setCameraY(height/2);}","const wasOpen=sv.get('IndexOpen').getAsBoolean(),shop=scene.__towerShopUI;","if(shop?.indexRequested){sv.get('IndexOpen').setBoolean(true);shop.indexRequested=false;}","let open=sv.get('IndexOpen').getAsBoolean();sv.get('IndexBlocksInput').setBoolean(wasOpen||open);","const down=input.isMouseButtonPressed(0);","if(!open){for(const name of ['IndexUI','IndexList','IndexDetail'])scene.getLayer(name).show(false);index.wasDown=down;index.pressed='';index.dragging=null;index.renderKey=null;return;}","const archive=game.__fusionArchive,discovery=scene.__monsterDiscovery,portraits=sv.get('IndexPortraitCatalog').toJSObject(),star=sv.get('StarCannonConfig').toJSObject();","const archetypes=sv.get('EnemyTypes').toJSObject(),catalog=sv.get('TowerShopCatalog').toJSObject(),categories=['Towers','Monsters','Fusion'];","if(!categories.includes(index.category))index.category='Towers';","const entries=index.category==='Towers'?catalog.flatMap(item=>{"," const def=data.objects.find(o=>o.name===item.Type);if(!def)return[];const v=Object.fromEntries(def.variables.map(v=>[v.name,v.value])),isStar=item.Type==='StarCannonTower';"," return[{id:item.Type,type:item.Type,name:v.TowerName||item.Name,price:item.Cost,damage:isStar?star.BaseDamage:v.Damage,range:isStar?star.BaseRange:v.AttackRange,cooldown:isStar?star.BaseInterval:v.AttackInterval,projectileSpeed:isStar?star.ProjectileSpeed:v.ProjectileSpeed,locked:false}];","}):index.category==='Monsters'?discovery.ids.map(id=>({id,typeId:id,name:archetypes[id].Name||id,...archetypes[id],locked:!discovery.has(id),monster:true})):archive.catalog.map(def=>({id:def.Id,type:def.Id,name:def.Name,definition:def,fusion:true,locked:!archive.has(def.Id)}));","index.entries=entries;index.categories=categories;","const categoryChanged=index.lastCategory!==index.category;","if(categoryChanged){index.scroll=0;index.collectionScroll=0;index.lastCategory=index.category;}","if(!entries.some(e=>e.id===index.selected[index.category]))index.selected[index.category]=entries[0]?.id;","const selected=entries.find(e=>e.id===index.selected[index.category]),selectedIndex=entries.indexOf(selected);","const mobile=width<760,w=Math.min(1320,width-32),h=Math.min(900,height-32),x=(width-w)/2,y=(height-h)/2;","const body={x:x+18,y:y+126,w:w-36,h:h-164},cw=Math.min(280,Math.max(196,w*.225));","const collection=mobile?{x:body.x,y:body.y,w:body.w,h:92}:{x:body.x,y:body.y,w:cw,h:body.h};","const detail=mobile?{x:body.x,y:body.y+106,w:body.w,h:body.h-106}:{x:body.x+cw+16,y:body.y,w:body.w-cw-16,h:body.h};","index.geometry={x,y,w,h,content:detail,collection,detail,mobile};","index.tabRects=categories.map((name,i)=>({name,x:x+20+i*(mobile?(w-40)/3:154),y:y+74,w:mobile?(w-56)/3:142,h:34}));","index.closeRect={x:x+w-58,y:y+20,w:36,h:36};","const mx=gdjs.evtTools.input.getCursorX(scene,'IndexUI',0),my=gdjs.evtTools.input.getCursorY(scene,'IndexUI',0),inside=r=>!!r&&mx>=r.x&&mx<r.x+r.w&&my>=r.y&&my<r.y+r.h;","const stride=mobile?182:90,rowWidth=mobile?172:collection.w-14;","index.collectionMaxScroll=Math.max(0,entries.length*stride-(mobile?collection.w:collection.h));","if(categoryChanged&&selectedIndex>=0)index.collectionScroll=Math.max(0,Math.min(index.collectionMaxScroll,selectedIndex*stride+80-(mobile?collection.w:collection.h)));","const wheel=input.getMouseWheelDelta();if(inside(collection))index.collectionScroll-=Math.sign(wheel)*52;else if(inside(detail))index.scroll-=Math.sign(wheel)*60;","index.collectionScroll=Math.max(0,Math.min(index.collectionMaxScroll,index.collectionScroll));","const cardRects=()=>entries.map((e,i)=>({id:e.id,x:collection.x+(mobile?i*stride-index.collectionScroll:0),y:collection.y+(mobile?0:i*stride-index.collectionScroll),w:rowWidth,h:80}));","index.cardRects=cardRects();","const detailTrack={x:detail.x+detail.w-8,y:detail.y,w:8,h:detail.h},collectionTrack=mobile?null:{x:collection.x+collection.w-7,y:collection.y,w:7,h:collection.h};","const hover=index.tabRects.find(inside)?.name||(inside(index.closeRect)?'Close':inside(detailTrack)&&index.maxScroll>0?'DetailTrack':inside(collectionTrack)&&index.collectionMaxScroll>0?'CollectionTrack':inside(collection)?index.cardRects.find(inside)?.id:'')||'';","if(down&&!index.wasDown){index.pressed=hover;if(hover.endsWith('Track'))index.dragging={list:hover==='CollectionTrack',y:my,value:hover==='CollectionTrack'?index.collectionScroll:index.scroll};}","if(down&&index.dragging){const d=index.dragging,r=d.list?collection:detail,max=d.list?index.collectionMaxScroll:index.maxScroll,thumb=Math.max(24,r.h*r.h/(r.h+max)),value=d.value+(my-d.y)*max/Math.max(1,r.h-thumb);if(d.list)index.collectionScroll=value;else index.scroll=value;}","index.collectionScroll=Math.max(0,Math.min(index.collectionMaxScroll,index.collectionScroll));index.cardRects=cardRects();","if(!down&&index.wasDown&&index.pressed===hover){"," if(hover==='Close'){sv.get('IndexOpen').setBoolean(false);open=false;}"," else if(categories.includes(hover)&&index.category!==hover){index.category=hover;index.renderKey=null;index.wasDown=down;index.pressed='';return;}"," else if(entries.some(e=>e.id===hover)){index.select(hover);index.wasDown=down;index.pressed='';return;}","}","if(gdjs.evtTools.input.wasKeyJustPressed(scene,'Escape')){sv.get('IndexOpen').setBoolean(false);open=false;}","if(!down)index.dragging=null;","index.scroll=Math.max(0,Math.min(index.maxScroll||0,index.scroll));","const key=JSON.stringify([index.category,index.selected[index.category],index.scroll,index.collectionScroll,width,height,hover,open,discovery.revision,archive.revision]);","if(index.renderKey===key){index.wasDown=down;if(!down)index.pressed='';return;}index.renderKey=key;index.renderCount=(index.renderCount||0)+1;","Object.values(index.objects).forEach(o=>o.hide());index.cards=[];index.monsterCards=[];index.measuredTexts=[];index.artRects=[];","for(const g of Object.values(index.graphics))g.clear();","for(const [name,r]of [['IndexList',collection],['IndexDetail',detail]])index.masks[name].clear().beginFill(0xffffff).drawRect(r.x,r.y,r.w,r.h).endFill();","const C={border:0x494169,gold:0xc5ab72,white:'242;236;255',muted:'172;166;197'};","const box=(layer,r,fill,border=C.border,radius=10,alpha=1)=>index.graphics[layer].lineStyle(1,border,.8).beginFill(fill,alpha).drawRoundedRect(r.x,r.y,r.w,r.h,radius).endFill();","const line=(layer,a,b,c,d,color=C.border)=>index.graphics[layer].lineStyle(1,color,.6).moveTo(a,b).lineTo(c,d);","const text=(key,value,px,py,ww,size=13,color=C.white,bold=false,layer='IndexUI')=>{"," const o=index.ensure(key,'IndexText',layer,3);o.setString(String(value));o.setCharacterSize(size);o.setBold(bold);o.setColor(color);o.setWrapping(true);o.setWrappingWidth(Math.max(20,ww));o.setPosition(px,py);o.hide(false);index.measuredTexts.push({key,object:o,x:px,y:py,w:ww});return o;","};","const label=(key,value,px,py,ww,layer='IndexDetail',color='192;173;123')=>text(key,value,px,py,ww,10,color,true,layer);","const g=index.graphics.IndexUI;g.beginFill(0x050610,.88).drawRect(0,0,width,height).endFill();box('IndexUI',{x,y,w,h},0x101024,0x797098,15,.99);","line('IndexUI',x+18,y+62,x+w-18,y+62,0x5c4a75);","for(const [sx,sy]of [[x+18,y+18],[x+w-18,y+18],[x+18,y+h-18],[x+w-18,y+h-18]])g.beginFill(C.gold,.9).drawPolygon([sx,sy-3,sx+3,sy,sx,sy+3,sx-3,sy]).endFill();","text('title','GALACTIC ARCHIVES',x+32,y+18,w-112,mobile?20:25,C.white,true);","label('archiveMark','CELESTIAL VOID  /  FIELD ENCYCLOPEDIA',x+34,y+47,w-130,'IndexUI','150;165;192');","box('IndexUI',index.closeRect,hover==='Close'?0x443458:0x211c36);text('buttonTextClose','X',index.closeRect.x+12,index.closeRect.y+9,20,15,C.white,true);","for(const r of index.tabRects){const active=r.name===index.category;box('IndexUI',r,active?0x302446:0x17142b,active?C.gold:C.border,7);text('tabText'+r.name,r.name.toUpperCase(),r.x+15,r.y+10,r.w-20,11,active?'234;216;170':C.muted,true);}","const found=entries.filter(e=>!e.locked).length;","const compact=w<1000;","text('subtitle',(index.category==='Towers'?'TOWER COLLECTION':index.category==='Monsters'?'MONSTER DISCOVERY':'FUSION ARCHIVE')+'  /  '+found+' / '+entries.length+' DISCOVERED',mobile?x+20:compact?x+w-338:x+w-350,compact?y+h-25:y+86,mobile?w-40:320,10,C.muted);","box('IndexUI',{x:collection.x-3,y:collection.y-3,w:collection.w+6,h:collection.h+6},0x121027,0x393152,10);","box('IndexUI',{x:detail.x-3,y:detail.y-3,w:detail.w+6,h:detail.h+6},0x14122b,0x54435f,10);","if(!mobile)text('footer',compact?'SCROLL EACH PANEL / ESC TO CLOSE':'SELECT AN ENTRY   /   SCROLL EACH PANEL   /   ESC TO CLOSE',x+32,y+h-25,compact?w-392:w-52,10,'139;137;167');","const fit=(o,b,r)=>{o.setScale(1);const scale=Math.min(r.w/b[2],r.h/b[3]);o.setScale(scale);o.setPosition(r.x+r.w/2-(b[0]+b[2]/2)*scale,r.y+r.h/2-(b[1]+b[3]/2)*scale);index.artRects.push({id:o.__archiveId,object:o,x:o.getX()+b[0]*scale,y:o.getY()+b[1]*scale,w:b[2]*scale,h:b[3]*scale,frame:r});};","const portrait=(key,e,r,layer)=>{"," if(e.monster){const o=index.ensure(key,'IndexMonsterImage',layer,2);o.__archivePortraitOwned=true;o.setAnimationName(e.Animation);o.setColor(e.locked?'0;0;0':'255;255;255');o.setOpacity(0);o.__discoveryLocked=e.locked;o.__discoveryPortrait={id:e.id,x:r.x+r.w/2,y:r.y+r.h/2,w:r.w,h:r.h};o.setWidth(r.w);o.setHeight(r.h);o.setPosition(r.x,r.y);o.hide(false);index.monsterCards.push({sprite:o});return o;}"," const meta=portraits[e.id],animation=meta&&data.objects.find(o=>o.name==='IndexShowcase').animations.find(a=>a.name===meta.Animation);"," if(!animation){label(key+'Pending','PORTRAIT PENDING',r.x+8,r.y+r.h/2-5,r.w-16,layer,'139;133;162');return null;}"," const o=index.ensure(key,'IndexShowcase',layer,2);o.setAnimationName(meta.Animation);o.setColor(e.locked?'0;0;0':'255;255;255');o.setOpacity(255);o.__archiveId=e.id;o.__fusionLocked=e.locked;o.hide(false);fit(o,meta.VisualBounds,r);return o;","};","for(const [i,e]of entries.entries()){"," const r=index.cardRects[i],active=e.id===index.selected[index.category];box('IndexList',r,active?0x302442:0x1a172f,active?C.gold:hover===e.id?0x8c79ba:0x403755,8);"," if(active)index.graphics.IndexList.beginFill(C.gold,.9).drawRoundedRect(r.x+1,r.y+14,3,r.h-28,2).endFill();"," const sprite=portrait('collection'+index.category+i,e,{x:r.x+9,y:r.y+10,w:56,h:60},'IndexList');"," const name=text('collectionName'+i,e.locked?'???':e.name,r.x+74,r.y+14,r.w-82,13,C.white,true,'IndexList');"," const status=text('collectionStatus'+i,e.locked?'UNDISCOVERED':e.monster||e.fusion?'DISCOVERED':'TOWER / AVAILABLE',r.x+74,r.y+48,r.w-82,9,e.locked?'154;139;175':'168;198;218',false,'IndexList');"," index.cards.push({name,status,sprite,locked:e.locked,id:e.id});","}","const scrollBar=(layer,r,max,value,horizontal=false)=>{if(max<=0)return;const g=index.graphics[layer],len=horizontal?r.w:r.h,thumb=Math.max(24,len*len/(len+max)),pos=value/max*(len-thumb);g.beginFill(0x3b3454).drawRoundedRect(r.x,r.y,r.w,r.h,3).endFill();g.beginFill(0x9b89ba).drawRoundedRect(r.x+(horizontal?pos:0),r.y+(horizontal?0:pos),horizontal?thumb:r.w,horizontal?r.h:thumb,3).endFill();};","scrollBar('IndexUI',mobile?{x:collection.x,y:collection.y+86,w:collection.w,h:4}:collectionTrack,index.collectionMaxScroll,index.collectionScroll,mobile);","if(selected){"," const e=selected,locked=e.locked,dx=detail.x+18,dw=detail.w-48,top=detail.y+16-index.scroll,stack=dw<480,artW=stack?Math.min(280,dw):Math.min(350,dw*.43),artH=Math.min(330,Math.max(128,detail.h-48)),artFrame={x:stack?dx+(dw-artW)/2:dx,y:top,w:artW,h:artH};"," box('IndexDetail',artFrame,0x111429,e.fusion?C.gold:0x344360,12);"," const ag=index.graphics.IndexDetail,cx=artFrame.x+artW/2,cy=top+artH*.57;"," ag.lineStyle(1,e.fusion?0x8d734b:0x48617e,.35).drawEllipse(cx,cy,artW*.43,artH*.27).drawEllipse(cx,cy,artW*.34,artH*.21);"," for(let k=0;k<5;k++)ag.beginFill(0x92a4cc,.4).drawCircle(artFrame.x+14+(k*37)%(artW-28),top+18+(k*53)%(artH-36),1).endFill();"," const art=portrait('detail'+index.category,e,{x:artFrame.x+16,y:artFrame.y+16,w:artW-32,h:artH-32},'IndexDetail');"," const tx=stack?dx:dx+artW+22,tw=stack?dw:dw-artW-22,ty=stack?top+artH+20:top+4;"," label('detailType',locked?'UNIDENTIFIED ARCHIVE':e.fusion?e.definition.Kind.toUpperCase()+' FUSION':e.monster?(e.Classification||'COMMON')+' ENEMY':'CELESTIAL ARTILLERY',tx,ty,tw);"," const title=text('detailName',locked?'???':e.name,tx,ty+20,tw,tw<250?24:30,C.white,true,'IndexDetail');"," let yy=ty+20+title.getHeight()+10;"," const desc=locked?(e.fusion?'CRYPTIC HINT\\n'+e.definition.Hint:'An unknown presence moves through the Void. Encounter this enemy to reveal its archive.'):(e.fusion?e.definition.Description:e.monster?(e.Role||(e.id==='Basic'?'A wandering cosmic entity.':'Fast Void creature.')):'A single stellar cannon, forged in ivory and gold. Shape its energy through two upgrade paths.');"," const description=text('detailDescription',desc,tx,yy,tw,13,C.muted,false,'IndexDetail');yy+=description.getHeight()+18;"," const config=e.fusion?(data.variables.some(v=>v.name===e.definition.StatsConfig)?sv.get(e.definition.StatsConfig).toJSObject():e.definition.Stats||{}):null;"," const stats=locked?[]:e.monster?[['HP',e.HP],['ARMOR',e.Armor],['SPEED',e.Speed+' px/s'],['REWARD',e.Reward+' Gold']]:[['DAMAGE',e.fusion?config.Damage:e.damage],['INTERVAL',Number(e.fusion?config.AttackInterval:e.cooldown).toFixed(2)+' s'],['RANGE',(e.fusion?config.AttackRange:e.range)+' px'],[e.fusion?'RATE':'COST',e.fusion?(1/config.AttackInterval).toFixed(2)+' /s':e.price+' Gold']];"," index.statValues=stats;const statsTop=yy,cellW=(tw-10)/2;"," for(const [i,[name,value]]of stats.entries()){","  const sx=tx+i%2*(cellW+10),sy=statsTop+Math.floor(i/2)*64;box('IndexDetail',{x:sx,y:sy,w:cellW,h:54},0x201d38,0x393551,6);","  const icon=index.graphics.IndexDetail,ix=sx+14,iy=sy+13;icon.lineStyle(1,0xa4bedb,.85);","  if(name==='INTERVAL'||name==='RATE')icon.drawCircle(ix,iy,4).moveTo(ix,iy-3).lineTo(ix,iy).lineTo(ix+3,iy+1);","  else if(name==='RANGE')icon.drawCircle(ix,iy,4).moveTo(ix-6,iy).lineTo(ix+6,iy).moveTo(ix,iy-6).lineTo(ix,iy+6);","  else if(name==='HP')icon.moveTo(ix-4,iy).lineTo(ix+4,iy).moveTo(ix,iy-4).lineTo(ix,iy+4);","  else if(name==='ARMOR')icon.drawPolygon([ix-4,iy-4,ix+4,iy-4,ix+3,iy+2,ix,iy+5,ix-3,iy+2,ix-4,iy-4]);","  else icon.drawPolygon([ix,iy-5,ix+4,iy,ix,iy+5,ix-4,iy,ix,iy-5]);","  label('statLabel'+i,name,sx+26,sy+8,cellW-36,'IndexDetail','151;164;192');text('statValue'+i,value,sx+10,sy+24,cellW-20,18,C.white,true,'IndexDetail');"," }"," yy+=stats.length?128:0;"," if(!locked&&!e.monster){const property=e.fusion?(Number.isFinite(config.SplashRadius)&&Number.isFinite(config.SplashRatio)?'SPLASH  /  '+config.SplashRadius+' px  /  '+Math.round(config.SplashRatio*100)+'% damage':''):(Number.isFinite(e.projectileSpeed)?'PROJECTILE SPEED  /  '+e.projectileSpeed+' px/s':'');if(property){const properties=text('detailProperties',property,tx,yy,tw,11,'151;170;198',false,'IndexDetail');yy+=properties.getHeight()+14;}}"," if(locked){label('detailLock','UNDISCOVERED  /  DETAILS LOCKED',tx,yy,tw,'IndexDetail','163;144;188');yy+=32;}"," let sectionY=Math.max(top+artH+24,yy+8);"," const section=(key,title)=>{line('IndexDetail',dx,sectionY,dx+dw,sectionY,0x655470);label(key,title,dx,sectionY+14,dw);sectionY+=40;};"," const paragraph=(key,value)=>{const t=text(key,value,dx,sectionY,dw,13,C.muted,false,'IndexDetail');sectionY+=t.getHeight()+18;return t;};"," index.detail={id:e.id,entry:e,locked,sprite:art,name:title,description,statValues:stats};"," if(e.type==='StarCannonTower'){","  section('upgradesTitle','UPGRADE PATHS');const cols=dw>=580?2:1,colW=cols===2?(dw-16)/2:dw,starts=[];","  for(const [p,path]of star.Paths.entries()){","   const px=dx+(p%cols)*(colW+16);let py=cols===2?sectionY:sectionY+(p?starts[0]:0);const start=py;","   box('IndexDetail',{x:px,y:py,w:colW,h:50},p?0x20203c:0x292038,p?0x586e94:0x8a7052,7);label('pathNumber'+p,'PATH '+(p+1),px+12,py+8,colW-24,'IndexDetail',p?'158;204;229':'225;193;130');text('starPath'+p,path.Name,px+12,py+23,colW-24,12,C.white,true,'IndexDetail');py+=64;","   for(const [n,u]of path.Upgrades.entries()){","    const icon=index.ensure('starUpgrade'+p+n,'StarUpgradeIcon','IndexDetail',2);icon.setAnimationName(u.Icon);icon.setWidth(38);icon.setHeight(38);icon.setPosition(px+8,py+8);icon.hide(false);","    const name=text('upgradeName'+p+n,'0'+(n+1)+'  '+u.Name,px+56,py+8,colW-68,13,C.white,true,'IndexDetail');","    const desc=text('upgradeDesc'+p+n,u.Description,px+56,py+name.getHeight()+14,colW-68,12,C.muted,false,'IndexDetail');","    const rh=Math.max(92,name.getHeight()+desc.getHeight()+48);box('IndexDetail',{x:px,y:py,w:colW,h:rh-8},0x19162e,0x302b45,6);label('upgradeCost'+p+n,u.Cost+' GOLD',px+56,py+rh-30,colW-68,'IndexDetail','195;175;129');py+=rh;","   }","   starts[p]=py-start+18;","  }","  sectionY+=cols===2?Math.max(...starts):starts.reduce((a,b)=>a+b,0);paragraph('starRule','Level 3 specializes one path. The other path can reach level 2. Maximum level '+star.MaxLevel+'.');"," }else if(e.monster&&!locked){","  section('abilityHeading','ENEMY PROFILE');paragraph('monsterProfile',!e.SpecialAbility||e.SpecialAbility==='None'?'No special ability.':'SPECIAL ABILITY  /  '+e.SpecialAbility);","  if(e.id==='VoidGolem'){const skill=sv.get('VoidGolemConfig').toJSObject().Skill;paragraph('golemSkill','Stops to cast '+skill.Name+'. Grants +'+skill.ArmorBonus+' armor within '+skill.Radius+' px for '+skill.Duration+' s. Cooldown: '+skill.Cooldown+' s.');}","  paragraph('monsterFirstWave','FIRST APPEARANCE  /  WAVE '+e.MinimumWave+'+');"," }else if(e.fusion){","  section('recipeHeading',locked?'SEALED COMBINATION':'FUSION COMBINATION');const recipe=v=>v.Recipe.map(p=>p.Label||p.Type+' '+p.Path1+'-'+p.Path2).join(' + '),known=e.definition.Variants.filter(v=>archive.hasVariant(e.id,v.Id));","  paragraph('fusionRecipe'+selectedIndex,locked?'Combination locked':e.definition.AdaptiveVariants?'Each adaptive variant is discovered separately.':known.map(recipe).join('\\n')||'Combination not yet recorded');","  if(e.definition.AdaptiveVariants){const progress=archive.progress(e.id);section('fusionProgress'+selectedIndex,'ADAPTIVE VARIANTS  /  '+progress.found+' / '+progress.total);e.definition.Variants.forEach((v,n)=>paragraph('fusionVariant'+n+selectedIndex,archive.hasVariant(e.id,v.Id)?v.Name+'\\n'+recipe(v):'???  /  UNDISCOVERED'));}","  else if(!locked)paragraph('fusionIdentity','PURE EVOLUTION  /  One canonical recipe. Source order does not change the result.');"," }"," index.detailHeight=sectionY+index.scroll-detail.y;index.maxScroll=Math.max(0,index.detailHeight-detail.h+12);scrollBar('IndexUI',detailTrack,index.maxScroll,index.scroll);","}else{text('emptyArchive','No entries available.',detail.x+20,detail.y+30,detail.w-40,16,C.muted);index.maxScroll=0;}","for(const name of ['IndexUI','IndexList','IndexDetail'])scene.getLayer(name).show(open);","index.wasDown=down;if(!down)index.pressed='';"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// A separate UI overlay. Shop and map geometry stay independent of selection.","const scene=runtimeScene,sv=scene.getVariables(),game=scene.getGame();","let ui=scene.__selectedPanel;","if(!ui) {","  ui=scene.__selectedPanel={objects:{},wasDown:false,pressed:\"\",pressedTower:0,cards:[]};","  ui.ensure=(key,name,z=1)=>{","    if(!ui.objects[key]){const o=scene.createObject(name);o.setLayer(\"SelectedTowerUI\");o.setZOrder(z);ui.objects[key]=o;}","    return ui.objects[key];","  };","}","const towers=scene.getObjects(\"StarCannonTower\");","let selected=towers.find(t=>t.getVariables().get(\"TowerId\").getAsNumber()===sv.get(\"SelectedTower\").getAsNumber());","if(!selected&&sv.get(\"SelectedTower\").getAsNumber()>0)sv.get(\"SelectedTower\").setNumber(0);","const input=game.getInputManager(),down=input.isMouseButtonPressed(0),modal=sv.get(\"IndexBlocksInput\").getAsBoolean()||sv.get(\"AudioUIConsumesClick\").getAsBoolean()||sv.get('FusionActive').getAsBoolean();","const h=680,w=320,layer=scene.getLayer(\"SelectedTowerUI\");","let scale=1,sx=8,sy=8;","const positionPanel=tower=>{"," const area=scene.__towerShopUI.gameArea,margin=8,map=scene.getLayer(\"\");"," const center=tower?(scene.__freePlacement?scene.__freePlacement.center(tower):[tower.getCenterXInScene(),tower.getCenterYInScene()]):[(area.left+area.right)/2,0];"," const screen=tower?map.convertInverseCoords(center[0],center[1],0,[0,0]):center;"," const right=tower&&screen[0]<(area.left+area.right)/2;"," const hud=scene.getObjects(\"HUDPanel\")[0],hudLayer=scene.getLayer(\"UI\");"," const hudBottom=hudLayer.convertInverseCoords(hud.getX(),hud.getY()+hud.getHeight(),0,[0,0])[1];"," sy=Math.max(margin,hudBottom+margin);"," const footprint=tower&&scene.__freePlacement?scene.__freePlacement.radius(tower)*map.getCameraZoom():0;"," const sideRoom=tower?(right?area.right-margin-screen[0]-footprint-margin:screen[0]-footprint-margin-area.left-margin):area.right-area.left-2*margin;"," scale=Math.max(.01,Math.min(1,(game.getGameResolutionHeight()-sy-margin)/h,((area.right-area.left)/2-2*margin)/w,sideRoom/w));"," sx=right?area.right-margin-w*scale:area.left+margin;"," sx=Math.max(area.left+margin,Math.min(area.right-margin-w*scale,sx));"," layer.setCameraZoom(scale);layer.setCameraX(game.getGameResolutionWidth()/2/scale-sx/scale);layer.setCameraY(game.getGameResolutionHeight()/2/scale-sy/scale);"," ui.panelSide=right?\"RIGHT\":\"LEFT\";ui.screenRect=tower?{x:sx,y:sy,w:w*scale,h:h*scale}:null;","};","positionPanel(selected);","const mx=gdjs.evtTools.input.getCursorX(scene,\"SelectedTowerUI\",0),my=gdjs.evtTools.input.getCursorY(scene,\"SelectedTowerUI\",0);","const inside=(x,y,width,height)=>mx>=x&&mx<x+width&&my>=y&&my<y+height;","const pointer=!!selected&&!modal&&inside(0,0,w,h);","sv.get(\"SelectedPanelPointerInside\").setBoolean(pointer);","sv.get(\"TowerUIConsumesClick\").setBoolean(pointer);","ui.screenRect=selected?{x:sx,y:sy,w:w*scale,h:h*scale}:null;","const canFuse=scene.__fusion?.eligible(selected)||false;","const hover=!selected||modal?\"\":canFuse&&inside(16,584,288,26)?'Fusion':inside(16,h-66,w-32,48)?\"Sell\":inside(278,12,26,26)?\"Close\":inside(16,314,140,270)?\"Path1\":inside(164,314,140,270)?\"Path2\":pointer?\"Panel\":\"\";","if(down&&!ui.wasDown){ui.pressed=hover;ui.pressedTower=selected?selected.getVariables().get(\"TowerId\").getAsNumber():0;}","if(!down&&ui.wasDown&&selected&&!modal&&ui.pressed===hover&&ui.pressedTower===selected.getVariables().get(\"TowerId\").getAsNumber()) {","  if(hover===\"Sell\") {","    const v=selected.getVariables(),investment=v.get(\"TotalInvestment\").getAsNumber();","    sv.get(\"Money\").setNumber(sv.get(\"Money\").getAsNumber()+Math.floor(investment*sv.get(\"SellRefundRate\").getAsNumber()+1e-8));","    selected.deleteFromScene();sv.get(\"SelectedTower\").setNumber(0);selected=null;","  } else if(hover==='Fusion'){scene.__fusion?.begin(selected);selected=null;}","  else if(hover===\"Close\") {sv.get(\"SelectedTower\").setNumber(0);selected=null;}","  else if((hover===\"Path1\"||hover===\"Path2\"))scene.__starCannon?.upgrade(selected,hover===\"Path1\"?1:2);","}","if(!down)ui.pressed=\"\";ui.wasDown=down;","ui.render=()=>{","  Object.values(ui.objects).forEach(o=>o.hide());","  const tower=towers.find(t=>t.getVariables().get(\"TowerId\").getAsNumber()===sv.get(\"SelectedTower\").getAsNumber()&&scene.getObjects(t.getName()).includes(t));","  positionPanel(tower);layer.show(!!tower);ui.tower=tower;ui.cards=[];","  if(!tower){ui.screenRect=null;return;}","  const v=tower.getVariables(),isStar=true,isFusion=scene.__starCannon.isFusion(tower),hasUpgrades=!isFusion,cfg=sv.get(\"StarCannonConfig\").toJSObject();","  const panel=(key,x,y,width,height,color=\"255;255;255\",name=\"SelectedPanelBackground\",z=1)=>{const o=ui.ensure(key,name,z);o.setPosition(x,y);o.setWidth(width);o.setHeight(height);o.setColor(color);o.setOpacity(255);o.hide(false);return o;};","  const text=(key,value,x,y,width,size=13,color=\"240;230;255\",bold=false)=>{const o=ui.ensure(key,\"SelectedPanelText\",4);o.setPosition(x,y);o.setWrapping(true);o.setWrappingWidth(width);o.setTextAlignment(\"left\");o.setString(String(value));o.setCharacterSize(size);o.setBold(bold);o.setColor(color);o.hide(false);return o;};","  panel(\"frame\",0,0,w,h);","  panel(\"header\",12,10,w-24,42,\"255;255;255\",\"SelectedPanelPlaque\",2);","  text(\"title\",v.get(\"TowerName\").getAsString().toUpperCase(),22,22,w-66,17,\"243;234;255\",true);","  text(\"close\",\"X\",286,20,16,14,\"194;171;233\",true);","  const preview=ui.ensure(\"preview\",\"SelectedTowerPreview\",3);preview.setAnimationName(\"SC_\"+v.get(\"VisualKey\").getAsString());preview.setScale(1);const ratio=preview.getWidth()/Math.max(1,preview.getHeight());preview.setWidth(ratio>=1?84:84*ratio);preview.setHeight(ratio>=1?84/ratio:84);preview.setPosition((w-preview.getWidth())/2,62+(84-preview.getHeight())/2);preview.hide(false);","  if(hasUpgrades)text(\"build\",v.get(\"Path1Level\").getAsNumber()+\" - \"+v.get(\"Path2Level\").getAsNumber(),138,148,64,12,\"163;224;251\",true);","  const stats=[[\"DAMAGE\",Number(v.get(\"Damage\").getAsNumber().toFixed(2))],[\"FIRE INTERVAL\",Number(v.get(\"AttackInterval\").getAsNumber()).toFixed(2)+\" s\"],[\"ATTACK RANGE\",Number(v.get(\"AttackRange\").getAsNumber().toFixed(2))+\" px\"],[\"DAMAGE DEALT\",Math.round(v.get(\"DamageDealt\").getAsNumber())]];","  stats.forEach(([label,value],i)=>{","    const y=174+i*25;text(\"statLabel\"+i,label,24,y,164,12,\"171;159;199\");const o=text(\"statValue\"+i,value,194,y,100,13,\"240;233;255\",true);o.setTextAlignment(\"right\");","    panel(\"rule\"+i,24,y+20,272,1,\"93;66;125\",\"SelectedProgressBlock\",2);","  });","  if(hasUpgrades) {","    if(isStar){","      const a=v.get('Path1Level').getAsNumber(),b=v.get('Path2Level').getAsNumber();","      const mode=a>=5?'EVERY 4TH: LANCE / '+cfg.Lance.MaxTargets+' IMPACTS':a>=3?'EVERY 4TH: NOVA / 175% DAMAGE':b>=5?(v.get('OverdriveActive').getAsBoolean()?'OVERDRIVE: DUAL FIRE':'ALTERNATING / OVERDRIVE '+v.get('OverdriveRemaining').getAsNumber().toFixed(1)+'s'):b>=3?'ALTERNATING MUZZLES':'SINGLE STELLAR BOLT';","      text('starMode',mode+(b>=4?' / RHYTHM '+v.get('RhythmStacks').getAsNumber()+'/5':''),24,276,272,10,'184;211;239');","    }","    text(\"upgrades\",\"UPGRADES\",116,isStar?294:282,150,14,\"160;230;249\",true);","    cfg.Paths.forEach((path,i)=>{","      const level=v.get(i===0?\"Path1Level\":\"Path2Level\").getAsNumber(),other=v.get(i===0?\"Path2Level\":\"Path1Level\").getAsNumber();","      const locked=level>=2&&other>=3,max=level>=cfg.MaxLevel,upgrade=path.Upgrades[max?cfg.MaxLevel-1:level],affordable=sv.get(\"Money\").getAsNumber()>=upgrade.Cost;","      const x=16+i*148,y=314,active=!locked&&!max;","      const background=panel(\"card\"+i,x,y,140,270,locked?\"116;95;148\":active&&hover===\"Path\"+(i+1)?\"230;210;255\":\"240;224;255\",\"SelectedUpgradeCard\",2);","      const badge=ui.ensure(\"pathBadge\"+i,\"StarUpgradeIcon\",3);badge.setAnimationName(i===0?\"PathDamage\":\"PathSpeed\");badge.setWidth(24);badge.setHeight(24);badge.setPosition(x+10,y+12);badge.setOpacity(locked?170:255);badge.hide(false);","      text(\"path\"+i,isStar?path.Name:\"PATH \"+(i+1),x+40,y+12,90,isStar?10:13,\"193;224;255\",true);","      for(let n=0;n<cfg.MaxLevel;n++)panel(\"progress\"+i+\"_\"+n,x+12+n*23,y+46,20,8,n<level?\"151;232;255\":\"112;93;146\",\"SelectedProgressBlock\",3);","      const icon=ui.ensure(\"icon\"+i,\"StarUpgradeIcon\",3);icon.setAnimationName(upgrade.Icon);icon.setWidth(72);icon.setHeight(72);icon.setPosition(x+34,y+61);icon.setOpacity(locked?165:255);icon.hide(false);","      const title=upgrade.Name;","      const name=text(\"upgradeName\"+i,title,x+10,y+138,120,12,\"237;224;255\",true);name.setTextAlignment(\"center\");","      const desc=text(\"description\"+i,upgrade.Description,x+10,y+174,120,11,\"184;174;208\");desc.setTextAlignment(\"center\");","      panel(\"purchase\"+i,x+10,y+222,120,34,locked?\"130;105;157\":\"255;255;255\",\"SelectedPanelPlaque\",3);","      const status=max?\"MAX LEVEL\":locked?\"LOCKED\":upgrade.Cost+\" GOLD\";","      const label=text(\"cost\"+i,status,x+14,y+232,112,12,locked?\"201;181;224\":!max&&!affordable?\"255;130;164\":\"229;226;255\",true);label.setTextAlignment(\"center\");","      if(locked) {","        panel(\"lockBody\"+i,x+63,y+202,14,12,\"168;147;211\",\"SelectedProgressBlock\",4);","        panel(\"lockLeft\"+i,x+65,y+195,2,9,\"168;147;211\",\"SelectedProgressBlock\",4);","        panel(\"lockTop\"+i,x+65,y+194,10,2,\"168;147;211\",\"SelectedProgressBlock\",4);","        panel(\"lockRight\"+i,x+73,y+195,2,9,\"168;147;211\",\"SelectedProgressBlock\",4);","        panel(\"lockHole\"+i,x+69,y+205,2,5,\"42;29;65\",\"SelectedProgressBlock\",5);","      }","      ui.cards.push({path:i+1,level,locked,max,affordable,background,icon,name,cost:label});","    });","    if(scene.__fusion?.eligible(tower)){","      ui.fusionButton=panel('fusion',16,584,288,26,hover==='Fusion'?'207;222;255':'255;255;255','SelectedPanelPlaque',3);","      text('fusionLabel','FUSION  /  CELESTIAL ASCENSION',35,592,260,11,'207;224;255',true);","    }else{ui.fusionButton=null;text(\"lockHint\",\"Specialization caps the other path at Lv2.\",24,593,272,11,\"167;151;195\");}","  } else{","    ui.fusionButton=null;text('fusionIdentity','PURE FUSION / STARBURST',32,302,260,15,'198;223;255',true);","    text('fusionInfo','Heavy core + rapid release\\nThree alternating muzzle positions\\nSmall impact splash\\nNo further upgrades',32,344,260,14,'204;188;228');","    text(\"none\",\"ASCENSION COMPLETE\",55,462,240,14,\"174;214;239\",true);","  }","  const investment=v.get(\"TotalInvestment\").getAsNumber()||v.get(\"PurchasePrice\").getAsNumber();","  const sellValue=Math.floor(investment*sv.get(\"SellRefundRate\").getAsNumber()+(isStar?1e-8:0));v.get(\"SellValue\").setNumber(sellValue);","  panel(\"sell\",16,h-66,w-32,48,hover===\"Sell\"?\"187;222;255\":\"255;255;255\",\"SelectedPanelPlaque\",3);","  text(\"sellText\",\"SELL\",30,h-49,90,14,\"230;222;255\",true);","  const sell=text(\"sellValue\",sellValue+\" GOLD\",154,h-49,132,14,\"230;222;255\",true);sell.setTextAlignment(\"right\");","  text(\"hint\",\"Empty map / ESC to close\",83,h-14,220,10,\"161;146;185\");","};"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Each removable prop owns its native visual, blocker, shadow and stable runtime ID.","const scene=runtimeScene,sv=scene.getVariables(),get=n=>scene.getObjects(n),p=scene.__freePlacement;","let ui=scene.__obstaclePanel;","if(!ui){"," ui=scene.__obstaclePanel={objects:{},wasDown:false,pressed:'',pressedOwner:0,message:''};"," ui.ensure=(key,name,z)=>{if(!ui.objects[key]){const o=scene.createObject(name);o.setLayer('ObstacleUI');o.setZOrder(z);ui.objects[key]=o;}return ui.objects[key];};"," ui.owner=()=>get('Ground_Decoration').find(o=>o.getUniqueId()===sv.get('SelectedObstacleId').getAsNumber()&&o.getVariables().get('EnvironmentCategory').getAsString()==='RemovableObstacle');"," ui.close=()=>{sv.get('SelectedObstacleId').setNumber(0);ui.message='';ui.screenRect=null;scene.getLayer('ObstacleUI').show(false);};"," ui.select=o=>{sv.get('SelectedTower').setNumber(0);sv.get('SelectedObstacleId').setNumber(o.getUniqueId());ui.message='';ui.render();};"," ui.classify=()=>{","  const placement=scene.__freePlacement,outline=scene.__islandSurfacePolygon;if(!placement||!outline)return;","  const left=outline[0],top=outline[1],right=outline[2],bottom=outline[5];","  for(const o of get('Ground_Decoration')){","   const v=o.getVariables(),c=placement.blockedCircle(o),interior=c.x-c.r>=left+8&&c.x+c.r<=right-8&&c.y-c.r>=top+8&&c.y+c.r<=bottom-8;","   v.get('ObstacleId').setNumber(o.getUniqueId());","   v.get('EnvironmentCategory').setString(v.get('Blocking').getAsBoolean()&&interior?'RemovableObstacle':'PermanentEnvironment');","  }","  for(const name of ['SpawnMarker','BaseMarker','Monster_Path','IslandCliffFrame','VoidBackdrop','Ground_Map'])for(const o of get(name))o.getVariables().get('EnvironmentCategory').setString('PermanentEnvironment');"," };"," ui.clear=()=>{","  const o=ui.owner();if(!o)return false;","  if(sv.get('Money').getAsNumber()<250){ui.message='INSUFFICIENT GOLD';return false;}","  const id=o.getUniqueId();sv.get('Money').sub(250);ui.close();","  o.deleteFromScene();const ring=scene.__blockedBuildRings?.get(id);if(ring){ring.deleteFromScene();scene.__blockedBuildRings.delete(id);}","  // Other owners' circles remain in the fresh blocker list, including overlaps.","  scene.__freePlacement.refresh();return true;"," };"," ui.render=()=>{","  Object.values(ui.objects).forEach(o=>o.hide());const owner=ui.owner(),layer=scene.getLayer('ObstacleUI');","  layer.show(!!owner);if(!owner){ui.screenRect=null;return;}","  const game=scene.getGame(),area=scene.__towerShopUI.gameArea,w=284,h=222,margin=8;","  const hud=get('HUDPanel')[0],hl=scene.getLayer('UI'),hudBottom=hl.convertInverseCoords(hud.getX(),hud.getY()+hud.getHeight(),0,[0,0])[1];","  const s=Math.max(.01,Math.min(1,(area.right-area.left-2*margin)/w,(game.getGameResolutionHeight()-hudBottom-3*margin)/h));","  const [ox,oy]=scene.getLayer('').convertInverseCoords(owner.getCenterXInScene(),owner.getCenterYInScene(),0,[0,0]);","  const x=Math.max(area.left+margin,Math.min(area.right-margin-w*s,ox+w*s<area.right-margin?ox+20:ox-20-w*s));","  const y=Math.max(hudBottom+margin,Math.min(game.getGameResolutionHeight()-margin-h*s,oy-h*s/2));","  layer.setCameraZoom(s);layer.setCameraX(game.getGameResolutionWidth()/2/s-x/s);layer.setCameraY(game.getGameResolutionHeight()/2/s-y/s);","  ui.screenRect={x,y,w:w*s,h:h*s};","  const panel=(k,x,y,w,h,name='SelectedPanelPlaque',color='255;255;255',z=2)=>{const o=ui.ensure(k,name,z);o.setPosition(x,y);o.setWidth(w);o.setHeight(h);o.setColor(color);o.hide(false);};","  const text=(k,t,x,y,w,size,color='234;224;255',bold=false,align='left')=>{const o=ui.ensure(k,'SelectedPanelText',5);o.setPosition(x,y);o.setWrapping(true);o.setWrappingWidth(w);o.setString(t);o.setCharacterSize(size);o.setBold(bold);o.setColor(color);o.setTextAlignment(align);o.hide(false);};","  const kind=owner.getVariables().get('Kind').getAsString(),title={Crystal:'ANCIENT CRYSTAL',Rock:'CELESTIAL ROCK',Ruin:'BROKEN RUINS'}[kind]||'SOLID OBSTACLE';","  panel('frame',0,0,w,h,'SelectedPanelBackground');panel('header',10,10,w-20,38);","  text('title',title,20,22,w-60,14,'236;225;255',true);text('close','X',w-34,22,18,13,'185;167;214',true);","  text('description','This obstacle blocks tower placement.',20,62,w-40,13);","  text('message',ui.message||'Clear this space for your defenses.',20,104,w-40,11,ui.message?'255;127;160':'174;161;199');","  panel('clear',16,132,w-32,38,'SelectedPanelPlaque',ui.hover==='Clear'?'211;230;255':'255;255;255');","  text('clearLabel','CLEAR  -  250 GOLD',24,145,w-48,13,'236;228;255',true,'center');","  panel('cancel',16,180,w-32,28,'SelectedPanelPlaque','166;151;194');","  text('cancelLabel','CANCEL',24,188,w-48,11,'235;222;255',true,'center');"," };","}","ui.classify();","const ghost=get('TilePlacement_Indicator')[0],input=scene.getGame().getInputManager(),down=input.isMouseButtonPressed(0);","if(!ui.owner()||sv.get('IndexBlocksInput').getAsBoolean()||(ghost&&!ghost.isHidden())||sv.get('TowerShopRequestedType').getAsString()||gdjs.evtTools.input.wasKeyJustPressed(scene,'Escape'))ui.close();","ui.render();const mx=gdjs.evtTools.input.getCursorX(scene,'ObstacleUI',0),my=gdjs.evtTools.input.getCursorY(scene,'ObstacleUI',0),inside=(x,y,w,h)=>mx>=x&&mx<x+w&&my>=y&&my<y+h;","const owner=ui.owner(),pointer=!!owner&&inside(0,0,284,222);","sv.get('ObstaclePanelPointerInside').setBoolean(pointer);","sv.get('TowerUIConsumesClick').setBoolean(sv.get('TowerUIConsumesClick').getAsBoolean()||pointer);","ui.hover=!pointer?'':inside(16,132,252,38)?'Clear':inside(16,180,252,28)?'Cancel':inside(246,10,28,38)?'Close':'Panel';","if(down&&!ui.wasDown){ui.pressed=ui.hover;ui.pressedOwner=owner?owner.getUniqueId():0;}","if(!sv.get('AudioUIConsumesClick').getAsBoolean()&&!down&&ui.wasDown&&owner&&ui.pressed===ui.hover&&ui.pressedOwner===owner.getUniqueId()){"," if(ui.hover==='Clear')ui.clear();else if(['Cancel','Close'].includes(ui.hover))ui.close();"," ui.render();","}","if(!down)ui.pressed='';ui.wasDown=down;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[]},{"colorB":109,"colorG":143,"colorR":90,"creationTime":0,"name":"Monster path initialization","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::Or"},"parameters":[],"subInstructions":[{"type":{"value":"SceneJustBegins"},"parameters":[""]},{"type":{"value":"BooleanVariable"},"parameters":["MapRouteDirty","True",""]}]}],"actions":[],"events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// The scene's Monster_Path instances are the only source of route geometry.","const tiles = runtimeScene.getObjects(\"Monster_Path\").slice().sort((a, b) =>","  a.getVariables().get(\"PathOrder\").getAsNumber() - b.getVariables().get(\"PathOrder\").getAsNumber());","if (tiles.length < 2) throw new Error(\"Monster_Path needs a spawn tile and an end tile.\");","const route = runtimeScene.getVariables().get(\"MonsterPathPoints\");","route.clearChildren();","for (let i = 0; i < tiles.length; i++) {","  const tile = tiles[i];","  if (tile.getVariables().get(\"PathOrder\").getAsNumber() !== i)","    throw new Error(\"Monster_Path PathOrder must be unique and consecutive, starting at 0.\");","  if (i > 0) {","    const prev = tiles[i - 1];","    const dx = Math.abs(tile.getCenterXInScene() - prev.getCenterXInScene());","    const dy = Math.abs(tile.getCenterYInScene() - prev.getCenterYInScene());","    const horizontal = dy < 0.001 && dx > 0.001 && dx <= (tile.getWidth() + prev.getWidth()) / 2 + 0.001;","    const vertical = dx < 0.001 && dy > 0.001 && dy <= (tile.getHeight() + prev.getHeight()) / 2 + 0.001;","    if (!horizontal && !vertical) throw new Error(\"Monster_Path tiles must form a continuous, cardinal route.\");","  }","  const point = route.getChild(i);","  point.getChild(\"X\").setNumber(tile.getCenterXInScene());","  point.getChild(\"Y\").setNumber(tile.getCenterYInScene());","}","runtimeScene.getVariables().get(\"MonsterPathPointCount\").setNumber(tiles.length);","runtimeScene.getVariables().get(\"MapRouteDirty\").setBoolean(false);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}]}],"parameters":[]},{"colorB":109,"colorG":143,"colorR":90,"creationTime":0,"name":"Tower selection and selling","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Selection silhouettes are independent of placement/range circles and logical sprite bounds.","const scene=runtimeScene,sv=scene.getVariables(),p=scene.__freePlacement,input=scene.getGame().getInputManager();","const down=input.isMouseButtonPressed(0),pressed=down&&!sv.get('TowerPointerWasDown').getAsBoolean();","let pick=scene.__worldSelection;","if(!pick){"," const geometry=sv.get('SelectionGeometry').toJSObject();"," pick=scene.__worldSelection={geometry};"," pick.hitPolygon=(x,y,points,padding=3)=>scene.__freePlacement.polygon(x,y,padding,points);"," pick.spritePoints=(o,scale,hull)=>{","  const r=o.getAngle()*Math.PI/180,c=Math.cos(r),s=Math.sin(r),w=o.getWidth()*scale,h=o.getHeight()*scale;","  const x=o.getCenterXInScene(),y=o.getCenterYInScene();","  return hull.map(([a,b])=>[x+(a-.5)*w*c-(b-.5)*h*s,y+(a-.5)*w*s+(b-.5)*h*c]);"," };"," pick.towerHit=(o,x,y)=>{","  const visual=scene.__starCannon?.visual(o);if(!visual)return false;","  return ['Base','Turret'].some(part=>pick.hitPolygon(x,y,scene.__starCannon.componentPoints(o,part,visual.meta[part].Hull)));"," };"," pick.obstacleHit=(o,x,y)=>{","  const kind=o.getVariables().get('Kind').getAsString(),hull=geometry.Ground_Decoration?.[kind]?.Hull;if(!hull)return false;","  const scale=(scene.__worldStyle.props[kind]||1)*(o.getVariables().get('LocalScale').getAsNumber()||1);","  return pick.hitPolygon(x,y,pick.spritePoints(o,scale,hull));"," };","}","if(!pressed||!p||scene.__fusion?.active)return;","if(sv.get('AudioUIConsumesClick').getAsBoolean()||sv.get('IndexBlocksInput').getAsBoolean()||sv.get('TowerUIConsumesClick').getAsBoolean()||sv.get('SelectedPanelPointerInside').getAsBoolean()||sv.get('ObstaclePanelPointerInside').getAsBoolean())return;","const [x,y]=p.cursor(),screen=scene.getLayer('').convertInverseCoords(x,y,0,[0,0]),area=scene.__towerShopUI.gameArea;","if(screen[0]<area.left||screen[0]>=area.right||screen[1]<area.top||screen[1]>=area.bottom)return;","const hud=scene.getObjects('HUDPanel')[0],hl=scene.getLayer('UI'),a=hl.convertInverseCoords(hud.getX(),hud.getY(),0,[0,0]),b=hl.convertInverseCoords(hud.getX()+hud.getWidth(),hud.getY()+hud.getHeight(),0,[0,0]);","if(screen[0]>=a[0]&&screen[0]<=b[0]&&screen[1]>=a[1]&&screen[1]<=b[1])return;","if(p.active||!scene.getObjects('TilePlacement_Indicator')[0].isHidden())return;","const tower=p.towers().filter(o=>pick.towerHit(o,x,y)).sort((a,b)=>b.getZOrder()-a.getZOrder())[0];","if(tower){scene.__obstaclePanel?.close();sv.get('SelectedTower').setNumber(tower.getVariables().get('TowerId').getAsNumber());return;}","const obstacle=scene.getObjects('Ground_Decoration').filter(o=>o.getVariables().get('EnvironmentCategory').getAsString()==='RemovableObstacle'&&pick.obstacleHit(o,x,y)).sort((a,b)=>b.getZOrder()-a.getZOrder())[0];","sv.get('SelectedTower').setNumber(0);","if(obstacle)scene.__obstaclePanel.select(obstacle);else scene.__obstaclePanel?.close();"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::ForEach","object":"PlaceableTile","conditions":[{"type":{"value":"NumberObjectVariable"},"parameters":["PlaceableTile","TowerId","=","0"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["NextTowerId","+","1"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["PlaceableTile","TowerId","=","NextTowerId"]},{"type":{"value":"ZOrder"},"parameters":["PlaceableTile","=","2"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"KeyFromTextJustPressed"},"parameters":["","\"Escape\""]},{"type":{"value":"BooleanVariable"},"parameters":["IndexBlocksInput","False",""]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["SelectedTower","=","0"]},{"type":{"value":"Hide"},"parameters":["TilePlacement_Indicator"]},{"type":{"value":"EffectCapability::EffectBehavior::EnableEffect"},"parameters":["TileType_Button","Effect","\"Outline\"",""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"MouseButtonFromTextPressed"},"parameters":["","\"Left\""]}],"actions":[{"type":{"value":"SetBooleanVariable"},"parameters":["TowerPointerWasDown","True",""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"inverted":true,"value":"MouseButtonFromTextPressed"},"parameters":["","\"Left\""]}],"actions":[{"type":{"value":"SetBooleanVariable"},"parameters":["TowerPointerWasDown","False",""]}]}],"parameters":[]},{"aiGeneratedEventId":"01M48XHDR72FVAPY3A0DBSQ22K","type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"SceneJustBegins"},"parameters":[""]}],"actions":[{"type":{"value":"EffectCapability::EffectBehavior::EnableEffect"},"parameters":["TileType_Button","Effect","\"Outline\"",""]},{"type":{"value":"Hide"},"parameters":["TilePlacement_Indicator"]}]},{"aiGeneratedEventId":"01M48YAZAMDTA5NH22ZJ44RA41","type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringObjectVariable"},"parameters":["TileType_Button","TowerType","=","TowerShopRequestedType"]},{"type":{"value":"BooleanVariable"},"parameters":["TowerUIConsumesClick","False",""]},{"type":{"value":"BooleanVariable"},"parameters":["TowerShopPointerInside","True",""]},{"type":{"value":"BooleanVariable"},"parameters":["IndexBlocksInput","False",""]}],"actions":[],"events":[{"aiGeneratedEventId":"01M48YBZJAA1WDCYJXPGSF4W59","type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"inverted":true,"value":"EffectCapability::EffectBehavior::IsEffectEnabled"},"parameters":["TileType_Button","Effect","\"Outline\""]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["SelectedTower","=","0"]},{"type":{"value":"EffectCapability::EffectBehavior::EnableEffect"},"parameters":["TileType_Button","Effect","\"Outline\"",""]},{"type":{"value":"Show"},"parameters":["TilePlacement_Indicator",""]},{"type":{"value":"AnimatableCapability::AnimatableBehavior::SetName"},"parameters":["TilePlacement_Indicator","Animation","=","TileType_Button.VariableString(TowerType)"]},{"type":{"value":"ChangeWidth"},"parameters":["TilePlacement_Indicator","=","64"]},{"type":{"value":"ChangeHeight"},"parameters":["TilePlacement_Indicator","=","64"]},{"type":{"value":"SetBooleanVariable"},"parameters":["ButtonChanged","True",""]}],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"PickAllInstances"},"parameters":["","TileType_Button"]}],"actions":[{"type":{"value":"EffectCapability::EffectBehavior::EnableEffect"},"parameters":["TileType_Button","Effect","\"Outline\"",""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"EffectCapability::EffectBehavior::EnableEffect"},"parameters":["TileType_Button","Effect","\"Outline\"","yes"]}]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"EffectCapability::EffectBehavior::IsEffectEnabled"},"parameters":["TileType_Button","Effect","\"Outline\""]},{"type":{"value":"BooleanVariable"},"parameters":["ButtonChanged","=",""]}],"actions":[{"type":{"value":"EffectCapability::EffectBehavior::EnableEffect"},"parameters":["TileType_Button","Effect","\"Outline\"",""]},{"type":{"value":"Hide"},"parameters":["TilePlacement_Indicator"]}]}],"variables":[{"name":"ButtonChanged","type":"boolean","value":false}]},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Shared validator for free world-space placement. Rendering tiles never snap towers.","const scene=runtimeScene,sv=scene.getVariables(),get=n=>scene.getObjects(n);","let p=scene.__freePlacement;","if(!p){"," p=scene.__freePlacement={wasDown:false,active:false,type:'',rightWasDown:false};"," const feedback=p.feedback={config:sv.get('PlacementFeedbackConfig').toJSObject(),now:0,next:0,remaining:0,cost:0,shown:0,sounds:0};"," p.rejectGold=cost=>{","  feedback.cost=cost;if(feedback.now<feedback.next)return false;","  feedback.next=feedback.now+feedback.config.Cooldown;feedback.remaining=feedback.config.Duration;feedback.shown++;","  if(scene.__audio?.play(feedback.config.Sound))feedback.sounds++;return true;"," };"," p.paintGold=()=>{","  const scale=scene.getTimeManager().getTimeScale(),dt=scale>0?Math.max(0,scene.getTimeManager().getElapsedTime()/scale/1000):0;feedback.now+=dt;feedback.remaining=Math.max(0,feedback.remaining-dt);","  if(!p.active||sv.get('Money').getAsNumber()>=feedback.cost||sv.get('FusionActive').getAsBoolean())feedback.remaining=0;","  const money=get('MoneyText')[0],hud=get('HUDPanel')[0];","  if(feedback.root)feedback.root.visible=false;","  if(money&&feedback.moneyColor!==undefined)money.setColor(feedback.moneyColor);","  if(!feedback.remaining||!money||!hud)return;","  if(feedback.moneyColor===undefined)feedback.moneyColor=money.getColor();","  if(!feedback.root){","   const root=feedback.root=new PIXI.Container();root.interactive=false;root.interactiveChildren=false;root.zIndex=30010;scene.getLayer('UI').getRenderer().getRendererObject().addChild(root);","   const title=feedback.title=new PIXI.Text('NOT ENOUGH GOLD',{fontFamily:'Arial',fontSize:10,fontWeight:'bold',fill:0xffa1a8,stroke:0x100c24,strokeThickness:2}),detail=feedback.detail=new PIXI.Text('',{fontFamily:'Arial',fontSize:10,fill:0xffd1d5,stroke:0x100c24,strokeThickness:2});title.position.set(0,0);detail.position.set(0,13);root.addChild(title,detail);","  }","  feedback.detail.text='Need '+Math.max(0,Math.ceil(feedback.cost-sv.get('Money').getAsNumber()))+' More Gold';","  const age=feedback.config.Duration-feedback.remaining,smooth=x=>{x=Math.max(0,Math.min(1,x));return x*x*(3-2*x);};","  // Follow the native HUD, never the shop list or a fixed screen coordinate.","  const x=money.getX(),y=hud.getY()+hud.getHeight()+4;","  feedback.root.position.set(x,y);feedback.root.scale.set(1);feedback.root.alpha=smooth(age/.10)*smooth(feedback.remaining/.22);feedback.root.visible=true;","  money.setColor(Math.sin(age*26)>0?'255;140;152':feedback.moneyColor);","  const corner=scene.getLayer('UI').convertInverseCoords(x,y,0,[0,0]);feedback.screenRect={x:corner[0],y:corner[1],w:feedback.root.width,h:feedback.root.height};"," };"," if(!gdjs.__placementGoldFeedbackCallbacks){gdjs.__placementGoldFeedbackCallbacks=true;gdjs.callbacksRuntimeScenePostEvents.push(s=>s.__freePlacement?.paintGold());gdjs.callbacksRuntimeSceneUnloading.push(s=>s.__freePlacement?.feedback.root?.destroy({children:true}));}"," p.stop=()=>{","  p.active=false;p.type='';get('TilePlacement_Indicator').forEach(o=>o.hide());","  if(scene.__placementBaseRing)scene.__placementBaseRing.hide();","  if(scene.__placementRange)scene.__placementRange.hide();","  if(scene.__towerBaseRings)for(const ring of scene.__towerBaseRings.values())ring.hide();","  if(scene.__blockedBuildRings)for(const ring of scene.__blockedBuildRings.values())ring.hide();","  sv.get('PlacementValid').setBoolean(false);sv.get('MapPlacementFits').setBoolean(false);","  sv.get('TowerCost').setNumber(0);sv.get('TowerShopRequestedType').setString('');sv.get('PlacementBlockReason').setString('');","  if(p.preview){p.preview.valid=false;p.preview.type='';}","  feedback.remaining=0;if(feedback.root)feedback.root.visible=false;","  get('TileType_Button').forEach(o=>{if(o.hasBehavior('Effect'))o.getBehavior('Effect').enableEffect('Outline',false);});"," };"," p.types=['StarCannonTower'];"," p.config=type=>p.types.includes(type)?sv.get('TowerFootprints').getChild(type).toJSObject():{};"," p.towers=()=>p.types.flatMap(get);"," p.offsets=type=>{const c=p.config(type);return [(c.AnchorX-.5)*c.Width*c.RenderScale,(c.AnchorY-.5)*c.Height*c.RenderScale];};"," // Persisted world placement center is authoritative; image centers never drive circles."," p.center=o=>[o.getVariables().get('FootprintX').getAsNumber(),o.getVariables().get('FootprintY').getAsNumber()];"," p.positionSprite=(o,type,x,y)=>{const c=p.config(type),[ox,oy]=p.offsets(type);o.setWidth(c.Width);o.setHeight(c.Height);o.setPosition(x-c.Width/2-ox,y-c.Height/2-oy);};"," p.radius=o=>o.getVariables().get('FootprintRadius').getAsNumber()||p.config(o.getName()).Radius;"," p.segment=(x,y,a,b)=>{const dx=b[0]-a[0],dy=b[1]-a[1],d=dx*dx+dy*dy,t=d?Math.max(0,Math.min(1,((x-a[0])*dx+(y-a[1])*dy)/d)):0;return Math.hypot(x-a[0]-t*dx,y-a[1]-t*dy);};"," p.polygon=(x,y,r,points)=>{","  let inside=false;","  for(let i=0,j=points.length-1;i<points.length;j=i++){","   const a=points[j],b=points[i];if(p.segment(x,y,a,b)<=r+0.04)return true;","   if((a[1]>y)!==(b[1]>y)&&x<(b[0]-a[0])*(y-a[1])/(b[1]-a[1])+a[0])inside=!inside;","  }return inside;"," };"," // SVG road ribbon: 64px outer stroke around radius-33 quarter arcs, clipped to each tile."," p.clip=(poly,axis,edge,greater)=>{","  const out=[];let a=poly.at(-1),ai=greater?a[axis]>=edge:a[axis]<=edge;","  for(const b of poly){const bi=greater?b[axis]>=edge:b[axis]<=edge;if(ai!==bi){const t=(edge-a[axis])/(b[axis]-a[axis]);out.push([a[0]+t*(b[0]-a[0]),a[1]+t*(b[1]-a[1])]);}if(bi)out.push(b);a=b;ai=bi;}return out;"," };"," p.roadSkin=skin=>{","  if(['H','V'].includes(skin))return [[0,0],[64,0],[64,64],[0,64]];","  let poly=[];","  const turns={NE:[65,-1,Math.PI/2,Math.PI],NW:[-1,-1,0,Math.PI/2],SE:[65,65,Math.PI,Math.PI*1.5],SW:[-1,65,-Math.PI/2,0]};","  if(turns[skin]){","   const [cx,cy,a,b]=turns[skin];for(let i=0;i<=64;i++){const t=a+(b-a)*i/64;poly.push([cx+65*Math.cos(t),cy+65*Math.sin(t)]);}","   for(let i=64;i>=0;i--){const t=a+(b-a)*i/64;poly.push([cx+Math.cos(t),cy+Math.sin(t)]);}","  }else{","   // Rounded cap plus half tile toward the neighbouring road.","   const side=skin.slice(4),rotation={E:0,S:Math.PI/2,W:Math.PI,N:-Math.PI/2}[side]||0;","   const local=[[66,0],[66,64],[32,64]];for(let i=1;i<=64;i++){const t=Math.PI/2+Math.PI*i/64;local.push([32+32*Math.cos(t),32+32*Math.sin(t)]);}poly=local.map(([x,y])=>[32+(x-32)*Math.cos(rotation)-(y-32)*Math.sin(rotation),32+(x-32)*Math.sin(rotation)+(y-32)*Math.cos(rotation)]);","  }","  for(const [a,e,g] of [[0,0,true],[0,64,false],[1,0,true],[1,64,false]])poly=p.clip(poly,a,e,g);return poly;"," };"," p.localRoads=new Map();"," // Normalised opaque contours follow each generated prop, including transparent corners."," p.obstacleShapes={","  Crystal:[[.55,.065],[.71,.26],[.72,.51],[.81,.49],[.90,.65],[.94,.77],[.85,.86],[.63,.94],[.40,.91],[.21,.83],[.09,.73],[.12,.63],[.16,.34],[.25,.29],[.40,.48],[.42,.21]],","  Rock:[[.18,.44],[.30,.38],[.32,.28],[.52,.24],[.64,.28],[.72,.43],[.79,.34],[.85,.50],[.93,.55],[.93,.65],[.80,.70],[.63,.76],[.42,.73],[.29,.69],[.11,.68],[.065,.60],[.11,.48]],","  Ruin:[[.5,.06],[.75,.16],[.9,.35],[.97,.55],[.86,.82],[.58,.96],[.29,.89],[.045,.62],[.12,.37],[.3,.16]]"," };"," // One authoritative circle definition drives validation and the displayed outline."," p.blockedCircle