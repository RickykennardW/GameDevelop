Fits\").setBoolean(fits && !overHUD);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"aiGeneratedEventId":"01M48Z56WMT06DXVY2HFVEAKRV","type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"Visible"},"parameters":["TilePlacement_Indicator"]},{"type":{"inverted":true,"value":"CollisionNP"},"parameters":["TilePlacement_Indicator","Monster_Path","","",""]},{"type":{"inverted":true,"value":"CollisionNP"},"parameters":["TilePlacement_Indicator","PlaceableTile","","",""]},{"type":{"inverted":true,"value":"IsCursorOnObject"},"parameters":["TileType_Button","","",""]},{"type":{"inverted":true,"value":"IsCursorOnObject"},"parameters":["TowerShopBox","","",""]},{"type":{"value":"NumberVariable"},"parameters":["Money",">=","TowerCost"]},{"type":{"value":"BooleanVariable"},"parameters":["MapPlacementFits","True",""]},{"type":{"inverted":true,"value":"CollisionNP"},"parameters":["TilePlacement_Indicator","MapEndpoints","","",""]}],"actions":[{"type":{"value":"ChangeColor"},"parameters":["TilePlacement_Indicator","\"0;255;0\""]}]},{"type":"BuiltinCommonInstructions::Else","conditions":[{"type":{"value":"Visible"},"parameters":["TilePlacement_Indicator"]}],"actions":[{"type":{"value":"ChangeColor"},"parameters":["TilePlacement_Indicator","\"255;0;0\""]}]}]},{"aiGeneratedEventId":"01M48VWVCAWVAC837GVWAXG07Z","type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"Visible"},"parameters":["TilePlacement_Indicator"]}],"actions":[],"events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const type = runtimeScene.getObjects(\"TilePlacement_Indicator\")[0].getAnimationName();","const item = runtimeScene.getVariables().get(\"TowerShopCatalog\").toJSObject().find(item => item.Type === type);","if (item) runtimeScene.getVariables().get(\"TowerCost\").setNumber(item.Cost);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,