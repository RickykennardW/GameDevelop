tomCollisionMask":[]}]}]},{"name":"Chapter4","useMultipleDirections":false,"directions":[{"looping":false,"timeBetweenFrames":0.1,"sprites":[{"hasCustomCollisionMask":true,"image":"assets/ui/campaign/chapter_4.svg","points":[],"originPoint":{"name":"origine","x":0.0,"y":0.0},"centerPoint":{"automatic":true,"name":"centre","x":0.0,"y":0.0},"customCollisionMask":[]}]}]},{"name":"Chapter5","useMultipleDirections":false,"directions":[{"looping":false,"timeBetweenFrames":0.1,"sprites":[{"hasCustomCollisionMask":true,"image":"assets/ui/campaign/chapter_5.svg","points":[],"originPoint":{"name":"origine","x":0.0,"y":0.0},"centerPoint":{"automatic":true,"name":"centre","x":0.0,"y":0.0},"customCollisionMask":[]}]}]}]}],"objectsFolderStructure":{"folderName":"__ROOT","children":[{"folderName":"CAMPAIGN","children":[{"objectName":"CampaignBackdrop"}]}]},"events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// A durable reset intent, not a save copy. Never clear unrelated preferences.","const resetGame=runtimeScene.getGame();","if(!resetGame.__freshStart){"," const data=resetGame.getSceneAndExtensionsData('Levels').sceneData;"," const config=new gdjs.VariablesContainer(data.variables).get('CampaignConfig').toJSObject();"," const service=resetGame.__freshStart={intentKey:'starfallBastionFreshStart.v1',keys:[config.StorageKey,'celestialVoidFusionDiscovery.v1','celestialVoidMonsterDiscovery.v1'],target:config.LevelsScene,pending:false,busy:false,error:'',resets:0};"," service.clearMemory=()=>{","  const c=resetGame.__campaign;","  if(c){c.save={Version:1,Completed:{},SelectTutorialDone:false,GameTutorialDone:false};c.active=null;c.chapter=config.Levels[0].Chapter;c.selected=config.Levels[0].Id;c.storageOK=true;}","  const a=resetGame.__fusionArchive;","  if(a){a.state={version:1,entries:{}};a.found.clear();a.queue.length=0;a.active=null;a.revision++;for(const k of Object.keys(a.stats))a.stats[k]=0;}","  resetGame.__celestialMonsterDiscoverySession?.resetForNewGame();","  delete resetGame.__celestialMonsterDiscovery;","  const order=resetGame.__celestialDiscoveryOrder;if(order){order.tickets.clear();order.next=0;}"," };"," service.commit=()=>{","  if(service.busy)return false;service.busy=true;service.error='';","  try{","   // Commit intent before the first removal. A crash or storage error is","   // completed forward on the next boot, before either archive/save loads.","   localStorage.setItem(service.intentKey,'1');","   if(localStorage.getItem(service.intentKey)!=='1')throw Error('Reset intent was not saved');","   service.pending=true;","   for(const key of service.keys){localStorage.removeItem(key);if(localStorage.getItem(key)!==null)throw Error('Progress data could not be cleared');}","   localStorage.removeItem(service.intentKey);","   if(localStorage.getItem(service.intentKey)!==null)throw Error('Reset could not be finalized');","   service.clearMemory();service.pending=false;service.resets++;return true;","  }catch(e){service.error='Fresh Start could not finish. Allow local storage, then retry.';return false;}","  finally{service.busy=false;}"," };"," service.leave=scene=>{","  // Native scene replacement unloads towers, projectiles, wave/currency state,","  // UI listeners and temporary placement. The existing Levels tutorial owns","  // the first-time flow; mission 1-1 then starts its own step-zero tutorial.","  scene.__devCheats?.close();scene.__fusion?.finish();scene.__freePlacement?.stop();scene.__obstaclePanel?.close();","  if(scene.__audio?.dirty)scene.__audio.persist();","  resetGame.__starfallMenuAudioReady=!!scene.__audio?.unlocked||!!resetGame.__starfallMenuAudioReady;","  gdjs.evtTools.runtimeScene.replaceScene(scene,service.target,false);"," };"," service.recovery=scene=>{","  if(service.overlay)return;","  // Only a failed, already-confirmed transaction uses this boot-time blocker.","  // DOM input remains available when the native game loop is paused.","  const overlay=service.overlay=document.createElement('div'),box=document.createElement('div'),title=document.createElement('strong'),message=document.createElement('p'),retry=document.createElement('button');","  overlay.setAttribute('data-celestial-reset-recovery','');overlay.setAttribute('role','alertdialog');overlay.setAttribute('aria-modal','true');overlay.setAttribute('aria-label','Fresh Start incomplete');","  Object.assign(overlay.style,{position:'fixed',inset:'0',zIndex:'3000',display:'grid',placeItems:'center',background:'#040617dd',padding:'16px',fontFamily:'Arial, sans-serif',color:'#ded7ed'});","  Object.assign(box.style,{maxWidth:'360px',padding:'22px',border:'1px solid #bd9b6a',borderRadius:'8px',background:'#101329'});title.textContent='Fresh Start incomplete';message.textContent=service.error+' Gameplay is held until the reset is complete.';retry.textContent='Retry Fresh Start';Object.assign(retry.style,{padding:'10px 14px',background:'#51304c',border:'1px solid #d6a08c',borderRadius:'4px',color:'#fff',cursor:'pointer'});","  box.append(title,message,retry);overlay.append(box);document.body.append(overlay);resetGame.pause(true);retry.focus();","  retry.onclick=()=>{if(!service.commit()){message.textContent=service.error;return;}overlay.remove();service.overlay=null;service.resumeScene=scene;resetGame.pause(false);};"," };"," try{service.pending=localStorage.getItem(service.intentKey)!==null;}catch(e){}"," if(service.pending){if(service.commit())service.leave(runtimeScene);else service.recovery(runtimeScene);}","}","// DOM retry runs outside scene events. Request the transition on the next native","// event frame so RuntimeScene does not discard an out-of-frame change request.","if(resetGame.__freshStart.resumeScene===runtimeScene){resetGame.__freshStart.resumeScene=null;resetGame.__freshStart.leave(runtimeScene);}"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// One persistent campaign owner; only this namespaced storage key is written.","const campaignGame=runtimeScene.getGame();","if(!campaignGame.__campaign){"," const config=runtimeScene.getVariables().get('CampaignConfig').toJSObject(),known=new Map(config.Levels.map(l=>[l.Id,l]));"," let saved={};try{saved=JSON.parse(localStorage.getItem(config.StorageKey)||'{}')||{};}catch(e){}"," const completed={};for(const level of config.Levels){if(!saved.Completed?.[level.Id])break;completed[level.Id]=true;}"," const c=campaignGame.__campaign={config,known,active:null,chapter:1,selected:'1-1',writes:0,save:{...saved,Version:1,Completed:completed,SelectTutorialDone:saved.SelectTutorialDone===true,GameTutorialDone:saved.GameTutorialDone===true}};"," c.frontier=()=>Math.min(config.Levels.length,Object.keys(c.save.Completed).length+1);"," c.chapterUnlocked=n=>Number.isInteger(n)&&n>=1&&n<=config.Chapters.length&&(n===1||!!c.save.Completed[config.Levels.find(l=>l.Chapter===n-1&&l.Boss)?.Id]);"," c.available=id=>known.has(id)&&known.get(id).Index<=c.frontier();"," c.persist=()=>{try{localStorage.setItem(config.StorageKey,JSON.stringify(c.save));c.storageOK=true;c.writes++;}catch(e){c.storageOK=false;}};"," c.launch=id=>{if(!c.available(id))return false;c.active=id;c.selected=id;c.chapter=known.get(id).Chapter;return true;};"," c.complete=run=>{","  if(!run||run!==run.scene.__campaignRun||run.level.Id!==c.active||!run.validVictory()||!c.available(c.active))return false;","  if(!c.save.Completed[c.active]){c.save.Completed[c.active]=true;c.persist();}return true;"," };"," c.tutorialDone=key=>{if(!c.save[key]){c.save[key]=true;c.persist();}};"," c.chapter=config.Levels[c.frontier()-1].Chapter;c.selected=config.Levels[c.frontier()-1].Id;","}","// PIXI is already the project's UI renderer. Text anchors are independent of","// decorative hover scaling, including at small physical viewport sizes.","if(!campaignGame.__campaignWidgets){"," campaignGame.__campaignWidgets=scene=>{","  const layer=scene.getLayer('CampaignUI'),root=new PIXI.Container();root.interactive=false;root.interactiveChildren=false;layer.getRenderer().getRendererObject().addChild(root);","  const u={scene,layer,root,down:scene.getGame().getInputManager().isMouseButtonPressed(0),pressed:'',hover:''};","  u.text=(value,size=14,color=0xc6c9e0,bold=false,parent=root)=>{const t=new PIXI.Text(value,{fontFamily:'Arial',fontSize:size,fill:color,fontWeight:bold?'bold':'normal',align:'center'});t.anchor.set(.5);parent.addChild(t);return t;};","  u.button=(id,label,parent=root)=>{const container=new PIXI.Container(),frame=new PIXI.Graphics();container.addChild(frame);parent.addChild(container);const text=u.text(label,14,0xe8e1d0,true,container);return{id,container,frame,text,enabled:true,visible:true};};","  u.place=(b,x,y,w,h,font=14)=>{b.container.position.set(x,y);b.rect={x:x-w/2,y:y-h/2,w,h};b.w=w;b.h=h;b.text.style.fontSize=font;b.text.position.set(0,0);};","  u.paint=(b,hot=false)=>{b.container.visible=b.visible!==false;const key=[b.w,b.h,hot,b.enabled].join(':');if(b.key===key)return;b.key=key;const g=b.frame;g.clear().lineStyle(1,hot?0xe4cf93:b.enabled?0x897658:0x3e3e55,.9).beginFill(hot?0x292343:0x11162b,b.enabled?.96:.65).drawRoundedRect(-b.w/2,-b.h/2,b.w,b.h,6).endFill();g.lineStyle(.7,0x747fae,.35).drawRoundedRect(-b.w/2+4,-b.h/2+4,b.w-8,b.h-8,3);b.text.alpha=b.enabled?1:.4;};","  u.input=buttons=>{const input=scene.getGame().getInputManager(),down=input.isMouseButtonPressed(0);if(scene.getVariables().get('DevUIConsumesClick').getAsBoolean()){u.hover='';u.pressed='';u.down=down;return'';}const x=gdjs.evtTools.input.getCursorX(scene,'CampaignUI',0),y=gdjs.evtTools.input.getCursorY(scene,'CampaignUI',0),hit=buttons.find(b=>b.visible!==false&&b.enabled!==false&&(b.hit?b.hit(x,y):b.rect&&x>=b.rect.x&&x<b.rect.x+b.rect.w&&y>=b.rect.y&&y<b.rect.y+b.rect.h));u.hover=hit?.id||'';if(down&&!u.down)u.pressed=u.hover;const action=!down&&u.down&&u.pressed===u.hover?u.hover:'';if(!down)u.pressed='';u.down=down;return action;};","  u.screen=()=>{const g=scene.getGame(),W=g.getGameResolutionWidth(),H=g.getGameResolutionHeight(),rect=g.getRenderer().getCanvas().getBoundingClientRect(),candidate=rect.width/W;if(Number.isFinite(candidate)&&candidate>0&&rect.width>=64&&rect.height>=64&&!document.hidden)u.lastDisplay=candidate;return{W,H,s:Math.min(W/1280,H/720,1.5),display:u.lastDisplay||1};};","  u.dispose=()=>{if(root.destroyed)return;const texts=[];const visit=n=>{if(n instanceof PIXI.Text)texts.push(n);else for(const c of n.children||[])visit(c);};visit(root);for(const text of texts)text.destroy({texture:true,baseTexture:true});root.destroy({children:true,texture:false,baseTexture:false});};return u;"," };","}"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Five chapters / one persistent service; all UI nodes are allocated once.","const scene=runtimeScene,game=scene.getGame(),C=game.__campaign,input=game.getInputManager();","let ui=scene.__levelsUI;","if(!ui){"," const u=game.__campaignWidgets(scene),destroyUI=u.dispose,first=!C.save.SelectTutorialDone;ui=scene.__levelsUI=Object.assign(u,{age:0,chapter:first?1:C.chapter,selected:first?'1-1':C.selected,stage:first?0:-1,transition:null,disposed:false,bgMix:1,notice:'',noticeAge:0});C.active=null;"," ui.bg=[scene.createObject('CampaignBackdrop'),scene.createObject('CampaignBackdrop')];ui.bg.forEach((o,i)=>{o.setLayer('');o.setZOrder(i);o.setAnimationName('Chapter'+ui.chapter);});ui.bgFront=0;"," ui.title=ui.text('GALACTIC CAMPAIGN',32,0xeee4c7,true);ui.subtitle=ui.text('STARFALL BASTION  /  CELESTIAL DEFENSE COMMAND',11,0xa8b9d3);"," ui.chapterTitle=ui.text('',25,0xe7dcbd,true);ui.description=ui.text('',13,0xb8bed8);ui.links=new PIXI.Graphics();ui.root.addChild(ui.links);"," ui.tabs=C.config.Chapters.map(ch=>{const b=ui.button('chapter'+ch.Id,'');b.name=ui.text(ch.ShortName.toUpperCase(),12,0xd2d4ea,true,b.container);return b;});"," ui.nodes=C.config.Levels.slice(0,5).map((_,i)=>{const container=new PIXI.Container(),frame=new PIXI.Graphics();container.addChild(frame);ui.root.addChild(container);const number=ui.text('',24,0xf0e5c8,true,container),state=ui.text('',10,0xb8b6db,false,container),boss=ui.text('BOSS',10,0xe6bc91,true,container);return{id:'level'+(i+1),container,frame,number,state,boss,enabled:true,visible:true};});"," ui.detailPanel=new PIXI.Graphics();ui.root.addChild(ui.detailPanel);ui.mission=ui.text('',19,0xe6ddc8,true);ui.details=ui.text('',12,0xb6c9e4);ui.hint=ui.text('',12,0xc0b8d3);"," ui.launch=ui.button('launch','LAUNCH MISSION');ui.back=ui.button('back','BACK');ui.progress=ui.text('',11,0xb8b3d0);ui.progressLine=new PIXI.Graphics();ui.root.addChild(ui.progressLine);ui.noticeText=ui.text('',12,0xf0c7a1);"," ui.coach=new PIXI.Container();ui.root.addChild(ui.coach);ui.shade=new PIXI.Graphics();ui.coach.addChild(ui.shade);ui.coachPanel=new PIXI.Graphics();ui.coach.addChild(ui.coachPanel);ui.coachTitle=ui.text('',17,0xf2e2b8,true,ui.coach);ui.coachBody=ui.text('',13,0xc7cbe0,false,ui.coach);ui.next=ui.button('next','CONTINUE',ui.coach);ui.skip=ui.button('skip','SKIP TUTORIAL',ui.coach);"," const gameplay=game.getSceneAndExtensionsData(C.config.GameplayScene).sceneData,conf=new gdjs.VariablesContainer(gameplay.variables).get('AudioConfig').toJSObject();ui.audioConfig=conf;ui.sound=scene.getSoundManager();ui.music=null;ui.unlocked=false;"," let saved=game.__celestialAudioSettings;try{if(!saved)saved=JSON.parse(localStorage.getItem(conf.StorageKey)||'null');}catch(e){}ui.settings=game.__celestialAudioSettings={Master:conf.Master,Music:conf.MusicVolume,UI:conf.UIVolume,SFX:conf.SFXVolume,MuteMusic:false,MuteSFX:false,...saved};"," ui.unlock=()=>{if(ui.disposed||ui.unlocked)return;if(typeof Howler!=='undefined')Howler.volume();const ctx=typeof Howler!=='undefined'?Howler.ctx:null;Promise.resolve(ctx?.state==='suspended'?ctx.resume():null).then(()=>{if(ui.disposed||!ctx||ctx.state!=='running')return;ui.unlocked=true;const s=ui.settings;if(!s.MuteMusic){ui.sound.playSoundOnChannel(conf.Music.SacredVoidTemple.File,1000,true,s.Master*s.Music/100,1);ui.music=ui.sound.getSoundOnChannel(1000);}}).catch(()=>{});};"," ui.cue=key=>{const s=ui.settings,d=conf.SFX[key];if(ui.unlocked&&!s.MuteSFX&&d)ui.sound.playSoundOnChannel(d.File,1020,false,s.Master*(key==='UIClick'?s.UI:s.SFX)/100*d.Gain,1);};"," document.addEventListener('pointerdown',ui.unlock);document.addEventListener('touchstart',ui.unlock,{passive:true});document.addEventListener('keydown',ui.unlock);if(game.__starfallMenuAudioReady)ui.unlock();"," ui.go=(target,id)=>{if(ui.transition)return false;if(id&&!C.launch(id))return false;ui.cue('UIClick');ui.transition={target,age:0};return true;};"," ui.chooseChapter=n=>{if(!C.chapterUnlocked(n)){ui.notice='Complete '+(n-1)+'-5 to unlock Chapter '+n;ui.noticeAge=3;ui.cue('InvalidAction');return false;}if(ui.chapter!==n){ui.chapter=C.chapter=n;ui.selected=C.config.Levels.find(l=>l.Chapter===n&&C.available(l.Id))?.Id||n+'-1';ui.bgFront=1-ui.bgFront;const o=ui.bg[ui.bgFront];o.setAnimationName('Chapter'+n);o.setZOrder(1);ui.bg[1-ui.bgFront].setZOrder(0);ui.bgMix=0;}return true;};"," ui.chooseLevel=id=>{if(!C.available(id)){ui.notice='Complete the previous mission to unlock '+id;ui.noticeAge=3;ui.cue('InvalidAction');return false;}ui.selected=C.selected=id;if(ui.stage===2)ui.stage=3;ui.cue('UIClick');return true;};"," ui.dispose=()=>{if(ui.disposed)return;ui.disposed=true;if(ui.transition)game.__starfallMenuAudioReady=ui.unlocked;document.removeEventListener('pointerdown',ui.unlock);document.removeEventListener('touchstart',ui.unlock);document.removeEventListener('keydown',ui.unlock);ui.music?.stop();destroyUI();const canvas=game.getRenderer().getCanvas();if(canvas)canvas.style.cursor='default';};"," if(!gdjs.__campaignSceneCallbacks){gdjs.__campaignSceneCallbacks=true;gdjs.callbacksRuntimeSceneUnloading.push(s=>{s.__levelsUI?.dispose();s.__campaignRun?.dispose();});}","}","const dt=Math.min(.1,Math.max(0,s