etAsBoolean(),category=scene.__unitIndex?.category||'Towers',selected=sv.get('SelectedTower').getAsNumber(),mode=sv.get('WaveMode').getAsString();","  if(!sv.get('DefeatActive').getAsBoolean()&&(index!==last.index||(index&&category!==last.category)||(mode!==last.mode&&wave===last.wave)))a.play('UIClick');","  if(selected>0&&selected!==last.selected)a.play('TowerSelect');","  if(flow!==a.flow){if(flow==='GAME_OVER'||flow==='VICTORY'){for(const v of a.voices)if(v.group==='low'){v.sound?.stop();v.end=0;}a.play(flow==='VICTORY'?'Victory':'GameOver');}a.flow=flow;}","  const mapping={MENU:'SacredVoidTemple',PREPARATION:'AncientGalaxyAmbience',NORMAL_COMBAT:'CosmicDefense',MILESTONE_COMBAT:'VoidAwakening',GAME_OVER:'',VICTORY:''};","  const song=mapping[flow];if(song!==a.desired||a.unlocked&&!a.music.some(s=>s.file)&&song)a.requestMusic(song);","  a.updateMusic(a.dt||0);","  if(a.goldPending&&a.now-a.goldStarted>=.35&&a.now-a.lastGold>=.8){a.play('GoldReward');a.stats.goldBatches++;a.lastGold=a.now;a.goldPending=0;}","  a.last={wave,reward,lives,index,category,selected,mode};a.draw();"," };"," a.dispose=()=>{if(a.disposed)return;a.disposed=true;for(const s of a.music)a.release(s);for(const v of a.voices)v.sound?.stop();for(const def of Object.values(config.SFX))manager.unloadAudio(def.File,false);for(const e of scene.getObjects('Enemy'))if(e.__audioOwner===a){e.unregisterDestroyCallback(e.__audioCleanup);e.__audioOwner=null;}for(const h of a.hooks)if(h.object[h.name]===h.wrapped)h.object[h.name]=h.original;document.removeEventListener('pointerdown',a.gesture);document.removeEventListener('keydown',a.gesture);document.removeEventListener('touchstart',a.gesture);};"," if(!gdjs.__celestialAudioCallbacks){gdjs.__celestialAudioCallbacks=true;gdjs.callbacksRuntimeScenePreEvents.push(s=>s.__audio?.pre());gdjs.callbacksRuntimeSceneUnloading.push(s=>s.__audio?.dispose());}"," // The first frame predates registration; later frames use the pre-event hook."," a.pre();","}","a.after();"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[]},{"colorB":0,"colorG":0,"colorR":0,"creationTime":0,"name":"Celestial sonar proximity warning","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Read-only route ETA observer. Native movement, damage, Lives and waves remain owners.","const scene=runtimeScene,sv=scene.getVariables(),game=scene.getGame();","let sonar=scene.__celestialSonar;","if(!sonar){"," const config=sv.get('CelestialSonarConfig').toJSObject();"," sonar=scene.__celestialSonar={config,state:'NORMAL',now:0,lastAlert:'NORMAL',nextSound:0,nextRepeat:0,nearest:null,count:0,disposed:false,sounds:{WARNING:0,CRITICAL:0}};"," sonar.stop=()=>{","  for(const voice of scene.__audio?.voices||[])if(voice.key===config.WarningSound||voice.key===config.CriticalSound){voice.sound?.stop();voice.end=0;}"," };"," const world=sonar.world=new PIXI.Graphics(),hud=sonar.hud=new PIXI.Graphics();world.interactive=false;hud.interactive=false;world.zIndex=19800;hud.zIndex=30009;scene.getLayer('').getRenderer().getRendererObject().addChild(world);scene.getLayer('UI').getRenderer().getRendererObject().addChild(hud);"," const mark=sonar.mark=new PIXI.Text('!',{fontFamily:'Arial',fontSize:12,fontWeight:'bold',fill:0xf4bd75});mark.interactive=false;mark.zIndex=30010;scene.getLayer('UI').getRenderer().getRendererObject().addChild(mark);mark.visible=false;"," sonar.estimate=(enemy,points,tail,scale)=>{","  const v=enemy.getVariables();if(enemy.getBehavior('Health').IsDead()||v.get('PathFinished').getAsBoolean()||v.get('EnemyState').getAsString()==='Dying')return null;","  const waypoint=Math.max(0,Math.floor(v.get('Waypoint').getAsNumber())),speed=v.get('MoveSpeed').getAsNumber();","  if(waypoint>=points.length||!Number.isFinite(speed)||speed<=.000001)return null;","  const point=points[waypoint],distance=Math.hypot(enemy.getCenterXInScene()-point.X,enemy.getCenterYInScene()-point.Y)+tail[waypoint];","  const g=enemy.__golemState,cast=g?.casting?Math.max(0,scene.__voidGolem.config.Skill.CastDuration-(scene.__voidGolem.frameTime-g.castStart)):0;","  const eta=(distance/speed+cast)/scale;if(!Number.isFinite(eta))return null;return{id:enemy.getUniqueId(),eta,distance,speed,cast};"," };"," sonar.paint=()=>{","  world.clear();hud.clear();mark.visible=false;if(sonar.state==='NORMAL')return;","  const end=sonar.points?.at(-1),base=scene.getObjects('BaseMarker')[0];if(!end||!base)return;","  const critical=sonar.state==='CRITICAL',color=critical?0xff7c94:0xe9ba70,period=critical?config.CriticalPeriod:config.WarningPeriod,phase=(sonar.now%period)/period,zoom=scene.getLayer('').getCameraZoom();","  const r=base.getWidth()*(scene.__worldStyle?.base||1)/2+10,reduced=config.ReducedMotion||typeof matchMedia==='function'&&matchMedia('(prefers-reduced-motion: reduce)').matches;","  for(let i=0;i<(critical?2:1);i++){","   const t=reduced?i*.35:(phase+i*.45)%1;world.lineStyle(1.2/zoom,color,reduced?.75:(1-t)*.72+.12).drawCircle(end.X,end.Y,r+(reduced?i*10:t*30));","  }","  // Different ring counts and notch patterns distinguish urgency beyond hue.","  for(let i=0;i<(critical?8:4);i++){const a=i*Math.PI/(critical?4:2),ra=r+3;world.lineStyle(1.5/zoom,color,.8).moveTo(end.X+Math.cos(a)*ra,end.Y+Math.sin(a)*ra).lineTo(end.X+Math.cos(a)*(ra+9),end.Y+Math.sin(a)*(ra+9));}","  const lives=scene.getObjects('LivesText')[0];if(lives){const x=lives.getX(),y=lives.getY(),w=lives.getWidth(),h=lives.getHeight();hud.lineStyle(1,color,.8).drawRoundedRect(x-4,y-2,w+8,h+4,5);if(critical)hud.lineStyle(1,color,.4).drawRoundedRect(x-6,y-4,w+12,h+8,6);mark.text=critical?'!!':'!';mark.style.fill=color;mark.position.set(x+w-7,y-10);mark.visible=true;}"," };"," sonar.update=()=>{","  if(sonar.disposed)return;const scale=scene.getTimeManager().getTimeScale(),elapsed=scene.getTimeManager().getElapsedTime();","  if(scale<=0||elapsed<=0)return;sonar.now+=Math.max(0,elapsed/scale/1000);","  const previous=sonar.state;sonar.nearest=null;sonar.count=0;","  if(config.Enabled&&!sv.get('GameOver').getAsBoolean()&&sv.get('Lives').getAsNumber()>0){","   const count=sv.get('MonsterPathPointCount').getAsNumber(),points=sv.get('MonsterPathPoints').toJSObject().slice(0,count),tail=new Array(points.length).fill(0);sonar.points=points;","   for(let i=points.length-2;i>=0;i--)tail[i]=tail[i+1]+Math.hypot(points[i+1].X-points[i].X,points[i+1].Y-points[i].Y);","   for(const enemy of scene.getObjects('Enemy')){const threat=sonar.estimate(enemy,points,tail,scale);if(!threat||threat.eta>config.WarningSeconds+(previous==='NORMAL'?0:config.HysteresisSeconds))continue;sonar.count++;if(!sonar.nearest||threat.eta<sonar.nearest.eta)sonar.nearest=threat;}","  }","  let desired=!sonar.nearest?'NORMAL':sonar.nearest.eta<=config.CriticalSeconds+(previous==='CRITICAL'?config.HysteresisSeconds:0)?'CRITICAL':'WARNING';","  // Immediate escalation/clear; small real-time debounce only for a live downgrade.","  if(previous==='CRITICAL'&&desired==='WARNING'){","   if(!sonar.downgradeAt)sonar.downgradeAt=sonar.now+config.DeescalationSeconds;","   if(sonar.now<sonar.downgradeAt)desired='CRITICAL';","  }else sonar.downgradeAt=0;","  sonar.state=desired;","  if(desired==='NORMAL'){","   if(previous!=='NORMAL')sonar.stop();","   sonar.nextRepeat=0;sonar.lastAlert='NORMAL';sonar.downgradeAt=0;","   // Keep the minimum audio gap across brief NORMAL periods, never the repeat.","  }else{","   const interval=desired==='CRITICAL'?config.CriticalRepeatSeconds:config.WarningRepeatSeconds;","   if(previous!==desired){","    if(desired==='CRITICAL')sonar.stop();","    sonar.nextRepeat=previous==='CRITICAL'?sonar.now+interval:sonar.now;","   }","   if(sonar.now>=sonar.nextSound&&sonar.now>=sonar.nextRepeat){","    // A single owned voice: escalation can replace Warning but never stack it.","    sonar.stop();","    const played=scene.__audio?.play(sonar.state==='CRITICAL'?config.CriticalSound:config.WarningSound);if(played)sonar.sounds[sonar.state]++;","    sonar.lastAlert=sonar.state;sonar.nextSound=sonar.now+config.GlobalCooldown;sonar.nextRepeat=sonar.now+interval;","   }","  }","  sonar.paint();"," };"," sonar.dispose=()=>{if(sonar.disposed)return;sonar.disposed=true;sonar.stop();world.destroy();hud.destroy();mark.destroy();};"," if(!gdjs.__celestialSonarCallbacks){gdjs.__celestialSonarCallbacks=true;gdjs.callbacksRuntimeSceneUnloading.push(s=>s.__celestialSonar?.dispose());}","}","sonar.update();"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[]},{"colorB":0,"colorG":0,"colorR":0,"creationTime":0,"name":"Starfall cinematic defeat","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// A loss-only overlay. Native Lives/Finish and victory rules remain authoritative.","const scene=runtimeScene,sv=scene.getVariables(),game=scene.getGame(),input=game.getInputManager();","let go=scene.__gameOverUI;","if(!go){"," const config=sv.get('GameOverUIConfig').toJSObject(),menuData=game.getSceneAndExtensionsData('MainMenu').sceneData;"," const hoverScale=new gdjs.VariablesContainer(menuData.variables).get('MenuConfig').getChild('HoverScale').getAsNumber();"," game.__starfallHoverStep ||= ((current,target,dt)=>current+(target-current)*(1-Math.exp(-dt*16)));"," go=scene.__gameOverUI={config,hoverScale,active:false,phase:'IDLE',age:0,wasDown:input.isMouseButtonPressed(0),armed:false,menuArmed:false,pressed:'',buttons:[],activations:0,continues:0,requests:0,disposed:false};"," const layer=scene.getLayer('GameOverUI'),parent=layer.getRenderer().getRendererObject();"," const root=go.root=new PIXI.Container();root.interactive=false;root.interactiveChildren=false;root.visible=false;root.zIndex=0;parent.addChild(root);"," const overlay=go.overlay=new PIXI.Graphics();root.addChild(overlay);"," const ornament=go.ornament=new PIXI.Graphics();root.addChild(ornament);"," const title=go.title=new PIXI.Text('GAME OVER',{fontFamily:'Georgia, serif',fontSize:52,fill:0xf0e7ed,letterSpacing:3,dropShadow:true,dropShadowColor:0x180919,dropShadowBlur:8,dropShadowDistance:1,dropShadowAlpha:.65});title.anchor.set(.5);root.addChild(title);"," const prompt=go.prompt=new PIXI.Text('CLICK TO CONTINUE',{fontFamily:'Arial',fontSize:11,letterSpacing:2,fill:0xd4becb});prompt.anchor.set(.5);root.addChild(prompt);"," const smooth=n=>{n=Math.max(0,Math.min(1,n));return n*n*(3-2*n);};"," const mix=(a,b,t)=>{let color=0;for(const shift of [16,8,0])color|=Math.round(((a>>shift)&255)*(1-t)+((b>>shift)&255)*t)<<shift;return color;};"," go.phaseTo=phase=>{go.phase=phase;sv.get('DefeatPhase').setString(phase);};"," go.block=()=>{","  if(!go.active)return;","  sv.get('GameOver').setBoolean(true);sv.get('DefeatActive').setBoolean(true);sv.get('WaveMode').setString('Waiting');","  sv.get('IndexOpen').setBoolean(false);sv.get('IndexBlocksInput').setBoolean(true);sv.get('TowerUIConsumesClick').setBoolean(true);sv.get('AudioUIConsumesClick').setBoolean(true);","  sv.get('PlayWaveRequested').setBoolean(false);sv.get('TowerShopRequestedType').setString('');","  scene.getTimeManager().setTimeScale(1);scene.getLayer('').setTimeScale(0);","  for(const name of ['IndexUI','IndexList','IndexDetail','SelectedTowerUI','ObstacleUI','FusionUI','DiscoveryUI','AudioUI'])scene.getLayer(name).show(false);","  if(scene.__towerShopUI)scene.__towerShopUI.indexRequested=false;"," };"," go.begin=()=>{","  if(go.active||sv.get('Lives').getAsNumber()>0)return false;","  go.active=true;go.activations++;go.age=0;go.wasDown=input.isMouseButtonPressed(0);go.armed=false;go.menuArmed=false;go.phaseTo('RED_FADE');","  if(scene.__fusion?.active)scene.__fusion.finish();scene.__freePlacement?.stop();scene.__obstaclePanel?.close();sv.get('SelectedTower').setNumber(0);","  if(scene.__audio){scene.__audio.ui.open=false;scene.__audio.ui.drag='';scene.__audio.ui.pressed='';if(scene.__audio.dirty)scene.__audio.persist();}","  for(const name of ['MessageText','WaveBannerPanel','WaveBannerTitle','WaveBannerDetail','WaveBannerReward'])for(const o of scene.getObjects(name))o.hide();","  const lives=scene.getObjects('LivesText')[0];if(lives)lives.setString(String(sv.get('Lives').getAsNumber()));","  for(const [id,frameName,labelName]of [['Restart','DefeatRestart','DefeatRestartLabel'],['MainMenu','DefeatMainMenu','DefeatMainMenuLabel']]){","   const frame=scene.createObject(frameName),label=scene.createObject(labelName);frame.setLayer('GameOverUI');label.setLayer('GameOverUI');frame.setZOrder(3);label.setZOrder(4);frame.hide();label.hide();go.buttons.push({id,frame,label,scale:1});","  }","  go.block();root.visible=true;layer.show(true);return true;"," };"," go.stopDefeatSound=()=>{for(const v of scene.__audio?.voices||[])if(v.key==='GameOver'){v.sound?.stop();v.end=0;}};"," go.leave=target=>{","  if(go.leaving||go.phase!=='MENU')return false;","  go.stopDefeatSound();scene.__audio?.play('UIClick');go.leaving={target,age:0};go.pressed='';go.phaseTo('LEAVING');","  game.__starfallMenuAudioReady=!!scene.__audio?.unlocked;return true;"," };"," go.paint=()=>{","  if(!go.active)return;","  const W=game.getGameResolutionWidth(),H=game.getGameResolutionHeight(),view=game.__celestialViewport;","  const scale=Math.min(W/1280,H/720,1.5),display=Math.min((view?.width||W)/W,(view?.height||H)/H),key=[W,H,view?.width,view?.height].join(':');","  layer.setCameraZoom(1);layer.setCameraX(W/2);layer.setCameraY(H/2);layer.show(true);","  if(go.layoutKey!==key){","   go.layoutKey=key;go.layoutCount=(go.layoutCount||0)+1;overlay.clear().beginFill(0xffffff).drawRect(0,0,W,H).endFill();","   ornament.clear().lineStyle(1,0xc2a5aa,.55).moveTo(-146,0).lineTo(-18,0).moveTo(18,0).lineTo(146,0).beginFill(0xd6b7bd,.7).drawPolygon([0,-4,4,0,0,4,-4,0]).endFill();","   title.style.fontSize=52*scale;title.style.letterSpacing=3*scale;prompt.style.fontSize=Math.max(11*scale,10/display);prompt.style.letterSpacing=1.5*scale;","   for(const b of go.buttons){b.label.setCharacterSize(Math.max(b.id==='Restart'?18:15,Math.ceil((b.id==='Restart'?12:11)/(scale*display))));b.label.setWrapping(true);b.label.setWrappingWidth(320);b.label.setTextAlignment('center');}","  }","  const black=go.blackStart!==undefined?smooth((go.age-go.blackStart)/config.BlackSeconds):0;","  go.blackProgress=black;go.overlayTint=mix(config.RedTint,config.BlackTint,black);overlay.tint=go.overlayTint;","  const red=config.InitialOpacity+(config.RedOpacity-config.InitialOpacity)*smooth(go.age/config.RedSeconds);","  overlay.alpha=(red*(1-black)+config.BlackOpacity*black)*Math.min(1,go.age/.12);","  if(go.leaving)overlay.alpha=config.BlackOpacity+(1-config.BlackOpacity)*smooth(go.leaving.age/config.LeaveSeconds);","  go.overlayOpacity=overlay.alpha;","  const reveal=smooth((go.age-config.RedSeconds)/config.TitleSeconds),ty=H/2-105*scale*black;","  title.position.set(W/2,ty);title.alpha=reveal;title.scale.set(.985+.015*reveal);","  prompt.position.set(W/2,H/2+60*scale);prompt.alpha=smooth((go.age-config.RedSeconds-config.TitleSeconds)/config.PromptSeconds)*(1-black);","  ornament.position.set(W/2,ty-49*scale);ornament.scale.set(scale);ornament.alpha=reveal*.75;","  const buttonsAlpha=go.blackStart===undefined?0:smooth((go.age-go.blackStart-config.BlackSeconds)/config.ButtonsSeconds);","  const mx=gdjs.evtTools.input.getCursorX(scene,'GameOverUI',0),my=gdjs.evtTools.input.getCursorY(scene,'GameOverUI',0);","  go.hover='';","  for(const [i,b]of go.buttons.entries()){","   b.x=W/2;b.y=H/2+(i?95:12)*scale;","   const current=320*scale*b.scale,height=72*scale*b.scale;","   const hot=go.phase==='MENU'&&mx>=b.x-current/2&&mx<b.x+current/2&&my>=b.y-height/2&&my<b.y+height/2;","   if(hot)go.hover=b.id;","   b.scale=game.__starfallHoverStep(b.scale,hot?hoverScale:1,go.dt||0);","   b.frame.setAnimationName(hot?'Hover':'Normal');b.frame.setScale(scale*b.scale);b.frame.setPosition(b.x-b.frame.getWidth()/2,b.y-b.frame.getHeight()/2);","   b.label.setScale(scale*b.scale);b.label.setPosition(b.x-160*scale*b.scale,b.y-b.label.getHeight()/2);","   for(const o of [b.frame,b.label]){o.hide(buttonsAlpha<=0);o.setOpacity(255*buttonsAlpha);}","   b.rect={x:b.frame.getX(),y:b.frame.getY(),w:b.frame.getWidth(),h:b.frame.getHeight()};","  }","  const canvas=game.getRenderer().getCanvas();if(canvas)canvas.style.cursor=go.hover||go.phase==='AWAIT_CONTINUE'?'pointer':'default';"," };"," go.pre=()=>{if(!go.active&&sv.get('Lives').getAsNumber()<=0)go.begin();go.block();};"," go.update=()=>{","  if(go.disposed)return;","  if(!go.active){if(sv.get('Lives').getAsNumber()<=0)go.begin();else return;}","  go.block();const t=scene.getTimeManager(),scale=t.getTimeScale();go.dt=scale>0?Math.min(.1,Math.max(0,t.getElapsedTime()/scale/1000)):0;go.age+=go.dt;","  const down=input.isMouseButtonPressed(0),fresh=down&&!go.wasDown,readyAt=config.RedSeconds+config.TitleSeconds+config.PromptSeconds;","  if(go.phase==='RED_FADE'&&go.age>=config.RedSeconds)go.phaseTo('TITLE');","  if(go.phase==='TITLE'&&go.age>=readyAt){go.phaseTo('AWAIT_CONTINUE');go.armed=!down;}","  if(go.phase==='AWAIT_CONTINUE'){","   if(!down)go.armed=true;","   if(fresh&&go.armed){go.continues++;go.blackStart=go.age;go.phaseTo('MENU_TRANSITION');scene.__audio?.play('UIClick');}","  }","  if(go.phase==='MENU_TRANSITION'&&go.age>=go.blackStart+config.BlackSeconds+config.ButtonsSeconds){go.phaseTo('MENU');go.menuArmed=!down;}","  go.paint();","  if(go.phase==='MENU'){","   if(!down)go.menuArmed=true;","   if(fresh&&go.menuArmed)go.pressed=go.hover;","   if(!down&&go.wasDown&&go.pressed&&go.pressed===go.hover)go.leave(go.pressed==='Restart'?scene.getName():'MainMenu');","   if(!down)go.pressed='';","  }","  if(go.leaving){go.leaving.age+=go.dt;if(go.leaving.age>=config.LeaveSeconds&&!go.leaving.requested){go.leaving.requested=true;go.requests++;gdjs.evtTools.runtimeScene.replaceScene(scene,go.leaving.target,false);}}","  go.wasDown=down;"," };"," go.dispose=()=>{if(go.disposed)return;go.disposed=true;go.stopDefeatSound();root.destroy({children:true});const canvas=game.getRenderer().getCanvas();if(canvas)canvas.style.cursor='default';};"," if(!gdjs.__starfallDefeatCallbacks){gdjs.__starfallDefeatCallbacks=true;gdjs.callbacksRuntimeScenePreEvents.push(s=>s.__gameOverUI?.pre());gdjs.callbacksRuntimeScenePostEvents.push(s=>{","  const g=s.getGame();if(g.__starfallMenuAudioReady&&s.__audio){delete g.__starfallMenuAudioReady;s.__audio.unlock();}","  s.__gameOverUI?.update();"," });gdjs.callbacksRuntimeSceneUnloading.push(s=>s.__gameOverUI?.dispose());}","}","// First-frame detection also covers a loss reached by the native Finish event.","if(!go.active&&sv.get('Lives').getAsNumber()<=0)go.begin();"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[]}],"layers":[{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"","renderingType":"","visibility":true,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0.0,"viewportBottom":1.0,"viewportLeft":0.0,"viewportRight":1.0,"viewportTop":0.0,"width":0.0}],"effects":[]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"UI","renderingType":"","visibility":true,"cameras":[],"effects":[]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"TowerShopList","renderingType":"","visibility":true,"cameras":[],"effects":[]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"SelectedTowerUI","renderingType":"","visibility":false,"cameras":[],"effects":[]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"IndexUI","renderingType":"","visibility":false,"cameras":[],"effects":[]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"IndexList","renderingType":"","visibility":false,"cameras":[],"effects":[]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"IndexDetail","renderingType":"","visibility":false,"cameras":[],"effects":[]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"ObstacleUI","renderingType":"","visibility":false,"cameras":[],"effects":[]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"AudioUI","renderingType":"","visibility":true,"cameras":[],"effects":[]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"DiscoveryUI","renderingType":"","visibility":true,"cameras":[],"effects":[]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":true,"name":"FusionUI","renderingType":"","visibility":false,"cameras":[],"effects":[]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"GameOverUI","renderingType":"","visibility":false,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0.0,"viewportBottom":1.0,"viewportLeft":0.0,"viewportRight":1.0,"viewportTop":0.0,"width":0.0}],"effects":[]}],"behaviorsSharedData":[{"name":"Animation","type":"AnimatableCapability::AnimatableBehavior"},{"name":"Effect","type":"EffectCapability::EffectBehavior"},{"name":"Flippable","type":"FlippableCapability::FlippableBehavior"},{"name":"Health","type":"Health::Health"},{"name":"Opacity","type":"OpacityCapability::OpacityBehavior"},{"name":"Resizable","type":"ResizableCapability::ResizableBehavior"},{"name":"Scale","type":"ScalableCapability::ScalableBehavior"},{"name":"Text","type":"TextContainerCapability::TextContainerBehavior"}]}],"externalEvents":[],"tests":[{"description":"Star Cannon selection toggles the single placement builder.","lastRunAt":0.0,"lastRunDurationMs":370.0,"lastRunFramesExecuted":20,"lastRunStatus":"not-run","name":"Picking Star Cannon","type":"gameplay","source":["// Picking a tile type in the toolbar shows what is about to be placed.","await harness.goToScene('Game Scene');","harness.watch('TilePlacement_Indicator');","","const getIndicator = () => harness.getObjects('TilePlacement_Indicator')[0];","await harness.stepFrames(5);","","harness.assert(","  getIndicator().hidden === true,","  'Nothing is about to be placed before a tile type is picked.'",");","","const buttons = harness.getObjects('TileType_Button');","harness.assert(buttons.length > 0, 'The toolbar has tile types to pick from.');","harness.assert(buttons.length === 1, \"Only Star Cannon is available.\");","const button = buttons[0];","console.log(","  'buttons=' + JSON.stringify(buttons.map((one) => one.animation)) +","    ' layer=' + JSON.stringify(button.layer)",");","","/** Click on a position of a layer. */","const clickAt = async (x, y, layerName) => {","  harness.setMousePosition(x, y, layerName);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false);","  await harness.stepFrames(3);","};","","await clickAt(button.centerX, button.centerY, button.layer);","const selected = getIndicator();","console.log(","  'afterPicking: hidden=' + selected.hidden + ' animation=' + JSON.stringify(selected.animation)",");","harness.assert(","  selected.hidden === false,","  'Picking a tile type shows what is about to be placed.'",");","harness.assert(","  selected.animation === button.animation,","  'What is about to be placed is the tile type that was picked (the indicator shows \"' +","    selected.animation + '\", the button is \"' + button.animation + '\").'",");","","// Picking it again turns it off.","await clickAt(button.centerX, button.centerY, button.layer);","console.log('afterPickingAgain: hidden=' + getIndicator().hidden);","harness.assert(","  getIndicator().hidden === true,","  'Picking the same tile type again stops placing.'",");"]}],"eventsFunctionsExtensions":[{"author":"@4ian","category":"Game mechanic","dimension":"","extensionNamespace":"","fullName":"Health points and damage","gdevelopVersion":">=5.5.222","helpPath":"","iconUrl":"data:image/svg+xml;base64,","name":"Health","previewIconUrl":"https://resources.gdevelop-app.com/assets/Icons/heart-half-full.svg","shortDescription":"Health/life system: damage, shield, armor, regeneration, cooldown, and over-healing.","version":"0.4.0","description":["Manage health (life) points, shield and armor of instances of an object. ","","It handles:","- Damage cooldown","- Health and shield regeneration","- Over healing","","It can be used on:","- Players","- Enemies","- NPCs","- Inanimate objects (for insance breakable doors or mining rocks)","","The top-down RPG example uses this extension ([open the project online](https://editor.gdevelop.io/?project=example://top-down-rpg))."],"origin":{"identifier":"Health","name":"gdevelop-extension-store"},"tags":["health","life","damage","hit","heal","shield","regeneration","armor"],"authorIds":["wWP8BSlAW0UP4NeaHa2LcmmDzmH2","xpwUwByyImTDcHEqDUqfyg0oRBt1","gqDaZjCfevOOxBYkK6zlhtZnXCg1"],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[],"eventsFunctionsFolderStructure":{"folderName":"__ROOT"},"eventsBasedBehaviors":[{"description":"Manage health (life) points, shield and armor.","fullName":"Health","helpPath":"","iconUrl":"","name":"Health","objectType":"","previewIconUrl":"","eventsFunctions":[{"fullName":"","functionType":"Action","name":"onCreated","sentence":"","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"ResetObjectTimer"},"parameters":["Object","\"__Health.TimeSinceLastHit\""]},{"type":{"value":"Health::Health::SetCurrentHealth"},"parameters":["Object","Behavior","Health",""]}]}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"Health::Health","type":"behavior"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"doStepPreEvents","sentence":"","events":[{"colorB":224,"colorG":16,"colorR":189,"creationTime":0,"name":"Health","source":"","type":"BuiltinCommonInstructions::Group","events":[{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"name":"Regeneration","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Health"},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["HealthRegenRate","!=","0"]},{"type":{"value":"NumberVariable"},"parameters":["CurrentHealth","<","Object.Behavior::MaxHealth()"]},{"type":{"value":"CompareObjectTimer"},"parameters":["Object","\"__Health.TimeSinceLastHit\"",">","HealthRegenDelay"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["CurrentHealth","+","HealthRegenRate * TimeDelta()"]}],"events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Correct any values above maximum limits"},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["CurrentHealth",">","Object.Behavior::MaxHealth()"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["CurrentHealth","=","MaxHealth"]}]}]}],"parameters":[]},{"colorB":228,"colorG":176,"colo