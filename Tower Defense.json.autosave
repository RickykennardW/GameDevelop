dren":[{"objectName":"ShopPlayButton"},{"objectName":"ShopPlayLabel"},{"objectName":"ShopPlayIcon"},{"objectName":"ShopIndexButton"},{"objectName":"ShopSpeedBadge"}]},{"folderName":"UpgradePanel","children":[{"objectName":"SelectedTowerPreview"},{"objectName":"StarUpgradeIcon"},{"objectName":"SelectedPanelBackground"},{"objectName":"SelectedPanelPlaque"},{"objectName":"SelectedUpgradeCard"},{"objectName":"SelectedPanelText"},{"objectName":"SelectedProgressBlock"}]},{"folderName":"Index","children":[{"objectName":"IndexPanel"},{"objectName":"IndexText"},{"objectName":"IndexTowerImage"},{"objectName":"IndexMonsterImage"},{"objectName":"Index_logo"},{"objectName":"IndexShowcase"}]},{"folderName":"Audio","children":[{"objectName":"AudioPanel"},{"objectName":"AudioText"},{"objectName":"AudioBlock"},{"objectName":"AudioSpeaker"}]},{"folderName":"GameOver","children":[{"objectName":"DefeatRestart"},{"objectName":"DefeatMainMenu"},{"objectName":"DefeatRestartLabel"},{"objectName":"DefeatMainMenuLabel"},{"objectName":"DefeatLevels"},{"objectName":"DefeatLevelsLabel"}]}]},{"folderName":"07_GAME_SYSTEMS","children":[{"folderName":"WaveFeedback","children":[{"objectName":"MessageText"},{"objectName":"WaveBannerPanel"},{"objectName":"WaveBannerTitle"},{"objectName":"WaveBannerDetail"},{"objectName":"WaveBannerReward"}]}]},{"folderName":"08_EFFECTS","children":[{"folderName":"VoidFortification","children":[{"objectName":"VoidFortificationVFX"},{"objectName":"VoidFortificationCastPulse"}]}]},{"folderName":"NEBULA BLOOM","children":[{"objectName":"NebulaBloomTower"},{"objectName":"NebulaBloomPod"},{"objectName":"NebulaBloomVFX"},{"objectName":"NebulaPoisonIcon"}]},{"folderName":"NEBULA BLOOM","children":[{"objectName":"NebulaBloomArtSource"}]}]},"events":[{"colorB":109,"colorG":143,"colorR":90,"creationTime":0,"name":"Responsive tower shop layout and input","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// A durable reset intent, not a save copy. Never clear unrelated preferences.","const resetGame=runtimeScene.getGame();","if(!resetGame.__freshStart){"," const data=resetGame.getSceneAndExtensionsData('Levels').sceneData;"," const config=new gdjs.VariablesContainer(data.variables).get('CampaignConfig').toJSObject();"," const service=resetGame.__freshStart={intentKey:'starfallBastionFreshStart.v1',keys:[config.StorageKey,'celestialVoidFusionDiscovery.v1','celestialVoidMonsterDiscovery.v1'],target:config.LevelsScene,pending:false,busy:false,error:'',resets:0};"," service.clearMemory=()=>{","  const c=resetGame.__campaign;","  if(c){c.save={Version:1,Completed:{},SelectTutorialDone:false,GameTutorialDone:false};c.active=null;c.chapter=config.Levels[0].Chapter;c.selected=config.Levels[0].Id;c.storageOK=true;}","  const a=resetGame.__fusionArchive;","  if(a){a.state={version:1,entries:{}};a.found.clear();a.queue.length=0;a.active=null;a.revision++;for(const k of Object.keys(a.stats))a.stats[k]=0;}","  resetGame.__celestialMonsterDiscoverySession?.resetForNewGame();","  delete resetGame.__celestialMonsterDiscovery;","  const order=resetGame.__celestialDiscoveryOrder;if(order){order.tickets.clear();order.next=0;}"," };"," service.commit=()=>{","  if(service.busy)return false;service.busy=true;service.error='';","  try{","   // Commit intent before the first removal. A crash or storage error is","   // completed forward on the next boot, before either archive/save loads.","   localStorage.setItem(service.intentKey,'1');","   if(localStorage.getItem(service.intentKey)!=='1')throw Error('Reset intent was not saved');","   service.pending=true;","   for(const key of service.keys){localStorage.removeItem(key);if(localStorage.getItem(key)!==null)throw Error('Progress data could not be cleared');}","   localStorage.removeItem(service.intentKey);","   if(localStorage.getItem(service.intentKey)!==null)throw Error('Reset could not be finalized');","   service.clearMemory();service.pending=false;service.resets++;return true;","  }catch(e){service.error='Fresh Start could not finish. Allow local storage, then retry.';return false;}","  finally{service.busy=false;}"," };"," service.leave=scene=>{","  // Native scene replacement unloads towers, projectiles, wave/currency state,","  // UI listeners and temporary placement. The existing Levels tutorial owns","  // the first-time flow; mission 1-1 then starts its own step-zero tutorial.","  scene.__devCheats?.close();scene.__fusion?.finish();scene.__freePlacement?.stop();scene.__obstaclePanel?.close();","  if(scene.__audio?.dirty)scene.__audio.persist();","  resetGame.__starfallMenuAudioReady=!!scene.__audio?.unlocked||!!resetGame.__starfallMenuAudioReady;","  gdjs.evtTools.runtimeScene.replaceScene(scene,service.target,false);"," };"," service.recovery=scene=>{","  if(service.overlay)return;","  // Only a failed, already-confirmed transaction uses this boot-time blocker.","  // DOM input remains available when the native game loop is paused.","  const overlay=service.overlay=document.createElement('div'),box=document.createElement('div'),title=document.createElement('strong'),message=document.createElement('p'),retry=document.createElement('button');","  overlay.setAttribute('data-celestial-reset-recovery','');overlay.setAttribute('role','alertdialog');overlay.setAttribute('aria-modal','true');overlay.setAttribute('aria-label','Fresh Start incomplete');","  Object.assign(overlay.style,{position:'fixed',inset:'0',zIndex:'3000',display:'grid',placeItems:'center',background:'#040617dd',padding:'16px',fontFamily:'Arial, sans-serif',color:'#ded7ed'});","  Object.assign(box.style,{maxWidth:'360px',padding:'22px',border:'1px solid #bd9b6a',borderRadius:'8px',background:'#101329'});title.textContent='Fresh Start incomplete';message.textContent=service.error+' Gameplay is held until the reset is complete.';retry.textContent='Retry Fresh Start';Object.assign(retry.style,{padding:'10px 14px',background:'#51304c',border:'1px solid #d6a08c',borderRadius:'4px',color:'#fff',cursor:'pointer'});","  box.append(title,message,retry);overlay.append(box);document.body.append(overlay);resetGame.pause(true);retry.focus();","  retry.onclick=()=>{if(!service.commit()){message.textContent=service.error;return;}overlay.remove();service.overlay=null;service.resumeScene=scene;resetGame.pause(false);};"," };"," try{service.pending=localStorage.getItem(service.intentKey)!==null;}catch(e){}"," if(service.pending){if(service.commit())service.leave(runtimeScene);else service.recovery(runtimeScene);}","}","// DOM retry runs outside scene events. Request the transition on the next native","// event frame so RuntimeScene does not discard an out-of-frame change request.","if(resetGame.__freshStart.resumeScene===runtimeScene){resetGame.__freshStart.resumeScene=null;resetGame.__freshStart.leave(runtimeScene);}"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Responsive two-column shop with one official Star Cannon. All purchase and wave actions stay in the native events below.","const scene = runtimeScene;","const variables = scene.getVariables();","// Independent world presentation controls; combat stats are deliberately separate.","const style=scene.__worldStyle || (scene.__worldStyle={road:88,star:2.5,"," enemy:1.55,spawn:5.2,base:2.15,"," props:{Crystal:1.65,Rock:1.75,Ruin:2.30,Shrub:1.65},"," footprints:{StarCannonTower:46},cliffUnit:.32});","if(!scene.__worldStyleInitialized){"," for(const [name,radius] of Object.entries(style.footprints)){","  const v=variables.get('TowerFootprints').getChild(name);v.getChild('Radius').setNumber(radius);","  v.getChild('RenderScale').setNumber(style.star);"," }"," scene.__worldStyleInitialized=true;","}","const get = name => scene.getObjects(name);","const first = name => get(name)[0];","const number = name => variables.get(name).getAsNumber();","const boolean = name => variables.get(name).getAsBoolean();","const mode = () => variables.get(\"WaveMode\").getAsString();","// One authoritative state: Waiting(0), Manual(1), ManualFast(2), Auto(3), AutoFast(4).","const autoMode = () => mode() === \"Auto\" || mode() === \"AutoFast\";","const fastMode = () => mode() === \"ManualFast\" || mode() === \"AutoFast\";","const syncWaveControl = () => {","  const valid = [\"Waiting\",\"Manual\",\"ManualFast\",\"Auto\",\"AutoFast\"];","  if (!valid.includes(mode())) variables.get(\"WaveMode\").setString(boolean(\"WaveActive\") ? \"Manual\" : \"Waiting\");","  const manager = scene.__waveManager;","  const spawningDone = !manager || manager.index >= manager.queue.length;","  const finished = !boolean(\"WaveActive\") && number(\"EnemiesToSpawn\") === 0 && get(\"Enemy\").length === 0 && spawningDone;","  if (boolean(\"GameOver\") || number(\"Lives\") <= 0) variables.get(\"WaveMode\").setString(\"Waiting\");","  else if (!autoMode() && finished) variables.get(\"WaveMode\").setString(\"Waiting\");","  else if (mode() === \"Waiting\" && boolean(\"WaveActive\")) variables.get(\"WaveMode\").setString(\"Manual\");","  const scale = scene.__fusion?.active ? scene.__fusion.config.FusionTimeScale : fastMode() ? 2 : 1;","  const time = scene.getTimeManager();","  if (time.getTimeScale() !== scale) time.setTimeScale(scale);","};","syncWaveControl();","const modal = boolean(\"IndexOpen\") || boolean(\"AudioUIConsumesClick\") || boolean(\"FusionActive\") || boolean('DefeatActive') || boolean('CampaignModal') || boolean('CampaignUIConsumesClick');","let ui = scene.__towerShopUI;","if (!ui || ui.root !== first(\"TowerShopBox\")) {","  ui = scene.__towerShopUI = { root: first(\"TowerShopBox\"), cards: [], wasDown: false, pressedCard: -1, pressedControl: \"\", dragging: false };","  ui.ensure = (name, index) => {","    let object = get(name).find(object => object.getVariables().get(\"ShopIndex\").getAsNumber() === index);","    if (!object) { object = scene.createObject(name); object.getVariables().get(\"ShopIndex\").setNumber(index); }","    object.setLayer(\"TowerShopList\");","    return object;","  };","  const container = scene.getLayer(\"TowerShopList\").getRenderer().getRendererObject();","  ui.mask = new PIXI.Graphics();","  container.addChild(ui.mask);","  container.mask = ui.mask;","}","// One resize owner. A bounded design canvas scales once through the renderer,","// never from an object's previous size or zoom. Retain the last valid canvas","// while minimized/hidden: native adaptWidth otherwise divides by window height.","const game = scene.getGame();","const viewportWidth = Math.round(gdjs.RuntimeGameRenderer.getWindowInnerWidth());","const viewportHeight = Math.round(gdjs.RuntimeGameRenderer.getWindowInnerHeight());","const viewport = game.__celestialViewport || (game.__celestialViewport = {minWidth:960,minHeight:540,revision:0});","if(game.getAdaptGameResolutionAtRuntime())game.setAdaptGameResolutionAtRuntime(false);","const validViewport=Number.isFinite(viewportWidth)&&Number.isFinite(viewportHeight)&&viewportWidth>=64&&viewportHeight>=64&&!(typeof document!=='undefined'&&document.hidden);","if (validViewport && (viewport.width!==viewportWidth || viewport.height!==viewportHeight)) {","  const factor=Math.max(1,viewport.minWidth/viewportWidth,viewport.minHeight/viewportHeight);","  viewport.width=viewportWidth;viewport.height=viewportHeight;","  viewport.logicalWidth=Math.round(viewportWidth*factor);viewport.logicalHeight=Math.round(viewportHeight*factor);","  viewport.revision++;","}","if(viewport.logicalWidth && (game.getGameResolutionWidth()!==viewport.logicalWidth || game.getGameResolutionHeight()!==viewport.logicalHeight)){","  game.setGameResolutionSize(viewport.logicalWidth,viewport.logicalHeight);","  scene.onGameResolutionResized();","}","const width = game.getGameResolutionWidth();","const height = game.getGameResolutionHeight();","// UI uses a stable logical shop X outside the buildable world area. Its camera anchors it to screen right.","const sidebarMargin = 8, mapSidebarGap = 10;","const sidebarScreenX = width - 224 - sidebarMargin;","const gameAreaRight = Math.max(1, sidebarScreenX - mapSidebarGap);","const offsetX = 1376 + sidebarMargin - width;","for (const layerName of [\"UI\", \"TowerShopList\"]) {","  const layer = scene.getLayer(layerName);","  layer.setCameraZoom(1, 0);","  layer.setCameraX(width / 2 + offsetX, 0);","  layer.setCameraY(height / 2, 0);","}","// One reference world, independent of monitor resolution. Fullscreen changes the","// world camera, not route density. World units, footprints and combat ranges stay intact.","const map = scene.getLayer(\"\");","const compactHUD = gameAreaRight < 348;","const hudHeight = compactHUD ? 104 : 44;","const safeTop = 16 + hudHeight + 20;","// HUD overlays the empty upper cliff margin; its input guard remains authoritative.","// On narrow portrait windows reserve the taller HUD band explicitly.","const frameTop = compactHUD ? safeTop : 16;","const mapFrame = { left: 16, top: frameTop, right: Math.max(17,gameAreaRight-16), bottom: Math.max(frameTop+1,height-24) };","const layoutKey = \"celestial-four-lane-88\";","if (!ui.level) {","  // Four broad lanes preserve total travel distance (7128 vs 7168 world units),","  // while allowing wider roads and larger sprites without shrinking build pockets.","  const cell=style.road,left=cell,right=cell*19,firstY=cell*2;","  const rows = [2,5,8,11].map(row=>row*cell);","  const corners = [[left,rows[0]]];","  rows.forEach((y,i)=>{if(i)corners.push([corners[corners.length-1][0],y]);corners.push([i%2===0?right:left,y]);});","  const positions = [corners[0]];","  for (const [tx,ty] of corners.slice(1)) {","    let [x,y] = positions[positions.length-1];","    while (x!==tx || y!==ty) { x+=Math.sign(tx-x)*cell;y+=Math.sign(ty-y)*cell;positions.push([x,y]); }","  }","  const tiles = get(\"Monster_Path\").slice().sort((a,b)=>a.getVariables().get(\"PathOrder\").getAsNumber()-b.getVariables().get(\"PathOrder\").getAsNumber());","  positions.forEach(([x,y],i)=>{","    const tile = tiles[i] || scene.createObject(\"Monster_Path\");","    tile.setLayer(\"\");tile.setZOrder(0);tile.setWidth(cell);tile.setHeight(cell);tile.setPosition(x,y);tile.setAnimationName(\"Surface\");tile.getVariables().get(\"PathOrder\").setNumber(i);","  });","  tiles.slice(positions.length).forEach(tile=>tile.deleteFromScene());","  const spawnPoint=[left+cell/2,firstY+cell/2],last=positions.at(-1),basePoint=[last[0]+cell/2,last[1]+cell/2];","  const spawn = first(\"SpawnMarker\"), base=first(\"BaseMarker\");","  spawn.setPosition(spawnPoint[0]-16,spawnPoint[1]-16);spawn.setWidth(32);spawn.setHeight(32);spawn.setZOrder(0);","  base.setPosition(basePoint[0]-40,basePoint[1]-40);base.setWidth(80);base.setHeight(80);","  const trees = get(\"Ground_Decoration\");","  const middle=(left+right)/2;","  const treePoints=[];","  // Asymmetric floor clusters: keep generous bend pockets and multiple open strips.","  const compositions=[[.24,.32,.60,.67],[.72,.64,.30,.39],[.35,.43,.72,.79]];","  for(let band=0;band<3;band++){","    const y=(rows[band]+cell+rows[band+1])/2-32;","    for(const t of compositions[band])treePoints.push([left+(right-left)*t-32,y]);","  }","  trees.forEach((tree,i)=>{tree.setPosition(...treePoints[i%12]);tree.getVariables().get('LocalScale').setNumber(1);tree.getVariables().get('Kind').setString(['Crystal','Rock','Ruin','Shrub'][i%4]);});","  // Smaller satellites enrich floor clusters without adding another large obstruction.","  for(const [kind,t,band,dy,size] of [","    ['Rock',.21,0,40,.42],['Shrub',.29,0,46,.56],","    ['Crystal',.75,1,42,.46],['Shrub',.67,1,50,.53],","    ['Rock',.69,2,44,.43],['Shrub',.39,2,48,.56],","    ['Crystal',.48,-1,0,.80],['Shrub',.54,-1,20,.72]]){","      const o=scene.createObject('Ground_Decoration');o.setLayer('');o.getVariables().get('Kind').setString(kind);o.getVariables().get('LocalScale').setNumber(size);","      const y=band<0?firstY-72:(rows[band]+cell+rows[band+1])/2+dy;","      o.setPosition(left+(right-left)*t-32,y-32);","  }","  // Exact outer extent of the proportional perimeter in island-map-runtime.js,","  // plus 12 world px breathing room. All frame pieces fit, including hanging rock.","  ui.mapBounds={left:left-16-225*style.cliffUnit-12,top:firstY-112-180*style.cliffUnit-12,","    right:right+cell+16+225*style.cliffUnit+12,bottom:rows.at(-1)+cell+16+206*style.cliffUnit+12};","  ui.level={key:layoutKey,rows,left,right,spawn:spawnPoint,base:basePoint,tileCount:positions.length,length:(positions.length-1)*cell};","  variables.get(\"MapRouteDirty\").setBoolean(true);","}","const bounds = {...ui.mapBounds};","// Fixed gameplay framing depends only on static map geometry, never on towers/ghosts.","ui.fittedBounds=bounds;","const zoom = Math.max(0.001,Math.min((mapFrame.right-mapFrame.left)/(bounds.right-bounds.left),(mapFrame.bottom-mapFrame.top)/(bounds.bottom-bounds.top)));","map.setCameraZoom(zoom,0);","map.setCameraX((bounds.left+bounds.right)/2-((mapFrame.left+mapFrame.right)/2-width/2)/zoom,0);","map.setCameraY((bounds.top+bounds.bottom)/2-((mapFrame.top+mapFrame.bottom)/2-height/2)/zoom,0);","// The original grass texture tiles naturally across ALL visible gameplay pixels.","const ground = first(\"Ground_Map\");","const min = map.convertCoords(0,0,0,[0,0]), max=map.convertCoords(gameAreaRight,height,0,[0,0]);","ground.setPosition(min[0],min[1]);ground.setWidth(max[0]-min[0]);ground.setHeight(max[1]-min[1]);","if (!ui.mapMask) {","  const container=map.getRenderer().getRendererObject();ui.mapMask=new PIXI.Graphics();container.addChild(ui.mapMask);container.mask=ui.mapMask;","}","const maskKey=[width,height,gameAreaRight,zoom,map.getCameraX(),map.getCameraY()].join(\",\");","if(ui.mapMaskKey!==maskKey){ui.mapMask.clear().beginFill(0xffffff).drawRect(min[0],min[1],max[0]-min[0],max[1]-min[1]).endFill();ui.mapMaskKey=maskKey;}","ui.gameArea={left:0,top:0,right:gameAreaRight,bottom:height,sidebarX:sidebarScreenX,gap:mapSidebarGap,margin:sidebarMargin,frame:mapFrame};","","ui.geometry = { rootX: 1152, rootY: sidebarMargin, panelHeight: height - sidebarMargin * 2, listX: 1168, listY: 72 + sidebarMargin, listWidth: 176 };","const geometry = ui.geometry;","geometry.bottom = geometry.rootY + geometry.panelHeight;","geometry.listHeight = Math.max(1, geometry.bottom - geometry.listY - 88);","geometry.playY = geometry.bottom - 72;","geometry.trackX = 1350;","const rect = (name, x, y, w, h) => { const o = first(name); o.setPosition(x, y); if (w !== undefined) o.setWidth(w); if (h !== undefined) o.setHeight(h); };","rect(\"TowerShopBox\", 1152, geometry.rootY, 224, geometry.panelHeight);","rect(\"ShopHeaderPlaque\", 1166, geometry.rootY + 10, 196, 48);","rect(\"ShopFooterFrame\", 1160, geometry.playY - 4, 208, 72);","rect(\"AssetPanelTitle\", 1168, geometry.rootY + 16, 192, 24);","rect(\"AssetPanelSubtitle\", 1168, geometry.rootY + 37, 192, 16);","rect(\"ShopIndexButton\", 1168, geometry.playY, 92, 60);","","rect(\"ShopPlayButton\", 1268, geometry.playY, 92, 60);","rect(\"ShopPlayIcon\", 1302, geometry.playY + 8, 24, 24);","rect(\"ShopPlayLabel\", 1268, geometry.playY + 36, 92, 20);","rect(\"ShopSpeedBadge\", 1332, geometry.playY + 8, 20, 14);","rect(\"ShopScrollTrack\", geometry.trackX, geometry.listY, 8, geometry.listHeight);","","// Keep the original HUD artwork. On narrow windows only its row arrangement changes.","const hudWidth = compactHUD ? Math.max(1, Math.min(196, gameAreaRight - 32)) : 316;","rect(\"HUDPanel\", offsetX + 16, 16, hudWidth, hudHeight);","get(\"HUDIcon\").forEach((o, i) => { o.setPosition(offsetX + (compactHUD ? 28 : [28,148,230][i]), compactHUD ? 26 + i * 30 : 26); o.setWidth(24); o.setHeight(24); });","for (const [i,name] of [\"MoneyText\",\"LivesText\",\"WaveText\"].entries()) {","  rect(name, offsetX + (compactHUD ? 60 : [60,180,262][i]), compactHUD ? 25 + i * 30 : 25, compactHUD ? Math.max(1,hudWidth-52) : [80,40,62][i], 28);","}","const message = first(\"MessageText\");","message.setWidth(Math.max(1, gameAreaRight - 32));","message.setPosition(offsetX + 16, height / 2 - 20);","// Prices have exactly one source: the existing costs migrated unchanged into TowerShopCatalog.","const catalog = variables.get(\"TowerShopCatalog\").toJSObject();","for (const name of [\"AssetCardPanel\", \"TileType_Button\", \"AssetTowerLabel\", \"AssetTowerPrice\", \"ShopCoin\"]) {","  get(name).slice().forEach(object => {","    if (object.getVariables().get(\"ShopIndex\").getAsNumber() >= catalog.length) object.deleteFromScene(scene);","  });","}","ui.cards.length = catalog.length;","for (let i = 0; i < catalog.length; i++) {","  const item = catalog[i];","  if (!ui.cards[i]) {","    const card = ui.cards[i] = { background: ui.ensure(\"AssetCardPanel\", i), icon: ui.ensure(\"TileType_Button\", i), name: ui.ensure(\"AssetTowerLabel\", i), price: ui.ensure(\"AssetTowerPrice\", i), coin: ui.ensure(\"ShopCoin\", i) };","    ","    if (card.icon.hasBehavior(\"Effect\")) card.icon.getBehavior(\"Effect\").enableEffect(\"Outline\", false);","    card.icon.setAnimationName(item.IconAnimation || item.Type);","    const ratio = card.icon.getWidth() / Math.max(1, card.icon.getHeight());","    const iconSize = item.Type === \"StarCannonTower\" ? 64 : 56;","    card.iconWidth = ratio > 1 ? iconSize : iconSize * ratio;","    card.iconHeight = ratio > 1 ? iconSize / ratio : iconSize;","  }","  const card = ui.cards[i];","  card.item = item;","  card.icon.getVariables().get(\"TowerType\").setString(item.Type);","  card.icon.getVariables().get(\"Cost\").setNumber(item.Cost);","  card.name.setString(item.Name);","  card.name.setCharacterSize(11);card.name.setWrapping(true);card.name.setWrappingWidth(76);card.name.setTextAlignment(\"center\");","  card.price.setCharacterSize(13);card.price.setWrapping(true);card.price.setWrappingWidth(46);card.price.setTextAlignment(\"center\");","  card.price.setString(String(item.Cost));","}","const contentHeight = Math.ceil(catalog.length / 2) * 120 - 8;","const maxScroll = Math.max(0, contentHeight - geometry.listHeight);","let scroll = Math.max(0, Math.min(maxScroll, number(\"TowerShopScroll\")));","const input = scene.getGame().getInputManager();","const mx = gdjs.evtTools.input.getCursorX(scene, \"UI\", 0);","const my = gdjs.evtTools.input.getCursorY(scene, \"UI\", 0);","const inside = (x,y,w,h) => mx >= x && mx < x+w && my >= y && my < y+h;","const shopVisible = !modal;","const inList = inside(geometry.listX, geometry.listY, geometry.listWidth, geometry.listHeight);","const inTrack = inside(geometry.trackX - 3, geometry.listY, 14, geometry.listHeight);","variables.get(\"TowerShopPointerInside\").setBoolean(shopVisible && inList);","variables.get(\"TowerShopRequestedType\").setString(\"\");","variables.get(\"PlayWaveRequested\").setBoolean(false);","if (shopVisible && (inList || inTrack)) scroll = Math.max(0, Math.min(maxScroll, scroll - Math.sign(input.getMouseWheelDelta()) * 48));","const hoveredIndex = () => {","  if (!shopVisible || !inList) return -1;","  const x = mx - geometry.listX, y = my - geometry.listY + scroll;","  const col = Math.floor(x / 92), row = Math.floor(y / 120), index = row * 2 + col;","  return col < 2 && x % 92 < 84 && y % 120 < 112 && index < catalog.length ? index : -1;","};","const ready = !boolean(\"WaveActive\") && !boolean(\"GameOver\") && number(\"Wave\") < (number(\"MaximumWave\")||45);","const overIndex = !modal && inside(1168, geometry.playY, 92, 60);","const overPlay = !modal && inside(1268, geometry.playY, 92, 60);","const down = input.isMouseButtonPressed(0);","let hovered = hoveredIndex();","if (down && !ui.wasDown) {","  ui.pressedCard = hovered;","  ui.pressedControl = overIndex ? \"Index\" : overPlay ? \"Play\" : \"\";","  if (inTrack && maxScroll > 0 && shopVisible) { ui.dragging = true; ui.dragStartY = my; ui.dragStartScroll = scroll; ui.pressedCard = -1; }","}","const thumbHeight = maxScroll > 0 ? Math.max(22, geometry.listHeight * geometry.listHeight / contentHeight) : geometry.listHeight;","if (ui.dragging && down) scroll = Math.max(0, Math.min(maxScroll, ui.dragStartScroll + (my - ui.dragStartY) * maxScroll / Math.max(1, geometry.listHeight - thumbHeight)));","if (!down && ui.wasDown) {","  if (ui.pressedControl === \"Index\" && overIndex) ui.indexRequested = true;","  if (ui.pressedControl === \"Play\" && overPlay && !boolean(\"GameOver\")) {","    if (mode() === \"Waiting\") {","      if (ready) variables.get(\"PlayWaveRequested\").setBoolean(true);","    } else {","      const cycle = [\"Manual\",\"ManualFast\",\"Auto\",\"AutoFast\"];","      variables.get(\"WaveMode\").setString(cycle[(cycle.indexOf(mode()) + 1) % cycle.length]);","      // Cancelling AUTO between waves returns to waiting; an active wave never pauses.","      syncWaveControl();","    }","  }","  if (!ui.dragging && ui.pressedCard >= 0 && ui.pressedCard === hovered) variables.get(\"TowerShopRequestedType\").setString(catalog[hovered].Type);","  ui.pressedCard = -1; ui.pressedControl = \"\"; ui.dragging = false;","}","ui.wasDown = down;","variables.get(\"TowerShopScroll\").setNumber(scroll);","hovered = hoveredIndex();","const listMaskKey=[geometry.listX,geometry.listY,geometry.listWidth,geometry.listHeight].join(':');","if(ui.listMaskKey!==listMaskKey){ui.mask.clear().beginFill(0xffffff).drawRect(geometry.listX,geometry.listY,geometry.listWidth,geometry.listHeight).endFill();ui.listMaskKey=listMaskKey;}","ui.cards.forEach((card, i) => {","  const x = geometry.listX + (i % 2) * 92, y = geometry.listY + Math.floor(i / 2) * 120 - scroll;","  card.background.setPosition(x, y); card.background.setWidth(84); card.background.setHeight(112);","  const pressed = down && ui.pressedCard === i && hovered === i;","  const scale = pressed ? 0.94 : hovered === i ? 1.04 : 1;","  card.icon.setWidth(card.iconWidth * scale); card.icon.setHeight(card.iconHeight * scale);","  card.icon.setPosition(x + 42 - card.icon.getWidth()/2, y + ([\"StarCannonTower\",\"NebulaBloomTower\"].includes(card.item.Type) ? 57 : 51) - card.icon.getHeight()/2);","  card.name.setPosition(x + 4, y + 5); card.name.setWidth(76); card.name.setHeight(18);","  card.coin.setPosition(x + 13, y + 91); card.coin.setWidth(15); card.coin.setHeight(15);","  card.price.setPosition(x + 31, y + 91); card.price.setWidth(46); card.price.setHeight(20);","});","rect(\"ShopScrollThumb\", geometry.trackX, geometry.listY + (maxScroll > 0 ? scroll / maxScroll * (geometry.listHeight - thumbHeight) : 0), 8, thumbHeight);","ui.scrollMax = maxScroll; ui.hovered = hovered; ui.ready = ready; ui.overPlay = overPlay;","ui.refresh = () => {","  const selectedTower = number(\"SelectedTower\") > 0;","  const fusion = boolean('FusionActive');","  scene.getLayer(\"TowerShopList\").show(!fusion);","  first('AssetPanelTitle').setString(fusion ? 'FUSION' : 'TOWERS');","  first('AssetPanelSubtitle').setString(fusion ? 'TACTICAL  /  '+scene.getTimeManager().getTimeScale()+'\\u00d7' : 'BUILD DEFENSE');","  first('ShopScrollTrack').hide(fusion);first('ShopScrollThumb').hide(fusion);","  const indicator = first(\"TilePlacement_Indicator\");","  ui.cards.forEach((card, i) => {","    const affordable = number(\"Money\") >= card.item.Cost;","    const selected = !indicator.isHidden() && indicator.getAnimationName() === card.item.Type;","    const pressed = ui.wasDown && ui.pressedCard === i && ui.hovered === i;","    card.background.setColor(selected ? \"188;237;255\" : pressed ? \"184;152;232\" : ui.hovered === i ? \"218;199;255\" : \"235;224;255\");","    if (card.background.hasBehavior(\"Effect\")) card.background.getBehavior(\"Effect\").enableEffect(\"Outline\", selected);","    card.background.setOpacity(affordable ? 255 : 220);","    card.icon.setOpacity(affordable ? 255 : 190);","    card.price.setColor(affordable ? \"244;232;255\" : \"255;120;155\");","    card.name.setColor(affordable ? \"245;233;255\" : \"173;150;203\");","    for (const part of [card.background,card.icon,card.name,card.price,card.coin]) part.hide(fusion);","  });","  syncWaveControl();","  const ended = boolean(\"GameOver\"), current = mode();","  const isAuto = autoMode(), isFast = fastMode();","  const isManual = current === \"Manual\" || current === \"ManualFast\";","  first(\"ShopPlayButton\").setOpacity(ended ? 155 : 255);","  first(\"ShopPlayButton\").setColor(isFast ? \"149;234;255\" : ui.overPlay ? \"207;194;255\" : \"240;228;255\");","  if (first(\"ShopPlayButton\").hasBehavior(\"Effect\")) first(\"ShopPlayButton\").getBehavior(\"Effect\").enableEffect(\"Outline\", isFast && !ended);","  first(\"ShopPlayIcon\").hide(ended || isAuto);","  first(\"ShopPlayIcon\").setAnimationName(isManual ? \"Manual\" : \"Play\");","  first(\"ShopPlayLabel\").setCharacterSize(ended ? 12 : 14);","  first(\"ShopPlayLabel\").setString(ended ? (number(\"Lives\") > 0 ? \"COMPLETE\" : \"GAME OVER\") : isAuto ? \"AUTO\" : isManual ? \"MANUAL\" : \"PLAY\");","  first(\"ShopPlayLabel\").setY(geometry.playY + (ended || isAuto ? 22 : 36));","  first(\"ShopSpeedBadge\").hide(!isFast || ended);","  first(\"ShopIndexButton\").setColor(overIndex ? \"207;194;255\" : \"255;255;255\");","  const indexIcon = first(\"Index_logo\"), indexButton = first(\"ShopIndexButton\");","  const iconScale = overIndex ? (ui.wasDown && ui.pressedControl === \"Index\" ? 0.95 : 1.05) : 1;","  const iconSize = Math.min(indexButton.getWidth(), indexButton.getHeight()) * 0.90 * iconScale;","  indexIcon.setWidth(iconSize); indexIcon.setHeight(iconSize);","  indexIcon.setPosition(indexButton.getX() + (indexButton.getWidth() - iconSize) / 2, indexButton.getY() + (indexButton.getHeight() - iconSize) / 2);","  first(\"ShopScrollThumb\").setOpacity(maxScroll > 0 ? 255 : 110);","};"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Directional skins reuse the same road instances, centers, masks and PathOrder.","const scene=runtimeScene,get=n=>scene.getObjects(n),sv=scene.getVariables();","const roads=get(\"Monster_Path\").slice().sort((a,b)=>a.getVariables().get(\"PathOrder\").getAsNumber()-b.getVariables().get(\"PathOrder\").getAsNumber());","const side=(o,n)=>n.getX()>o.getX()?\"E\":n.getX()<o.getX()?\"W\":n.getY()>o.getY()?\"S\":\"N\";","roads.forEach((o,i)=>{","  const sides=[i?side(o,roads[i-1]):null,i<roads.length-1?side(o,roads[i+1]):null].filter(Boolean);","  let skin;","  if(sides.length===1)skin=\"Cap_\"+sides[0];","  else if(sides.includes(\"E\")&&sides.includes(\"W\"))skin=\"H\";","  else if(sides.includes(\"N\")&&sides.includes(\"S\"))skin=\"V\";","  else skin=(sides.includes(\"N\")?\"N\":\"S\")+(sides.includes(\"E\")?\"E\":\"W\");","  if(o.getAnimationName()!==skin)o.setAnimationName(skin);","  o.pauseAnimation();o.setAnimationFrame((skin===\"H\"||skin===\"V\")?i%4:0);","});","const kinds=[\"Crystal\",\"Rock\",\"Ruin\",\"Shrub\"];","get(\"Ground_Decoration\").forEach((o,i)=>{","  const kind=o.getVariables().get(\"Kind\").getAsString()||kinds[i%4];if(o.getAnimationName()!==kind)o.setAnimationName(kind);","  o.setWidth(64);o.setHeight(64);o.getVariables().get(\"Blocking\").setBoolean(kind!==\"Shrub\");o.getVariables().get(\"Kind\").setString(kind);","});","let backdrop=scene.__voidBackdrop;","if(!backdrop)backdrop=scene.__voidBackdrop=scene.createObject(\"VoidBackdrop\");","const ground=get(\"Ground_Map\")[0];backdrop.setLayer(\"\");backdrop.setZOrder(ground.getZOrder()-10);","backdrop.setPosition(ground.getX(),ground.getY());backdrop.setWidth(ground.getWidth());backdrop.setHeight(ground.getHeight());","// Compose the existing frame as proportionally scaled perimeter pieces outside the road.","// No full-frame stretch, no rocky art laid beneath the bottom road.","if(scene.__islandCliffFrame){scene.__islandCliffFrame.deleteFromScene();scene.__islandCliffFrame=null;}","const left=Math.min(...roads.map(o=>o.getX()))-16,right=Math.max(...roads.map(o=>o.getX()+o.getWidth()))+16;","const top=Math.min(...roads.map(o=>o.getY()))-112,bottom=Math.max(...roads.map(o=>o.getY()+o.getHeight()))+16;","const unit=scene.__worldStyle.cliffUnit,L=225,R=225,T=180,B=206,W=1448,H=1086,lw=L*unit,rw=R*unit,th=T*unit,bh=B*unit;","const pieces=[];","const add=(sx,sy,sw,sh,x,y,w,h)=>pieces.push({sx,sy,sw,sh,x,y,w,h});","add(0,0,L,T,left-lw,top-th,lw,th);add(W-R,0,R,T,right,top-th,rw,th);","add(0,H-B,L,B,left-lw,bottom,lw,bh);add(W-R,H-B,R,B,right,bottom,rw,bh);","// Repeat long edges at uniform scale and crop the final piece, keeping rock proportions.","for(let x=left;x<right-.001;){const width=Math.min((W-L-R)*unit,right-x);add(L,0,width/unit,T,x,top-th,width,th);add(L,H-B,width/unit,B,x,bottom,width,bh);x+=width;}","for(let y=top;y<bottom-.001;){const height=Math.min((H-T-B)*unit,bottom-y);add(0,T,L,height/unit,left-lw,y,lw,height);add(W-R,T,R,height/unit,right,y,rw,height);y+=height;}","// One native owner keeps the correct world layer/Z-order; its PIXI children use","// cropped textures at uniform scale without changing GDevelop's frame-size calculations.","let holder=scene.__cliffOwner;if(!holder)holder=scene.__cliffOwner=scene.createObject('IslandCliffFrame');","holder.setLayer('');holder.setZOrder(-7);holder.updatePreRender(scene);","const root=holder.getRendererObject();if(!scene.__cliffBaseTexture)scene.__cliffBaseTexture=root.texture.baseTexture;","root.texture=PIXI.Texture.EMPTY;root.anchor.set(0);root.position.set(0,0);root.scale.set(1,1);","let edges=scene.__islandEdges;if(!edges)edges=scene.__islandEdges=[];","while(edges.length>pieces.length){const e=edges.pop();root.removeChild(e.sprite);e.sprite.destroy();e.texture.destroy(false);}","let shadows=scene.__environmentShadows;","if(!shadows){shadows=scene.__environmentShadows=new PIXI.Graphics();root.addChildAt(shadows,0);}","shadows.clear();","for(const o of get('Ground_Decoration')){"," const kind=o.getVariables().get('Kind').getAsString(),scale=(scene.__worldStyle.props[kind]||1)*(o.getVariables().get('LocalScale').getAsNumber()||1),w=o.getWidth()*scale;"," const x=o.getCenterXInScene(),y=o.getCenterYInScene()+w*.30;"," shadows.beginFill(0x100c25,kind==='Shrub'?.16:.30).drawEllipse(x,y,w*.34,w*.08).endFill();","}","const regions=[];","for(const [i,d] of pieces.entries()){"," let e=edges[i];if(!e){e=edges[i]={sprite:new PIXI.Sprite()};root.addChild(e.sprite);}"," const key=[d.sx,d.sy,d.sw,d.sh].join(',');"," if(e.key!==key){if(e.texture)e.texture.destroy(false);e.texture=new PIXI.Texture(scene.__cliffBaseTexture,new PIXI.Rectangle(d.sx,d.sy,d.sw,d.sh));e.key=key;}"," e.sprite.texture=e.texture;e.sprite.anchor.set(0);e.sprite.position.set(d.x,d.y);e.sprite.scale.set(unit,unit);"," regions.push([[d.x,d.y],[d.x+d.w,d.y],[d.x+d.w,d.y+d.h],[d.x,d.y+d.h]]);","}","scene.__islandRockRegions=regions;","// Buildable top surface is separate from the rocky frame. Terrain extends UNDER the","// inner fringe so transparent pockets in the edge sprites cannot expose accidental holes.","scene.__islandSurfacePolygon=[left,top,right,top,right,bottom,left,bottom];","const drawable=ground.getRendererObject();","if(!scene.__islandSurfaceMask){scene.__islandSurfaceMask=new PIXI.Graphics();scene.getLayer('').getRenderer().getRendererObject().addChild(scene.__islandSurfaceMask);drawable.mask=scene.__islandSurfaceMask;}","const underlap=32,mask=scene.__islandSurfaceMask,key=[left,top,right,bottom].join(',');","if(scene.__islandSurfaceKey!==key){mask.clear().beginFill(0xffffff).drawRoundedRect(left-underlap,top-underlap,right-left+underlap*2,bottom-top+underlap*2,20).endFill();scene.__islandSurfaceKey=key;}","ground.setColor(\"192;195;218\");"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Archive state is presentation-only. The sole unlock caller is the native wave spawn.","const scene=runtimeScene,game=scene.getGame(),sv=scene.getVariables();","let d=scene.__monsterDiscovery;","if(!d){"," const types=sv.get('EnemyTypes').toJSObject(),definition=game.getSceneAndExtensionsData(scene.getName()).sceneData.objects.find(o=>o.name==='IndexMonsterImage');"," const animations=new Map(definition.animations.map(a=>[a.name,a.directions[0].sprites[0].image]));"," const ids=definition.animations.flatMap(animation=>Object.keys(types).filter(id=>types[id].Animation===animation.name));"," let session=game.__celestialMonsterDiscoverySession;"," if(!session){","  session=game.__celestialMonsterDiscoverySession={found:new Set(),queue:[],active:null,revision:0,stats:{unlocks:0,shown:0,sounds:0,completed:0}};","  // Explicit Restart/New Game calls this; ordinary scene changes do not.","  session.resetForNewGame=()=>{session.found.clear();session.queue.length=0;session.active=null;session.revision++;for(const key of Object.keys(session.stats))session.stats[key]=0;for(const key of game.__celestialDiscoveryOrder?.tickets.keys()||[])if(key.startsWith('monster:'))game.__celestialDiscoveryOrder.tickets.delete(key);};","  delete game.__celestialMonsterDiscovery;","  // Ignore all legacy discovery data. Remove only its old key, never settings.","  try{localStorage.removeItem('celestialVoidMonsterDiscovery.v1');}catch(e){}"," }"," d=scene.__monsterDiscovery={scope:'session',ids,types,session,found:session.found,queue:session.queue,get active(){return session.active;},set active(value){session.active=value;},get revision(){return session.revision;},ready:false,disposed:false,outlines:new Map(),indexPortraits:new Map(),textures:new Map(),ownedTextures:new Set(),portraits:sv.get('MonsterPortraitConfig').toJSObject(),stats:session.stats};"," d.ready=true;"," d.has=id=>d.found.has(id);"," d.resetForNewGame=session.resetForNewGame;"," d.onWaveSpawn=(enemy,id)=>{","  const wave=scene.__waveManager;","  if(d.disposed||!ids.includes(id)||d.has(id)||!sv.get('WaveActive').getAsBoolean()||sv.get('GameOver').getAsBoolean()||!wave||wave.queue[wave.index-1]!==id||!scene.getObjects('Enemy').includes(enemy)||enemy.getVariables().get('EnemyType').getAsString()!==id||enemy.getBehavior('Health').IsDead())return false;","  d.found.add(id);session.revision++;d.stats.unlocks++;d.queue.push(id);scene.__discoveryToast?.enqueue('monster',id);return true;"," };"," d.texture=id=>{","  if(d.textures.has(id))return d.textures.get(id);","  const meta=d.portraits[id],base=game.getImageManager().getPIXITexture(meta?.Image||animations.get(types[id].Animation));","  // Only atlases need frame extraction; individual PNGs remain shared unchanged.","  const texture=meta?.Frame?new PIXI.Texture(base.baseTexture,new PIXI.Rectangle(...meta.Frame)):base;","  if(meta?.Frame)d.ownedTextures.add(texture);","  if(texture)d.textures.set(id,texture);return texture;"," };"," d.fitPortrait=(sprite,id,x,y,width,height)=>{","  const texture=d.texture(id),bounds=d.portraits[id]?.VisualBounds||[0,0,texture.width,texture.height];sprite.texture=texture;","  sprite.anchor.set((bounds[0]+bounds[2]/2)/texture.width,(bounds[1]+bounds[3]/2)/texture.height);","  sprite.scale.set(Math.min(width/bounds[2],height/bounds[3]));sprite.position.set(x,y);sprite.rotation=0;"," };"," // One compact presentation style for every existing archive queue. Unlock and"," // persistence remain with their original owners; presentation never discovers."," const layer=scene.getLayer('DiscoveryUI'),parent=layer.getRenderer().getRendererObject();"," const toast=scene.__discoveryToast={duration:3.2};"," // FIFO presentation across the existing independent discovery/save systems."," // Tickets live only in this RuntimeGame, not in archive persistence."," const order=game.__celestialDiscoveryOrder||(game.__celestialDiscoveryOrder={next:0,tickets:new Map()});"," const ticket=(kind,event)=>kind+':'+(typeof event==='string'?event:event.id+':'+event.variant);"," toast.enqueue=(kind,event)=>{const key=ticket(kind,event);if(!order.tickets.has(key))order.tickets.set(key,++order.next);return order.tickets.get(key);};"," toast.take=(kind,event)=>order.tickets.delete(ticket(kind,event));"," toast.canBegin=kind=>{","  const monster=d.queue[0],fusion=game.__fusionArchive?.queue[0];","  const m=monster?toast.enqueue('monster',monster):Infinity,f=fusion?toast.enqueue('fusion',fusion):Infinity;","  return kind==='monster'?m<=f:f<m;"," };"," toast.geometry=()=>{","  const area=scene.__towerShopUI.gameArea,hud=scene.getObjects('HUDPanel')[0];","  const top=scene.getLayer('UI').convertInverseCoords(hud.getX(),hud.getY(),0,[0,0]);","  const w=272,h=60;return{x:area.right-12-w,y:Math.max(4,top[1]-8),w,h,scale:1};"," };"," toast.create=z=>{","  const root=new PIXI.Container(),mask=new PIXI.Graphics();root.interactive=false;root.interactiveChildren=false;root.visible=false;root.zIndex=z;mask.zIndex=z-1;mask.interactive=false;parent.addChild(mask,root);root.mask=mask;","  const panel=new PIXI.Graphics();root.addChild(panel);","  panel.lineStyle(1,0xc5ab72,.9).beginFill(0x181027,.97).drawRoundedRect(0,0,272,60,7).endFill();","  panel.lineStyle(1,0x8bb9e9,.3).moveTo(53,10).lineTo(53,50);","  panel.lineStyle(1,0x8d70bb,.45).beginFill(0x100b22).drawRoundedRect(7,9,40,42,5).endFill();","  const text=(value,x,y,size,color,bold=false)=>{const t=new PIXI.Text(value,{fontFamily:'Arial',fontSize:size,fill:color,fontWeight:bold?'bold':'normal',wordWrap:true,wordWrapWidth:198});t.position.set(x,y);root.addChild(t);return t;};","  const heading=text('NEW DISCOVERY',63,7,9,0xaacdf3,true),name=text('',63,21,13,0xf3e8ff,true),detail=text('Monster Archive Updated',63,41,9,0xaf9fc6);","  const icon=new PIXI.Sprite();icon.anchor.set(.5);icon.position.set(27,30);root.addChild(icon);","  const stars=[];for(let i=0;i<3;i++){const star=new PIXI.Graphics();star.beginFill(i%2?0xcaa1ff:0xa4dcff).drawPolygon([0,-2,1,-1,2,0,1,1,0,2,-1,1,-2,0,-1,-1]).endFill();root.addChild(star);stars.push(star);}","  return{root,mask,icon,heading,name,detail,stars};"," };"," toast.paint=(view,age)=>{","  const g=toast.geometry(),smooth=x=>{x=Math.max(0,Math.min(1,x));return x*x*(3-2*x);},enter=smooth(age/.2),exit=smooth((age-2.9)/.3),reveal=smooth((age-.2)/.45);","  view.screenRect=g;const key=[g.x,g.y,g.w,g.h].join(':');if(view.maskKey!==key){view.mask.clear().beginFill(0xffffff).drawRect(g.x,g.y,g.w,g.h).endFill();view.maskKey=key;}","  view.mask.visible=true;view.root.visible=true;view.root.alpha=enter*(1-exit);view.root.scale.set(1);view.root.position.set(g.x,g.y-(1-enter)*8-exit*8);","  const c=Math.round(255*reveal);view.icon.tint=(c<<16)|(c<<8)|c;view.name.alpha=smooth((age-.65)/.2);","  view.stars.forEach((star,i)=>{star.position.set(27+Math.cos(age+i*2.1)*20,30+Math.sin(age+i*2.1)*20);star.alpha=reveal*.3*Math.sin(age*2+i)**2;});"," };"," const view=d.toast=toast.create(100),{root,mask,icon,name}=view;d.root=root;d.mask=mask;d.icon=icon;d.nameText=name;d.stars=view.stars;"," d.geometry=toast.geometry;"," d.bindPortrait=id=>{","  if(!d.texture(id))return false;","  name.text=types[id].Name||id;name.scale.set(1);name.scale.set(Math.min(1,198/Math.max(1,name.width),18/Math.max(1,name.height)));","  d.fitPortrait(icon,id,27,30,38,40);d.boundPortrait=id;return true;"," };"," d.begin=id=>{","  if(!d.bindPortrait(id))return false;toast.take('monster',id);d.active={id,age:0};d.stats.shown++;","  if(scene.__audio?.play('DiscoveryUnlock'))d.stats.sounds++;return true;"," };"," d.paint=()=>{","  if(!d.active){root.visible=false;mask.visible=false;return;}","  if(d.boundPortrait!==d.active.id)d.bindPortrait(d.active.id);","  // geometry remains replaceable by native click-through validation fixtures.","  const geometry=toast.geometry;toast.geometry=d.geometry;toast.paint(view,d.active.age);toast.geometry=geometry;"," };"," d.paintIndex=()=>{","  const index=scene.__unitIndex,visible=sv.get('IndexOpen').getAsBoolean()&&index?.category==='Monsters';","  for(const outline of d.outlines.values())if(!outline.destroyed)outline.destroy({texture:false,baseTexture:false});d.outlines.clear();","  for(const portrait of d.indexPortraits.values())portrait.root.visible=false;","  if(!visible)return;","  for(const {sprite:object} of index.monsterCards||index.cards){","   const frame=object.__discoveryPortrait;if(!frame||object.isHidden())continue;","   // The native object is a bounded UI handle, never a second visible artwork.","   object.__archivePortraitOwned=true;object.setOpacity(0);const native=object.getRendererObject();native.alpha=0;native.visible=false;","   if(object.__golemPortraitRig)object.__golemPortraitRig.visible=false;","   let portrait=d.indexPortraits.get(object);","   if(!portrait){","    const root=new PIXI.Container(),mask=new PIXI.Graphics(),sprite=new PIXI.Sprite();root.interactive=false;root.interactiveChildren=false;mask.interactive=false;sprite.interactive=false;sprite.mask=mask;root.addChild(mask,sprite);","    portrait={root,mask,sprite,frameKey:''};d.indexPortraits.set(object,portrait);object.__archivePortrait=portrait;","    const cleanup=()=>{sprite.mask=null;if(!root.destroyed)root.destroy({children:true,texture:false,baseTexture:false});d.indexPortraits.delete(object);delete object.__archivePortrait;object.unregisterDestroyCallback(cleanup);};object.registerDestroyCallback(cleanup);","   }","   const {root,mask,sprite}=portrait,parent=scene.getLayer(object.getLayer()).getRenderer().getRendererObject();if(root.parent!==parent)parent.addChild(root);","   root.zIndex=object.getZOrder();root.position.set(0);root.scale.set(1);root.rotation=0;root.alpha=1;root.visible=true;","   d.fitPortrait(sprite,frame.id,frame.x,frame.y,frame.w,frame.h);","   // Read encounter state afresh. A new unlock stays black until the matching text refresh.","   const locked=!d.has(frame.id)||object.__discoveryLocked;sprite.tint=locked?0x000000:0xffffff;sprite.alpha=1;sprite.visible=true;sprite.blendMode=PIXI.BLEND_MODES.NORMAL;portrait.id=frame.id;portrait.locked=locked;","   const frameKey=[frame.x,frame.y,frame.w,frame.h].join(':');if(portrait.frameKey!==frameKey){mask.clear().beginFill(0xffffff).drawRect(frame.x-frame.w/2,frame.y-frame.h/2,frame.w,frame.h).endFill();portrait.frameKey=frameKey;}","  }"," };"," d.update=()=>{","  if(d.disposed)return;","  const uiLayer=scene.getLayer('DiscoveryUI');uiLayer.setCameraZoom(1);uiLayer.setCameraX(game.getGameResolutionWidth()/2);uiLayer.setCameraY(game.getGameResolutionHeight()/2);","  // Keep queued announcements intact while the encyclopedia owns the screen.","  if(sv.get('DefeatActive').getAsBoolean()||sv.get('IndexOpen').getAsBoolean()||!d.active&&(game.__fusionArchive?.active||!toast.canBegin('monster'))){root.visible=false;mask.visible=false;d.paintIndex();return;}","  const dt=Math.max(0,scene.getTimeManager().getElapsedTime()/Math.max(.001,scene.getTimeManager().getTimeScale())/1000);","  if(d.active){d.active.age+=dt;if(d.active.age>=toast.duration){d.active=null;d.stats.completed++;}}","  if(!d.active&&d.queue.length&&toast.canBegin('monster')){if(d.begin(d.queue[0]))d.queue.shift();}","  d.paint();d.paintIndex();"," };"," d.dispose=()=>{if(d.disposed)return;d.disposed=true;for(const portrait of d.indexPortraits.values()){portrait.sprite.mask=null;if(!portrait.root.destroyed)portrait.root.destroy({children:true,texture:false,baseTexture:false});}d.indexPortraits.clear();for(const outline of d.outlines.values())if(!outline.destroyed)outline.destroy({texture:false,baseTexture:false});d.outlines.clear();d.textures.clear();root.mask=null;root.destroy({children:true,texture:false,baseTexture:false});mask.destroy();for(const texture of d.ownedTextures)texture.destroy(false);d.ownedTextures.clear();};"," if(!gdjs.__celestialDiscoveryCallbacks){gdjs.__celestialDiscoveryCallbacks=true;gdjs.callbacksRuntimeScenePostEvents.push(s=>s.__monsterDiscovery?.update());gdjs.callbacksRuntimeSceneUnloading.push(s=>s.__monsterDiscovery?.dispose());}","}"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Transactional Pure Fusion. Original towers remain alive until valid placement.","const scene=runtimeScene,sv=scene.getVariables(),game=scene.getGame(),get=n=>scene.getObjects(n),p=scene.__freePlacement,star=scene.__starCannon;","if(!p||!star)return;","let f=scene.__fusion;","if(!f){"," const config=sv.get('StarburstConfig').toJSObject(),layer=scene.getLayer('FusionUI');"," const archive=game.__fusionArchive;if(!archive?.persistent)return;"," f=scene.__fusion={config,archive,active:false,stage:'idle',objects:{},markers:new Map(),footprints:new Map(),obstacleFootprints:new Map(),wasDown:false,pressed:'',error:'',disposed:false};"," f.graphics=new PIXI.Graphics();layer.getRenderer().getRendererObject().addChild(f.graphics);f.graphics.zIndex=0;"," // One reusable batch above the dimmer; clip world hints away from all sidebar UI."," f.worldGraphics=new PIXI.Graphics();f.worldMask=new PIXI.Graphics();f.worldGraphics.zIndex=1;f.worldGraphics.interactive=false;f.worldMask.interactive=false;f.worldGraphics.mask=f.worldMask;layer.getRenderer().getRendererObject().addChild(f.worldMask,f.worldGraphics);"," f.hudGraphics=new PIXI.Graphics();f.hudGraphics.zIndex=5;f.hudGraphics.interactive=false;layer.getRenderer().getRendererObject().addChild(f.hudGraphics);"," f.ensure=(key,name,z=2)=>{if(!f.objects[key]){const o=scene.createObject(name);o.setLayer('FusionUI');o.setZOrder(z);f.objects[key]=o;}return f.objects[key];};"," f.ghost=f.ensure('ghost','StarburstGhost',3);f.ghost.hide();"," f.hudSlot=height=>{","  const rect=o=>{const l=scene.getLayer(o.getLayer()),a=l.convertInverseCoords(o.getX(),o.getY(),0,[0,0]),b=l.convertInverseCoords(o.getX()+o.getWidth(),o.getY()+o.getHeight(),0,[0,0]);return{x:a[0],y:a[1],w:b[0]-a[0],h:b[1]-a[1]};};","  const box=rect(get('TowerShopBox')[0]),header=rect(get('ShopHeaderPlaque')[0]),footer=rect(get('ShopFooterFrame')[0]),x=box.x+12,w=box.w-24;","  let gaps=[[header.y+header.h+10,footer.y-10]];","  const occupied=[...scene.__towerShopUI.cards.map(c=>rect(c.background)),scene.__selectedPanel?.screenRect,scene.__obstaclePanel?.screenRect,...(scene.__audio?.ui.open?[scene.__audio.geometry().panel]:[])].filter(Boolean);","  for(const r of occupied)if(r.x<x+w&&r.x+r.w>x)gaps=gaps.flatMap(([a,b])=>r.y>=b||r.y+r.h<=a?[[a,b]]:[[a,Math.min(b,r.y-10)],[Math.max(a,r.y+r.h+10),b]].filter(([a,b])=>b>a));","  gaps.sort((a,b)=>(b[1]-b[0])-(a[1]-a[0]));const gap=gaps[0];if(!gap)return null;","  const scale=Math.min(1,w/200,(gap[1]-gap[0])/height);return{x:x+(w-200*scale)/2,y:gap[0],w:200*scale,h:height*scale,scale};"," };"," // One contextual body replaces shop content; it never adds a second sidebar frame."," const sidebar=f.sidebar={root:new PIXI.Container(),mask:new PIXI.Graphics(),graphics:new PIXI.Graphics(),texts:new Map(),portraits:new Map(),scroll:0,phase:'',sourceEntries:[],result:null};"," sidebar.root.zIndex=4;sidebar.root.interactive=false;sidebar.root.interactiveChildren=false;sidebar.mask.interactive=false;sidebar.root.mask=sidebar.mask;sidebar.root.addChild(sidebar.graphics);layer.getRenderer().getRendererObject().addChild(sidebar.mask,sidebar.root);sidebar.root.visible=false;"," const portraitCatalog=sv.get('IndexPortraitCatalog').toJSObject(),sceneData=game.getSceneAndExtensionsData(scene.getName()).sceneData;"," f.sourceInfo=t=>{","  if(!t)return null;const v=t.getVariables(),variant=v.get('TowerType').getAsString(),catalog=sv.get('TowerShopCatalog').toJSObject(),type=portraitCatalog[variant]||archive.definition(variant)||catalog.some(c=>c.Type===variant)?variant:t.getName(),shop=catalog.find(c=>c.Type===type);","  return{type,name:v.get('TowerName').getAsString()||shop?.Name||type,path1:v.get('Path1Level').getAsNumber(),path2:v.get('Path2Level').getAsNumber()};"," };"," f.renderSidebar=()=>{","  const toScreen=o=>{const l=scene.getLayer(o.getLayer()),a=l.convertInverseCoords(o.getX(),o.getY(),0,[0,0]),b=l.convertInverseCoords(o.getX()+o.getWidth(),o.getY()+o.getHeight(),0,[0,0]);return{x:a[0],y:a[1],w:b[0]-a[0],h:b[1]-a[1]};};","  const box=toScreen(get('TowerShopBox')[0]),header=toScreen(get('ShopHeaderPlaque')[0]),footer=toScreen(get('ShopFooterFrame')[0]),x=box.x+12,y=header.y+header.h+12,w=box.w-24;","  const placement=f.stage==='placement',phase=placement?'PREVIEW_PLACEMENT':'SELECT_PARTNER',natural=placement?254:174,bodyHeight=Math.max(1,Math.min(natural,footer.y-y-60));","  if(sidebar.phase!==phase){sidebar.scroll=0;sidebar.phase=phase;}","  const cursorX=gdjs.evtTools.input.getCursorX(scene,'FusionUI',0),cursorY=gdjs.evtTools.input.getCursorY(scene,'FusionUI',0);","  sidebar.maxScroll=Math.max(0,natural-bodyHeight);if(cursorX>=x&&cursorX<x+w&&cursorY>=y&&cursorY<y+bodyHeight)sidebar.scroll-=Math.sign(game.getInputManager().getMouseWheelDelta())*30;sidebar.scroll=Math.max(0,Math.min(sidebar.maxScroll,sidebar.scroll));","  sidebar.screenRect={x,y,w,h:bodyHeight};sidebar.root.position.set(x,y-sidebar.scroll);sidebar.root.visible=true;","  const maskKey=[x,y,w,bodyHeight].join(':');if(sidebar.maskKey!==maskKey){sidebar.mask.clear().beginFill(0xffffff).drawRect(x,y,w,bodyHeight).endFill();sidebar.maskKey=maskKey;}","  const g=sidebar.graphics;g.clear();for(const t of sidebar.texts.values())t.visible=false;for(const p of sidebar.portraits.values())p.sprite.visible=false;","  const text=(key,value,tx,ty,width,size=12,color=0xece4fa,bold=false)=>{","   let t=sidebar.texts.get(key);if(!t){t=new PIXI.Text('',{fontFamily:'Arial'});t.interactive=false;sidebar.root.addChild(t);sidebar.texts.set(key,t);}","   t.text=value;t.style.fontSize=size;t.style.fill=color;t.style.fontWeight=bold?'bold':'normal';t.style.wordWrap=true;t.style.wordWrapWidth=width;t.style.breakWords=true;t.position.set(tx,ty);t.visible=true;return t;","  };","  const image=(key,type,animation,frame,locked=false)=>{","   const meta=portraitCatalog[type],fallback=sceneData.objects.find(o=>o.name==='IndexTowerImage')?.animations.find(a=>a.name===animation||a.name===type),resource=meta?.Image||fallback?.directions[0].sprites[0].image;","   let rec=sidebar.portraits.get(key);if(!rec){const sprite=new PIXI.Sprite();sprite.interactive=false;sidebar.root.addChild(sprite);rec={sprite};sidebar.portraits.set(key,rec);}","   if(!resource){rec.sprite.visible=false;return false;}","   const texture=game.getImageManager().getPIXITexture(resource),bounds=meta?.VisualBounds||[0,0,texture.width,texture.height],sprite=rec.sprite;","   sprite.texture=texture;sprite.anchor.set((bounds[0]+bounds[2]/2)/texture.width,(bounds[1]+bounds[3]/2)/texture.height);sprite.scale.set(Math.min(frame.w/bounds[2],frame.h/bounds[3]));sprite.position.set(frame.x+frame.w/2,frame.y+frame.h/2);sprite.rotation=0;sprite.alpha=1;sprite.tint=locked?0x000000:0xffffff;sprite.blendMode=PIXI.BLEND_MODES.NORMAL;sprite.visible=true;Object.assign(rec,{resource,type,frame,locked});return true;","  };","  text('sources','SOURCE TOWERS',0,0,w,10,0xc9b785,true);","  sidebar.sourceEntries=[f.sourceInfo(f.a),f.sourceInfo(f.b)];const cw=(w-24)/2;","  sidebar.sourceEntries.forEach((entry,i)=>{","   const sx=i*(cw+24);g.lineStyle(1,0x655276,.55).beginFill(0x19142c,.85).drawRoundedRect(sx,17,cw,106,8).endFill();text('sourceId'+i,i?'B':'A',sx+8,23,12,9,0xc9b785,true);","   if(entry){if(!image('source'+i,entry.type,entry.type,{x:sx+17,y:25,w:cw-34,h:43}))text('sourceFallback'+i,'?',sx+cw/2-7,35,22,25,0xa698c4);text('sourceName'+i,entry.name,sx+6,73,cw-12,12,0xece4fa,true);text('sourcePath'+i,entry.path1+' - '+entry.path2,sx+cw/2-17,104,50,12,0xcab884,true);}","   else{text('sourceQuestion'+i,'?',sx+cw/2-8,35,24,28,0xa698c4);text('sourceName'+i,'Select',sx+cw/2-18,77,60,12,0xb2a4ca);}","  });","  text('plus','+',cw+6,54,20,22,0xc9b785);","  sidebar.result=null;","  if(placement){","   const resolved=archive.resolve([f.a,f.b]),definition=resolved&&archive.definition(resolved.id),locked=!definition||!archive.has(definition.Id);","   sidebar.result={id:definition?.Id||'',name:locked?'???':definition.Name,locked,cost:config.FusionCost};","   g.lineStyle(1,0x655276,.55).moveTo(0,133).lineTo(w,133);text('evolution','EVOLUTION',0,140,w,10,0xc9b785,true);","   g.beginFill(0x332448,.7).drawRoundedRect(0,158,64,64,9).endFill();if(!image('result',definition?.Id,definition?.Animation,{x:4,y:162,w:56,h:56},locked))text('resultFallback','?',24,174,26,24,0xa698c4);","   text('resultName',sidebar.result.name,74,160,w-74,14,0xeee6ff,true);if(locked)text('resultLock','UNDISCOVERED',74,180,w-74,9,0xa799bb);","   text('cost',config.FusionCost+' Gold',74,201,w-74,13,0xe3ca8d,true);","   let status=f.preview&&!f.preview.valid?f.message(f.preview.reason):f.error||'Place near either source tower';","   if(f.preview?.reason==='obstacle'){","    const radius=p.config('StarCannonTower').Radius,hit=p.blockers.find(c=>Math.hypot(f.preview.x-c.x,f.preview.y-c.y)<=radius+c.r+1e-6);","    const kind=hit?.owner.getVariables().get('Kind').getAsString();status=kind==='Ruin'?'Blocked by Ruins':kind==='Rock'?'Blocked by Rock':kind==='Crystal'?'Blocked by Crystal':f.message('obstacle');","   }","   sidebar.status=status;text('status',status,0,226,w,12,f.preview?.valid?0xafdace:0xeea1b2);","  }else{sidebar.status=f.error||'Select a Max-Level Tower';text('status',sidebar.status,0,143,w,14,f.error?0xeea1b2:0xece4fa,true);}","  // Fixed large hit target stays available even when a short viewport needs body scrolling.","  const cy=y+bodyHeight+10,button=f.ensure('cancel','SelectedPanelPlaque',4);button.setPosition(x,cy);button.setWidth(w);button.setHeight(40);button.setColor('210;190;248');button.hide(false);","  const label=f.ensure('cancelText','IndexText',5);label.setString('Cancel / ESC');label.setCharacterSize(14);label.setBold(true);label.setTextAlignment('center');label.setWrapping(true);label.setWrappingWidth(w);label.setColor('246;235;255');label.setPosition(x,cy+11);label.hide(false);","  f.cancelRect={x,y:cy,w,h:40};f.bannerRect={x,y,w,h:bodyHeight+50};f.hudGraphics.clear();","  f.hudGraphics.lineStyle(1,0xd8ba7d,.95).moveTo(header.x+13,header.y+21).lineTo(header.x+18,header.y+15).lineTo(header.x+23,header.y+21).lineTo(header.x+18,header.y+27).closePath();","  if(sidebar.maxScroll)f.hudGraphics.lineStyle(2,0xb9a0d6,.6).moveTo(x+w+5,y+3).lineTo(x+w+5,y+bodyHeight-3);"," };"," f.eligible=t=>!!t&&get('StarCannonTower').includes(t)&&!star.isFusion(t)&&((t.getVariables().get('Path1Level').getAsNumber()===5&&t.getVariables().get('Path2Level').getAsNumber()===2)||(t.getVariables().get('Path1Level').getAsNumber()===2&&t.getVariables().get('Path2Level').getAsNumber()===5));"," f.pair=(a,b)=>f.eligible(a)&&f.eligible(b)&&a!==b&&a.getVariables().get('Path1Level').getAsNumber()!==b.getVariables().get('Path1Level').getAsNumber();"," f.alive=(t,id)=>!!t&&t.getUniqueId()===id&&get('StarCannonTower').includes(t);"," f.message=reason=>({region:'Outside Fusion Zone',path:'Path blocked',tower:'Occupied',obstacle:'Blocked by obstacle',bounds:'Outside build area','rocky-edge':'Outside build area',gold:'Insufficient Gold',ui:'Move onto the map',pair:'Choose a compatible tower'}[reason]||'Choose a clear spot');"," f.finish=()=>{","  f.active=false;f.stage='idle';f.a=null;f.b=null;f.aId=0;f.bId=0;f.preview=null;f.error='';f.pressed='';sv.get('FusionActive').setBoolean(false);","  f.graphics.clear();f.worldGraphics.clear();f.worldMask.clear();f.worldMaskKey='';f.hudGraphics.clear();f.footprints.clear();f.obstacleFootprints.clear();for(const m of f.markers.values())m.destroy();f.markers.clear();Object.values(f.objects).forEach(o=>o.hide());f.bannerRect=null;f.cancelRect=null;layer.show(false);","  sidebar.root.visible=false;sidebar.scroll=0;sidebar.phase='';sidebar.sourceEntries=[];sidebar.result=null;","  scene.getTimeManager().setTimeScale(f.previousScale||1);f.previousScale=undefined;"," };"," f.cancel=()=>{if(!f.active)return false;f.finish();scene.__audio?.play('UIClick');return true;};"," f.begin=t=>{","  if(f.active||!f.eligible(t)||sv.get('GameOver').getAsBoolean()||sv.get('IndexBlocksInput').getAsBoolean())return false;","  f.previousScale=scene.getTimeManager().getTimeScale();f.active=true;f.stage='partner';f.a=t;f.aId=t.getUniqueId();f.b=null;f.error='';f.wasDown=game.getInputManager().isMouseButtonPressed(0);f.pressed='';","  sv.get('FusionActive').setBoolean(true);sv.get('SelectedTower').setNumber(0);sv.get('IndexOpen').setBoolean(false);scene.__obstaclePanel?.close();p.stop();","  if(scene.__audio){scene.__audio.ui.open=false;scene.__audio.ui.pressed='';}scene.getTimeManager().setTimeScale(config.FusionTimeScale);scene.__audio?.play('UIClick');return true;"," };"," f.choose=t=>{if(!f.active||f.stage!=='partner'||!f.pair(f.a,t)){f.error=f.message('pair');scene.__audio?.play('InvalidAction');return false;}f.b=t;f.bId=t.getUniqueId();f.stage='placement';f.error='';scene.__audio?.play('TowerSelect');return true;};"," f.validate=(x,y)=>{","  if(!f.active||f.stage!=='placement'||!f.alive(f.a,f.aId)||!f.alive(f.b,f.bId)||!f.pair(f.a,f.b))return{valid:false,reason:'pair'};","  if(![f.a,f.b].some(t=>{const c=p.center(t);return Math.hypot(x-c[0],y-c[1])<=config.RegionalRadius;}))return{valid:false,reason:'region'};","  const point=scene.getLayer('').convertInverseCoords(x,y,0,[0,0]);","  if([f.bannerRect,f.cancelRect].some(r=>r&&point[0]>=r.x&&point[0]<r.x+r.w&&point[1]>=r.y&&point[1]<r.y+r.h))return{valid:false,reason:'ui'};","  return p.validate('StarCannonTower',x,y,{ignoreTowers:new Set([f.a,f.b]),cost:config.FusionCost});"," };"," f.confirm=(x,y)=>{","  const valid=f.validate(x,y);if(!valid.valid){f.error=f.message(valid.reason);scene.__audio?.play('InvalidAction');return false;}","  const a=f.a,b=f.b,t=scene.createObject('StarCannonTower');if(!t){f.error='Unable to create tower';return false;}","  const v=t.getVariables(),av=a.getVariables(),bv=b.getVariables(),cost=config.FusionCost,investment=av.get('TotalInvestment').getAsNumber()+bv.get('TotalInvestment').getAsNumber()+cost;","  const id=Math.max(sv.get('NextTowerId').getAsNumber(),...get('StarCannonTower').map(o=>o.getVariables().get('TowerId').getAsNumber()))+1;","  for(const [name,value]of Object.entries({TowerId:id,PurchasePrice:investment,TotalInvestment:investment,DamageDealt:av.get('DamageDealt').getAsNumber()+bv.get('DamageDealt').getAsNumber(),Path1Level:5,Path2Level:2,FootprintX:x,FootprintY:y,FootprintRadius:p.config('StarCannonTower').Radius,FootprintOffsetX:0,FootprintOffsetY:0,ShotCounter:0}))v.get(name).setNumber(value);","  v.get('TowerType').setString('StarburstCannon');v.get('TowerName').setString(config.Name);t.setLayer('');","  try{if(!star.apply(t))throw Error('Invalid fusion stats');}catch(e){t.deleteFromScene();f.error='Fusion could not be completed';return false;}","  const discovery=archive.resolve([a,b]);","  sv.get('NextTowerId').setNumber(id);sv.get('Money').sub(cost);a.deleteFromScene();b.deleteFromScene();if(discovery)archive.discover(discovery.id,discovery.variant);","  f.finish();sv.get('SelectedTower').setNumber(id);scene.__audio?.play('TowerMajorUpgrade');return t;"," };"," f.render=()=>{","  const w=game.getGameResolutionWidth(),h=game.getGameResolutionHeight();layer.setCameraZoom(1);layer.setCameraX(w/2);layer.setCameraY(h/2);layer.show(f.active);if(!f.active)return;","  const g=f.worldGraphics,map=scene.getLayer(''),zoom=map.getCameraZoom(),screen=t=>map.convertInverseCoords(...p.center(t),0,[0,0]),area=scene.__towerShopUI.gameArea;","  f.graphics.clear().beginFill(0x09051b,config.OverlayOpacity).drawRect(area.left,area.top,area.right-area.left,area.bottom-area.top).endFill();g.clear();","  const maskKey=[area.left,area.top,area.right,area.bottom].join(':');if(f.worldMaskKey!==maskKey){f.worldMask.clear().beginFill(0xffffff).drawRect(area.left,area.top,area.right-area.left,area.bottom-area.top).endFill();f.worldMaskKey=maskKey;}","  const markerIds=new Set(),footprintIds=new Set(),obstacleIds=new Set();","  if(f.stage==='placement')for(const collider of p.blockers){","   // These are the exact circles tested by p.validate, including Spawn and Base.","   const {owner,x,y,r}=collider,id=owner.getUniqueId(),point=map.convertInverseCoords(x,y,0,[0,0]),radius=r*zoom,color=0xf2b866;","   g.lineStyle(1.5,color,.85).beginFill(color,.055).drawCircle(point[0],point[1],radius).endFill();","   const top=point[1]-radius;g.lineStyle(1,color,.95).beginFill(0x271a30,.85).drawPolygon([point[0],top-3,point[0]+3,top,point[0],top+3,point[0]-3,top]).endFill();","   const record=f.obstacleFootprints.get(id)||{};Object.assign(record,{id,owner,shape:'circle',x,y,r,screenX:point[0],screenY:point[1],screenRadius:radius,color});f.obstacleFootprints.set(id,record);obstacleIds.add(id);","  }","  for(const id of f.obstacleFootprints.keys())if(!obstacleIds.has(id))f.obstacleFootprints.delete(id);","  for(const t of p.towers()){","   const v=t.getVariables(),max=Math.max(v.get('Path1Level').getAsNumber(),v.get('Path2Level').getAsNumber())===5&&!star.isFusion(t);","   const id=t.getUniqueId(),[x,y]=screen(t),valid=f.pair(f.a,t),selected=t===f.a||t===f.b;","   if(f.stage==='placement'){","    const radius=p.radius(t),color=selected?0x9de8f0:0xf49ab1;","    g.lineStyle(2,color,.95).beginFill(color,selected ? .025 : .045).drawCircle(x,y,radius*zoom).endFill();","    const record=f.footprints.get(id)||{};Object.assign(record,{id,x,y,radius,screenRadius:radius*zoom,color,ignored:selected});f.footprints.set(id,record);footprintIds.add(id);","   }else if(max){const color=selected?0xf5d58d:valid?0x9df1ff:0x8a75aa;g.lineStyle(selected||valid?3:1,color,selected||valid?.95:.4).drawCircle(x,y,(p.radius(t)+5)*zoom);}","   if(!(f.stage==='partner'?max:selected))continue;","   markerIds.add(id);const color=selected?0xf5d58d:valid?0x9df1ff:0x8a75aa;","   let marker=f.markers.get(id);if(!marker){marker=new PIXI.Text('FUSION',{fontFamily:'Arial',fontSize:10,fontWeight:'bold',fill:color,stroke:0x211236,strokeThickness:3});marker.anchor.set(.5,1);marker.zIndex=2;layer.getRenderer().getRendererObject().addChild(marker);f.markers.set(id,marker);}marker.position.set(x,y-(p.radius(t)+8)*zoom);marker.style.fill=color;","  }","  for(const [id,m]of f.markers)if(!markerIds.has(id)){m.destroy();f.markers.delete(id);}","  for(const id of f.footprints.keys())if(!footprintIds.has(id))f.footprints.delete(id);","  if(f.stage==='placement'){","   for(const t of [f.a,f.b]){const [x,y]=screen(t);g.lineStyle(2,0xbfa0ff,.5).beginFill(0x9470d0,.07).drawCircle(x,y,config.RegionalRadius*zoom).endFill();}","   const [x,y]=p.cursor(),result=f.validate(x,y),point=map.convertInverseCoords(x,y,0,[0,0]);if(f.preview&&(f.preview.x!==x||f.preview.y!==y))f.error='';f.preview={x,y,...result};","   const size=88*zoom;f.ghost.setWidth(size);f.ghost.setHeight(size);f.ghost.setPosition(point[0]-size/2,point[1]-size/2);f.ghost.setOpacity(185);f.ghost.setColor(result.valid?'180;255;230':'255;80;105');f.ghost.hide(false);","   g.lineStyle(2,result.valid?0x9aedd5:0xff5b79,.95).drawCircle(...point,p.config('StarCannonTower').Radius*zoom);","  }","  f.renderSidebar();"," };"," f.dispose=()=>{if(f.disposed)return;if(f.active)f.finish();for(const o of Object.values(f.objects))o.deleteFromScene();f.objects={};f.worldGraphics.mask=null;f.worldGraphics.destroy();f.worldMask.destroy();sidebar.root.mask=null;sidebar.root.destroy({children:true,texture:false,baseTexture:false});sidebar.mask.destroy();sidebar.texts.clear();sidebar.portraits.clear();f.hudGraphics.destroy();f.graphics.destroy();f.disposed=true;};"," if(!gdjs.__starburstFusionCallbacks){gdjs.__starburstFusionCallbacks=true;gdjs.callbacksRuntimeSceneUnloading.push(s=>s.__fusion?.dispose());}","}","const input=game.getInputManager(),down=input.isMouseButtonPressed(0);","if(f.active){"," if(!f.alive(f.a,f.aId)||!f.eligible(f.a)||(f.b&&(!f.alive(f.b,f.bId)||!f.pair(f.a,f.b)))||sv.get('GameOver').getAsBoolean())f.cancel();"," else if(gdjs.evtTools.input.wasKeyJustPressed(scene,'Escape'))f.cancel();"," else{","  f.render();const x=gdjs.evtTools.input.getCursorX(scene,'FusionUI',0),y=gdjs.evtTools.input.getCursorY(scene,'FusionUI',0),r=f.cancelRect,cancel=!!r&&x>=r.x&&x<r.x+r.w&&y>=r.y&&y<r.y+r.h;","  if(down&&!f.wasDown)f.pressed=cancel?'cancel':f.stage;","  if(!down&&f.wasDown){","   if(cancel&&f.pressed==='cancel')f.cancel();","   else if(f.pressed===f.stage){const [wx,wy]=p.cursor(),area=scene.__towerShopUI.gameArea,screen=scene.getLayer('').convertInverseCoords(wx,wy,0,[0,0]);","    if(screen[0]>=area.left&&screen[0]<area.right&&screen[1]>=area.top&&screen[1]<area.bottom){","     if(f.stage==='partner'){const target=p.towers().filter(t=>scene.__worldSelection.towerHit(t,wx,wy)).sort((a,b)=>b.getZOrder()-a.getZOrder())[0];f.choose(target);}","     else f.confirm(wx,wy);","    }","   }","   f.pressed='';","  }"," }","}","f.wasDown=down;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// One permanent Fusion discovery source for notification, variants and Index.","// Storage follows the existing audio-settings mechanism; monster session state stays separate.","const scene=runtimeScene,game=scene.getGame(),sv=scene.getVariables(),catalog=sv.get('FusionCatalog').toJSObject();","let archive=game.__fusionArchive;","if(!archive?.persistent){"," const oldFound=[...(archive?.found||[])],key='celestialVoidFusionDiscovery.v1';let state={version:1,entries:{}},storageOK=true,saveNeeded=false;"," try{const raw=JSON.parse(localStorage.getItem(key)||'null');if(raw&&typeof raw==='object'&&!Array.isArray(raw)){state={...raw,entries:raw.entries&&typeof raw.entries==='object'&&!Array.isArray(raw.entries)?raw.entries:{}};state.version=raw.version||1;}}catch(e){storageOK=false;}"," archive=game.__fusionArchive={persistent:true,storageKey:key,state,storageOK,catalog,found:new Set(),revision:0,queue:[],active:null,stats:{unlockedVariants:0,shown:0,completed:0,sounds:0,writes:0}};"," const a=archive;"," a.definition=id=>a.catalog.find(d=>d.Id===id);"," a.recipeKey=parts=>parts.map(p=>{","  if(p?.getVariables){const v=p.getVariables();return(v.get('TowerType').getAsString()==='StarburstCannon'?'StarburstCannon':p.getName())+':'+v.get('Path1Level').getAsNumber()+'-'+v.get('Path2Level').getAsNumber();}","  return p.Type+':'+p.Path1+'-'+p.Path2;"," }).sort().join('|');"," a.resolve=parts=>{const k=a.recipeKey(parts);for(const d of a.catalog)for(const v of d.Variants||[])if(a.recipeKey(v.Recipe)===k)return{id:d.Id,variant:v.Id};return null;};"," a.record=id=>{let r=a.state.entries[id];if(!r||typeof r!=='object'||Array.isArray(r)){r={discovered:r===true,variants:{}};a.state.entries[id]=r;}if(!r.variants||typeof r.variants!=='object'||Array.isArray(r.variants))r.variants={};return r;};"," a.has=id=>a.found.has(id);"," a.hasVariant=(id,variant)=>a.state.entries[id]?.variants?.[variant]===true;"," a.progress=id=>{const d=a.definition(id),variants=d?.Variants||[];return{found:variants.filter(v=>a.hasVariant(id,v.Id)).length,total:variants.length};};"," a.save=()=>{try{localStorage.setItem(key,JSON.stringify(a.state));a.storageOK=true;a.stats.writes++;return true;}catch(e){a.storageOK=false;return false;}};"," const legacy=[...oldFound,...(Array.isArray(state.found)?state.found:[])];"," for(const id of legacy)if(typeof id==='string'){a.record(id).discovered=true;saveNeeded=true;}"," for(const id of Object.keys(state.entries)){","  const r=a.record(id),d=a.definition(id);if(r.discovered===true||Object.values(r.variants).some(v=>v===true)){","   a.found.add(id);r.discovered=true;","   // A legacy Pure unlock implies its sole variant. Hybrid progress never fans out.","   if(d?.Kind==='Pure'&&d.Variants?.length===1&&!Object.keys(r.variants).length){r.variants[d.Variants[0].Id]=true;saveNeeded=true;}","  }"," }"," a.discover=(id,variant)=>{","  const d=a.definition(id);if(!d)return false;","  variant=variant||(d.Kind==='Pure'&&d.Variants.length===1?d.Variants[0].Id:'');","  if(!d.Variants.some(v=>v.Id===variant)||a.hasVariant(id,variant))return false;","  const first=!a.has(id),r=a.record(id);r.discovered=true;r.variants[variant]=true;a.found.add(id);a.revision++;a.stats.unlockedVariants++;a.save();a.queue.push({id,variant,first});scene.__discoveryToast?.enqueue('fusion',a.queue.at(-1));return true;"," };"," a.discoverRecipe=parts=>{const r=a.resolve(parts);return r?{...r,unlocked:a.discover(r.id,r.variant)}:null;};"," if(saveNeeded)a.save();","}","let view=scene.__fusionDiscovery;","if(!view){"," // Refresh definitions on scene reload; records and queue remain one shared source."," archive.catalog=catalog;"," view=scene.__fusionDiscovery={archive,disposed:false};"," const layer=scene.getLayer('DiscoveryUI'),shared=scene.__discoveryToast;"," const visual=shared.create(204);Object.assign(view,visual);const {root,mask}=visual;"," view.bind=event=>{","  const def=archive.definition(event.id),object=game.getSceneAndExtensionsData(scene.getName()).sceneData.objects.find(o=>o.name==='IndexTowerImage'),animation=object.animations.find(a=>a.name===def.Animation);","  const texture=game.getImageManager().getPIXITexture(animation.directions[0].sprites[0].image);view.icon.texture=texture;view.icon.scale.set(Math.min(38/texture.width,40/texture.height));","  view.heading.text=event.first?'NEW DISCOVERY':'NEW VARIANT';view.name.text=event.first?def.Name:def.Variants.find(v=>v.Id===event.variant)?.Name||def.Name;view.name.scale.set(1);view.name.scale.set(Math.min(1,18/Math.max(1,view.name.height),198/Math.max(1,view.name.width)));view.detail.text=def.Kind+' Fusion Archive Updated';view.bound=event;"," };"," view.update=()=>{","  if(view.disposed)return;","  if(sv.get('DefeatActive').getAsBoolean()||sv.get('IndexOpen').getAsBoolean()||scene.__monsterDiscovery?.active||!archive.active&&!shared.canBegin('fusion')){root.visible=false;mask.visible=false;return;}","  const dt=Math.max(0,scene.getTimeManager().getElapsedTime()/Math.max(.001,scene.getTimeManager().getTimeScale())/1000);","  if(archive.active){archive.active.age+=dt;if(archive.active.age>=shared.duration){archive.active=null;archive.stats.completed++;}}","  if(!archive.active&&archive.queue.length&&shared.canBegin('fusion')){const event=archive.queue.shift();shared.take('fusion',event);archive.active={...event,age:0};archive.stats.shown++;if(scene.__audio?.play('DiscoveryUnlock'))archive.stats.sounds++;}","  const active=archive.active;if(!active){root.visible=false;mask.visible=false;return;}if(view.bound!==active)view.bind(active);","  layer.setCameraZoom(1);layer.setCameraX(game.getGameResolutionWidth()/2);layer.setCameraY(game.getGameResolutionHeight()/2);","  shared.paint(view,active.age);"," };"," view.dispose=()=>{if(view.disposed)return;view.disposed=true;root.mask=null;root.destroy({children:true,texture:false,baseTexture:false});mask.destroy();};"," if(!gdjs.__fusionArchiveCallbacks){gdjs.__fusionArchiveCallbacks=true;gdjs.callbacksRuntimeScenePostEvents.push(s=>s.__fusionDiscovery?.update());gdjs.callbacksRuntimeSceneUnloading.push(s=>s.__fusionDiscovery?.dispose());}","}"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Initialized only for a mission launched by Levels. Direct gameplay preview","// retains the existing 45-wave sandbox and its authored starting values.","const scene=runtimeScene,game=scene.getGame(),C=game.__campaign,sv=scene.getVariables();","if(!C?.active||!C.available(C.active))return;","let r=scene.__campaignRun;","if(!r){"," const level=C.known.get(C.active),chapter=C.config.Chapters[level.Chapter-1],u=game.__campaignWidgets(scene),destroyUI=u.dispose;"," r=scene.__campaignRun=Object.assign(u,{scene,level,chapter,stage:level.Tutorial&&!C.save.GameTutorialDone?0:-1,now:0,realAge:0,killCount:0,started:new Set(),pendingWave:false,boss:null,bossKilled:false,bossEscaped:false,finished:false,resultAge:0,transition:null,disposed:false});"," sv.get('Money').setNumber(level.StartingGold);sv.get('Lives').setNumber(level.StartingLives);sv.get('MaximumWave').setNumber(level.Waves.length);sv.get('CampaignLevelId').setString(level.Id);sv.get('WaveMode').setString('Waiting');"," r.coach=new PIXI.Container();u.root.addChild(r.coach);r.shade=new PIXI.Graphics();r.plate=new PIXI.Graphics();r.coach.addChild(r.shade,r.plate);r.title=u.text('',17,0xead5a5,true,r.coach);r.body=u.text('',13,0xc7cde1,false,r.coach);r.next=u.button('next','CONTINUE',r.coach);r.skip=u.button('skip','SKIP',r.coach);"," r.result=new PIXI.Container();u.root.addChild(r.result);r.resultShade=new PIXI.Graphics();r.result.addChild(r.resultShade);r.resultTitle=u.text('',33,0xf0e1b3,true,r.result);r.resultInfo=u.text('',15,0xbdcce1,false,r.result);r.resultProgress=u.text('',12,0xc8ba94,false,r.result);r.resultButtons=[u.button('nextmission','NEXT MISSION',r.result),u.button('levels','RETURN TO LEVELS',r.result),u.button('menu','MAIN MENU',r.result)];"," r.bossUI=new PIXI.Container();u.root.addChild(r.bossUI);r.bossPanel=new PIXI.Graphics();r.bossUI.addChild(r.bossPanel);r.bossName=u.text('',14,0xe9cb97,true,r.bossUI);r.bossHealth=u.text('',10,0xcdd6ed,false,r.bossUI);r.bossHint=u.text('',11,0xc0c4dc,false,r.bossUI);r.bossRing=new PIXI.Graphics();r.bossRing.zIndex=11980;scene.getLayer('').getRenderer().getRendererObject().addChild(r.bossRing);"," r.wavePlan=wave=>{","  const spec=level.Waves[wave-1];if(!spec)throw Error('Campaign wave outside mission configuration');const queue=[];for(const [type,count]of Object.entries(spec.Enemies))for(let i=0;i<count;i++)queue.push(type);","  let seed=level.Index*777+wave;for(let i=queue.length-1;i>0;i--){seed=(Math.imul(seed,1664525)+1013904223)>>>0;const j=seed%(i+1);[queue[i],queue[j]]=[queue[j],queue[i]];}","  if(spec.Boss)queue.unshift('VoidGolem');r.started.add(wave);const budget=queue.reduce((n,t,i)=>n+(spec.Boss&&i===0?chapter.Boss.Reward:sv.get('EnemyTypes').getChild(t).getChild('Reward').getAsNumber()),0);return{wave,queue,budget,spent:budget,unused:0,milestone:spec.Boss||wave%5===0,bossIndex:spec.Boss?0:-1,campaign:true,expectedIncome:spec.ExpectedGold};"," };"," r.canStart=wave=>r.stage<0||r.stage>=5&&wave===1;"," r.spawned=(enemy,type,index)=>{","  const spec=level.Waves[sv.get('Wave').getAsNumber()-1];if(!spec)return;const v=enemy.getVariables(),health=enemy.getBehavior('Health'),stats=sv.get('EnemyTypes').getChild(type).toJSObject();","  const hp=Math.ceil(stats.HP*spec.HealthScale);v.get('CampaignBoss').setBoolean(false);health.SetMaxHealth(hp);health.SetHealth(hp);v.get('MoveSpeed').setNumber(stats.Speed*spec.SpeedScale);for(const key of ['__novaState','__houndState','__voidCommonState','__golemState'])if(enemy[key])enemy[key].lastHP=hp;","  if(!spec.Boss||index!==0)return;","  const boss=chapter.Boss;health.SetMaxHealth(boss.HP);health.SetHealth(boss.HP);health.SetFlatDamageReduction(boss.Armor);v.get('MoveSpeed').setNumber(boss.Speed);v.get('GoldReward').setNumber(boss.Reward);v.get('EnemyName').setString(boss.Name);v.get('CampaignBoss').setBoolean(true);v.get('BaseArmor').setNumber(boss.Armor);v.get('Armor').setNumber(boss.Armor);","  const rec=scene.__voidGolem.fort.members.get(enemy.getUniqueId());if(rec){rec.baseArmor=boss.Armor;scene.__voidGolem.fort.armor(rec);}const state=enemy.__golemState;state.lastHP=boss.HP;state.nextCast=scene.__voidGolem.frameTime+boss.CastCooldown;","  r.boss={id:enemy.getUniqueId(),enemy,config:boss,shieldUntil:0,surgeUntil:0,castCount:0,releaseCount:0,reservesQueued:false,age:0};","  const cleanup=()=>{if(!health.IsDead()&&v.get('PathFinished').getAsBoolean()){r.bossEscaped=true;sv.get('Lives').setNumber(0);}enemy.unregisterDestroyCallback(cleanup);};enemy.registerDestroyCallback(cleanup);","  // Existing milestone-wave audio introduces the encounter once.","  if(!r.bossPortrait){r.bossPortrait=new PIXI.Sprite(scene.__voidGolem.texture('Down','Idle',0));r.bossPortrait.anchor.set(.5);r.bossUI.addChild(r.bossPortrait);}"," };"," r.defeated=enemy=>{r.killCount++;if(enemy.getUniqueId()===r.boss?.id&&enemy.getVariables().get('CampaignBoss').getAsBoolean())r.bossKilled=true;};"," r.validVictory=()=>sv.get('GameOver').getAsBoolean()&&sv.get('Lives').getAsNumber()>0&&sv.get('Wave').getAsNumber()>=level.Waves.length&&sv.get('LastRewardedWave').getAsNumber()>=level.Waves.length&&r.started.size===level.Waves.length&&!scene.getObjects('Enemy').length&&scene.__waveManager?.index>=scene.__waveManager?.queue.length&&(!level.Boss||r.bossKilled)&&!r.bossEscaped;"," r.leave=(target,id)=>{if(r.transition)return false;if(id&&!C.launch(id))return false;scene.__audio?.play('UIClick');r.transition={target,age:0};return true;};"," r.before=()=>{","  const tutorial=r.stage>=0&&!r.finished&&!sv.get('DefeatActive').getAsBoolean(),modal=r.finished||tutorial&&[0,3,4,6,8].includes(r.stage),paused=r.finished||tutorial&&[0,3,4,6,7,8].includes(r.stage);","  sv.get('CampaignTutorialActive').setBoolean(tutorial);sv.get('CampaignModal').setBoolean(modal);sv.get('CampaignCombatPaused').setBoolean(paused&&!!scene.__starCannon);sv.get('MaximumWave').setNumber(level.Waves.length);","  const mx=gdjs.evtTools.input.getCursorX(scene,'CampaignUI',0),my=gdjs.evtTools.input.getCursorY(scene,'CampaignUI',0),p=r.panelRect;sv.get('CampaignUIConsumesClick').setBoolean(tutorial&&!!p&&mx>=p.x&&mx<p.x+p.w&&my>=p.y&&my<p.y+p.h||r.finished);","  if(modal||sv.get('CampaignUIConsumesClick').getAsBoolean()){const down=game.getInputManager().isMouseButtonPressed(0);if(scene.__freePlacement)scene.__freePlacement.wasDown=down;sv.get('TowerPointerWasDown').setBoolean(down);}","  if(!sv.get('DefeatActive').getAsBoolean())scene.getLayer('').setTimeScale(paused?0:1);","  if(tutorial&&r.stage===7&&!sv.get('IndexOpen').getAsBoolean()&&scene.getObjects('StarCannonTower').length)sv.get('SelectedTower').setNumber(scene.getObjects('StarCannonTower')[0].getVariables().get('TowerId').getAsNumber());","  // Reserve the opening defense budget until the required first placement.","  if(tutorial&&r.stage<=2){scene.__obstaclePanel?.close();const request=sv.get('TowerShopRequestedType').getAsString();if(request&&request!=='StarCannonTower')sv.get('TowerShopRequestedType').setString('');}"," };"," r.bossTick=dt=>{","  const b=r.boss;r.bossRing.clear();if(!b||b.enemy.getUniqueId()!==b.id)return;const e=b.enemy,h=e.getBehavior('Health'),state=e.__golemState,c=b.config;if(h.IsDead()||!scene.getObjects('Enemy').includes(e)){if(h.IsDead())r.bossKilled=true;return;}","  b.age+=dt;if(state.castCount>b.castCount){b.castCount=state.castCount;state.nextCast=state.castStart+c.CastCooldown;}","  if(state.releaseCount>b.releaseCount){b.releaseCount=state.releaseCount;b.shieldUntil=r.now+c.ShieldSeconds;b.surgeUntil=r.now+c.SurgeSeconds;}","  h.SetPercentDamageReduction(r.now<b.shieldUntil?c.ShieldPercent/100:0);e.getVariables().get('MoveSpeed').setNumber(c.Speed*(r.now<b.surgeUntil?c.SurgeMultiplier:1));","  if(!b.reservesQueued&&c.Reserves.length&&h.Health()/h.MaxHealth()<=c.ReserveThreshold){b.reservesQueued=true;b.reservesNoticeUntil=r.now+3;const m=scene.__waveManager,price=c.Reserves.reduce((n,t)=>n+sv.get('EnemyTypes').getChild(t).getChild('Reward').getAsNumber(),0);m.queue.push(...c.Reserves);m.elapsed=0;m.composition.budget+=price;m.composition.spent+=price;sv.get('WaveBudget').add(price);sv.get('WaveBudgetSpent').add(price);sv.get('EnemiesToSpawn').setNumber(m.queue.length-m.index);sv.get('WaveSpawningFinished').setBoolean(false);sv.get('WaveEnemyCount').add(c.Reserves.length);}","  if(state.casting||r.now<b.shieldUntil||b.age<1.3){const x=e.getCenterXInScene(),y=e.getCenterYInScene(),entrance=b.age<1.3;r.bossRing.lineStyle(2,state.casting?0xd4a3ed:0x91cce4,entrance?1-b.age/1.3:.75).beginFill(0x8d6bc9,.05).drawCircle(x,y,entrance?30+75*b.age/1.3:state.casting?100:74).endFill();}"," };"," r.advance=()=>{scene.__audio?.play('UIClick');if(r.stage===4)r.pendingWave=true;if(r.stage===8){C.tutorialDone('GameTutorialDone');r.stage=-1;}else r.stage++;};"," r.after=()=>{","  if(r.disposed)return;const time=scene.getTimeManager(),dt=Math.min(.2,Math.max(0,time.getElapsedTime()/1000)),real=time.getTimeScale()>0?dt/time.getTimeScale():0;r.realAge+=real;","  if(r.bossEscaped){sv.get('Lives').setNumber(0);scene.getObjects('LivesText')[0]?.setString('0');}","  if(sv.get('CampaignCombatPaused').getAsBoolean()){scene.getObjects('MoneyText')[0]?.setString(String(sv.get('Money').getAsNumber()));scene.getObjects('LivesText')[0]?.setString(String(sv.get('Lives').getAsNumber()));}","  if(sv.get('DefeatActive').getAsBoolean()){r.coach.visible=false;r.bossUI.visible=false;r.result.visible=false;r.bossRing.clear();return;}","  if(!sv.get('CampaignCombatPaused').getAsBoolean()){r.now+=dt;r.bossTick(dt);}","  if(!r.finished&&r.validVictory()){r.finished=true;C.complete(r);scene.__fusion?.finish();scene.__freePlacement?.stop();sv.get('SelectedTower').setNumber(0);sv.get('IndexOpen').setBoolean(false);for(const o of scene.getObjects('MessageText'))o.hide();r.before();}","  const {W,H,s,display}=r.screen(),font=(n,min=9)=>Math.max(n*s,min/display),layer=scene.getLayer('CampaignUI');layer.show(true);layer.setCameraZoom(1);layer.setCameraX(W/2);layer.setCameraY(H/2);","  if(r.stage===1&&scene.__freePlacement?.active&&scene.__freePlacement.type==='StarCannonTower')r.stage=2;","  if(r.stage===2&&sv.get('PlacementCommitted').getAsBoolean()&&scene.getObjects('StarCannonTower').length)r.stage=3;","  if(r.stage===5&&r.killCount>0)r.stage=6;","  r.bossUI.visible=!!r.boss&&!r.bossKilled&&!r.finished&&r.boss.enemy.getUniqueId()===r.boss.id;r.coach.visible=r.stage>=0&&!r.finished&&!sv.get('IndexOpen').getAsBoolean()&&!sv.get('AudioPanelOpen').getAsBoolean();r.result.visible=r.finished;","  if(r.bossUI.visible){const b=r.boss,e=b.enemy,h=e.getBehavior('Health'),mw=scene.__towerShopUI?.sidebarX||W,bw=Math.min(400*s,mw*.55),cx=mw/2,hud=scene.getObjects('HUDPanel')[0],hudBottom=hud?scene.getLayer('UI').convertInverseCoords(hud.getX(),hud.getY()+hud.getHeight(),0,[0,0])[1]:56,notices=[scene.__monsterDiscovery?.root,scene.__fusionDiscovery?.root].filter(n=>n?.visible).map(n=>n.getBounds().bottom).filter(Number.isFinite),y=Math.max(83*s,hudBottom+28*s,...notices.map(bottom=>bottom+32*s));const ratio=Math.max(0,h.Health()/h.MaxHealth());r.bossPanel.clear().lineStyle(1,0xb59c69,.75).beginFill(0x0c1025,.92).drawRoundedRect(cx-bw/2-14*s,y-24*s,bw+28*s,70*s,6*s).endFill().beginFill(0x332b47).drawRoundedRect(cx-bw/2,y+6*s,bw,9*s,3*s).endFill().beginFill(0xb59bda).drawRoundedRect(cx-bw/2,y+6*s,Math.max(1,bw*ratio),9*s,3*s).endFill();r.bossName.text=b.config.Name.toUpperCase();r.bossName.style.fontSize=font(14,10);r.bossName.position.set(cx,y-9*s);r.bossHealth.text=Math.max(0,Math.ceil(h.Health()))+' / '+h.MaxHealth();r.bossHealth.style.fontSize=font(10,8);r.bossHealth.position.set(cx,y+11*s);r.bossHint.text=e.__golemState.casting?'VOID PULSE - CASTING':r.now<b.shieldUntil?'NEBULA SHIELD ACTIVE':r.now<b.surgeUntil&&b.config.SurgeMultiplier>1?'HORIZON SURGE':b.age<3?'BOSS INBOUND - HOLD THE FINISH':r.now<(b.reservesNoticeUntil||0)?'REINFORCEMENTS INBOUND':b.config.Reserves.length&&!b.reservesQueued?'REINFORCEMENTS AT 50% HP':'DESTROY BEFORE IT REACHES THE FINISH';r.bossHint.style.fontSize=font(10,8);r.bossHint.position.set(cx,y+31*s);r.bossPortrait.position.set(cx-bw/2-35*s,y);r.bossPortrait.scale.set(52*s/r.bossPortrait.texture.height);}","  const allowed=[];","  if(r.coach.visible){","   const steps=[['DEFEND THE COSMOS','Enemies follow the path toward the Finish. Stop them before they escape.'],['STEP 1 - SELECT YOUR TOWER','Choose the Star Cannon in the Tower Shop to prepare your first defense.'],['STEP 2 - PLACE YOUR DEFENSE','Deploy on clear ground. Roads, ruins and other towers remain blocked.'],['STEP 3 - TARGET ACQUIRED','Your Tower tracks enemies in range and attacks automatically.'],['INCOMING CONTACT','Watch your Star Cannon aim, fire and defend the path.'],['FIRST ENGAGEMENT','Defeat an enemy to observe its real Gold reward.'],['RESOURCE ACQUIRED','Defeating enemies earns Gold. Spend it wisely to strengthen your defenses.'],['UPGRADE YOUR DEFENSE','Use the selected Tower panel to upgrade. You can also continue when ready.'],['TRAINING COMPLETE','Your campaign begins now, Commander. Use PLAY to begin each remaining wave.']];const [title,defaultBody]=steps[r.stage];let body=defaultBody,upgradePath=-1;if(r.stage===7){const t=scene.getObjects('StarCannonTower')[0];if(t){const v=t.getVariables();for(const [i,name]of ['Path1Level','Path2Level'].entries()){const next=scene.__starCannon.config.Paths[i].Upgrades[v.get(name).getAsNumber()];if(next&&next.Cost<=sv.get('Money').getAsNumber()){upgradePath=i;break;}}}if(upgradePath<0)body='Upgrades cost Gold. Earn more from enemies, then improve your Tower. You can continue now.';}","   const panelW=Math.min(480*s,W-36*s),panelH=Math.max(142*s,91/display),x=18*s,y=H-panelH-20*s;r.panelRect={x,y,w:panelW,h:panelH};r.shade.clear();let target;","   const screenRect=o=>{const l=scene.getLayer(o.getLayer()),a=l.convertInverseCoords(o.getX(),o.getY(),0,[0,0]),b=l.convertInverseCoords(o.getX()+o.getWidth(),o.getY()+o.getHeight(),0,[0,0]);return{x:a[0],y:a[1],w:b[0]-a[0],h:b[1]-a[1]};};","   if(r.stage===1)target=screenRect(scene.__towerShopUI.cards[0].background);","   else if(r.stage===2&&scene.__freePlacement?.active){const o=scene.getObjects('TilePlacement_Indicator')[0];if(o)target=screenRect(o);}","   else if(r.stage===3&&scene.getObjects('StarCannonTower')[0]){target=screenRect(scene.getObjects('StarCannonTower')[0]);}","   else if(r.stage===7&&upgradePath>=0&&scene.__selectedPanel?.cards[upgradePath]?.background)target=screenRect(scene.__selectedPanel.cards[upgradePath].background);","   else if(r.stage===0){const map=scene.__towerShopUI;target={x:map.left,y:map.top,w:map.right-map.left,h:map.bottom-map.top};}","   if([0,1,2,3,7].includes(r.stage)){r.shade.beginFill(0x030512,[1,2].includes(r.stage)?.26:.5).drawRect(0,0,W,H);if(target&&target.w>0&&target.h>0)r.shade.beginHole().drawRoundedRect(target.x-7*s,target.y-7*s,target.w+14*s,target.h+14*s,8*s).endHole();r.shade.endFill();}","   if(r.stage===0){const map=scene.getLayer(''),points=sv.get('MonsterPathPoints').toJSObject().map(p=>map.convertInverseCoords(p.X,p.Y,0,[0,0]));r.shade.lineStyle(2*s,0x9ccfeb,.65);points.forEach((p,i)=>i?r.shade.lineTo(p[0],p[1]):r.shade.moveTo(p[0],p[1]));const finish=points.at(-1);if(finish)r.shade.drawCircle(finish[0],finish[1],22*s);}","   if(r.stage===3&&scene.getObjects('StarCannonTower')[0]){const t=scene.getObjects('StarCannonTower')[0],v=t.getVariables(),map=scene.getLayer(''),center=scene.__freePlacement.center(t),p=map.convertInverseCoords(center[0],center[1],0,[0,0]),stats=scene.__starCannon.stats(v.get('Path1Level').getAsNumber(),v.get('Path2Level').getAsNumber());r.shade.lineStyle(1.5*s,0x9ccfeb,.6).drawCircle(p[0],p[1],stats.AttackRange*map.getCameraZoom());}","   r.plate.clear().lineStyle(1,0xb99d69,.9).beginFill(0x0f1329,.97).drawRoundedRect(x,y,panelW,panelH,8*s).endFill();r.title.text=title;r.title.style.fontSize=font(16,11);r.title.position.set(x+panelW/2,y+panelH*.18);r.body.text=body;r.body.style.fontSize=font(13,9);r.body.style.wordWrap=true;r.body.style.wordWrapWidth=panelW-28*s;r.body.position.set(x+panelW/2,y+panelH*.47);","   r.place(r.next,x+panelW*.72,y+panelH*.82,panelW*.46,Math.max(28*s,22/display),font(11,9));r.next.text.text=r.stage===4?'BEGIN WAVE':r.stage===8?'CONTINUE MISSION':'CONTINUE';r.next.visible=![1,2,5].includes(r.stage);r.place(r.skip,x+panelW*.23,y+panelH*.82,panelW*.25,Math.max(28*s,22/display),font(10,8));r.skip.visible=true;if(r.next.visible)allowed.push(r.next);allowed.push(r.skip);","  }else r.panelRect=null;","  if(r.finished){","   r.resultAge+=real;r.result.alpha=Math.min(1,r.resultAge/.4);r.resultShade.clear().beginFill(0x050719,.78).drawRect(0,0,W,H).endFill();r.resultTitle.text=level.Index===C.config.Levels.length?'CAMPAIGN COMPLETE':level.Boss?'BOSS DEFEATED':'MISSION COMPLETE';r.resultTitle.position.set(W/2,H/2-133*s);r.resultTitle.style.fontSize=font(32,18);r.resultInfo.text=level.Id+'  /  '+level.Name;r.resultInfo.position.set(W/2,H/2-85*s);r.resultInfo.style.fontSize=font(16,11);r.resultProgress.text=sv.get('Lives').getAsNumber()+' LIVES REMAINING  /  '+Object.keys(C.save.Completed).length+' OF '+C.config.Levels.length+' MISSIONS COMPLETE';r.resultProgress.position.set(W/2,H/2-48*s);r.resultProgress.style.fontSize=font(12,9);r.resultButtons.forEach((b,i)=>{r.place(b,W/2,H/2+(20+72*i)*s,300*s,Math.max(48*s,28/display),font(14,10));b.visible=i!==0||level.Index<C.config.Levels.length;b.enabled=i!==0||C.available(C.config.Levels[level.Index]?.Id);if(b.visible)allowed.push(b);});","  }","  const action=r.input(r.transition?[]:allowed);for(const b of [r.next,r.skip,...r.resultButtons])r.paint(b,r.hover===b.id);","  if(action==='next')r.advance();else if(action==='skip'){C.tutorialDone('GameTutorialDone');r.stage=-1;scene.__audio?.play('UIClick');}else if(action==='levels')r.leave(C.config.LevelsScene);else if(action==='menu')r.leave(C.config.MenuScene);else if(action==='nextmission')r.leave(C.config.GameplayScene,C.config.Levels[level.Index].Id);","  if(r.transition){r.transition.age+=real;r.root.alpha=Math.max(0,1-r.transition.age/.3);if(r.transition.age>=.3&&!r.transition.requested){r.transition.requested=true;gdjs.evtTools.runtimeScene.replaceScene(scene,r.transition.target,false);}}","  r.before();"," };"," r.dispose=()=>{if(r.disposed)return;r.disposed=true;if(r.transition)game.__starfallMenuAudioReady=!!scene.__audio?.unlocked;r.bossRing.destroy();destroyUI();};","}","r.before();"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// A development-only economy/upgrade UI. Native prices, recipes and validation own all transactions.","const scene=runtimeScene,sv=scene.getVariables(),game=scene.getGame();","if(!scene.__devCheats&&sv.get('DEV_CHEATS_ENABLED').getAsBoolean()&&game.isPreview?.()===true){"," const config=sv.get('DevCheatConfig').toJSObject(),layer=scene.getLayer('DeveloperUI'),root=new PIXI.Container();root.interactive=false;root.interactiveChildren=false;layer.getRenderer().getRendererObject().addChild(root);"," const d=scene.__devCheats={config,root,open:false,disposed:false,scroll:0,down:game.getInputManager().isMouseButtonPressed(0),captured:false,pressed:'',pending:'',path:1,selectedId:0,notice:'Session tools / normal prices apply',noticeAge:0,buttons:[],lastDisplay:1};"," d.enabled=()=>!d.disposed&&sv.get('DEV_CHEATS_ENABLED').getAsBoolean()&&game.isPreview?.()===true;"," d.obscured=()=>sv.get('GameOver').getAsBoolean()||sv.get('DefeatActive').getAsBoolean()||sv.get('IndexOpen').getAsBoolean()||sv.get('AudioPanelOpen').getAsBoolean()||sv.get('FusionActive').getAsBoolean();"," d.feedback=(message,error=false)=>{d.notice=message;d.error=error;d.noticeAge=config.FeedbackSeconds;};"," d.guard=(allowTutorial=false)=>{if(!d.enabled()){d.feedback('Developer Cheats Disabled',true);return false;}if(d.obscured()||!allowTutorial&&sv.get('CampaignTutorialActive').getAsBoolean()){d.feedback('Close the active modal / testing flow first',true);return false;}return !d.resetting;};"," d.amount=raw=>{const value=String(raw??'').trim();if(!/^[1-9]\\d*$/.test(value))return null;const n=Number(value),limit=Math.min(Number.MAX_SAFE_INTEGER,Number(config.GoldLimit));return Number.isSafeInteger(n)&&Number.isFinite(limit)&&limit>0&&n<=limit?n:null;};"," d.moneyHUD=()=>{for(const text of scene.getObjects('MoneyText'))text.setString(String(sv.get('Money').getAsNumber()));};"," d.gold=(raw,set=false)=>{","  if(!d.guard())return false;const n=d.amount(raw),before=sv.get('Money').getAsNumber(),limit=Math.min(Number.MAX_SAFE_INTEGER,Number(config.GoldLimit));","  if(n===null||!Number.isSafeInteger(before)||before<0||!Number.isSafeInteger(set?n:before+n)||(set?n:before+n)>limit){d.feedback('Invalid Gold Amount / limit '+Number(limit).toLocaleString('en-US'),true);return false;}","  sv.get('Money').setNumber(set?n:before+n);d.moneyHUD();d.feedback((set?'SET ': '+')+n.toLocaleString('en-US')+' DEV GOLD');scene.__audio?.play('UIClick');return true;"," };"," d.addGold=raw=>d.gold(raw,false);d.setGold=raw=>d.gold(raw,true);"," d.selected=()=>[...scene.getObjects('StarCannonTower'),...scene.getObjects('NebulaBloomTower')].find(t=>t.getVariables().get('TowerId').getAsNumber()===sv.get('SelectedTower').getAsNumber());"," d.controller=t=>t?.getName()==='NebulaBloomTower'?scene.__nebulaBloom:scene.__starCannon;"," d.target=()=>{const star=d.controller(d.selected()),max=star?.config.MaxLevel;if(!Number.isInteger(max))return null;let cross=-1;for(let n=0;n<=max;n++)if(star.valid(max,n)&&star.valid(n,max))cross=n;return cross<0?null:d.path===1?[max,cross]:[cross,max];};"," d.setPath=path=>{if(!d.guard()||![1,2].includes(path))return false;d.path=path;return true;};"," d.maxSelected=()=>{","  if(!d.guard())return false;const tower=d.selected(),star=d.controller(tower);","  if(!tower){d.feedback('No Tower Selected',true);return false;}","  if(!star||star.isFusion(tower)){d.feedback('Selected Tower has no supported upgrade path',true);return false;}","  const target=d.target(),v=tower.getVariables(),current=[v.get('Path1Level').getAsNumber(),v.get('Path2Level').getAsNumber()];","  if(!target||!star.valid(...current)||!star.valid(...target)||current.some((n,i)=>n>target[i])){d.feedback('Path Locked / choose the other legal build',true);return false;}","  if(current.every((n,i)=>n===target[i])){d.feedback('Tower Already Maxed');return false;}","  let cost=0;const sequence=[];","  for(let path=0;path<2;path++)for(let n=current[path];n<target[path];n++){const upgrade=star.config.Paths[path]?.Upgrades[n];if(!Number.isSafeInteger(upgrade?.Cost)||upgrade.Cost<0){d.feedback('Unsupported Tower upgrade configuration',true);return false;}cost+=upgrade.Cost;sequence.push(path+1);}","  if(sv.get('Money').getAsNumber()<cost){d.feedback('Need '+(cost-sv.get('Money').getAsNumber()).toLocaleString('en-US')+' more Gold',true);return false;}","  for(const path of sequence){if(!d.enabled()||!star.upgrade(tower,path)){d.moneyHUD();d.feedback('Upgrade stopped by native validation',true);return false;}}","  d.moneyHUD();star.render();scene.__selectedPanel?.render();d.feedback('Tower Maxed / '+target.join('-')+' / '+cost.toLocaleString('en-US')+' Gold spent');return true;"," };"," d.startFusion=()=>{if(!d.guard())return false;const tower=d.selected();if(!tower){d.feedback('No Tower Selected',true);return false;}if(tower.getName()==='NebulaBloomTower'){d.feedback('Nebula Bloom has no Fusion in this build',true);return false;}if(!scene.__fusion?.eligible(tower)){d.feedback('Fusion needs a legal 5-2 or 2-5 source',true);return false;}if(!scene.__fusion.begin(tower)){d.feedback('Fusion unavailable',true);return false;}d.close();return true;};"," d.text=(value,size=12,color=0xcdd2e8,bold=false,parent=root)=>{const t=new PIXI.Text(value,{fontFamily:'Arial',fontSize:size,fill:color,fontWeight:bold?'bold':'normal'});parent.addChild(t);return t;};"," d.button=(id,label,parent=root)=>{const container=new PIXI.Container(),frame=new PIXI.Graphics();container.addChild(frame);parent.addChild(container);const text=d.text(label,12,0xe2e2f0,true,container);text.anchor.set(.5);const b={id,container,frame,text};d.buttons.push(b);return b;};"," d.place=(b,x,y,w,h)=>{b.r={x,y,w,h};b.container.position.set(x,y);b.text.position.set(w/2,h/2);};"," d.paint=(b,hot=false,active=false)=>{if(!b.r)return;const {w,h}=b.r,key=[w,h,hot,active].join(':');if(b.key===key)return;b.key=key;b.frame.clear().lineStyle(1,b.danger?0xc58b82:active?0xa7cae9:hot?0xb5a8dc:0x60527e,.9).beginFill(b.danger?(hot?0x63354d:0x3b253e):active?0x353052:hot?0x302747:0x1a1b35,.97).drawRoundedRect(0,0,w,h,5).endFill();};"," d.launcher=d.button('toggle','DEV');d.launcher.text.style.fontSize=10;"," d.panel=new PIXI.Container();root.addChild(d.panel);d.frame=new PIXI.Graphics();d.panel.addChild(d.frame);d.title=d.text('DEVELOPER TOOLS',14,0xddcff1,true,d.panel);d.subtitle=d.text('SESSION TESTING',9,0x88bed1,false,d.panel);d.exit=d.button('close','X',d.panel);"," d.body=new PIXI.Container();d.content=new PIXI.Container();d.mask=new PIXI.Graphics();d.panel.addChild(d.body,d.mask);d.body.addChild(d.content);d.body.mask=d.mask;"," d.balance=d.text('',13,0xe5d7a7,true,d.content);d.goldLabel=d.text('GOLD CONTROLS',10,0x91c6da,true,d.content);d.presets=[1000,5000,10000,50000].map(n=>d.button('gold'+n,'+'+n.toLocaleString('en-US'),d.content));"," d.customLabel=d.text('CUSTOM AMOUNT',10,0xaeb7d3,true,d.content);d.inputFrame=new PIXI.Graphics();d.content.addChild(d.inputFrame);d.add=d.button('add','ADD GOLD',d.content);d.set=d.button('set','SET BALANCE',d.content);d.limit=d.text('',9,0x9399b5,false,d.content);"," d.towerLabel=d.text('TOWER TESTING',10,0x91c6da,true,d.content);d.towerName=d.text('',12,0xd9d8e6,false,d.content);d.paths=[d.button('path1','5 - 2',d.content),d.button('path2','2 - 5',d.content)];d.max=d.button('max','MAX SELECTED TOWER',d.content);d.costNote=d.text('Uses real upgrade costs and legal path locks.',10,0x999fbb,false,d.content);"," d.fusionLabel=d.text('FUSION TESTING',10,0x91c6da,true,d.content);d.fusion=d.button('fusion','START NORMAL FUSION',d.content);d.fusionNote=d.text('Use the real recipe, partner and placement controls.\\nDiscovery overrides are not applied.',10,0x999fbb,false,d.content);"," d.freshLabel=d.text('PROGRESS RESET',10,0xe3ae9f,true,d.content);d.fresh=d.button('fresh','FRESH START',d.content);d.fresh.danger=true;"," d.dialog=new PIXI.Container();root.addChild(d.dialog);d.dialog.visible=false;d.shade=new PIXI.Graphics();d.dialogFrame=new PIXI.Graphics();d.dialog.addChild(d.shade,d.dialogFrame);d.dialogTitle=d.text('Start a Fresh Game?',18,0xf1ddbd,true,d.dialog);d.dialogBody=d.text('This will erase your current game progress and return you to the beginning. All unlocked content and discoveries will be reset, and the tutorial will play again. This action cannot be undone.',13,0xcdd2e8,false,d.dialog);d.dialogBody.style.wordWrap=true;"," d.dialogNote=d.text('Audio and other player settings are kept.',11,0x94ccdc,false,d.dialog);d.dialogNote.style.wordWrap=true;d.cancelReset=d.button('cancelReset','CANCEL',d.dialog);d.confirmReset=d.button('confirmReset','CONFIRM FRESH START',d.dialog);d.confirmReset.danger=true;"," d.askFresh=()=>{if(!d.guard(true)||d.confirming)return false;d.confirming=true;d.resetError='';d.pressed='';d.pending='';d.input?.blur();scene.__audio?.play('UIClick');return true;};"," d.cancelFresh=()=>{if(d.resetting)return false;d.confirming=false;d.resetError='';d.pressed='';d.pending='';return true;};"," d.freshStart=()=>{","  if(!d.confirming||!d.guard(true))return false;d.resetting=true;","  const service=game.__freshStart;","  if(!service?.commit()){d.resetting=false;d.resetError=service?.error||'Fresh Start is unavailable.';if(service?.pending)service.recovery(scene);return false;}","  d.close();service.leave(scene);return true;"," };"," d.status=d.text('',11,0x9ad3de,false,d.panel);d.status.style.wordWrap=true;d.rules=new PIXI.Graphics();d.content.addChild(d.rules);"," d.close=()=>{d.open=false;d.confirming=false;d.pressed='';d.pending='';d.input?.blur();if(d.input)d.input.style.display='none';};"," d.ensureInput=()=>{","  if(d.input)return;const input=d.input=document.createElement('input');input.type='text';input.inputMode='numeric';input.autocomplete='off';input.maxLength=12;input.placeholder='250000';input.setAttribute('aria-label','Developer Gold amount');input.setAttribute('data-celestial-dev-input','');","  Object.assign(input.style,{position:'fixed',boxSizing:'border-box',margin:'0',padding:'5px 9px',border:'1px solid #71618f',borderRadius:'4px',background:'#11172d',color:'#e2e4f4',fontFamily:'Arial, sans-serif',outlineColor:'#9dccdb',zIndex:'2000',display:'none'});document.body.appendChild(input);","  for(const name of ['pointerdown','pointerup','mousedown','mouseup','touchstart','touchend','wheel'])input.addEventListener(name,e=>e.stopPropagation());","  d.keyGuard=e=>{if(document.activeElement!==input)return;e.stopImmediatePropagation();if(e.type==='keydown'&&e.key==='Enter'){e.preventDefault();d.addGold(input.value);}else if(e.type==='keydown'&&e.key==='Escape'){e.preventDefault();d.close();}};","  for(const name of ['keydown','keyup','keypress'])window.addEventListener(name,d.keyGuard,true);"," };"," d.toggle=()=>{if(!d.guard(true)||d.confirming)return false;if(d.open)d.close();else{d.open=true;d.scroll=0;d.ensureInput();}scene.__audio?.play('UIClick');return true;};"," d.geometry=()=>{","  const W=game.getGameResolutionWidth(),H=game.getGameResolutionHeight(),canvas=game.getRenderer().getCanvas().getBoundingClientRect(),display=canvas.width/W;if(Number.isFinite(display)&&display>0&&canvas.width>=64&&canvas.height>=64&&!document.hidden)d.lastDisplay=display;","  const unit=Math.max(1,1/d.lastDisplay),area=scene.__towerShopUI?.gameArea,right=area?.right||W,audio=scene.__audio?.geometry().button||{x:8,y:16,w:32,h:32},size=36*unit;","  const button={x:Math.max(8*unit,Math.min(right-size-8*unit,audio.x+audio.w+8)),y:Math.max(8*unit,audio.y),w:size,h:size};","  const w=Math.min(config.PanelWidth*unit,right-16*unit),x=Math.max(8*unit,Math.min(right-w-8*unit,button.x)),y=button.y+size+8*unit,h=Math.max(120*unit,Math.min(config.PanelHeight*unit,H-y-8*unit));return{W,H,unit,display:d.lastDisplay,button,panel:{x,y,w,h},body:{x,y:y+48*unit,w,h:h-96*unit}};"," };"," d.contains=(r,x,y)=>!!r&&x>=r.x&&x<r.x+r.w&&y>=r.y&&y<r.y+r.h;"," d.layout=()=>{","  const g=d.geometry(),{unit,button,panel:p}=g;d.g=g;layer.setCameraZoom(1);layer.setCameraX(g.W/2);layer.setCameraY(g.H/2);d.launcher.container.position.set(button.x,button.y);d.launcher.container.scale.set(unit);d.place(d.launcher,0,0,36,36);d.launcher.container.position.set(button.x,button.y);","  d.panel.position.set(p.x,p.y);d.panel.scale.set(unit);const w=p.w/unit,h=p.h/unit,bodyH=h-96;d.panel.visible=d.open;d.frame.clear().lineStyle(1,0x9a82b6,.9).beginFill(0x0e1329,.97).drawRoundedRect(0,0,w,h,8).endFill().lineStyle(1,0xb5a575,.35).moveTo(12,43).lineTo(w-12,43).moveTo(12,h-46).lineTo(w-12,h-46);d.title.position.set(14,10);d.subtitle.position.set(14,28);d.place(d.exit,w-38,8,28,28);","  d.body.position.set(0,48);d.mask.clear().beginFill(0xffffff).drawRect(0,48,w,bodyH).endFill();d.maxScroll=Math.max(0,604-bodyH);d.subtitle.text=d.maxScroll?'SESSION TESTING / SCROLL':'SESSION TESTING';d.scroll=Math.max(0,Math.min(d.maxScroll,d.scroll));d.content.position.set(0,-d.scroll);","  d.goldLabel.position.set(14,3);d.balance.position.set(14,21);d.balance.text=sv.get('Money').getAsNumber().toLocaleString('en-US')+' GOLD';const cell=(w-36)/2;","  d.presets.forEach((b,i)=>d.place(b,12+(i%2)*(cell+12),45+Math.floor(i/2)*38,cell,30));d.customLabel.position.set(14,127);d.inputRect={x:12,y:146,w:w-24,h:32};d.inputFrame.clear().lineStyle(1,0x60527e).beginFill(0x11172d).drawRoundedRect(12,146,w-24,32,4).endFill();d.place(d.add,12,186,cell,30);d.place(d.set,24+cell,186,cell,30);d.limit.text='MAX BALANCE '+Number(config.GoldLimit).toLocaleString('en-US');d.limit.position.set(14,224);","  d.towerLabel.position.set(14,260);d.towerName.position.set(14,278);const tower=d.selected(),v=tower?.getVariables(),id=tower?.getUniqueId()||0;if(id!==d.selectedId){d.selectedId=id;d.path=v?.get('Path2Level').getAsNumber()>=3?2:1;}d.towerName.text=tower?(scene.__starCannon?.isFusion(tower)?'Starburst / no upgrade paths':v.get('TowerName').getAsString()+' / '+v.get('Path1Level').getAsNumber()+'-'+v.get('Path2Level').getAsNumber()):'No Tower Selected';d.paths.forEach((b,i)=>d.place(b,12+i*(cell+12),301,cell,28));d.place(d.max,12,337,w-24,34);d.costNote.position.set(14,380);d.costNote.style.wordWrap=true;d.costNote.style.wordWrapWidth=w-28;","  d.fusionLabel.position.set(14,421);d.place(d.fusion,12,442,w-24,32);d.fusionNote.position.set(14,483);d.fusionNote.style.wordWrap=true;d.fusionNote.style.wordWrapWidth=w-28;d.rules.clear().lineStyle(1,0x4d435e,.7).moveTo(12,247).lineTo(w-12,247).moveTo(12,408).lineTo(w-12,408);d.status.text=d.notice;d.status.style.fill=d.error?0xf3a1ae:0x9ad3de;d.status.style.wordWrapWidth=w-28;d.status.position.set(14,h-36);","  d.freshLabel.position.set(14,546);d.place(d.fresh,12,565,w-24,32);d.rules.moveTo(12,531).lineTo(w-12,531);","  if(d.maxScroll>0){d.frame.lineStyle(2,0x544866).moveTo(w-5,50).lineTo(w-5,h-50);const len=Math.max(20,bodyH*bodyH/604),sy=48+d.scroll/d.maxScroll*(bodyH-len);d.frame.lineStyle(2,0x9d8fbb).moveTo(w-5,sy).lineTo(w-5,sy+len);}","  d.dialog.visible=!!d.confirming;","  if(d.confirming){","   const dw=Math.min(384,g.W/unit-24),dx=(g.W/unit-dw)/2;d.dialog.scale.set(unit);d.shade.clear().beginFill(0x030615,.84).drawRect(0,0,g.W/unit,g.H/unit).endFill();d.dialogBody.style.wordWrapWidth=dw-36;d.dialogNote.style.wordWrapWidth=dw-36;d.dialogNote.text=d.resetError||'Audio and other player settings are kept.';d.dialogNote.style.fill=d.resetError?0xf3a1ae:0x94ccdc;const dh=134+d.dialogBody.height+d.dialogNote.height,dy=Math.max(8,(g.H/unit-dh)/2);d.dialogRect={x:dx,y:dy,w:dw,h:dh};d.dialogFrame.clear().lineStyle(1,0xc5a171,.95).beginFill(0x101329,.99).drawRoundedRect(dx,dy,dw,dh,8).endFill();d.dialogTitle.position.set(dx+18,dy+16);d.dialogBody.position.set(dx+18,dy+49);d.dialogNote.position.set(dx+18,dy+57+d.dialogBody.height);const cw=(dw-44)/3;d.place(d.cancelReset,dx+18,dy+dh-49,cw,32);d.place(d.confirmReset,dx+26+cw,dy+dh-49,dw-44-cw,32);d.cancelReset.text.style.fontSize=11;d.confirmReset.text.style.fontSize=11;","  }","  if(d.input){const r=d.inputRect,visible=d.open&&!d.confirming&&r.y-d.scroll>=0&&r.y+r.h-d.scroll<=bodyH&&root.visible&&!document.hidden;d.input.style.display=visible?'block':'none';if(!visible&&document.activeElement===d.input)d.input.blur();if(visible){const rect=game.getRenderer().getCanvas().getBoundingClientRect(),scale=d.g.display;Object.assign(d.input.style,{left:(rect.left+(p.x+r.x*unit)*scale)+'px',top:(rect.top+(p.y+(48+r.y-d.scroll)*unit)*scale)+'px',width:(r.w*unit*scale)+'px',height:(r.h*unit*scale)+'px',fontSize:(13*unit*scale)+'px'});}}"," };"," d.hit=()=>{","  const x=gdjs.evtTools.input.getCursorX(scene,'DeveloperUI',0),y=gdjs.evtTools.input.getCursorY(scene,'DeveloperUI',0),g=d.g;","  if(d.confirming){for(const b of [d.cancelReset,d.confirmReset])if(d.contains(b.r,x/g.unit,y/g.unit))return b.id;return'dialog';}","  if(d.contains(g.button,x,y))return'toggle';if(!d.open||!d.contains(g.panel,x,y))return'';const px=(x-g.panel.x)/g.unit,py=(y-g.panel.y)/g.unit;if(d.contains(d.exit.r,px,py))return'close';","  if(d.contains(g.body,x,y)){for(const b of [...d.presets,d.add,d.set,...d.paths,d.max,d.fusion,d.fresh])if(d.contains(b.r,px,py-48+d.scroll))return b.id;}return'panel';"," };"," d.pre=()=>{","  if(d.disposed)return;sv.get('DevUIConsumesClick').setBoolean(false);sv.get('DevGoldInputFocused').setBoolean(false);root.visible=d.enabled()&&!d.obscured();const down=game.getInputManager().isMouseButtonPressed(0);d.pending='';","  if(!root.visible){d.close();d.down=down;d.captured=false;return;}d.layout();const hit=d.hit(),inside=hit!=='',focused=document.activeElement===d.input;","  const wasDialog=!!d.confirming;","  if(d.open&&gdjs.evtTools.input.wasKeyJustPressed(scene,'Escape')){if(d.confirming)d.cancelFresh();else d.close();d.captured=true;}","  if(down&&!d.down){d.pressed=hit;d.captured=inside||focused;if(d.input&&hit!=='panel')d.input.blur();}","  if(!down&&d.down){if(d.pressed===hit&&hit)d.pending=hit;d.pressed='';}","  const consume=inside||d.captured||focused||wasDialog||d.open&&sv.get('CampaignTutorialActive').getAsBoolean();sv.get('DevUIConsumesClick').setBoolean(consume);sv.get('DevGoldInputFocused').setBoolean(focused||wasDialog);","  if(consume){if(scene.__freePlacement)scene.__freePlacement.wasDown=down;sv.get('TowerPointerWasDown').setBoolean(down);}","  if(d.open&&!d.confirming&&d.contains(d.g.body,gdjs.evtTools.input.getCursorX(scene,'DeveloperUI',0),gdjs.evtTools.input.getCursorY(scene,'DeveloperUI',0))){const wheel=game.getInputManager().getMouseWheelDelta();if(wheel)d.scroll=Math.max(0,Math.min(d.maxScroll,d.scroll-Math.sign(wheel)*38));}","  if(!down)d.captured=false;d.down=down;d.hover=hit;"," };"," d.after=()=>{","  if(d.disposed)return;if(!d.enabled()||d.obscured()){d.close();root.visible=false;return;}root.visible=true;const action=d.pending;d.pending='';if(action==='fresh')d.askFresh();else if(action==='cancelReset')d.cancelFresh();else if(action==='confirmReset'){d.freshStart();if(d.resetting)return;}else if(!d.confirming){if(action==='toggle')d.toggle();else if(action==='close')d.close();else if(action.startsWith('gold'))d.addGold(action.slice(4));else if(action==='add')d.addGold(d.input?.value);else if(action==='set')d.setGold(d.input?.value);else if(action==='path1'||action==='path2')d.setPath(Number(action.at(-1)));else if(action==='max')d.maxSelected();else if(action==='fusion')d.startFusion();}","  d.layout();for(const b of d.buttons)d.paint(b,d.hover===b.id,b.id==='path'+d.path);const tm=scene.getTimeManager(),dt=Math.min(.2,Math.max(0,tm.getElapsedTime()/Math.max(.001,tm.getTimeScale())/1000));d.noticeAge=Math.max(0,d.noticeAge-dt);if(d.noticeAge===0){d.notice='Session tools / normal prices apply';d.error=false;}"," };"," d.dispose=()=>{if(d.disposed)return;d.close();d.disposed=true;d.input?.remove();if(d.keyGuard)for(const name of ['keydown','keyup','keypress'])window.removeEventListener(name,d.keyGuard,true);d.body.mask=null;const texts=[];const visit=n=>{if(n instanceof PIXI.Text)texts.push(n);else for(const c of n.children||[])visit(c);};visit(root);for(const text of texts)text.destroy({texture:true,baseTexture:true});root.destroy({children:true,texture:false,baseTexture:false});};"," // Prepend input gating even when DEV is enabled after the audio owner exists."," if(!gdjs.__developerCheatsCallbacks){gdjs.__developerCheatsCallbacks=true;gdjs.callbacksRuntimeScenePreEvents.unshift(s=>s.__devCheats?.pre());gdjs.callbacksRuntimeSceneUnloading.push(s=>s.__devCheats?.dispose());}"," d.pre();","}"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Modular celestial mortar. Damage uses the existing native Health/armor adapter.","const scene=runtimeScene,sv=scene.getVariables(),game=scene.getGame(),get=n=>scene.getObjects(n);","if(!scene.__nebulaBloom){"," const config=sv.get('NebulaBloomConfig').toJSObject();"," const nb=scene.__nebulaBloom={config,time:0,rigs:new Map(),textures:new Map(),pods:new Map(),effects:[],zones:[],poisons:new Map(),disposed:false,metrics:{shots:0,impacts:0,directHits:0,poisonTicks:0,poisonsApplied:0,zonesCreated:0,visualsDropped:0}};"," nb.valid=(a,b)=>Number.isInteger(a)&&Number.isInteger(b)&&a>=0&&b>=0&&a<=config.MaxLevel&&b<=config.MaxLevel&&!(a>=3&&b>=3);"," nb.isFusion=()=>false;"," nb.stats=(a,b)=>nb.valid(a,b)?{Damage:config.BaseDamage*config.BurstDamage[b],AttackRange:config.BaseRange*config.ToxicRange[a],AttackInterval:config.BaseInterval,ProjectileSpeed:0,BlastRadius:config.BaseRadius*config.BurstRadius[b],SplashRadius:config.BaseRadius*config.BurstRadius[b],PoisonDamage:config.PoisonDamage[a],PoisonDuration:config.PoisonDuration[a],ZoneRadius:config.ZoneRadius[a]*config.BurstRadius[b],ZoneDuration:config.ZoneDuration[a],Path1:a,Path2:b,PodSize:config.PodSize+a+2*b,Pod:b>=3?['BloomDetonationShell','StellarOverbloomShell','NebulaCataclysmShell'][b-3]:a>0?['ToxicPod','VirulentPod','BlightPod','CausticPod','PestilentPod'][a-1]:b>0?['HeavySeedPod','EnlargedBurstPod'][b-1]:'BasePod'}:null;"," nb.texture=(atlas,frame)=>{const key=atlas+':'+frame;if(!nb.textures.has(key)){const a=config.Atlases[atlas],t=game.getImageManager().getPIXITexture(a.Image);nb.textures.set(key,new PIXI.Texture(t.baseTexture,new PIXI.Rectangle(...a.Frames[frame])));}return nb.textures.get(key);};"," nb.alive=e=>!!e&&(nb.liveSet?nb.liveSet.has(e):get('Enemy').includes(e))&&!e.getBehavior('Health').IsDead()&&!e.getVariables().get('PathFinished').getAsBoolean();"," nb.owner=r=>r.owner&&r.owner.getUniqueId()===r.ownerId&&get('NebulaBloomTower').includes(r.owner)?r.owner:null;"," nb.apply=tower=>{","  if(!get('NebulaBloomTower').includes(tower))return false;const v=tower.getVariables(),a=v.get('Path1Level').getAsNumber(),b=v.get('Path2Level').getAsNumber(),s=nb.stats(a,b);if(!s)return false;","  for(const [key,val]of Object.entries(s))if(typeof val==='number')v.get(key).setNumber(val);v.get('CurrentDamage').setNumber(s.Damage);v.get('CurrentRange').setNumber(s.AttackRange);v.get('CurrentAttackInterval').setNumber(s.AttackInterval);v.get('CurrentProjectileSpeed').setNumber(0);v.get('VisualKey').setString(a+'_'+b);tower.setAnimationName(a+'_'+b);tower.setWidth(64);tower.setHeight(64);const [x,y]=scene.__freePlacement.center(tower);tower.setPosition(x-32,y-32);tower.setOpacity(0);return true;"," };"," nb.upgrade=(tower,path)=>{","  if(!get('NebulaBloomTower').includes(tower)||![1,2].includes(path)||sv.get('IndexBlocksInput').getAsBoolean()||scene.__fusion?.active)return false;","  const v=tower.getVariables(),a=v.get('Path1Level').getAsNumber(),b=v.get('Path2Level').getAsNumber(),level=path===1?a:b,other=path===1?b:a;if(!nb.valid(a,b)||level>=config.MaxLevel||level+1>=3&&other>=3)return false;","  const cost=config.Paths[path-1].Upgrades[level].Cost;if(sv.get('Money').getAsNumber()<cost)return false;sv.get('Money').sub(cost);v.get(path===1?'Path1Level':'Path2Level').setNumber(level+1);v.get('TotalInvestment').add(cost);nb.apply(tower);return true;"," };"," nb.rig=tower=>{","  const id=tower.getUniqueId(),key=tower.getVariables().get('VisualKey').getAsString();let r=nb.rigs.get(id);","  if(!r){const root=new PIXI.Container(),base=new PIXI.Container(),head=new PIXI.Container();root.addChild(base,head);r={id,tower,root,base,head};r.cleanup=()=>{if(tower.getUniqueId()===id)tower.unregisterDestroyCallback(r.cleanup);root.destroy({children:true,texture:false,baseTexture:false});nb.rigs.delete(id);};tower.registerDestroyCallback(r.cleanup);nb.rigs.set(id,r);}","  if(r.key!==key){for(const group of [r.base,r.head])for(const child of group.removeChildren())child.destroy({children:true,texture:false,baseTexture:false});r.key=key;r.cores=[];","   for(const p of config.States[key].Parts){const sprite=new PIXI.Sprite(nb.texture(p.Atlas,p.Frame));sprite.anchor.set(.5);sprite.position.set(p.X-64,p.Y-64);sprite.scale.set(p.Size/Math.max(sprite.texture.width,sprite.texture.height));sprite.rotation=p.Angle*Math.PI/180;(p.Group==='Base'?r.base:r.head).addChild(sprite);if(p.Group==='Core')r.cores.push({sprite,scale:sprite.scale.x});}","  }return r;"," };"," nb.removeObject=(o,id)=>{if(o&&o.getUniqueId()===id&&get(o.getName()).includes(o))o.deleteFromScene();};"," nb.fx=(kind,x,y,size,life=.6,alpha=.7,delay=0,drift=null)=>{","  if(nb.effects.length>=config.MaxImpactVisuals){const old=nb.effects.shift();nb.removeObject(old.object,old.id);nb.metrics.visualsDropped++;}","  const object=scene.createObject('NebulaBloomVFX');object.setAnimationName(kind);object.setLayer('');object.setZOrder(15002);object.hide(delay>0);const r={object,id:object.getUniqueId(),kind,x,y,size,life,alpha,age:-delay,drift};nb.effects.push(r);return r;"," };"," nb.clearPoison=r=>{","  if(nb.poisons.get(r.id)!==r)return;nb.poisons.delete(r.id);if(r.enemy.getUniqueId()===r.id){r.enemy.unregisterDestroyCallback(r.cleanup);scene.__enemyStatusIcons?.remove(r.enemy,'NebulaPoison',r.id);}nb.removeObject(r.icon,r.iconId);"," };"," nb.poison=(enemy,snapshot,owner,ownerId)=>{","  if(!snapshot.PoisonDamage||!nb.alive(enemy))return false;const id=enemy.getUniqueId();let r=nb.poisons.get(id);","  if(r&&r.damage>snapshot.PoisonDamage)return false;","  if(!r){const icon=scene.createObject('NebulaPoisonIcon');r={id,enemy,icon,iconId:icon.getUniqueId(),nextTick:nb.time+config.PoisonTickSeconds,bound:false};r.cleanup=()=>nb.clearPoison(r);enemy.registerDestroyCallback(r.cleanup);nb.poisons.set(id,r);nb.metrics.poisonsApplied++;nb.fx('SporeApply',enemy.getCenterXInScene(),enemy.getCenterYInScene(),24,.3,.55);}","  r.damage=snapshot.PoisonDamage;r.expires=nb.time+snapshot.PoisonDuration;r.owner=owner;r.ownerId=ownerId;","  if(scene.__enemyStatusIcons){scene.__enemyStatusIcons.set(enemy,'NebulaPoison',r.icon,config.StatusIconSize,config.StatusIconOrder);r.bound=true;}return true;"," };"," nb.impact=r=>{","  const s=r.stats,x=r.target[0],y=r.target[1],owner=nb.owner(r);nb.metrics.impacts++;","  // One native armor-aware direct hit per Enemy; decorative VFX never deal damage.","  for(const e of get('Enemy'))if(nb.alive(e)&&Math.hypot(e.getCenterXInScene()-x,e.getCenterYInScene()-y)<=s.BlastRadius){scene.__starCannon.deal(owner,e,s.Damage);nb.metrics.directHits++;nb.poison(e,s,r.owner,r.ownerId);}","  const size=s.BlastRadius*2*128/120,poison=s.Path1>0,kind=s.Path2>=3?config.ImpactFamilies.Burst[s.Path2-1]:poison?config.ImpactFamilies.Toxic[s.Path1-1]:s.Path2>0?config.ImpactFamilies.Burst[s.Path2-1]:'BaseImpact';nb.fx(kind,x,y,size,.58,poison?.62:.78);nb.fx('BaseImpact',x,y,Math.min(42,size*.45),.14,.8);nb.fx('Shockwave',x,y,size,.55,.6);","  if(s.Path2>=3)nb.fx('Shockwave',x,y,size,.7,.4,.09);","  const count=Math.min(8,2+Math.max(s.Path1,s.Path2));for(let i=0;i<count;i++){const a=i*Math.PI*2/count;nb.fx('SporeApply',x,y,12+s.Path1+s.Path2,.65,.55,i*.012,[Math.cos(a)*s.BlastRadius*.75,Math.sin(a)*s.BlastRadius*.75]);}","  if(s.ZoneDuration){const patch=scene.createObject('NebulaBloomVFX'),cloud=scene.createObject('NebulaBloomVFX'),cloudVariant=config.CloudVariants[nb.metrics.zonesCreated%config.CloudVariants.length],cloudAngle=nb.metrics.zonesCreated*config.CloudRotationStep%360;patch.setAnimationName('ToxicPatch');cloud.setAnimationName(cloudVariant);cloud.setAngle(cloudAngle);for(const o of [patch,cloud]){o.setLayer('');o.setZOrder(91);o.hide(false);}nb.zones.push({x,y,radius:s.ZoneRadius,stats:s,owner:r.owner,ownerId:r.ownerId,patch,patchId:patch.getUniqueId(),cloud,cloudId:cloud.getUniqueId(),cloudVariant,cloudAngle,born:nb.time,expires:nb.time+s.ZoneDuration,nextPulse:nb.time});nb.metrics.zonesCreated++;}"," };"," nb.predict=(enemy,flight)=>{","  let x=enemy.getCenterXInScene(),y=enemy.getCenterYInScene(),left=enemy.__golemState?.casting?0:Math.max(0,enemy.getVariables().get('MoveSpeed').getAsNumber())*flight;const path=sv.get('MonsterPathPoints').toJSObject();","  for(let i=Math.max(0,enemy.getVariables().get('Waypoint').getAsNumber());i<path.length&&left>0;i++){const p=path[i],dx=p.X-x,dy=p.Y-y,d=Math.hypot(dx,dy);if(d>left)return[x+dx*left/d,y+dy*left/d];left-=d;x=p.X;y=p.Y;}return[x,y];"," };"," nb.fire=(tower,enemy)=>{","  if(!get('NebulaBloomTower').includes(tower)||!nb.alive(enemy)||sv.get('GameOver').getAsBoolean())return false;const [x,y]=scene.__freePlacement.center(tower),v=tower.getVariables(),s=nb.stats(v.get('Path1Level').getAsNumber(),v.get('Path2Level').getAsNumber()),dist=Math.hypot(enemy.getCenterXInScene()-x,enemy.getCenterYInScene()-y);if(!s||dist>s.AttackRange)return false;","  const flight=config.FlightMin+(config.FlightMax-config.FlightMin)*Math.min(1,dist/s.AttackRange),target=nb.predict(enemy,flight),angle=Math.atan2(target[1]-y,target[0]-x),start=[x+Math.cos(angle)*16,y+Math.sin(angle)*16],object=scene.createObject('NebulaBloomPod');object.setLayer('');object.setZOrder(15003);object.setAnimationName(s.Pod);object.setWidth(s.PodSize);object.setHeight(s.PodSize);object.setPosition(start[0]-s.PodSize/2,start[1]-config.LaunchHeight-s.PodSize/2);object.hide(false);","  const record={object,id:object.getUniqueId(),owner:tower,ownerId:tower.getUniqueId(),stats:s,start,target,flight,age:0,ground:start,altitude:config.LaunchHeight};nb.pods.set(record.id,record);tower.__nebulaFired=nb.time;v.get('ShotCounter').add(1);nb.metrics.shots++;return record;"," };"," nb.tick=()=>{","  if(nb.disposed||sv.get('GameOver').getAsBoolean())return;const dt=Math.min(.2,Math.max(0,scene.getTimeManager().getElapsedTime()/1000));nb.time+=dt;const all=get('Enemy');nb.liveSet=new Set(all);const enemies=all.filter(nb.alive);","  for(const t of get('NebulaBloomTower')){","   const v=t.getVariables();if(t.__nebulaLifetime!==t.getUniqueId()){t.__nebulaLifetime=t.getUniqueId();t.__nebulaCooldown=0;t.__nebulaFacing=-90;t.__nebulaFired=-10;if(v.get('TotalInvestment').getAsNumber()<=0)v.get('TotalInvestment').setNumber(v.get('PurchasePrice').getAsNumber()||config.Cost);nb.apply(t);}nb.rig(t);t.__nebulaCooldown=Math.max(0,t.__nebulaCooldown-dt);","   const [x,y]=scene.__freePlacement.center(t),range=v.get('AttackRange').getAsNumber();let target=null,nearest=Infinity;for(const e of enemies){const d=Math.hypot(e.getCenterXInScene()-x,e.getCenterYInScene()-y);if(d<=range&&d<nearest){nearest=d;target=e;}}","   t.__nebulaTarget=target?.getUniqueId()||0;if(target){const facing=Math.atan2(target.getCenterYInScene()-y,target.getCenterXInScene()-x)*180/Math.PI,difference=(facing-t.__nebulaFacing+540)%360-180,limit=config.AimDegreesPerSecond*dt;t.__nebulaFacing+=Math.max(-limit,Math.min(limit,difference));if(t.__nebulaCooldown<=0&&nb.fire(t,target))t.__nebulaCooldown=v.get('AttackInterval').getAsNumber();}","  }","  for(const r of [...nb.pods.values()]){","   if(r.object.getUniqueId()!==r.id||!get('NebulaBloomPod').includes(r.object)){nb.pods.delete(r.id);continue;}r.age+=dt;const p=Math.min(1,r.age/r.flight);r.ground=[r.start[0]+(r.target[0]-r.start[0])*p,r.start[1]+(r.target[1]-r.start[1])*p];r.altitude=config.LaunchHeight*(1-p)+4*config.ArcHeight*p*(1-p);r.object.setPosition(r.ground[0]-r.stats.PodSize/2,r.ground[1]-r.altitude-r.stats.PodSize/2);r.object.setAngle(p*280);if(p>=1){nb.impact(r);nb.removeObject(r.object,r.id);nb.pods.delete(r.id);}","  }","  for(const z of [...nb.zones]){","   if(nb.time>=z.expires){nb.removeObject(z.patch,z.patchId);nb.removeObject(z.cloud,z.cloudId);nb.zones.splice(nb.zones.indexOf(z),1);continue;}","   if(nb.time+1e-8>=z.nextPulse){z.nextPulse=nb.time+config.CloudApplyIntervalSeconds;for(const e of enemies)if(nb.alive(e)&&Math.hypot(e.getCenterXInScene()-z.x,e.getCenterYInScene()-z.y)<=z.radius)nb.poison(e,z.stats,z.owner,z.ownerId);}","  }","  for(const r of [...nb.poisons.values()]){","   if(r.enemy.getUniqueId()!==r.id||!nb.alive(r.enemy)){nb.clearPoison(r);continue;}","   while(r.nextTick<=nb.time+1e-8&&r.nextTick<=r.expires+1e-8&&nb.alive(r.enemy)){scene.__starCannon.deal(nb.owner(r),r.enemy,r.damage);nb.metrics.poisonTicks++;r.nextTick+=config.PoisonTickSeconds;}","   if(nb.time>=r.expires||!nb.alive(r.enemy))nb.clearPoison(r);","  }","  for(const r of [...nb.effects]){r.age+=dt;if(r.object.getUniqueId()!==r.id||!get('NebulaBloomVFX').includes(r.object)||r.age>=r.life){nb.removeObject(r.object,r.id);nb.effects.splice(nb.effects.indexOf(r),1);}}nb.liveSet=null;"," };"," nb.render=()=>{","  if(nb.disposed)return;if(sv.get('GameOver').getAsBoolean())nb.clearTransients();const live=new Set(get('NebulaBloomTower').map(t=>t.getUniqueId()));for(const [id,r]of nb.rigs)if(!live.has(id))r.cleanup();","  for(const tower of get('NebulaBloomTower')){","   if(!config.States[tower.getVariables().get('VisualKey').getAsString()])nb.apply(tower);const r=nb.rig(tower),parent=scene.getLayer(tower.getLayer()).getRenderer().getRendererObject();if(r.root.parent!==parent)parent.addChild(r.root);r.root.position.set(...scene.__freePlacement.center(tower));r.root.scale.set(64*config.RenderScale/128);r.root.zIndex=tower.getZOrder()+.1;r.root.visible=!tower.isHidden();r.base.rotation=0;r.head.rotation=((tower.__nebulaFacing??-90)+90)*Math.PI/180;","   const age=nb.time-(tower.__nebulaFired??-10),charge=tower.__nebulaTarget?Math.max(0,1-(tower.__nebulaCooldown||0)/config.ChargeSeconds):0,recoil=age<config.RecoilSeconds?Math.sin(age/config.RecoilSeconds*Math.PI):0;r.head.scale.set(1+charge*.035-recoil*.08);r.head.position.y=Math.sin(nb.time*1.8)*.6+recoil*3;","   for(const c of r.cores){c.sprite.scale.set(c.scale*(1+.05*Math.sin(nb.time*3)+charge*.15));c.sprite.alpha=.82+charge*.18;}tower.setOpacity(0);tower.getVariables().get('BloomPhase').setString(age<.08?'Firing':age<.2?'Recoil':age<config.RecoilSeconds?'Recovery':charge>0?'Charge':'Idle');","  }","  if(!nb.shadow){nb.shadow=new PIXI.Graphics();nb.shadow.zIndex=90;scene.getLayer('').getRenderer().getRendererObject().addChild(nb.shadow);}nb.shadow.clear();","  for(const r of nb.pods.values())nb.shadow.beginFill(0x0b0823,.3).drawEllipse(r.ground[0],r.ground[1],r.stats.PodSize*.38,r.stats.PodSize*.16).endFill();","  for(const r of nb.effects){const o=r.object;if(r.age<0){o.hide();continue;}const t=Math.min(1,r.age/r.life),growth=r.kind==='SporeApply'?.8+.2*t:.2+.8*(1-Math.pow(1-t,2)),size=r.size*growth;o.hide(false);o.setWidth(size);o.setHeight(size);o.setPosition(r.x+(r.drift?.[0]||0)*t-size/2,r.y+(r.drift?.[1]||0)*t-size/2);o.setOpacity(255*r.alpha*Math.pow(1-t,1.25));o.setAngle((r.kind==='Shockwave'?0:18)*t);}","  for(const z of nb.zones){const remaining=Math.min(1,(z.expires-nb.time)/.5),age=Math.min(1,(nb.time-z.born)/.2),size=z.radius*2*128/120;for(const [o,scale,alpha]of [[z.patch,1,.22],[z.cloud,.97+.02*Math.sin(nb.time*1.5),.17]]){o.setWidth(size*scale);o.setHeight(size*scale);o.setPosition(z.x-size*scale/2,z.y-size*scale/2);o.setOpacity(255*alpha*remaining*age);}}","  for(const r of nb.poisons.values())if(!r.bound&&scene.__enemyStatusIcons){scene.__enemyStatusIcons.set(r.enemy,'NebulaPoison',r.icon,config.StatusIconSize,config.StatusIconOrder);r.bound=true;}scene.__enemyStatusIcons?.render();"," };"," nb.clearTransients=()=>{for(const r of [...nb.poisons.values()])nb.clearPoison(r);for(const r of nb.pods.values())nb.removeObject(r.object,r.id);nb.pods.clear();for(const r of nb.effects)nb.removeObject(r.object,r.id);nb.effects=[];for(const z of nb.zones){nb.removeObject(z.patch,z.patchId);nb.removeObject(z.cloud,z.cloudId);}nb.zones=[];nb.shadow?.clear();};"," nb.dispose=()=>{if(nb.disposed)return;nb.clearTransients();for(const r of [...nb.rigs.values()])r.cleanup();nb.shadow?.destroy();for(const t of nb.textures.values())t.destroy(false);nb.textures.clear();nb.disposed=true;};"," if(!gdjs.__nebulaBloomCleanup){gdjs.__nebulaBloomCleanup=true;gdjs.callbacksRuntimeSceneUnloading.push(s=>s.__nebulaBloom?.dispose());}","}"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[]},{"colorB":109,"colorG":143,"colorR":90,"creationTime":0,"name":"Unit INDEX modal","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BooleanVariable"},"parameters":["DefeatActive","False",""]}],"actions":[],"events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Galactic Archives is presentation-only. Combat and discovery owners stay authoritative.","const scene=runtimeScene,sv=scene.getVariables(),game=scene.getGame(),input=game.getInputManager();","const width=game.getGameResolutionWidth(),height=game.getGameResolutionHeight(),data=game.getSceneAndExtensionsData(scene.getName()).sceneData;","let index=scene.__unitIndex;","if(!index){"," index=scene.__unitIndex={objects:{},cards:[],monsterCards:[],category:'Towers',selected:{},scroll:0,collectionScroll:0,wasDown:false,pressed:'',dragging:null,disposed:false};"," index.ensure=(key,name,layer,z)=>{let o=index.objects[key];if(!o){o=scene.createObject(name);o.setLayer(layer);o.setZOrder(z);index.objects[key]=o;}return o;};"," index.graphics={};index.masks={};"," for(const name of ['IndexUI','IndexList','IndexDetail']){","  const parent=scene.getLayer(name).getRenderer().getRendererObject(),g=new PIXI.Graphics();g.zIndex=-10;g.interactive=false;parent.addChild(g);index.graphics[name]=g;","  if(name!=='IndexUI'){const mask=new PIXI.Graphics();mask.zIndex=-20;parent.addChild(mask);parent.mask=mask;index.masks[name]=mask;}"," }"," index.select=id=>{index.selected[index.category]=id;index.scroll=0;index.renderKey=null;};"," index.dispose=()=>{if(index.disposed)return;index.disposed=true;for(const name of ['IndexUI','IndexList','IndexDetail']){scene.getLayer(name).getRenderer().getRendererObject().mask=null;index.graphics[name].destroy();index.masks[name]?.destroy();}};"," if(!gdjs.__indexShowcaseCallbacks){gdjs.__indexShowcaseCallbacks=true;gdjs.callbacksRuntimeSceneUnloading.push(s=>s.__unitIndex?.dispose());}","}","for(const name of ['IndexUI','IndexList','IndexDetail']){const l=scene.getLayer(name);l.setCameraZoom(1);l.setCameraX(width/2);l.setCameraY(height/2);}","const wasOpen=sv.get('IndexOpen').getAsBoolean(),shop=scene.__towerShopUI;","if(shop?.indexRequested){sv.get('IndexOpen').setBoolean(true);shop.indexRequested=false;}","let open=sv.get('IndexOpen').getAsBoolean();sv.get('IndexBlocksInput').setBoolean(wasOpen||open);","const down=input.isMouseButtonPressed(0);","if(!open){for(const name of ['IndexUI','IndexList','IndexDetail'])scene.getLayer(name).show(false);index.wasDown=down;index.pressed='';index.dragging=null;index.renderKey=null;return;}","const archive=game.__fusionArchive,discovery=scene.__monsterDiscovery,portraits=sv.get('IndexPortraitCatalog').toJSObject(),star=sv.get('StarCannonConfig').toJSObject();","const archetypes=sv.get('EnemyTypes').toJSObject(),catalog=sv.get('TowerShopCatalog').toJSObject(),categories=['Towers','Monsters','Fusion'];","if(!categories.includes(index.category))index.category='Towers';","const entries=index.category==='Towers'?catalog.flatMap(item=>{"," const def=data.objects.find(o=>o.name===item.Type);if(!def)return[];const v=Object.fromEntries(def.variables.map(v=>[v.name,v.value])),isStar=item.Type==='StarCannonTower',isNebula=item.Type==='NebulaBloomTower',cfg=isNebula?sv.get('NebulaBloomConfig').toJSObject():star;"," return[{id:item.Type,type:item.Type,name:v.TowerName||item.Name,price:item.Cost,damage:isStar||isNebula?cfg.BaseDamage:v.Damage,range:isStar||isNebula?cfg.BaseRange:v.AttackRange,cooldown:isStar||isNebula?cfg.BaseInterval:v.AttackInterval,projectileSpeed:isNebula?undefined:isStar?star.ProjectileSpeed:v.ProjectileSpeed,locked:false}];","}):index.category==='Monsters'?discovery.ids.map(id=>({id,typeId:id,name:archetypes[id].Name||id,...archetypes[id],locked:!discovery.has(id),monster:true})):archive.catalog.map(def=>({id:def.Id,type:def.Id,name:def.Name,definition:def,fusion:true,locked:!archive.has(def.Id)}));","index.entries=entries;index.categories=categories;","const categoryChanged=index.lastCategory!==index.category;","if(categoryChanged){index.scroll=0;index.collectionScroll=0;index.lastCategory=index.category;}","if(!entries.some(e=>e.id===index.selected[index.category]))index.selected[index.category]=entries[0]?.id;","const selected=entries.find(e=>e.id===index.selected[index.category]),selectedIndex=entries.indexOf(selected);","const mobile=width<760,w=Math.min(1320,width-32),h=Math.min(900,height-32),x=(width-w)/2,y=(height-h)/2;","const body={x:x+18,y:y+126,w:w-36,h:h-164},cw=Math.min(280,Math.max(196,w*.225));","const collection=mobile?{x:body.x,y:body.y,w:body.w,h:92}:{x:body.x,y:body.y,w:cw,h:body.h};","const detail=mobile?{x:body.x,y:body.y+106,w:body.w,h:body.h-106}:{x:body.x+cw+16,y:body.y,w:body.w-cw-16,h:body.h};","index.geometry={x,y,w,h,content:detail,collection,detail,mobile};","index.tabRects=categories.map((name,i)=>({name,x:x+20+i*(mobile?(w-40)/3:154),y:y+74,w:mobile?(w-56)/3:142,h:34}));","index.closeRect={x:x+w-58,y:y+20,w:36,h:36};","const mx=gdjs.evtTools.input.getCursorX(scene,'IndexUI',0),my=gdjs.evtTools.input.getCursorY(scene,'IndexUI',0),inside=r=>!!r&&mx>=r.x&&mx<r.x+r.w&&my>=r.y&&my<r.y+r.h;","const stride=mobile?182:90,rowWidth=mobile?172:collection.w-14;","index.collectionMaxScroll=Math.max(0,entries.length*stride-(mobile?collection.w:collection.h));","if(categoryChanged&&selectedIndex>=0)index.collectionScroll=Math.max(0,Math.min(index.collectionMaxScroll,selectedIndex*stride+80-(mobile?collection.w:collection.h)));","const wheel=input.getMouseWheelDelta();if(inside(collection))index.collectionScroll-=Math.sign(wheel)*52;else if(inside(detail))index.scroll-=Math.sign(wheel)*60;","index.collectionScroll=Math.max(0,Math.min(index.collectionMaxScroll,index.collectionScroll));","const cardRects=()=>entries.map((e,i)=>({id:e.id,x:collection.x+(mobile?i*stride-index.collectionScroll:0),y:collection.y+(mobile?0:i*stride-index.collectionScroll),w:rowWidth,h:80}));","index.cardRects=cardRects();","const detailTrack={x:detail.x+detail.w-8,y:detail.y,w:8,h:detail.h},collectionTrack=mobile?null:{x:collection.x+collection.w-7,y:collection.y,w:7,h:collection.h};","const hover=index.tabRects.find(inside)?.name||(inside(index.closeRect)?'Close':inside(detailTrack)&&index.maxScroll>0?'DetailTrack':inside(collectionTrack)&&index.collectionMaxScroll>0?'CollectionTrack':inside(collection)?index.cardRects.find(inside)?.id:'')||'';","if(down&&!index.wasDown){index.pressed=hover;if(hover.endsWith('Track'))index.dragging={list:hover==='CollectionTrack',y:my,value:hover==='CollectionTrack'?index.collectionScroll:index.scroll};}","if(down&&index.dragging){const d=index.dragging,r=d.list?collection:detail,max=d.list?index.collectionMaxScroll:index.maxScroll,thumb=Math.max(24,r.h*r.h/(r.h+max)),value=d.value+(my-d.y)*max/Math.max(1,r.h-thumb);if(d.list)index.collectionScroll=value;else index.scroll=value;}","index.collectionScroll=Math.max(0,Math.min(index.collectionMaxScroll,index.collectionScroll));index.cardRects=cardRects();","if(!down&&index.wasDown&&index.pressed===hover){"," if(hover==='Close'){sv.get('IndexOpen').setBoolean(false);open=false;}"," else if(categories.includes(hover)&&index.category!==hover){index.category=hover;index.renderKey=null;index.wasDown=down;index.pressed='';return;}"," else if(entries.some(e=>e.id===hover)){index.select(hover);index.wasDown=down;index.pressed='';return;}","}","if(gdjs.evtTools.input.wasKeyJustPressed(scene,'Escape')){sv.get('IndexOpen').setBoolean(false);open=false;}","if(!down)index.dragging=null;","index.scroll=Math.max(0,Math.min(index.maxScroll||0,index.scroll));","const key=JSON.stringify([index.category,index.selected[index.category],index.scroll,index.collectionScroll,width,height,hover,open,discovery.revision,archive.revision]);","if(index.renderKey===key){index.wasDown=down;if(!down)index.pressed='';return;}index.renderKey=key;index.renderCount=(index.renderCount||0)+1;","Object.values(index.objects).forEach(o=>o.hide());index.cards=[];index.monsterCards=[];index.measuredTexts=[];index.artRects=[];","for(const g of Object.values(index.graphics))g.clear();","for(const [name,r]of [['IndexList',collection],['IndexDetail',detail]])index.masks[name].clear().beginFill(0xffffff).drawRect(r.x,r.y,r.w,r.h).endFill();","const C={border:0x494169,gold:0xc5ab72,white:'242;236;255',muted:'172;166;197'};","const box=(layer,r,fill,border=C.border,radius=10,alpha=1)=>index.graphics[layer].lineStyle(1,border,.8).beginFill(fill,alpha).drawRoundedRect(r.x,r.y,r.w,r.h,radius).endFill();","const line=(layer,a,b,c,d,color=C.border)=>index.graphics[layer].lineStyle(1,color,.6).moveTo(a,b).lineTo(c,d);","const text=(key,value,px,py,ww,size=13,color=C.white,bold=false,layer='IndexUI')=>{"," const o=index.ensure(key,'IndexText',layer,3);o.setString(String(value));o.setCharacterSize(size);o.setBold(bold);o.setColor(color);o.setWrapping(true);o.setWrappingWidth(Math.max(20,ww));o.setPosition(px,py);o.hide(false);index.measuredTexts.push({key,object:o,x:px,y:py,w:ww});return o;","};","const label=(key,value,px,py,ww,layer='IndexDetail',color='192;173;123')=>text(key,value,px,py,ww,10,color,true,layer);","const g=index.graphics.IndexUI;g.beginFill(0x050610,.88).drawRect(0,0,width,height).endFill();box('IndexUI',{x,y,w,h},0x101024,0x797098,15,.99);","line('IndexUI',x+18,y+62,x+w-18,y+62,0x5c4a75);","for(const [sx,sy]of [[x+18,y+18],[x+w-18,y+18],[x+18,y+h-18],[x+w-18,y+h-18]])g.beginFill(C.gold,.9).drawPolygon([sx,sy-3,sx+3,sy,sx,sy+3,sx-3,sy]).endFill();","text('title','GALACTIC ARCHIVES',x+32,y+18,w-112,mobile?20:25,C.white,true);","label('archiveMark','CELESTIAL VOID  /  FIELD ENCYCLOPEDIA',x+34,y+47,w-130,'IndexUI','150;165;192');","box('IndexUI',index.closeRect,hover==='Close'?0x443458:0x211c36);text('buttonTextClose','X',index.closeRect.x+12,index.closeRect.y+9,20,15,C.white,true);","for(const r of index.tabRects){const active=r.name===index.category;box('IndexUI',r,active?0x302446:0x17142b,active?C.gold:C.border,7);text('tabText'+r.name,r.name.toUpperCase(),r.x+15,r.y+10,r.w-20,11,active?'234;216;170':C.muted,true);}","const found=entries.filter(e=>!e.locked).length;","const compact=w<1000;","text('subtitle',(index.category==='Towers'?'TOWER COLLECTION':index.category==='Monsters'?'MONSTER DISCOVERY':'FUSION ARCHIVE')+'  /  '+found+' / '+entries.length+' DISCOVERED',mobile?x+20:compact?x+w-338:x+w-350,compact?y+h-25:y+86,mobile?w-40:320,10,C.muted);","box('IndexUI',{x:collection.x-3,y:collection.y-3,w:collection.w+6,h:collection.h+6},0x121027,0x393152,10);","box('IndexUI',{x:detail.x-3,y:detail.y-3,w:detail.w+6,h:detail.h+6},0x14122b,0x54435f,10);","if(!mobile)text('footer',compact?'SCROLL EACH PANEL / ESC TO CLOSE':'SELECT AN ENTRY   /   SCROLL EACH PANEL   /   ESC TO CLOSE',x+32,y+h-25,compact?w-392:w-52,10,'139;137;167');","const fit=(o,b,r)=>{o.setScale(1);const scale=Math.min(r.w/b[2],r.h/b[3]);o.setScale(scale);o.setPosition(r.x+r.w/2-(b[0]+b[2]/2)*scale,r.y+r.h/2-(b[1]+b[3]/2)*scale);index.artRects.push({id:o.__archiveId,object:o,x:o.getX()+b[0]*scale,y:o.getY()+b[1]*scale,w:b[2]*scale,h:b[3]*scale,frame:r});};","const portrait=(key,e,r,layer)=>{"," if(e.monster){const o=index.ensure(key,'IndexMonsterImage',layer,2);o.__archivePortraitOwned=true;o.setAnimationName(e.Animation);o.setColor(e.locked?'0;0;0':'255;255;255');o.setOpacity(0);o.__discoveryLocked=e.locked;o.__discoveryPortrait={id:e.id,x:r.x+r.w/2,y:r.y+r.h/2,w:r.w,h:r.h};o.setWidth(r.w);o.setHeight(r.h);o.setPosition(r.x,r.y);o.hide(false);index.monsterCards.push({sprite:o});return o;}"," const meta=portraits[e.id],animation=meta&&data.objects.find(o=>o.name==='IndexShowcase').animations.find(a=>a.name===meta.Animation);"," if(!animation){label(key+'Pending','PORTRAIT PENDING',r.x+8,r.y+r.h/2-5,r.w-16,layer,'139;133;162');return null;}"," const o=index.ensure(key,'IndexShowcase',layer,2);o.setAnimationName(meta.Animation);o.setColor(e.locked?'0;0;0':'255;255;255');o.setOpacity(255);o.__archiveId=e.id;o.__fusionLocked=e.locked;o.hide(false);fit(o,meta.VisualBounds,r);return o;","};","for(const [i,e]of entries.entries()){"," const r=index.cardRects[i],active=e.id===index.selected[index.category];box('IndexList',r,active?0x302442:0x1a172f,active?C.gold:hover===e.id?0x8c79ba:0x403755,8);"," if(active)index.graphics.IndexList.beginFill(C.gold,.9).drawRoundedRect(r.x+1,r.y+14,3,r.h-28,2).endFill();"," const sprite=portrait('collection'+index.category+i,e,{x:r.x+9,y:r.y+10,w:56,h:60},'IndexList');"," const name=text('collectionName'+i,e.locked?'???':e.name,r.x+74,r.y+14,r.w-82,13,C.white,true,'IndexList');"," const status=text('collectionStatus'+i,e.locked?'UNDISCOVERED':e.monster||e.fusion?'DISCOVERED':'TOWER / AVAILABLE',r.x+74,r.y+48,r.w-82,9,e.locked?'154;139;175':'168;198;218',false,'IndexList');"," index.cards.push({name,status,sprite,locked:e.locked,id:e.id});","}","const scrollBar=(layer,r,max,value,horizontal=false)=>{if(max<=0)return;const g=index.graphics[layer],len=horizontal?r.w:r.h,thumb=Math.max(24,len*len/(len+max)),pos=value/max*(len-thumb);g.beginFill(0x3b3454).drawRoundedRect(r.x,r.y,r.w,r.h,3).endFill();g.beginFill(0x9b89ba).drawRoundedRect(r.x+(horizontal?pos:0),r.y+(horizontal?0:pos),horizontal?thumb:r.w,horizontal?r.h:thumb,3).endFill();};","scrollBar('IndexUI',mobile?{x:collection.x,y:collection.y+86,w:collection.w,h:4}:collectionTrack,index.collectionMaxScroll,index.collectionScroll,mobile);","if(selected){"," const e=selected,locked=e.locked,dx=detail.x+18,dw=detail.w-48,top=detail.y+16-index.scroll,stack=dw<480,artW=stack?Math.min(280,dw):Math.min(350,dw*.43),artH=Math.min(330,Math.max(128,detail.h-48)),artFrame={x:stack?dx+(dw-artW)/2:dx,y:top,w:artW,h:artH};"," box('IndexDetail',artFrame,0x111429,e.fusion?C.gold:0x344360,12);"," const ag=index.graphics.IndexDetail,cx=artFrame.x+artW/2,cy=top+artH*.57;"," ag.lineStyle(1,e.fusion?0x8d734b:0x48617e,.35).drawEllipse(cx,cy,artW*.43,artH*.27).drawEllipse(cx,cy,artW*.34,artH*.21);"," for(let k=0;k<5;k++)ag.beginFill(0x92a4cc,.4).drawCircle(artFrame.x+14+(k*37)%(artW-28),top+18+(k*53)%(artH-36),1).endFill();"," const art=portrait('detail'+index.category,e,{x:artFrame.x+16,y:artFrame.y+16,w:artW-32,h:artH-32},'IndexDetail');"," const tx=stack?dx:dx+artW+22,tw=stack?dw:dw-artW-22,ty=stack?top+artH+20:top+4;"," label('detailType',locked?'UNIDENTIFIED ARCHIVE':e.fusion?e.definition.Kind.toUpperCase()+' FUSION':e.monster?(e.Classification||'COMMON')+' ENEMY':'CELESTIAL ARTILLERY',tx,ty,tw);"," const title=text('detailName',locked?'???':e.name,tx,ty+20,tw,tw<250?24:30,C.white,true,'IndexDetail');"," let yy=ty+20+title.getHeight()+10;"," const desc=locked?(e.fusion?'CRYPTIC HINT\\n'+e.definition.Hint:'An unknown presence moves through the Void. Encounter this enemy to reveal its archive.'):(e.fusion?e.definition.Description:e.monster?(e.Role||(e.id==='Basic'?'A wandering cosmic entity.':'Fast Void creature.')):e.type==='NebulaBloomTower'?'A celestial flower mortar that lobs nebula seed pods at a predicted impact point. Specialize in lingering spore poison or heavy area detonation. No Fusion path.':'A single stellar cannon, forged in ivory and gold. Shape its energy through two upgrade paths.');"," const description=text('detailDescription',desc,tx,yy,tw,13,C.muted,false,'IndexDetail');yy+=description.getHeight()+18;"," const config=e.fusion?(data.variables.some(v=>v.name===e.definition.StatsConfig)?sv.get(e.definition.StatsConfig).toJSObject():e.definition.Stats||{}):null;"," const stats=locked?[]:e.monster?[['HP',e.HP],['ARMOR',e.Armor],['SPEED',e.Speed+' px/s'],['REWARD',e.Reward+' Gold']]:[['DAMAGE',e.fusion?config.Damage:e.damage],['INTERVAL',Number(e.fusion?config.AttackInterval:e.cooldown).toFixed(2)+' s'],['RANGE',(e.fusion?config.AttackRange:e.range)+' px'],[e.fusion?'RATE':'COST',e.fusion?(1/config.AttackInterval).toFixed(2)+' /s':e.price+' Gold']];"," index.statValues=stats;const statsTop=yy,cellW=(tw-10)/2;"," for(const [i,[name,value]]of stats.entries()){","  const sx=tx+i%2*(cellW+10),sy=statsTop+Math.floor(i/2)*64;box('IndexDetail',{x:sx,y:sy,w:cellW,h:54},0x201d38,0x393551,6);","  const icon=index.graphics.IndexDetail,ix=sx+14,iy=sy+13;icon.lineStyle(1,0xa4bedb,.85);","  if(name==='INTERVAL'||name==='RATE')icon.drawCircle(ix,iy,4).moveTo(ix,iy-3).lineTo(ix,iy).lineTo(ix+3,iy+1);","  else if(name==='RANGE')icon.drawCircle(ix,iy,4).moveTo(ix-6,iy).lineTo(ix+6,iy).moveTo(ix,iy-6).lineTo(ix,iy+6);","  else if(name==='HP')icon.moveTo(ix-4,iy).lineTo(ix+4,iy).moveTo(ix,iy-4).lineTo(ix,iy+4);","  else if(name==='ARMOR')icon.drawPolygon([ix-4,iy-4,ix+4,iy-4,ix+3,iy+2,ix,iy+5,ix-3,iy+2,ix-4,iy-4]);","  else icon.drawPolygon([ix,iy-5,ix+4,iy,ix,iy+5,ix-4,iy,ix,iy-5]);","  label('statLabel'+i,name,sx+26,sy+8,cellW-36,'IndexDetail','151;164;192');text('statValue'+i,value,sx+10,sy+24,cellW-20,18,C.white,true,'IndexDetail');"," }"," yy+=stats.length?128:0;"," if(!locked&&!e.monster){const property=e.fusion?(Number.isFinite(config.SplashRadius)&&Number.isFinite(config.SplashRatio)?'SPLASH  /  '+config.SplashRadius+' px  /  '+Math.round(config.SplashRatio*100)+'% damage':''):e.type==='NebulaBloomTower'?'ARC FLIGHT / '+sv.get('NebulaBloomConfig').getChild('FlightMin').getAsNumber()+'-'+sv.get('NebulaBloomConfig').getChild('FlightMax').getAsNumber()+' s / SPLASH '+sv.get('NebulaBloomConfig').getChild('BaseRadius').getAsNumber()+' px':(Number.isFinite(e.projectileSpeed)?'PROJECTILE SPEED  /  '+e.projectileSpeed+' px/s':'');if(property){const properties=text('detailProperties',property,tx,yy,tw,11,'151;170;198',false,'IndexDetail');yy+=properties.getHeight()+14;}}"," if(locked){label('detailLock','UNDISCOVERED  /  DETAILS LOCKED',tx,yy,tw,'IndexDetail','163;144;188');yy+=32;}"," let sectionY=Math.max(top+artH+24,yy+8);"," const section=(key,title)=>{line('IndexDetail',dx,sectionY,dx+dw,sectionY,0x655470);label(key,title,dx,sectionY+14,dw);sectionY+=40;};"," const paragraph=(key,value)=>{const t=text(key,value,dx,sectionY,dw,13,C.muted,false,'IndexDetail');sectionY+=t.getHeight()+18;return t;};"," index.detail={id:e.id,entry:e,locked,sprite:art,name:title,description,statValues:stats};"," if(e.type==='StarCannonTower'||e.type==='NebulaBloomTower'){","  const upgradeConfig=e.type==='NebulaBloomTower'?sv.get('NebulaBloomConfig').toJSObject():star;","  section('upgradesTitle','UPGRADE PATHS');const cols=dw>=580?2:1,colW=cols===2?(dw-16)/2:dw,starts=[];","  for(const [p,path]of upgradeConfig.Paths.entries()){","   const px=dx+(p%cols)*(colW+16);let py=cols===2?sectionY:sectionY+(p?starts[0]:0);const start=py;","   box('IndexDetail',{x:px,y:py,w:colW,h:50},p?0x20203c:0x292038,p?0x586e94:0x8a7052,7);label('pathNumber'+p,'PATH '+(p+1),px+12,py+8,colW-24,'IndexDetail',p?'158;204;229':'225;193;130');text('starPath'+p,path.Name,px+12,py+23,colW-24,12,C.white,true,'IndexDetail');py+=64;","   for(const [n,u]of path.Upgrades.entries()){","    const icon=index.ensure('starUpgrade'+p+n,'StarUpgradeIcon','IndexDetail',2);icon.setAnimationName(u.Icon);icon.setWidth(38);icon.setHeight(38);icon.setPosition(px+8,py+8);icon.hide(false);","    const name=text('upgradeName'+p+n,'0'+(n+1)+'  '+u.Name,px+56,py+8,colW-68,13,C.white,true,'IndexDetail');","    const desc=text('upgradeDesc'+p+n,u.Description,px+56,py+name.getHeight()+14,colW-68,12,C.muted,false,'IndexDetail');","    const rh=Math.max(92,name.getHeight()+desc.getHeight()+48);box('IndexDetail',{x:px,y:py,w:colW,h:rh-8},0x19162e,0x302b45,6);label('upgradeCost'+p+n,u.Cost+' GOLD',px+56,py+rh-30,colW-68,'IndexDetail','195;175;129');py+=rh;","   }","   starts[p]=py-start+18;","  }","  sectionY+=cols===2?Math.max(...starts):starts.reduce((a,b)=>a+b,0);paragraph('starRule','Level 3 specializes one path. The other path can reach level 2. Maximum level '+upgradeConfig.MaxLevel+'.');"," }else if(e.monster&&!locked){","  section('abilityHeading','ENEMY PROFILE');paragraph('monsterProfile',!e.SpecialAbility||e.SpecialAbility==='None'?'No special ability.':'SPECIAL ABILITY  /  '+e.SpecialAbility);","  if(e.id==='VoidGolem'){const skill=sv.get('VoidGolemConfig').toJSObject().Skill;paragraph('golemSkill','Stops to cast '+skill.Name+'. Grants +'+skill.ArmorBonus+' armor within '+skill.Radius+' px for '+skill.Duration+' s. Cooldown: '+skill.Cooldown+' s.');}","  paragraph('monsterFirstWave','FIRST APPEARANCE  /  WAVE '+e.MinimumWave+'+');"," }else if(e.fusion){","  section('recipeHeading',locked?'SEALED COMBINATION':'FUSION COMBINATION');const recipe=v=>v.Recipe.map(p=>p.Label||p.Type+' '+p.Path1+'-'+p.Path2).join(' + '),known=e.definition.Variants.filter(v=>archive.hasVariant(e.id,v.Id));","  paragraph('fusionRecipe'+selectedIndex,locked?'Combination locked':e.definition.AdaptiveVariants?'Each adaptive variant is discovered separately.':known.map(recipe).join('\\n')||'Combination not yet recorded');","  if(e.definition.AdaptiveVariants){const progress=archive.progress(e.id);section('fusionProgress'+selectedIndex,'ADAPTIVE VARIANTS  /  '+progress.found+' / '+progress.total);e.definition.Variants.forEach((v,n)=>paragraph('fusionVariant'+n+selectedIndex,archive.hasVariant(e.id,v.Id)?v.Name+'\\n'+recipe(v):'???  /  UNDISCOVERED'));}","  else if(!locked)paragraph('fusionIdentity','PURE EVOLUTION  /  One canonical recipe. Source order does not change the result.');"," }"," index.detailHeight=sectionY+index.scroll-detail.y;index.maxScroll=Math.max(0,index.detailHeight-detail.h+12);scrollBar('IndexUI',detailTrack,index.maxScroll,index.scroll);","}else{text('emptyArchive','No entries available.',detail.x+20,detail.y+30,detail.w-40,16,C.muted);index.maxScroll=0;}","for(const name of ['IndexUI','IndexList','IndexDetail'])scene.getLayer(name).show(open);","index.wasDown=down;if(!down)index.pressed='';"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// A separate UI overlay. Shop and map geometry stay independent of selection.","const scene=runtimeScene,sv=scene.getVariables(),game=scene.getGame();","let ui=scene.__selectedPanel;","if(!ui) {","  ui=scene.__selectedPanel={objects:{},wasDown:false,pressed:\"\",pressedTower:0,cards:[]};","  ui.ensure=(key,name,z=1)=>{","    if(!ui.objects[key]){const o=scene.createObject(name);o.setLayer(\"SelectedTowerUI\");o.setZOrder(z);ui.objects[key]=o;}","    return ui.objects[key];","  };","}","const towers=[...scene.getObjects(\"StarCannonTower\"),...scene.getObjects('NebulaBloomTower')];","let selected=towers.find(t=>t.getVariables().get(\"TowerId\").getAsNumber()===sv.get(\"SelectedTower\").getAsNumber());","if(!selected&&sv.get(\"SelectedTower\").getAsNumber()>0)sv.get(\"SelectedTower\").setNumber(0);","const input=game.getInputManager(),down=input.isMouseButtonPressed(0),modal=sv.get(\"IndexBlocksInput\").getAsBoolean()||sv.get(\"AudioUIConsumesClick\").getAsBoolean()||sv.get('FusionActive').getAsBoolean()||sv.get('CampaignModal').getAsBoolean()||sv.get('CampaignUIConsumesClick').getAsBoolean();","const h=680,w=320,layer=scene.getLayer(\"SelectedTowerUI\");","let scale=1,sx=8,sy=8;","const positionPanel=tower=>{"," const area=scene.__towerShopUI.gameArea,margin=8,map=scene.getLayer(\"\");"," const center=tower?(scene.__freePlacement?scene.__freePlacement.center(tower):[tower.getCenterXInScene(),tower.getCenterYInScene()]):[(area.left+area.right)/2,0];"," const screen=tower?map.convertInverseCoords(center[0],center[1],0,[0,0]):center;"," const right=tower&&screen[0]<(area.left+area.right)/2;"," const hud=scene.getObjects(\"HUDPanel\")[0],hudLayer=scene.getLayer(\"UI\");"," const hudBottom=hudLayer.convertInverseCoords(hud.getX(),hud.getY()+hud.getHeight(),0,[0,0])[1];"," sy=Math.max(margin,hudBottom+margin);"," const footprint=tower&&scene.__freePlacement?scene.__freePlacement.radius(tower)*map.getCameraZoom():0;"," const sideRoom=tower?(right?area.right-margin-screen[0]-footprint-margin:screen[0]-footprint-margin-area.left-margin):area.right-area.left-2*margin;"," scale=Math.max(.01,Math.min(1,(game.getGameResolutionHeight()-sy-margin)/h,((area.right-area.left)/2-2*margin)/w,sideRoom/w));"," sx=right?area.right-margin-w*scale:area.left+margin;"," sx=Math.max(area.left+margin,Math.min(area.right-margin-w*scale,sx));"," layer.setCameraZoom(scale);layer.setCameraX(game.getGameResolutionWidth()/2/scale-sx/scale);layer.setCameraY(game.getGameResolutionHeight()/2/scale-sy/scale);"," ui.panelSide=right?\"RIGHT\":\"LEFT\";ui.screenRect=tower?{x:sx,y:sy,w:w*scale,h:h*scale}:null;","};","positionPanel(selected);","const mx=gdjs.evtTools.input.getCursorX(scene,\"SelectedTowerUI\",0),my=gdjs.evtTools.input.getCursorY(scene,\"SelectedTowerUI\",0);","const inside=(x,y,width,height)=>mx>=x&&mx<x+width&&my>=y&&my<y+height;","const pointer=!!selected&&!modal&&inside(0,0,w,h);","sv.get(\"SelectedPanelPointerInside\").setBoolean(pointer);","sv.get(\"TowerUIConsumesClick\").setBoolean(pointer);","ui.screenRect=selected?{x:sx,y:sy,w:w*scale,h:h*scale}:null;","const canFuse=scene.__fusion?.eligible(selected)||false;","const hover=!selected||modal?\"\":canFuse&&inside(16,584,288,26)?'Fusion':inside(16,h-66,w-32,48)?\"Sell\":inside(278,12,26,26)?\"Close\":inside(16,314,140,270)?\"Path1\":inside(164,314,140,270)?\"Path2\":pointer?\"Panel\":\"\";","if(down&&!ui.wasDown){ui.pressed=hover;ui.pressedTower=selected?selected.getVariables().get(\"TowerId\").getAsNumber():0;}","if(!down&&ui.wasDown&&selected&&!modal&&ui.pressed===hover&&ui.pressedTower===selected.getVariables().get(\"TowerId\").getAsNumber()) {","  if(hover===\"Sell\") {","    const v=selected.getVariables(),investment=v.get(\"TotalInvestment\").getAsNumber();","    sv.get(\"Money\").setNumber(sv.get(\"Money\").getAsNumber()+Math.floor(investment*sv.get(\"SellRefundRate\").getAsNumber()+1e-8));","    selected.deleteFromScene();sv.get(\"SelectedTower\").setNumber(0);selected=null;","  } else if(hover==='Fusion'){scene.__fusion?.begin(selected);selected=null;}","  else if(hover===\"Close\") {sv.get(\"SelectedTower\").setNumber(0);selected=null;}","  else if((hover===\"Path1\"||hover===\"Path2\"))(selected.getName()==='NebulaBloomTower'?scene.__nebulaBloom:scene.__starCannon)?.upgrade(selected,hover===\"Path1\"?1:2);","}","if(!down)ui.pressed=\"\";ui.wasDown=down;","ui.render=()=>{","  Object.values(ui.objects).forEach(o=>o.hide());","  const tower=towers.find(t=>t.getVariables().get(\"TowerId\").getAsNumber()===sv.get(\"SelectedTower\").getAsNumber()&&scene.getObjects(t.getName()).includes(t));","  positionPanel(tower);layer.show(!!tower);ui.tower=tower;ui.cards=[];","  if(!tower){ui.screenRect=null;return;}","  const v=tower.getVariables(),isStar=true,isNebula=tower.getName()==='NebulaBloomTower',isFusion=scene.__starCannon.isFusion(tower),hasUpgrades=!isFusion,cfg=sv.get(isNebula?'NebulaBloomConfig':'StarCannonConfig').toJSObject();","  const panel=(key,x,y,width,height,color=\"255;255;255\",name=\"SelectedPanelBackground\",z=1)=>{const o=ui.ensure(key,name,z);o.setPosition(x,y);o.setWidth(width);o.setHeight(height);o.setColor(color);o.setOpacity(255);o.hide(false);return o;};","  const text=(key,value,x,y,width,size=13,color=\"240;230;255\",bold=false)=>{const o=ui.ensure(key,\"SelectedPanelText\",4);o.setPosition(x,y);o.setWrapping(true);o.setWrappingWidth(width);o.setTextAlignment(\"left\");o.setString(String(value));o.setCharacterSize(size);o.setBold(bold);o.setColor(color);o.hide(false);return o;};","  panel(\"frame\",0,0,w,h);","  panel(\"header\",12,10,w-24,42,\"255;255;255\",\"SelectedPanelPlaque\",2);","  text(\"title\",v.get(\"TowerName\").getAsString().toUpperCase(),22,22,w-66,17,\"243;234;255\",true);","  text(\"close\",\"X\",286,20,16,14,\"194;171;233\",true);","  const preview=ui.ensure(\"preview\",\"SelectedTowerPreview\",3);preview.setAnimationName((isNebula?'NB_':'SC_')+v.get(\"VisualKey\").getAsString());preview.setScale(1);const ratio=preview.getWidth()/Math.max(1,preview.getHeight());preview.setWidth(ratio>=1?84:84*ratio);preview.setHeight(ratio>=1?84/ratio:84);preview.setPosition((w-preview.getWidth())/2,62+(84-preview.getHeight())/2);preview.hide(false);","  if(hasUpgrades)text(\"build\",v.get(\"Path1Level\").getAsNumber()+\" - \"+v.get(\"Path2Level\").getAsNumber(),138,148,64,12,\"163;224;251\",true);","  const stats=[[\"DAMAGE\",Number(v.get(\"Damage\").getAsNumber().toFixed(2))],[\"FIRE INTERVAL\",Number(v.get(\"AttackInterval\").getAsNumber()).toFixed(2)+\" s\"],[\"ATTACK RANGE\",Number(v.get(\"AttackRange\").getAsNumber().toFixed(2))+\" px\"],[\"DAMAGE DEALT\",Math.round(v.get(\"DamageDealt\").getAsNumber())]];","  stats.forEach(([label,value],i)=>{","    const y=174+i*25;text(\"statLabel\"+i,label,24,y,164,12,\"171;159;199\");const o=text(\"statValue\"+i,value,194,y,100,13,\"240;233;255\",true);o.setTextAlignment(\"right\");","    panel(\"rule\"+i,24,y+20,272,1,\"93;66;125\",\"SelectedProgressBlock\",2);","  });","  if(hasUpgrades) {","    if(isNebula){","      const s=scene.__nebulaBloom.stats(v.get('Path1Level').getAsNumber(),v.get('Path2Level').getAsNumber());text('starMode','AOE '+s.BlastRadius.toFixed(0)+'px'+(s.PoisonDamage?' / SPORES '+s.PoisonDamage+' PER '+cfg.PoisonTickSeconds+'s':' / LOCKED IMPACT POINT'),24,276,272,10,'184;211;239');","    }else if(isStar){","      const a=v.get('Path1Level').getAsNumber(),b=v.get('Path2Level').getAsNumber();","      const mode=a>=5?'EVERY 4TH: LANCE / '+cfg.Lance.MaxTargets+' IMPACTS':a>=3?'EVERY 4TH: NOVA / 175% DAMAGE':b>=5?(v.get('OverdriveActive').getAsBoolean()?'OVERDRIVE: DUAL FIRE':'ALTERNATING / OVERDRIVE '+v.get(