,{"objectName":"TileType_Button"},{"objectName":"Ground_Tilemap"},{"objectName":"Tower"},{"objectName":"Enemy"},{"objectName":"Bullet"},{"objectName":"MoneyText"},{"objectName":"LivesText"},{"objectName":"WaveText"},{"objectName":"MessageText"},{"objectName":"HelpText"},{"objectName":"ShotgunTower"},{"objectName":"RocketTower"},{"objectName":"RocketBullet"},{"objectName":"TowerShopBox"},{"objectName":"Monster_Path"},{"objectName":"AssetCardPanel"},{"objectName":"AssetPanelTitle"},{"objectName":"AssetPanelSubtitle"},{"objectName":"AssetTowerLabel"},{"objectName":"AssetTowerPrice"},{"objectName":"AssetShotgunTowerLabel"},{"objectName":"AssetShotgunTowerPrice"},{"objectName":"AssetRocketTowerLabel"},{"objectName":"AssetRocketTowerPrice"},{"objectName":"AssetPanelHint"},{"objectName":"AssetCardSeparator"},{"objectName":"TowerInfoName"},{"objectName":"TowerInfoDamageLabel"},{"objectName":"TowerInfoDamage"},{"objectName":"TowerInfoRateLabel"},{"objectName":"TowerInfoRate"},{"objectName":"TowerInfoRangeLabel"},{"objectName":"TowerInfoRange"},{"objectName":"TowerInfoDealtLabel"},{"objectName":"TowerInfoDealt"},{"objectName":"TowerSellButton"},{"objectName":"TowerSellLabel"},{"objectName":"TowerSellValue"},{"objectName":"TowerInfoCloseHint"},{"objectName":"RangeIndicator"},{"objectName":"Ground_Map"},{"objectName":"Ground_Decoration"},{"objectName":"ShopCoin"},{"objectName":"HUDIcon"},{"objectName":"HUDPanel"},{"objectName":"ShopPlayButton"},{"objectName":"NewSprite"},{"objectName":"ShopPlayLabel"},{"objectName":"ShopPlayIcon"},{"objectName":"ShopScrollUp"},{"objectName":"ShopScrollDown"},{"objectName":"ShopScrollArrow"},{"objectName":"ShopScrollLabel"},{"objectName":"ShopScrollTrack"},{"objectName":"ShopScrollThumb"},{"objectName":"ShopIndexButton"},{"objectName":"ShopIndexLabel"},{"objectName":"IndexPanel"},{"objectName":"IndexText"},{"objectName":"IndexTowerImage"},{"objectName":"IndexMonsterImage"},{"objectName":"HealthBarBackground"},{"objectName":"HealthBarFill"},{"objectName":"NewTiledSprite"}]},"events":[{"colorB":109,"colorG":143,"colorR":90,"creationTime":0,"name":"Responsive tower shop layout and input","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Responsive, clipped, two-column UI. All purchase and wave actions stay in the native events below.","const scene = runtimeScene;","const variables = scene.getVariables();","const get = name => scene.getObjects(name);","const first = name => get(name)[0];","const number = name => variables.get(name).getAsNumber();","const boolean = name => variables.get(name).getAsBoolean();","const mode = () => variables.get(\"WaveMode\").getAsString();","if (mode() !== \"Auto\") variables.get(\"WaveMode\").setString(boolean(\"WaveActive\") ? \"Manual\" : \"Waiting\");","const modal = boolean(\"IndexOpen\");","let ui = scene.__towerShopUI;","if (!ui || ui.root !== first(\"TowerShopBox\")) {","  ui = scene.__towerShopUI = { root: first(\"TowerShopBox\"), cards: [], wasDown: false, pressedCard: -1, pressedControl: \"\", dragging: false };","  ui.ensure = (name, index) => {","    let object = get(name).find(object => object.getVariables().get(\"ShopIndex\").getAsNumber() === index);","    if (!object) { object = scene.createObject(name); object.getVariables().get(\"ShopIndex\").setNumber(index); }","    object.setLayer(\"TowerShopList\");","    return object;","  };","  const container = scene.getLayer(\"TowerShopList\").getRenderer().getRendererObject();","  ui.mask = new PIXI.Graphics();","  container.addChild(ui.mask);","  container.mask = ui.mask;","}","const width = scene.getGame().getGameResolutionWidth();","const height = scene.getGame().getGameResolutionHeight();","// UI uses a stable logical shop X outside the buildable world area. Its camera anchors it to screen right.","const offsetX = 1392 - width;","for (const layerName of [\"UI\", \"TowerShopList\"]) {","  const layer = scene.getLayer(layerName);","  layer.setCameraZoom(1, 0);","  layer.setCameraX(width / 2 + offsetX, 0);","  layer.setCameraY(height / 2, 0);","}","const mapWidth = Math.max(240, width - 272);","const zoom = Math.min(mapWidth / 1408, Math.max(160, height - 128) / 720);","const map = scene.getLayer(\"\");","map.setCameraZoom(zoom, 0);","map.setCameraX((width / 2 - 16) / zoom, 0);","map.setCameraY((height / 2 - 80) / zoom, 0);","ui.geometry = { rootX: 1152, rootY: 16, panelHeight: Math.min(432, Math.max(320, height - 32)), listX: 1168, listY: 80, listWidth: 176 };","const geometry = ui.geometry;","geometry.listHeight = geometry.panelHeight - 216;","geometry.bottom = geometry.rootY + geometry.panelHeight;","geometry.controlsY = geometry.bottom - 142;","geometry.playY = geometry.bottom - 80;","geometry.trackX = 1350;","const rect = (name, x, y, w, h) => { const o = first(name); o.setPosition(x, y); if (w !== undefined) o.setWidth(w); if (h !== undefined) o.setHeight(h); };","rect(\"TowerShopBox\", 1152, 16, 224, geometry.panelHeight);","rect(\"AssetPanelTitle\", 1168, 32, 192, 24);","rect(\"AssetPanelSubtitle\", 1168, 57, 192, 16);","rect(\"AssetPanelHint\", 1168, geometry.bottom - 108, 192, 18);","rect(\"ShopIndexButton\", 1168, geometry.playY, 92, 60);","rect(\"ShopIndexLabel\", 1168, geometry.playY + 22, 92, 24);","first(\"ShopIndexLabel\").setString(\"INDEX\");","rect(\"ShopPlayButton\", 1268, geometry.playY, 92, 60);","rect(\"ShopPlayIcon\", 1302, geometry.playY + 8, 24, 24);","rect(\"ShopPlayLabel\", 1268, geometry.playY + 36, 92, 20);","rect(\"ShopScrollUp\", 1168, geometry.controlsY, 40, 28);","rect(\"ShopScrollDown\", 1216, geometry.controlsY, 40, 28);","get(\"ShopScrollArrow\").forEach((o, i) => { o.setPosition(1176 + i * 48, geometry.controlsY + 6); o.setWidth(20); o.setHeight(16); });","rect(\"ShopScrollLabel\", 1260, geometry.controlsY + 7, 100, 18);","rect(\"ShopScrollTrack\", geometry.trackX, geometry.listY, 8, geometry.listHeight);","// The existing tower information view shares the frame, while PLAY remains available below it.","rect(\"TowerInfoName\", 1168, 36, 192, 30);","const statStep = Math.max(26, (geometry.bottom - 152 - 80 - 10) / 4);","for (const [index, field] of [\"Damage\", \"Rate\", \"Range\", \"Dealt\"].entries()) {","  const y = 80 + index * statStep;","  rect(\"TowerInfo\" + field + \"Label\", 1168, y + 5, 112, 20);","  rect(\"TowerInfo\" + field, 1280, y, 80, 24);","}","rect(\"TowerSellButton\", 1168, geometry.bottom - 152, 192, 52);","rect(\"TowerSellLabel\", 1180, geometry.bottom - 137, 72, 24);","rect(\"TowerSellValue\", 1252, geometry.bottom - 137, 100, 24);","rect(\"TowerInfoCloseHint\", 1168, geometry.bottom - 92, 192, 18);","rect(\"HUDPanel\", offsetX + 16, 16, 316, 44);","get(\"HUDIcon\").forEach((o, i) => { o.setPosition(offsetX + [28,148,230][i], 26); o.setWidth(24); o.setHeight(24); });","rect(\"MoneyText\", offsetX + 60, 25, 80, 28);","rect(\"LivesText\", offsetX + 180, 25, 40, 28);","rect(\"WaveText\", offsetX + 262, 25, 62, 28);","rect(\"HelpText\", offsetX + 20, height - 42, mapWidth, 30);","const message = first(\"MessageText\");","message.setPosition(offsetX + 16 + mapWidth / 2 - message.getWidth() / 2, height / 2 - 20);","// Prices have exactly one source: the existing costs migrated unchanged into TowerShopCatalog.","const catalog = variables.get(\"TowerShopCatalog\").toJSObject();","for (const name of [\"AssetCardPanel\", \"TileType_Button\", \"AssetTowerLabel\", \"AssetTowerPrice\", \"ShopCoin\"]) {","  get(name).slice().forEach(object => {","    if (object.getVariables().get(\"ShopIndex\").getAsNumber() >= catalog.length) object.deleteFromScene(scene);","  });","}","ui.cards.length = catalog.length;","for (let i = 0; i < catalog.length; i++) {","  const item = catalog[i];","  if (!ui.cards[i]) {","    const card = ui.cards[i] = { background: ui.ensure(\"AssetCardPanel\", i), icon: ui.ensure(\"TileType_Button\", i), name: ui.ensure(\"AssetTowerLabel\", i), price: ui.ensure(\"AssetTowerPrice\", i), coin: ui.ensure(\"ShopCoin\", i) };","    card.icon.activateBehavior(\"ButtonScaleTween\", false);","    if (card.icon.hasBehavior(\"Effect\")) card.icon.getBehavior(\"Effect\").enableEffect(\"Outline\", false);","    card.icon.setAnimationName(item.IconAnimation || item.Type);","    const ratio = card.icon.getWidth() / Math.max(1, card.icon.getHeight());","    card.iconWidth = ratio > 1 ? 44 : 44 * ratio;","    card.iconHeight = ratio > 1 ? 44 / ratio : 44;","  }","  const card = ui.cards[i];","  card.item = item;","  card.icon.getVariables().get(\"TowerType\").setString(item.Type);","  card.icon.getVariables().get(\"Cost\").setNumber(item.Cost);","  card.name.setString(item.Name);","  card.price.setString(String(item.Cost));","}","const contentHeight = Math.ceil(catalog.length / 2) * 108 - 8;","const maxScroll = Math.max(0, contentHeight - geometry.listHeight);","let scroll = Math.max(0, Math.min(maxScroll, number(\"TowerShopScroll\")));","const input = scene.getGame().getInputManager();","const mx = gdjs.evtTools.input.getCursorX(scene, \"UI\", 0);","const my = gdjs.evtTools.input.getCursorY(scene, \"UI\", 0);","const inside = (x,y,w,h) => mx >= x && mx < x+w && my >= y && my < y+h;","const shopVisible = number(\"SelectedTower\") === 0 && !modal;","const inList = inside(geometry.listX, geometry.listY, geometry.listWidth, geometry.listHeight);","const inTrack = inside(geometry.trackX - 3, geometry.listY, 14, geometry.listHeight);","variables.get(\"TowerShopPointerInside\").setBoolean(shopVisible && inList);","variables.get(\"TowerShopRequestedType\").setString(\"\");","variables.get(\"PlayWaveRequested\").setBoolean(false);","if (shopVisible && (inList || inTrack)) scroll = Math.max(0, Math.min(maxScroll, scroll - Math.sign(input.getMouseWheelDelta()) * 48));","const hoveredIndex = () => {","  if (!shopVisible || !inList) return -1;","  const x = mx - geometry.listX, y = my - geometry.listY + scroll;","  const col = Math.floor(x / 92), row = Math.floor(y / 108), index = row * 2 + col;","  return col < 2 && x % 92 < 84 && y % 108 < 100 && index < catalog.length ? index : -1;","};","const ready = !boolean(\"WaveActive\") && !boolean(\"GameOver\") && number(\"Wave\") < 50;","const overIndex = !modal && inside(1168, geometry.playY, 92, 60);","const overPlay = !modal && inside(1268, geometry.playY, 92, 60);","const overUp = shopVisible && inside(1168, geometry.controlsY, 40, 28);","const overDown = shopVisible && inside(1216, geometry.controlsY, 40, 28);","const down = input.isMouseButtonPressed(0);","let hovered = hoveredIndex();","if (down && !ui.wasDown) {","  ui.pressedCard = hovered;","  ui.pressedControl = overIndex ? \"Index\" : overPlay ? \"Play\" : overUp ? \"Up\" : overDown ? \"Down\" : \"\";","  if (inTrack && maxScroll > 0 && shopVisible) { ui.dragging = true; ui.dragStartY = my; ui.dragStartScroll = scroll; ui.pressedCard = -1; }","}","const thumbHeight = maxScroll > 0 ? Math.max(22, geometry.listHeight * geometry.listHeight / contentHeight) : geometry.listHeight;","if (ui.dragging && down) scroll = Math.max(0, Math.min(maxScroll, ui.dragStartScroll + (my - ui.dragStartY) * maxScroll / Math.max(1, geometry.listHeight - thumbHeight)));","if (!down && ui.wasDown) {","  if (ui.pressedControl === \"Index\" && overIndex) ui.indexRequested = true;","  if (ui.pressedControl === \"Play\" && overPlay && !boolean(\"GameOver\")) {","    if (mode() === \"Auto\") variables.get(\"WaveMode\").setString(boolean(\"WaveActive\") ? \"Manual\" : \"Waiting\");","    else if (boolean(\"WaveActive\")) variables.get(\"WaveMode\").setString(\"Auto\");","    else if (ready) variables.get(\"PlayWaveRequested\").setBoolean(true);","  }","  if (ui.pressedControl === \"Up\" && overUp) scroll = Math.max(0, scroll - 108);","  if (ui.pressedControl === \"Down\" && overDown) scroll = Math.min(maxScroll, scroll + 108);","  if (!ui.dragging && ui.pressedCard >= 0 && ui.pressedCard === hovered && number(\"Money\") >= catalog[hovered].Cost) variables.get(\"TowerShopRequestedType\").setString(catalog[hovered].Type);","  ui.pressedCard = -1; ui.pressedControl = \"\"; ui.dragging = false;","}","ui.wasDown = down;","variables.get(\"TowerShopScroll\").setNumber(scroll);","hovered = hoveredIndex();","ui.mask.clear().beginFill(0xffffff).drawRect(geometry.listX, geometry.listY, geometry.listWidth, geometry.listHeight).endFill();","ui.cards.forEach((card, i) => {","  const x = geometry.listX + (i % 2) * 92, y = geometry.listY + Math.floor(i / 2) * 108 - scroll;","  card.background.setPosition(x, y); card.background.setWidth(84); card.background.setHeight(100);","  const pressed = down && ui.pressedCard === i && hovered === i;","  const scale = pressed ? 0.94 : 1;","  card.icon.setWidth(card.iconWidth * scale); card.icon.setHeight(card.iconHeight * scale);","  card.icon.setPosition(x + 42 - card.icon.getWidth()/2, y + 47 - card.icon.getHeight()/2);","  card.name.setPosition(x + 4, y + 7); card.name.setWidth(76); card.name.setHeight(18);","  card.coin.setPosition(x + 13, y + 79); card.coin.setWidth(15); card.coin.setHeight(15);","  card.price.setPosition(x + 31, y + 77); card.price.setWidth(46); card.price.setHeight(20);","});","rect(\"ShopScrollThumb\", geometry.trackX, geometry.listY + (maxScroll > 0 ? scroll / maxScroll * (geometry.listHeight - thumbHeight) : 0), 8, thumbHeight);","ui.scrollMax = maxScroll; ui.hovered = hovered; ui.ready = ready; ui.overPlay = overPlay; ui.overUp = overUp; ui.overDown = overDown;","ui.refresh = () => {","  const selectedTower = number(\"SelectedTower\") > 0;","  scene.getLayer(\"TowerShopList\").show(!selectedTower);","  const indicator = first(\"TilePlacement_Indicator\");","  ui.cards.forEach((card, i) => {","    const affordable = number(\"Money\") >= card.item.Cost;","    const selected = !indicator.isHidden() && indicator.getAnimationName() === card.item.Type;","    const pressed = ui.wasDown && ui.pressedCard === i && ui.hovered === i;","    card.background.setColor(selected ? \"255;223;157\" : pressed ? \"237;219;184\" : ui.hovered === i ? \"255;242;211\" : \"255;255;255\");","    if (card.background.hasBehavior(\"Effect\")) card.background.getBehavior(\"Effect\").enableEffect(\"Outline\", selected);","    card.background.setOpacity(affordable ? 255 : 155);","    card.icon.setOpacity(affordable ? 255 : 140);","    card.price.setColor(affordable ? \"117;82;32\" : \"164;67;60\");","    card.name.setColor(affordable ? \"55;60;48\" : \"126;121;110\");","    for (const part of [card.background,card.icon,card.name,card.price,card.coin]) part.hide(selectedTower);","  });","  if (mode() !== \"Auto\") variables.get(\"WaveMode\").setString(boolean(\"WaveActive\") ? \"Manual\" : \"Waiting\");","  const ended = boolean(\"GameOver\"), current = mode();","  first(\"ShopPlayButton\").setOpacity(ended ? 155 : 255);","  first(\"ShopPlayButton\").setColor(current === \"Auto\" ? \"189;222;148\" : ui.overPlay ? \"235;255;228\" : \"255;255;255\");","  first(\"ShopPlayIcon\").hide(ended || current === \"Auto\");","  first(\"ShopPlayIcon\").setAnimationName(current === \"Manual\" ? \"Manual\" : \"Play\");","  first(\"ShopPlayLabel\").setCharacterSize(ended ? 12 : 14);","  first(\"ShopPlayLabel\").setString(ended ? (number(\"Lives\") > 0 ? \"COMPLETE\" : \"GAME OVER\") : current === \"Auto\" ? \"AUTO\" : current === \"Manual\" ? \"MANUAL\" : \"PLAY\");","  first(\"ShopPlayLabel\").setY(geometry.playY + (ended || current === \"Auto\" ? 22 : 36));","  first(\"ShopIndexButton\").setColor(overIndex ? \"235;255;228\" : \"255;255;255\");","  first(\"ShopScrollUp\").setOpacity(scroll > 0 ? 255 : 120);","  first(\"ShopScrollDown\").setOpacity(scroll < maxScroll ? 255 : 120);","  first(\"ShopScrollThumb\").setOpacity(maxScroll > 0 ? 255 : 110);","  first(\"ShopScrollLabel\").setString(catalog.length + \" TOWERS\");","  first(\"AssetPanelHint\").setString(ui.hovered >= 0 && number(\"Money\") < ui.cards[ui.hovered].item.Cost ? \"Need \" + (ui.cards[ui.hovered].item.Cost - number(\"Money\")) + \" more\" : \"Select, then place\");","};"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[]},{"colorB":109,"colorG":143,"colorR":90,"creationTime":0,"name":"Unit INDEX modal","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Display-only objects: none belongs to Enemy or PlaceableTile.","const sv = runtimeScene.getVariables();","const game = runtimeScene.getGame();","const width = game.getGameResolutionWidth(), height = game.getGameResolutionHeight();","const input = game.getInputManager();","let index = runtimeScene.__unitIndex;","if (!index) {","  index = runtimeScene.__unitIndex = { objects: {}, cards: [], category: \"Towers\", scroll: 0, wasDown: false, pressed: \"\", dragging: false };","  index.ensure = (key, name, layer, z) => {","    if (!index.objects[key]) {","      const object = runtimeScene.createObject(name); object.setLayer(layer); object.setZOrder(z);","      index.objects[key] = object;","    }","    return index.objects[key];","  };","  const container = runtimeScene.getLayer(\"IndexList\").getRenderer().getRendererObject();","  index.mask = new PIXI.Graphics(); container.addChild(index.mask); container.mask = index.mask;","}","for (const name of [\"IndexUI\", \"IndexList\"]) {","  const layer = runtimeScene.getLayer(name);","  layer.setCameraZoom(1); layer.setCameraX(width/2); layer.setCameraY(height/2);","}","const wasOpen = sv.get(\"IndexOpen\").getAsBoolean();","const shop = runtimeScene.__towerShopUI;","if (shop && shop.indexRequested) { sv.get(\"IndexOpen\").setBoolean(true); shop.indexRequested = false; }","let open = sv.get(\"IndexOpen\").getAsBoolean();","// Block the entire closing frame too, so CLOSE/Escape cannot activate controls beneath.","sv.get(\"IndexBlocksInput\").setBoolean(wasOpen || open);","const down = input.isMouseButtonPressed(0);","if (!open) {","  runtimeScene.getLayer(\"IndexUI\").show(false); runtimeScene.getLayer(\"IndexList\").show(false);","  index.wasDown = down; index.pressed = \"\"; index.dragging = false;","  return;","}","const mx = gdjs.evtTools.input.getCursorX(runtimeScene,\"IndexUI\",0), my = gdjs.evtTools.input.getCursorY(runtimeScene,\"IndexUI\",0);","const w = Math.min(700,width-32), h = Math.min(600,height-32), x = (width-w)/2, y = (height-h)/2;","const content = { x:x+20,y:y+108,w:w-52,h:h-180 };","index.geometry = {x,y,w,h,content};","const inside = (a,b,c,d) => mx>=a && mx<a+c && my>=b && my<b+d;","const closeY=y+h-54, tabWidth=(w-48)/2;","const hover = inside(x+20,y+62,tabWidth,32)?\"Towers\":inside(x+28+tabWidth,y+62,tabWidth,32)?\"Monsters\":inside(x+w-140,closeY,120,34)?\"Close\":inside(x+20,closeY,38,34)?\"Up\":inside(x+64,closeY,38,34)?\"Down\":\"\";","if (down && !index.wasDown) index.pressed=hover;","if ((!down && index.wasDown && index.pressed===\"Close\" && hover===\"Close\") || gdjs.evtTools.input.wasKeyJustPressed(runtimeScene,\"Escape\")) {","  sv.get(\"IndexOpen\").setBoolean(false);open=false;","}","if (!down && index.wasDown && index.pressed===hover && [\"Towers\",\"Monsters\"].includes(hover) && index.category!==hover) { index.category=hover;index.scroll=0; }","// Read the same object variables/catalog/archetypes that the game uses. No copied balance table.","const data=game.getSceneAndExtensionsData(runtimeScene.getName()).sceneData;","const catalog=sv.get(\"TowerShopCatalog\").toJSObject();","const archetypes=sv.get(\"EnemyTypes\").toJSObject();","const roles={Normal:\"General enemy\",Fast:\"Fast runner / low HP\",Tank:\"High HP / slow\",Elite:\"Durable and fast\",Boss:\"Heavy threat / slow\"};","const entries=index.category===\"Towers\" ? catalog.map(item=>{","  const definition=data.objects.find(o=>o.name===item.Type); if(!definition)return null;","  const values=Object.fromEntries(definition.variables.map(v=>[v.name,v.value]));","  return {name:values.TowerName||item.Name,animation:item.IconAnimation||item.Type,damage:values.Damage,range:values.AttackRange,cooldown:values.AttackInterval,price:item.Cost,","    special:item.Type===\"RocketTower\"?\"Single-target rocket projectile.\":\"Single projectile per shot.\",type:item.Type};","}).filter(Boolean) : [...new Set([\"Normal\",\"Fast\",\"Tank\",\"Elite\",\"Boss\",...Object.keys(archetypes)])].filter(name=>archetypes[name]).map(name=>({name,...archetypes[name],role:roles[name]||\"Enemy archetype\"}));","index.entries=entries;","const stride=160, cardHeight=148, maxScroll=Math.max(0,entries.length*stride-12-content.h);","if(inside(content.x,content.y,content.w+16,content.h))index.scroll-=Math.sign(input.getMouseWheelDelta())*52;","if(!down && index.wasDown && index.pressed===hover){if(hover===\"Up\")index.scroll-=stride;if(hover===\"Down\")index.scroll+=stride;}","const trackX=x+w-24,thumbHeight=maxScroll>0?Math.max(28,content.h*content.h/(entries.length*stride-12)):content.h;","if(down&&!index.wasDown&&inside(trackX-3,content.y,14,content.h)){index.dragging=true;index.dragY=my;index.dragScroll=index.scroll;}","if(down&&index.dragging)index.scroll=index.dragScroll+(my-index.dragY)*maxScroll/Math.max(1,content.h-thumbHeight);","if(!down)index.dragging=false;","index.scroll=Math.max(0,Math.min(maxScroll,index.scroll));index.maxScroll=maxScroll;","const panel=(key,a,b,c,d,color,opacity=255,layer=\"IndexUI\",z=1)=>{","  const o=index.ensure(key,\"IndexPanel\",layer,z);o.setPosition(a,b);o.setWidth(c);o.setHeight(d);o.setColor(color);o.setOpacity(opacity);o.hide(false);return o;","};","const text=(key,value,a,b,c,size,color=\"51;62;49\",bold=false,layer=\"IndexUI\",z=2)=>{","  const o=index.ensure(key,\"IndexText\",layer,z);o.setPosition(a,b);o.setWidth(c);o.setString(String(value));o.setCharacterSize(size);o.setColor(color);o.setBold(bold);o.hide(false);return o;","};","Object.values(index.objects).forEach(o=>o.hide());","panel(\"shade\",0,0,width,height,\"20;29;23\",190,\"IndexUI\",0);","panel(\"frame\",x,y,w,h,\"255;255;255\");","text(\"title\",\"UNIT INDEX\",x+22,y+16,w-44,24,\"47;68;46\",true);","text(\"subtitle\",\"Field guide  /  Live gameplay stats\",x+22,y+44,w-44,12,\"115;114;96\");","for(const [i,category] of [\"Towers\",\"Monsters\"].entries()){","  const tx=x+20+i*(tabWidth+8),active=index.category===category;","  panel(\"tab\"+i,tx,y+62,tabWidth,32,active?\"191;219;171\":\"237;231;213\");","  text(\"tabText\"+i,category.toUpperCase(),tx+14,y+69,tabWidth-28,14,\"48;67;44\",true);","}","index.mask.clear().beginFill(0xffffff).drawRect(content.x,content.y,content.w,content.h).endFill();","index.cards=[];","entries.forEach((entry,i)=>{","  const cy=content.y+i*stride-index.scroll, cx=content.x, cw=content.w;","  panel(\"card\"+i,cx,cy,cw,cardHeight,\"248;246;234\",255,\"IndexList\",0);","  panel(\"portrait\"+i,cx+12,cy+12,80,cardHeight-24,\"230;235;214\",255,\"IndexList\",1);","  const monster=index.category===\"Monsters\", sprite=index.ensure((monster?\"monster\":\"tower\")+i,monster?\"IndexMonsterImage\":\"IndexTowerImage\",\"IndexList\",2);","  sprite.setAnimationName(monster?\"Idle Run\":entry.animation);","  sprite.setColor(monster?entry.Tint:\"255;255;255\");","  // Fit each existing image to the portrait; no real gameplay unit is created.","  sprite.setScale(1);const ratio=sprite.getWidth()/Math.max(1,sprite.getHeight());","  const size=monster?Math.min(66,46*(entry.Scale||1)):58;","  sprite.setWidth(ratio>=1?size:size*ratio);sprite.setHeight(ratio>=1?size/ratio:size);","  sprite.setPosition(cx+52-sprite.getWidth()/2,cy+cardHeight/2-sprite.getHeight()/2);sprite.hide(false);","  const name=text(\"name\"+i,entry.name,cx+108,cy+12,cw-124,20,\"45;67;43\",true,\"IndexList\");","  const stats=monster?\"HP: \"+entry.HP+\"     Speed: \"+entry.Speed+\"\\nGold Reward: \"+entry.Reward+\" Gold\":\"Damage: \"+entry.damage+\"     Range: \"+entry.range+\"\\nCooldown: \"+Number(entry.cooldown).toFixed(2)+\" s     Price: \"+entry.price+\" Gold\";","  const statText=text(\"stats\"+i,stats,cx+108,cy+44,cw-124,15,\"62;68;53\",false,\"IndexList\");","  const special=text(\"special\"+i,(monster?\"ROLE\\n\":\"SPECIAL\\n\")+(monster?entry.role:entry.special),cx+108,cy+92,cw-124,13,\"116;102;67\",false,\"IndexList\");","  index.cards.push({name,stats:statText,special,sprite});","});","panel(\"track\",trackX,content.y,8,content.h,\"225;219;198\");","panel(\"thumb\",trackX,content.y+(maxScroll?index.scroll/maxScroll*(content.h-thumbHeight):0),8,thumbHeight,\"138;163;116\");","for(const [key,label,bx,bw] of [[\"Up\",\"UP\",x+20,38],[\"Down\",\"DN\",x+64,38],[\"Close\",\"CLOSE\",x+w-140,120]]){","  panel(\"button\"+key,bx,closeY,bw,34,hover===key?\"196;222;175\":\"224;230;208\");","  text(\"buttonText\"+key,label,bx+8,closeY+9,bw-16,13,\"48;68;44\",true);","}","text(\"count\",entries.length+\" \"+index.category.toUpperCase()+\"  /  SCROLL\",x+118,closeY+10,Math.max(80,w-280),12,\"116;111;91\");","runtimeScene.getLayer(\"IndexUI\").show(open);runtimeScene.getLayer(\"IndexList\").show(open);","index.wasDown=down;if(!down)index.pressed=\"\";"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[]},{"colorB":109,"colorG":143,"colorR":90,"creationTime":0,"name":"Monster path initialization","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"SceneJustBegins"},"parameters":[""]}],"actions":[],"events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// The scene's Monster_Path instances are the only source of route geometry.","const tiles = runtimeScene.getObjects(\"Monster_Path\").slice().sort((a, b) =>","  a.getVariables().get(\"PathOrder\").getAsNumber() - b.getVariables().get(\"PathOrder\").getAsNumber());","if (tiles.length < 2) throw new Error(\"Monster_Path needs a spawn tile and an end tile.\");","const route = runtimeScene.getVariables().get(\"MonsterPathPoints\");","route.clearChildren();","for (let i = 0; i < tiles.length; i++) {","  const tile = tiles[i];","  if (tile.getVariables().get(\"PathOrder\").getAsNumber() !== i)","    throw new Error(\"Monster_Path PathOrder must be unique and consecutive, starting at 0.\");","  if (i > 0) {","    const prev = tiles[i - 1];","    const dx = Math.abs(tile.getCenterXInScene() - prev.getCenterXInScene());","    const dy = Math.abs(tile.getCenterYInScene() - prev.getCenterYInScene());","    const horizontal = dy < 0.001 && dx > 0.001 && dx <= (tile.getWidth() + prev.getWidth()) / 2 + 0.001;","    const vertical = dx < 0.001 && dy > 0.001 && dy <= (tile.getHeight() + prev.getHeight()) / 2 + 0.001;","    if (!horizontal && !vertical) throw new Error(\"Monster_Path tiles must form a continuous, cardinal route.\");","  }","  const point = route.getChild(i);","  point.getChild(\"X\").setNumber(tile.getCenterXInScene());","  point.getChild(\"Y\").setNumber(tile.getCenterYInScene());","}","runtimeScene.getVariables().get(\"MonsterPathPointCount\").setNumber(tiles.length);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}]}],"parameters":[]},{"colorB":109,"colorG":143,"colorR":90,"creationTime":0,"name":"Tower selection and selling","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"SceneJustBegins"},"parameters":[""]}],"actions":[{"type":{"value":"PanelSpriteObject::SetColor"},"parameters":["TowerSellButton","\"239;227;196\""]}]},{"type":"BuiltinCommonInstructions::ForEach","object":"PlaceableTile","conditions":[{"type":{"value":"NumberObjectVariable"},"parameters":["PlaceableTile","TowerId","=","0"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["NextTowerId","+","1"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["PlaceableTile","TowerId","=","NextTowerId"]},{"type":{"value":"ZOrder"},"parameters":["PlaceableTile","=","2"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"MouseButtonFromTextPressed"},"param