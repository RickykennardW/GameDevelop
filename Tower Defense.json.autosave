AGE DEALT\",Math.round(v.get(\"DamageDealt\").getAsNumber())]];","  stats.forEach(([label,value],i)=>{","    const y=174+i*25;text(\"statLabel\"+i,label,24,y,164,12,\"171;159;199\");const o=text(\"statValue\"+i,value,194,y,100,13,\"240;233;255\",true);o.setTextAlignment(\"right\");","    panel(\"rule\"+i,24,y+20,272,1,\"93;66;125\",\"SelectedProgressBlock\",2);","  });","  if(hasUpgrades) {","    if(isStar){","      const a=v.get('Path1Level').getAsNumber(),b=v.get('Path2Level').getAsNumber();","      const mode=a>=5?'EVERY 4TH: LANCE / '+cfg.Lance.MaxTargets+' IMPACTS':a>=3?'EVERY 4TH: NOVA / 175% DAMAGE':b>=5?(v.get('OverdriveActive').getAsBoolean()?'OVERDRIVE: DUAL FIRE':'ALTERNATING / OVERDRIVE '+v.get('OverdriveRemaining').getAsNumber().toFixed(1)+'s'):b>=3?'ALTERNATING MUZZLES':'SINGLE STELLAR BOLT';","      text('starMode',mode+(b>=4?' / RHYTHM '+v.get('RhythmStacks').getAsNumber()+'/5':''),24,276,272,10,'184;211;239');","    }","    text(\"upgrades\",\"UPGRADES\",116,isStar?294:282,150,14,\"160;230;249\",true);","    cfg.Paths.forEach((path,i)=>{","      const level=v.get(i===0?\"Path1Level\":\"Path2Level\").getAsNumber(),other=v.get(i===0?\"Path2Level\":\"Path1Level\").getAsNumber();","      const locked=level>=2&&other>=3,max=level>=cfg.MaxLevel,upgrade=path.Upgrades[max?cfg.MaxLevel-1:level],affordable=sv.get(\"Money\").getAsNumber()>=upgrade.Cost;","      const x=16+i*148,y=314,active=!locked&&!max;","      const background=panel(\"card\"+i,x,y,140,270,locked?\"116;95;148\":active&&hover===\"Path\"+(i+1)?\"230;210;255\":\"240;224;255\",\"SelectedUpgradeCard\",2);","      const badge=ui.ensure(\"pathBadge\"+i,\"StarUpgradeIcon\",3);badge.setAnimationName(i===0?\"PathDamage\":\"PathSpeed\");badge.setWidth(24);badge.setHeight(24);badge.setPosition(x+10,y+12);badge.setOpacity(locked?170:255);badge.hide(false);","      text(\"path\"+i,isStar?path.Name:\"PATH \"+(i+1),x+40,y+12,90,isStar?10:13,\"193;224;255\",true);","      for(let n=0;n<cfg.MaxLevel;n++)panel