riables":[],"effects":[],"behaviors":[],"string":"","font":"","textAlignment":"left","characterSize":11.0,"color":{"b":48,"g":52,"r":39},"content":{"bold":true,"isOutlineEnabled":false,"isShadowEnabled":false,"italic":false,"outlineColor":"255;255;255","outlineThickness":2.0,"shadowAngle":90.0,"shadowBlurRadius":2.0,"shadowColor":"0;0;0","shadowDistance":4.0,"shadowOpacity":127.0,"smoothed":true,"underlined":false,"text":"","font":"","textAlignment":"left","verticalTextAlignment":"top","characterSize":11.0,"lineHeight":0.0,"color":"39;52;48"}},{"adaptCollisionMaskAutomatically":true,"assetStoreId":"","name":"AudioBlock","persistentUuid":"85d4981f-811c-419b-852b-87ffed392d61","type":"Sprite","updateIfNotVisible":false,"variables":[],"effects":[],"behaviors":[],"animations":[{"name":"Bar","useMultipleDirections":false,"directions":[{"looping":false,"timeBetweenFrames":0.08,"sprites":[{"hasCustomCollisionMask":true,"image":"assets/ui/enemy-health-pixel.svg","points":[],"originPoint":{"name":"origine","x":0.0,"y":0.0},"centerPoint":{"automatic":true,"name":"centre","x":0.0,"y":0.0},"customCollisionMask":[]}]}]}]},{"adaptCollisionMaskAutomatically":true,"assetStoreId":"","name":"AudioSpeaker","persistentUuid":"82a03eee-fdfe-4b36-81a0-1ef2c746698b","type":"Sprite","updateIfNotVisible":false,"variables":[],"effects":[],"behaviors":[],"animations":[{"name":"Bar","useMultipleDirections":false,"directions":[{"looping":false,"timeBetweenFrames":0.08,"sprites":[{"hasCustomCollisionMask":true,"image":"assets/ui/audio_speaker.svg","points":[],"originPoint":{"name":"origine","x":0.0,"y":0.0},"centerPoint":{"automatic":true,"name":"centre","x":0.0,"y":0.0},"customCollisionMask":[]}]}]}]},{"adaptCollisionMaskAutomatically":true,"assetStoreId":"","name":"StarburstGhost","persistentUuid":"3fa0e824-2a26-4249-a8de-d5039013998b","type":"Sprite","updateIfNotVisible":false,"variables":[],"effects":[],"behaviors":[],"animations":[{"name":"Preview","useMultipleDirections":false,"directions":[{"looping":false,"timeBetweenFrames":0.05,"sprites":[{"hasCustomCollisionMask":false,"image":"assets/towers/starburst_cannon/Starburst_Preview.png","points":[],"originPoint":{"name":"origine","x":0.0,"y":0.0},"centerPoint":{"automatic":true,"name":"centre","x":0.0,"y":0.0},"customCollisionMask":[]}]}]}]},{"adaptCollisionMaskAutomatically":true,"assetStoreId":"","name":"IndexShowcase","persistentUuid":"23aa232d-f0a9-43af-84bd-981c9c5c0c82","type":"Sprite","updateIfNotVisible":false,"variables":[],"effects":[],"behaviors":[],"animations":[{"name":"StarCannon_IndexPortrait","useMultipleDirections":false,"directions":[{"looping":false,"timeBetweenFrames":0.06,"sprites":[{"hasCustomCollisionMask":false,"image":"assets/ui/index/portraits/StarCannon_IndexPortrait.png","points":[],"originPoint":{"name":"origine","x":0.0,"y":0.0},"centerPoint":{"automatic":true,"name":"centre","x":0.0,"y":0.0},"customCollisionMask":[]}]}]},{"name":"StarburstCannon_IndexPortrait","useMultipleDirections":false,"directions":[{"looping":false,"timeBetweenFrames":0.06,"sprites":[{"hasCustomCollisionMask":false,"image":"assets/ui/index/portraits/StarburstCannon_IndexPortrait.png","points":[],"originPoint":{"name":"origine","x":0.0,"y":0.0},"centerPoint":{"automatic":true,"name":"centre","x":0.0,"y":0.0},"customCollisionMask":[]}]}]}]}],"objectsFolderStructure":{"folderName":"__ROOT","children":[{"folderName":"01_MAP","children":[{"folderName":"Terrain","children":[{"objectName":"Ground_Map"},{"objectName":"VoidBackdrop"},{"objectName":"IslandCliffFrame"}]},{"folderName":"MonsterPath","children":[{"objectName":"Monster_Path"}]},{"folderName":"SpawnAndBase","children":[{"objectName":"SpawnMarker"},{"objectName":"BaseMarker"}]}]},{"folderName":"02_OBSTACLES","children":[{"folderName":"EnvironmentAndBlockers","children":[{"objectName":"Ground_Decoration"}]}]},{"folderName":"03_TOWERS","children":[{"folderName":"StarCannon","children":[{"objectName":"StarCannonTower"},{"objectName":"StarCannonBaseVisual"},{"objectName":"StarCannonTurretVisual"}]},{"folderName":"PlacementAndRange","children":[{"objectName":"TilePlacement_Indicator"},{"objectName":"TowerBaseRing"},{"objectName":"RangeIndicator"},{"objectName":"PlacementRangeIndicator"}]},{"folderName":"StarburstFusion","children":[{"objectName":"StarburstGhost"}]}]},{"folderName":"04_PROJECTILES","children":[{"folderName":"StarCannon","children":[{"objectName":"StarCannonProjectile"},{"objectName":"StarCannonImpact"}]}]},{"folderName":"05_ENEMIES","children":[{"folderName":"Actors","children":[{"objectName":"Enemy"}]},{"folderName":"HealthBars","children":[{"objectName":"HealthBarBackground"},{"objectName":"HealthBarFill"}]},{"folderName":"DeathEffects","children":[{"objectName":"NovaWispDeathVisual"}]}]},{"folderName":"06_UI","children":[{"folderName":"HUD","children":[{"objectName":"MoneyText"},{"objectName":"LivesText"},{"objectName":"WaveText"},{"objectName":"HUDIcon"},{"objectName":"HUDPanel"}]},{"folderName":"TowerShop","children":[{"objectName":"TowerShopBox"},{"objectName":"TileType_Button"},{"objectName":"AssetCardPanel"},{"objectName":"AssetPanelTitle"},{"objectName":"AssetPanelSubtitle"},{"objectName":"AssetTowerLabel"},{"objectName":"AssetTowerPrice"},{"objectName":"ShopCoin"},{"objectName":"ShopHeaderPlaque"},{"objectName":"ShopFooterFrame"},{"objectName":"ShopScrollTrack"},{"objectName":"ShopScrollThumb"}]},{"folderName":"Buttons","children":[{"objectName":"ShopPlayButton"},{"objectName":"ShopPlayLabel"},{"objectName":"ShopPlayIcon"},{"objectName":"ShopIndexButton"},{"objectName":"ShopSpeedBadge"}]},{"folderName":"UpgradePanel","children":[{"objectName":"SelectedTowerPreview"},{"objectName":"StarUpgradeIcon"},{"objectName":"SelectedPanelBackground"},{"objectName":"SelectedPanelPlaque"},{"objectName":"SelectedUpgradeCard"},{"objectName":"SelectedPanelText"},{"objectName":"SelectedProgressBlock"}]},{"folderName":"Index","children":[{"objectName":"IndexPanel"},{"objectName":"IndexText"},{"objectName":"IndexTowerImage"},{"objectName":"IndexMonsterImage"},{"objectName":"Index_logo"},{"objectName":"IndexShowcase"}]},{"folderName":"Audio","children":[{"objectName":"AudioPanel"},{"objectName":"AudioText"},{"objectName":"AudioBlock"},{"objectName":"AudioSpeaker"}]}]},{"folderName":"07_GAME_SYSTEMS","children":[{"folderName":"WaveFeedback","children":[{"objectName":"MessageText"},{"objectName":"WaveBannerPanel"},{"objectName":"WaveBannerTitle"},{"objectName":"WaveBannerDetail"},{"objectName":"WaveBannerReward"}]}]},{"folderName":"08_EFFECTS","children":[{"folderName":"VoidFortification","children":[{"objectName":"VoidFortificationVFX"},{"objectName":"VoidFortificationCastPulse"}]}]}]},"events":[{"colorB":109,"colorG":143,"colorR":90,"creationTime":0,"name":"Responsive tower shop layout and input","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Responsive two-column shop with one official Star Cannon. All purchase and wave actions stay in the native events below.","const scene = runtimeScene;","const variables = scene.getVariables();","// Independent world presentation controls; combat stats are deliberately separate.","const style=scene.__worldStyle || (scene.__worldStyle={road:88,star:2.5,"," enemy:1.55,spawn:5.2,base:2.15,"," props:{Crystal:1.65,Rock:1.75,Ruin:2.30,Shrub:1.65},"," footprints:{StarCannonTower:46},cliffUnit:.32});","if(!scene.__worldStyleInitialized){"," for(const [name,radius] of Object.entries(style.footprints)){","  const v=variables.get('TowerFootprints').getChild(name);v.getChild('Radius').setNumber(radius);","  v.getChild('RenderScale').setNumber(style.star);"," }"," scene.__worldStyleInitialized=true;","}","const get = name => scene.getObjects(name);","const first = name => get(name)[0];","const number = name => variables.get(name).getAsNumber();","const boolean = name => variables.get(name).getAsBoolean();","const mode = () => variables.get(\"WaveMode\").getAsString();","// One authoritative state: Waiting(0), Manual(1), ManualFast(2), Auto(3), AutoFast(4).","const autoMode = () => mode() === \"Auto\" || mode() === \"AutoFast\";","const fastMode = () => mode() === \"ManualFast\" || mode() === \"AutoFast\";","const syncWaveControl = () => {","  const valid = [\"Waiting\",\"Manual\",\"ManualFast\",\"Auto\",\"AutoFast\"];","  if (!valid.includes(mode())) variables.get(\"WaveMode\").setString(boolean(\"WaveActive\") ? \"Manual\" : \"Waiting\");","  const manager = scene.__waveManager;","  const spawningDone = !manager || manager.index >= manager.queue.length;","  const finished = !boolean(\"WaveActive\") && number(\"EnemiesToSpawn\") === 0 && get(\"Enemy\").length === 0 && spawningDone;","  if (boolean(\"GameOver\") || number(\"Lives\") <= 0) variables.get(\"WaveMode\").setString(\"Waiting\");","  else if (!autoMode() && finished) variables.get(\"WaveMode\").setString(\"Waiting\");","  else if (mode() === \"Waiting\" && boolean(\"WaveActive\")) variables.get(\"WaveMode\").setString(\"Manual\");","  const scale = scene.__fusion?.active ? scene.__fusion.config.FusionTimeScale : fastMode() ? 2 : 1;","  const time = scene.getTimeManager();","  if (time.getTimeScale() !== scale) time.setTimeScale(scale);","};","syncWaveControl();","const modal = boolean(\"IndexOpen\") || boolean(\"AudioUIConsumesClick\") || boolean(\"FusionActive\");","let ui = scene.__towerShopUI;","if (!ui || ui.root !== first(\"TowerShopBox\")) {","  ui = scene.__towerShopUI = { root: first(\"TowerShopBox\"), cards: [], wasDown: false, pressedCard: -1, pressedControl: \"\", dragging: false };","  ui.ensure = (name, index) => {","    let object = get(name).find(object => object.getVariables().get(\"ShopIndex\").getAsNumber() === index);","    if (!object) { object = scene.createObject(name); object.getVariables().get(\"ShopIndex\").setNumber(index); }","    object.setLayer(\"TowerShopList\");","    return object;","  };","  const container = scene.getLayer(\"TowerShopList\").getRenderer().getRendererObject();","  ui.mask = new PIXI.Graphics();","  container.addChild(ui.mask);","  container.mask = ui.mask;","}","// Match the actual Preview/window viewport; keep UI pixels and camera zoom at 1.","const game = scene.getGame();","const viewportWidth = Math.round(gdjs.RuntimeGameRenderer.getWindowInnerWidth());","const viewportHeight = Math.round(gdjs.RuntimeGameRenderer.getWindowInnerHeight());","if (viewportWidth > 0 && viewportHeight > 0 && (game.getGameResolutionWidth() !== viewportWidth || game.getGameResolutionHeight() !== viewportHeight)) {","  game.setGameResolutionSize(viewportWidth, viewportHeight);","  scene.onGameResolutionResized();","}","const width = game.getGameResolutionWidth();","const height = game.getGameResolutionHeight();","// UI uses a stable logical shop X outside the buildable world area. Its camera anchors it to screen right.","const sidebarMargin = 8, mapSidebarGap = 10;","const sidebarScreenX = width - 224 - sidebarMargin;","const gameAreaRight = Math.max(1, sidebarScreenX - mapSidebarGap);","const offsetX = 1376 + sidebarMargin - width;","for (const layerName of [\"UI\", \"TowerShopList\"]) {","  const layer = scene.getLayer(layerName);","  layer.setCameraZoom(1, 0);","  layer.setCameraX(width / 2 + offsetX, 0);","  layer.setCameraY(height / 2, 0);","}","// One reference world, independent of monitor resolution. Fullscreen changes the","// world camera, not route density. World units, footprints and combat ranges stay intact.","const map = scene.getLayer(\"\");","const compactHUD = gameAreaRight < 348;","const hudHeight = compactHUD ? 104 : 44;","const safeTop = 16 + hudHeight + 20;","// HUD overlays the empty upper cliff margin; its input guard remains authoritative.","// On narrow portrait windows reserve the taller HUD band explicitly.","const frameTop = compactHUD ? safeTop : 16;","const mapFrame = { left: 16, top: frameTop, right: Math.max(17,gameAreaRight-16), bottom: Math.max(frameTop+1,height-24) };","const layoutKey = \"celestial-four-lane-88\";","if (!ui.level) {","  // Four broad lanes preserve total travel distance (7128 vs 7168 world units),","  // while allowing wider roads and larger sprites without shrinking build pockets.","  const cell=style.road,left=cell,right=cell*19,firstY=cell*2;","  const rows = [2,5,8,11].map(row=>row*cell);","  const corners = [[left,rows[0]]];","  rows.forEach((y,i)=>{if(i)corners.push([corners[corners.length-1][0],y]);corners.push([i%2===0?right:left,y]);});","  const positions = [corners[0]];","  for (const [tx,ty] of corners.slice(1)) {","    let [x,y] = positions[positions.length-1];","    while (x!==tx || y!==ty) { x+=Math.sign(tx-x)*cell;y+=Math.sign(ty-y)*cell;positions.push([x,y]); }","  }","  const tiles = get(\"Monster_Path\").slice().sort((a,b)=>a.getVariables().get(\"PathOrder\").getAsNumber()-b.getVariables().get(\"PathOrder\").getAsNumber());","  positions.forEach(([x,y],i)=>{","    const tile = tiles[i] || scene.createObject(\"Monster_Path\");","    tile.setLayer(\"\");tile.setZOrder(0);tile.setWidth(cell);tile.setHeight(cell);tile.setPosition(x,y);tile.setAnimationName(\"Surface\");tile.getVariables().get(\"PathOrder\").setNumber(i);","  });","  tiles.slice(positions.length).forEach(tile=>tile.deleteFromScene());","  const spawnPoint=[left+cell/2,firstY+cell/2],last=positions.at(-1),basePoint=[last[0]+cell/2,last[1]+cell/2];","  const spawn = first(\"SpawnMarker\"), base=first(\"BaseMarker\");","  spawn.setPosition(spawnPoint[0]-16,spawnPoint[1]-16);spawn.setWidth(32);spawn.setHeight(32);spawn.setZOrder(0);","  base.setPosition(basePoint[0]-40,basePoint[1]-40);base.setWidth(80);base.setHeight(80);","  const trees = get(\"Ground_Decoration\");","  const middle=(left+right)/2;","  const treePoints=[];","  // Asymmetric floor clusters: keep generous bend pockets and multiple open strips.","  const compositions=[[.24,.32,.60,.67],[.72,.64,.30,.39],[.35,.43,.72,.79]];","  for(let band=0;band<3;band++){","    const y=(rows[band]+cell+rows[band+1])/2-32;","    for(const t of compositions[band])treePoints.push([left+(right-left)*t-32,y]);","  }","  trees.forEach((tree,i)=>{tree.setPosition(...treePoints[i%12]);tree.getVariables().get('LocalScale').setNumber(1);tree.getVariables().get('Kind').setString(['Crystal','Rock','Ruin','Shrub'][i%4]);});","  // Smaller satellites enrich floor clusters without adding another large obstruction.","  for(const [kind,t,band,dy,size] of [","    ['Rock',.21,0,40,.42],['Shrub',.29,0,46,.56],","    ['Crystal',.75,1,42,.46],['Shrub',.67,1,50,.53],","    ['Rock',.69,2,44,.43],['Shrub',.39,2,48,.56],","    ['Crystal',.48,-1,0,.80],['Shrub',.54,-1,20,.72]]){","      const o=scene.createObject('Ground_Decoration');o.setLayer('');o.getVariables().get('Kind').setString(kind);o.getVariables().get('LocalScale').setNumber(size);","      const y=band<0?firstY-72:(rows[band]+cell+rows[band+1])/2+dy;","      o.setPosition(left+(right-left)*t-32,y-32);","  }","  // Exact outer extent of the proportional perimeter in island-map-runtime.js,","  // plus 12 world px breathing room. All frame pieces fit, including hanging rock.","  ui.mapBounds={left:left-16-225*style.cliffUnit-12,top:firstY-112-180*style.cliffUnit-12,","    right:right+cell+16+225*style.cliffUnit+12,bottom:rows.at(-1)+cell+16+206*style.cliffUnit+12};","  ui.level={key:layoutKey,rows,left,right,spawn:spawnPoint,base:basePoint,tileCount:positions.length,length:(positions.length-1)*cell};","  variables.get(\"MapRouteDirty\").setBoolean(true);","}","const bounds = {...ui.mapBounds};","// Fixed gameplay framing depends only on static map geometry, never on towers/ghosts.","ui.fittedBounds=bounds;","const zoom = Math.max(0.001,Math.min((mapFrame.right-mapFrame.left)/(bounds.right-bounds.left),(mapFrame.bottom-mapFrame.top)/(bounds.bottom-bounds.top)));","map.setCameraZoom(zoom,0);","map.setCameraX((bounds.left+bounds.right)/2-((mapFrame.left+mapFrame.right)/2-width/2)/zoom,0);","map.setCameraY((bounds.top+bounds.bottom)/2-((mapFrame.top+mapFrame.bottom)/2-height/2)/zoom,0);","// The original grass texture tiles naturally across ALL visible gameplay pixels.","const ground = first(\"Ground_Map\");","const min = map.convertCoords(0,0,0,[0,0]), max=map.convertCoords(gameAreaRight,height,0,[0,0]);","ground.setPosition(min[0],min[1]);ground.setWidth(max[0]-min[0]);ground.setHeight(max[1]-min[1]);","if (!ui.mapMask) {","  const container=map.getRenderer().getRendererObject();ui.mapMask=new PIXI.Graphics();container.addChild(ui.mapMask);container.mask=ui.mapMask;","}","const maskKey=[width,height,gameAreaRight,zoom,map.getCameraX(),map.getCameraY()].join(\",\");","if(ui.mapMaskKey!==maskKey){ui.mapMask.clear().beginFill(0xffffff).drawRect(min[0],min[1],max[0]-min[0],max[1]-min[1]).endFill();ui.mapMaskKey=maskKey;}","ui.gameArea={left:0,top:0,right:gameAreaRight,bottom:height,sidebarX:sidebarScreenX,gap:mapSidebarGap,margin:sidebarMargin,frame:mapFrame};","","ui.geometry = { rootX: 1152, rootY: sidebarMargin, panelHeight: height - sidebarMargin * 2, listX: 1168, listY: 72 + sidebarMargin, listWidth: 176 };","const geometry = ui.geometry;","geometry.bottom = geometry.rootY + geometry.panelHeight;","geometry.listHeight = Math.max(1, geometry.bottom - geometry.listY - 88);","geometry.playY = geometry.bottom - 72;","geometry.trackX = 1350;","const rect = (name, x, y, w, h) => { const o = first(name); o.setPosition(x, y); if (w !== undefined) o.setWidth(w); if (h !== undefined) o.setHeight(h); };","rect(\"TowerShopBox\", 1152, geometry.rootY, 224, geometry.panelHeight);","rect(\"ShopHeaderPlaque\", 1166, geometry.rootY + 10, 196, 48);","rect(\"ShopFooterFrame\", 1160, geometry.playY - 4, 208, 72);","rect(\"AssetPanelTitle\", 1168, geometry.rootY + 16, 192, 24);","rect(\"AssetPanelSubtitle\", 1168, geometry.rootY + 37, 192, 16);","rect(\"ShopIndexButton\", 1168, geometry.playY, 92, 60);","","rect(\"ShopPlayButton\", 1268, geometry.playY, 92, 60);","rect(\"ShopPlayIcon\", 1302, geometry.playY + 8, 24, 24);","rect(\"ShopPlayLabel\", 1268, geometry.playY + 36, 92, 20);","rect(\"ShopSpeedBadge\", 1332, geometry.playY + 8, 20, 14);","rect(\"ShopScrollTrack\", geometry.trackX, geometry.listY, 8, geometry.listHeight);","","// Keep the original HUD artwork. On narrow windows only its row arrangement changes.","const hudWidth = compactHUD ? Math.max(1, Math.min(196, gameAreaRight - 32)) : 316;","rect(\"HUDPanel\", offsetX + 16, 16, hudWidth, hudHeight);","get(\"HUDIcon\").forEach((o, i) => { o.setPosition(offsetX + (compactHUD ? 28 : [28,148,230][i]), compactHUD ? 26 + i * 30 : 26); o.setWidth(24); o.setHeight(24); });","for (const [i,name] of [\"MoneyText\",\"LivesText\",\"WaveText\"].entries()) {","  rect(name, offsetX + (compactHUD ? 60 : [60,180,262][i]), compactHUD ? 25 + i * 30 : 25, compactHUD ? Math.max(1,hudWidth-52) : [80,40,62][i], 28);","}","const message = first(\"MessageText\");","message.setWidth(Math.max(1, gameAreaRight - 32));","message.setPosition(offsetX + 16, height / 2 - 20);","// Prices have exactly one source: the existing costs migrated unchanged into TowerShopCatalog.","const catalog = variables.get(\"TowerShopCatalog\").toJSObject();","for (const name of [\"AssetCardPanel\", \"TileType_Button\", \"AssetTowerLabel\", \"AssetTowerPrice\", \"ShopCoin\"]) {","  get(name).slice().forEach(object => {","    if (object.getVariables().get(\"ShopIndex\").getAsNumber() >= catalog.length) object.deleteFromScene(scene);","  });","}","ui.cards.length = catalog.length;","for (let i = 0; i < catalog.length; i++) {","  const item = catalog[i];","  if (!ui.cards[i]) {","    const card = ui.cards[i] = { background: ui.ensure(\"AssetCardPanel\", i), icon: ui.ensure(\"TileType_Button\", i), name: ui.ensure(\"AssetTowerLabel\", i), price: ui.ensure(\"AssetTowerPrice\", i), coin: ui.ensure(\"ShopCoin\", i) };","    ","    if (card.icon.hasBehavior(\"Effect\")) card.icon.getBehavior(\"Effect\").enableEffect(\"Outline\", false);","    card.icon.setAnimationName(item.IconAnimation || item.Type);","    const ratio = card.icon.getWidth() / Math.max(1, card.icon.getHeight());","    const iconSize = item.Type === \"StarCannonTower\" ? 64 : 56;","    card.iconWidth = ratio > 1 ? iconSize : iconSize * ratio;","    card.iconHeight = ratio > 1 ? iconSize / ratio : iconSize;","  }","  const card = ui.cards[i];","  card.item = item;","  card.icon.getVariables().get(\"TowerType\").setString(item.Type);","  card.icon.getVariables().get(\"Cost\").setNumber(item.Cost);","  card.name.setString(item.Name);","  card.name.setCharacterSize(11);card.name.setWrapping(true);card.name.setWrappingWidth(76);card.name.setTextAlignment(\"center\");","  card.price.setCharacterSize(13);card.price.setWrapping(true);card.price.setWrappingWidth(46);card.price.setTextAlignment(\"center\");","  card.price.setString(String(item.Cost));","}","const contentHeight = Math.ceil(catalog.length / 2) * 120 - 8;","const maxScroll = Math.max(0, contentHeight - geometry.listHeight);","let scroll = Math.max(0, Math.min(maxScroll, number(\"TowerShopScroll\")));","const input = scene.getGame().getInputManager();","const mx = gdjs.evtTools.input.getCursorX(scene, \"UI\", 0);","const my = gdjs.evtTools.input.getCursorY(scene, \"UI\", 0);","const inside = (x,y,w,h) => mx >= x && mx < x+w && my >= y && my < y+h;","const shopVisible = !modal;","const inList = inside(geometry.listX, geometry.listY, geometry.listWidth, geometry.listHeight);","const inTrack = inside(geometry.trackX - 3, geometry.listY, 14, geometry.listHeight);","variables.get(\"TowerShopPointerInside\").setBoolean(shopVisible && inList);","variables.get(\"TowerShopRequestedType\").setString(\"\");","variables.get(\"PlayWaveRequested\").setBoolean(false);","if (shopVisible && (inList || inTrack)) scroll = Math.max(0, Math.min(maxScroll, scroll - Math.sign(input.getMouseWheelDelta()) * 48));","const hoveredIndex = () => {","  if (!shopVisible || !inList) return -1;","  const x = mx - geometry.listX, y = my - geometry.listY + scroll;","  const col = Math.floor(x / 92), row = Math.floor(y / 120), index = row * 2 + col;","  return col < 2 && x % 92 < 84 && y % 120 < 112 && index < catalog.length ? index : -1;","};","const ready = !boolean(\"WaveActive\") && !boolean(\"GameOver\") && number(\"Wave\") < (number(\"MaximumWave\")||45);","const overIndex = !modal && inside(1168, geometry.playY, 92, 60);","const overPlay = !modal && inside(1268, geometry.playY, 92, 60);","const down = input.isMouseButtonPressed(0);","let hovered = hoveredIndex();","if (down && !ui.wasDown) {","  ui.pressedCard = hovered;","  ui.pressedControl = overIndex ? \"Index\" : overPlay ? \"Play\" : \"\";","  if (inTrack && maxScroll > 0 && shopVisible) { ui.dragging = true; ui.dragStartY = my; ui.dragStartScroll = scroll; ui.pressedCard = -1; }","}","const thumbHeight = maxScroll > 0 ? Math.max(22, geometry.listHeight * geometry.listHeight / contentHeight) : geometry.listHeight;","if (ui.dragging && down) scroll = Math.max(0, Math.min(maxScroll, ui.dragStartScroll + (my - ui.dragStartY) * maxScroll / Math.max(1, geometry.listHeight - thumbHeight)));","if (!down && ui.wasDown) {","  if (ui.pressedControl === \"Index\" && overIndex) ui.indexRequested = true;","  if (ui.pressedControl === \"Play\" && overPlay && !boolean(\"GameOver\")) {","    if (mode() === \"Waiting\") {","      if (ready) variables.get(\"PlayWaveRequested\").setBoolean(true);","    } else {","      const cycle = [\"Manual\",\"ManualFast\",\"Auto\",\"AutoFast\"];","      variables.get(\"WaveMode\").setString(cycle[(cycle.indexOf(mode()) + 1) % cycle.length]);","      // Cancelling AUTO between waves returns to waiting; an active wave never pauses.","      syncWaveControl();","    }","  }","  if (!ui.dragging && ui.pressedCard >= 0 && ui.pressedCard === hovered && number(\"Money\") >= catalog[hovered].Cost) variables.get(\"TowerShopRequestedType\").setString(catalog[hovered].Type);","  ui.pressedCard = -1; ui.pressedControl = \"\"; ui.dragging = false;","}","ui.wasDown = down;","variables.get(\"TowerShopScroll\").setNumber(scroll);","hovered = hoveredIndex();","ui.mask.clear().beginFill(0xffffff).drawRect(geometry.listX, geometry.listY, geometry.listWidth, geometry.listHeight).endFill();","ui.cards.forEach((card, i) => {","  const x = geometry.listX + (i % 2) * 92, y = geometry.listY + Math.floor(i / 2) * 120 - scroll;","  card.background.setPosition(x, y); card.background.setWidth(84); card.background.setHeight(112);","  const pressed = down && ui.pressedCard === i && hovered === i;","  const scale = pressed ? 0.94 : hovered === i ? 1.04 : 1;","  card.icon.setWidth(card.iconWidth * scale); card.icon.setHeight(card.iconHeight * scale);","  card.icon.setPosition(x + 42 - card.icon.getWidth()/2, y + (card.item.Type === \"StarCannonTower\" ? 57 : 51) - card.icon.getHeight()/2);","  card.name.setPosition(x + 4, y + 5); card.name.setWidth(76); card.name.setHeight(18);","  card.coin.setPosition(x + 13, y + 91); card.coin.setWidth(15); card.coin.setHeight(15);","  card.price.setPosition(x + 31, y + 91); card.price.setWidth(46); card.price.setHeight(20);","});","rect(\"ShopScrollThumb\", geometry.trackX, geometry.listY + (maxScroll > 0 ? scroll / maxScroll * (geometry.listHeight - thumbHeight) : 0), 8, thumbHeight);","ui.scrollMax = maxScroll; ui.hovered = hovered; ui.ready = ready; ui.overPlay = overPlay;","ui.refresh = () => {","  const selectedTower = number(\"SelectedTower\") > 0;","  scene.getLayer(\"TowerShopList\").show(true);","  const indicator = first(\"TilePlacement_Indicator\");","  ui.cards.forEach((card, i) => {","    const affordable = number(\"Money\") >= card.item.Cost;","    const selected = !indicator.isHidden() && indicator.getAnimationName() === card.item.Type;","    const pressed = ui.wasDown && ui.pressedCard === i && ui.hovered === i;","    card.background.setColor(selected ? \"188;237;255\" : pressed ? \"184;152;232\" : ui.hovered === i ? \"218;199;255\" : \"235;224;255\");","    if (card.background.hasBehavior(\"Effect\")) card.background.getBehavior(\"Effect\").enableEffect(\"Outline\", selected);","    card.background.setOpacity(affordable ? 255 : 220);","    card.icon.setOpacity(affordable ? 255 : 190);","    card.price.setColor(affordable ? \"244;232;255\" : \"255;120;155\");","    card.name.setColor(affordable ? \"245;233;255\" : \"173;150;203\");","    for (const part of [card.background,card.icon,card.name,card.price,card.coin]) part.hide(false);","  });","  syncWaveControl();","  const ended = boolean(\"GameOver\"), current = mode();","  const isAuto = autoMode(), isFast = fastMode();","  const isManual = current === \"Manual\" || current === \"ManualFast\";","  first(\"ShopPlayButton\").setOpacity(ended ? 155 : 255);","  first(\"ShopPlayButton\").setColor(isFast ? \"149;234;255\" : ui.overPlay ? \"207;194;255\" : \"240;228;255\");","  if (first(\"ShopPlayButton\").hasBehavior(\"Effect\")) first(\"ShopPlayButton\").getBehavior(\"Effect\").enableEffect(\"Outline\", isFast && !ended);","  first(\"ShopPlayIcon\").hide(ended || isAuto);","  first(\"ShopPlayIcon\").setAnimationName(isManual ? \"Manual\" : \"Play\");","  first(\"ShopPlayLabel\").setCharacterSize(ended ? 12 : 14);","  first(\"ShopPlayLabel\").setString(ended ? (number(\"Lives\") > 0 ? \"COMPLETE\" : \"GAME OVER\") : isAuto ? \"AUTO\" : isManual ? \"MANUAL\" : \"PLAY\");","  first(\"ShopPlayLabel\").setY(geometry.playY + (ended || isAuto ? 22 : 36));","  first(\"ShopSpeedBadge\").hide(!isFast || ended);","  first(\"ShopIndexButton\").setColor(overIndex ? \"207;194;255\" : \"255;255;255\");","  const indexIcon = first(\"Index_logo\"), indexButton = first(\"ShopIndexButton\");","  const iconScale = overIndex ? (ui.wasDown && ui.pressedControl === \"Index\" ? 0.95 : 1.05) : 1;","  const iconSize = Math.min(indexButton.getWidth(), indexButton.getHeight()) * 0.90 * iconScale;","  indexIcon.setWidth(iconSize); indexIcon.setHeight(iconSize);","  indexIcon.setPosition(indexButton.getX() + (indexButton.getWidth() - iconSize) / 2, indexButton.getY() + (indexButton.getHeight() - iconSize) / 2);","  first(\"ShopScrollThumb\").setOpacity(maxScroll > 0 ? 255 : 110);","};"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Directional skins reuse the same road instances, centers, masks and PathOrder.","const scene=runtimeScene,get=n=>scene.getObjects(n),sv=scene.getVariables();","const roads=get(\"Monster_Path\").slice().sort((a,b)=>a.getVariables().get(\"PathOrder\").getAsNumber()-b.getVariables().get(\"PathOrder\").getAsNumber());","const side=(o,n)=>n.getX()>o.getX()?\"E\":n.getX()<o.getX()?\"W\":n.getY()>o.getY()?\"S\":\"N\";","roads.forEach((o,i)=>{","  const sides=[i?side(o,roads[i-1]):null,i<roads.length-1?side(o,roads[i+1]):null].filter(Boolean);","  let skin;","  if(sides.length===1)skin=\"Cap_\"+sides[0];","  else if(sides.includes(\"E\")&&sides.includes(\"W\"))skin=\"H\";","  else if(sides.includes(\"N\")&&sides.includes(\"S\"))skin=\"V\";","  else skin=(sides.includes(\"N\")?\"N\":\"S\")+(sides.includes(\"E\")?\"E\":\"W\");","  if(o.getAnimationName()!==skin)o.setAnimationName(skin);","  o.pauseAnimation();o.setAnimationFrame((skin===\"H\"||skin===\"V\")?i%4:0);","});","const kinds=[\"Crystal\",\"Rock\",\"Ruin\",\"Shrub\"];","get(\"Ground_Decoration\").forEach((o,i)=>{","  const kind=o.getVariables().get(\"Kind\").getAsString()||kinds[i%4];if(o.getAnimationName()!==kind)o.setAnimationName(kind);","  o.setWidth(64);o.setHeight(64);o.getVariables().get(\"Blocking\").setBoolean(kind!==\"Shrub\");o.getVariables().get(\"Kind\").setString(kind);","});","let backdrop=scene.__voidBackdrop;","if(!backdrop)backdrop=scene.__voidBackdrop=scene.createObject(\"VoidBackdrop\");","const ground=get(\"Ground_Map\")[0];backdrop.setLayer(\"\");backdrop.setZOrder(ground.getZOrder()-10);","backdrop.setPosition(ground.getX(),ground.getY());backdrop.setWidth(ground.getWidth());backdrop.setHeight(ground.getHeight());","// Compose the existing frame as proportionally scaled perimeter pieces outside the road.","// No full-frame stretch, no rocky art laid beneath the bottom road.","if(scene.__islandCliffFrame){scene.__islandCliffFrame.deleteFromScene();scene.__islandCliffFrame=null;}","const left=Math.min(...roads.map(o=>o.getX()))-16,right=Math.max(...roads.map(o=>o.getX()+o.getWidth()))+16;","const top=Math.min(...roads.map(o=>o.getY()))-112,bottom=Math.max(...roads.map(o=>o.getY()+o.getHeight()))+16;","const unit=scene.__worldStyle.cliffUnit,L=225,R=225,T=180,B=206,W=1448,H=1086,lw=L*unit,rw=R*unit,th=T*unit,bh=B*unit;","const pieces=[];","const add=(sx,sy,sw,sh,x,y,w,h)=>pieces.push({sx,sy,sw,sh,x,y,w,h});","add(0,0,L,T,left-lw,top-th,lw,th);add(W-R,0,R,T,right,top-th,rw,th);","add(0,H-B,L,B,left-lw,bottom,lw,bh);add(W-R,H-B,R,B,right,bottom,rw,bh);","// Repeat long edges at uniform scale and crop the final piece, keeping rock proportions.","for(let x=left;x<right-.001;){const width=Math.min((W-L-R)*unit,right-x);add(L,0,width/unit,T,x,top-th,width,th);add(L,H-B,width/unit,B,x,bottom,width,bh);x+=width;}","for(let y=top;y<bottom-.001;){const height=Math.min((H-T-B)*unit,bottom-y);add(0,T,L,height/unit,left-lw,y,lw,height);add(W-R,T,R,height/unit,right,y,rw,height);y+=height;}","// One native owner keeps the correct world layer/Z-order; its PIXI children use","// cropped textures at uniform scale without changing GDevelop's frame-size calculations.","let holder=scene.__cliffOwner;if(!holder)holder=scene.__cliffOwner=scene.createObject('IslandCliffFrame');","holder.setLayer('');holder.setZOrder(-7);holder.updatePreRender(scene);","const root=holder.getRendererObject();if(!scene.__cliffBaseTexture)scene.__cliffBaseTexture=root.texture.baseTexture;","root.texture=PIXI.Texture.EMPTY;root.anchor.set(0);root.position.set(0,0);root.scale.set(1,1);","let edges=scene.__islandEdges;if(!edges)edges=scene.__islandEdges=[];","while(edges.length>pieces.length){const e=edges.pop();root.removeChild(e.sprite);e.sprite.destroy();e.texture.destroy(false);}","let shadows=scene.__environmentShadows;","if(!shadows){shadows=scene.__environmentShadows=new PIXI.Graphics();root.addChildAt(shadows,0);}","shadows.clear();","for(const o of get('Ground_Decoration')){"," const kind=o.getVariables().get('Kind').getAsString(),scale=(scene.__worldStyle.props[kind]||1)*(o.getVariables().get('LocalScale').getAsNumber()||1),w=o.getWidth()*scale;"," const x=o.getCenterXInScene(),y=o.getCenterYInScene()+w*.30;"," shadows.beginFill(0x100c25,kind==='Shrub'?.16:.30).drawEllipse(x,y,w*.34,w*.08).endFill();","}","const regions=[];","for(const [i,d] of pieces.entries()){"," let e=edges[i];if(!e){e=edges[i]={sprite:new PIXI.Sprite()};root.addChild(e.sprite);}"," const key=[d.sx,d.sy,d.sw,d.sh].join(',');"," if(e.key!==key){if(e.texture)e.texture.destroy(false);e.texture=new PIXI.Texture(scene.__cliffBaseTexture,new PIXI.Rectangle(d.sx,d.sy,d.sw,d.sh));e.key=key;}"," e.sprite.texture=e.texture;e.sprite.anchor.set(0);e.sprite.position.set(d.x,d.y);e.sprite.scale.set(unit,unit);"," regions.push([[d.x,d.y],[d.x+d.w,d.y],[d.x+d.w,d.y+d.h],[d.x,d.y+d.h]]);","}","scene.__islandRockRegions=regions;","// Buildable top surface is separate from the rocky frame. Terrain extends UNDER the","// inner fringe so transparent pockets in the edge sprites cannot expose accidental holes.","scene.__islandSurfacePolygon=[left,top,right,top,right,bottom,left,bottom];","const drawable=ground.getRendererObject();","if(!scene.__islandSurfaceMask){scene.__islandSurfaceMask=new PIXI.Graphics();scene.getLayer('').getRenderer().getRendererObject().addChild(scene.__islandSurfaceMask);drawable.mask=scene.__islandSurfaceMask;}","const underlap=32,mask=scene.__islandSurfaceMask,key=[left,top,right,bottom].join(',');","if(scene.__islandSurfaceKey!==key){mask.clear().beginFill(0xffffff).drawRoundedRect(left-underlap,top-underlap,right-left+underlap*2,bottom-top+underlap*2,20).endFill();scene.__islandSurfaceKey=key;}","ground.setColor(\"192;195;218\");"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Archive state is presentation-only. The sole unlock caller is the native wave spawn.","const scene=runtimeScene,game=scene.getGame(),sv=scene.getVariables();","let d=scene.__monsterDiscovery;","if(!d){"," const types=sv.get('EnemyTypes').toJSObject(),definition=game.getSceneAndExtensionsData(scene.getName()).sceneData.objects.find(o=>o.name==='IndexMonsterImage');"," const animations=new Map(definition.animations.map(a=>[a.name,a.directions[0].sprites[0].image]));"," const ids=definition.animations.flatMap(animation=>Object.keys(types).filter(id=>types[id].Animation===animation.name));"," let session=game.__celestialMonsterDiscoverySession;"," if(!session){","  session=game.__celestialMonsterDiscoverySession={found:new Set(),queue:[],active:null,revision:0,stats:{unlocks:0,shown:0,sounds:0,completed:0}};","  // Explicit Restart/New Game calls this; ordinary scene changes do not.","  session.resetForNewGame=()=>{session.found.clear();session.queue.length=0;session.active=null;session.revision++;for(const key of Object.keys(session.stats))session.stats[key]=0;};","  delete game.__celestialMonsterDiscovery;","  // Ignore all legacy discovery data. Remove only its old key, never settings.","  try{localStorage.removeItem('celestialVoidMonsterDiscovery.v1');}catch(e){}"," }"," d=scene.__monsterDiscovery={scope:'session',ids,types,session,found:session.found,queue:session.queue,get active(){return session.active;},set active(value){session.active=value;},get revision(){return session.revision;},ready:false,disposed:false,outlines:new Map(),textures:new Map(),ownedTextures:new Set(),portraits:sv.get('MonsterPortraitConfig').toJSObject(),stats:session.stats};"," d.ready=true;"," d.has=id=>d.found.has(id);"," d.resetForNewGame=session.resetForNewGame;"," d.onWaveSpawn=(enemy,id)=>{","  const wave=scene.__waveManager;","  if(d.disposed||!ids.includes(id)||d.has(id)||!sv.get('WaveActive').getAsBoolean()||sv.get('GameOver').getAsBoolean()||!wave||wave.queue[wave.index-1]!==id||!scene.getObjects('Enemy').includes(enemy)||enemy.getVariables().get('EnemyType').getAsString()!==id||enemy.getBehavior('Health').IsDead())return false;","  d.found.add(id);session.revision++;d.stats.unlocks++;d.queue.push(id);return true;"," };"," d.texture=id=>{","  if(d.textures.has(id))return d.textures.get(id);","  const meta=d.portraits[id],base=game.getImageManager().getPIXITexture(meta?.Image||animations.get(types[id].Animation));","  // Only atlases need frame extraction; individual PNGs remain shared unchanged.","  const texture=meta?.Frame?new PIXI.Texture(base.baseTexture,new PIXI.Rectangle(...meta.Frame)):base;","  if(meta?.Frame)d.ownedTextures.add(texture);","  if(texture)d.textures.set(id,texture);return texture;"," };"," d.fitPortrait=(sprite,id,x,y,width,height)=>{","  const texture=d.texture(id),bounds=d.portraits[id]?.VisualBounds||[0,0,texture.width,texture.height];sprite.texture=texture;","  sprite.anchor.set((bounds[0]+bounds[2]/2)/texture.width,(bounds[1]+bounds[3]/2)/texture.height);","  sprite.scale.set(Math.min(width/bounds[2],height/bounds[3]));sprite.position.set(x,y);sprite.rotation=0;"," };"," const layer=scene.getLayer('DiscoveryUI'),parent=layer.getRenderer().getRendererObject();"," const root=d.root=new PIXI.Container();root.interactive=false;root.interactiveChildren=false;root.visible=false;root.zIndex=100;parent.addChild(root);"," const mask=d.mask=new PIXI.Graphics();mask.interactive=false;mask.zIndex=99;parent.addChild(mask);root.mask=mask;"," const panel=new PIXI.Graphics();root.addChild(panel);"," for(let i=5;i>0;i--)panel.beginFill(0x8953e6,.018).drawRoundedRect(-i*2,-i*2,440+i*4,132+i*4,14+i).endFill();"," panel.beginFill(0x090819,.75).drawRoundedRect(2,5,440,132,12).endFill();"," panel.lineStyle(1.5,0xc1a46a,.95).beginFill(0x1a1030,.98).drawRoundedRect(0,0,440,132,12).endFill();"," panel.lineStyle(1,0x68528e,.85).drawRoundedRect(5,5,430,122,9);"," panel.lineStyle(1,0x789acb,.35).moveTo(112,29).lineTo(412,29);"," panel.lineStyle(1,0xc1a46a,.8).moveTo(16,26).lineTo(16,16).lineTo(36,16).moveTo(424,26).lineTo(424,16).lineTo(404,16).moveTo(424,106).lineTo(424,116).lineTo(404,116);"," panel.lineStyle(1,0x9e7bc6,.55).beginFill(0x100b22).drawCircle(59,67,43).endFill();"," panel.lineStyle(1,0xc1a46a,.6).drawCircle(59,67,39);"," for(const [x,y,r]of [[59,22,4],[59,112,4],[103,67,3],[15,67,3],[420,108,3]])panel.beginFill(0xc4a76f,.8).drawPolygon([x,y-r,x+r,y,x,y+r,x-r,y]).endFill();"," const makeText=(value,x,y,size,color,bold=false)=>{const t=new PIXI.Text(value,{fontFamily:'Arial',fontSize:size,fill:color,fontWeight:bold?'bold':'normal'});t.position.set(x,y);root.addChild(t);return t;};"," makeText('CELESTIAL ARCHIVE',113,12,10,0xd5bd87,true).style.letterSpacing=2;"," makeText('NEW DISCOVERY!',113,36,13,0xa6d9ff,true);"," const name=d.nameText=makeText('',112,56,21,0xf3e8ff,true);"," makeText('New enemy encountered',113,85,11,0xb7a6cd);"," makeText('Monster Index Updated',113,103,11,0x97bbdf);"," const outline=d.iconOutline=new PIXI.Sprite(),icon=d.icon=new PIXI.Sprite();"," outline.anchor.set(.5);icon.anchor.set(.5);outline.tint=0x452460;outline.position.set(59,67);icon.position.set(59,67);root.addChild(outline,icon);"," d.stars=[];"," for(let i=0;i<8;i++){const star=new PIXI.Graphics(),r=i%3===0?3:2;star.beginFill(i%2?0xcaa1ff:0xa4dcff).drawPolygon([0,-r,r*.3,-r*.3,r,0,r*.3,r*.3,0,r,-r*.3,r*.3,-r,0,-r*.3,-r*.3]).endFill();root.addChild(star);d.stars.push(star);}"," d.geometry=()=>{","  const width=game.getGameResolutionWidth(),height=game.getGameResolutionHeight(),right=Math.max(20,scene.__towerShopUI.gameArea.right-12);","  const hud=scene.getObjects('HUDPanel')[0],ui=scene.getLayer('UI');","  const corner=ui.convertInverseCoords(hud.getX()+hud.getWidth(),hud.getY()+hud.getHeight(),0,[0,0]);","  const selected=scene.__selectedPanel?.screenRect,obstacles=[{x:0,y:0,w:corner[0]+56,h:corner[1]+4},...(selected?[selected]:[])],candidates=[];","  // Pack into free screen rectangles without ever changing the existing HUD/panels.","  for(const y of [16,corner[1]+18,...(selected?[selected.y+selected.h+12]:[])]){","   if(y>=height-12)continue;let gaps=[[12,right]];","   for(const o of obstacles)if(o.y<y+132&&o.y+o.h>y)gaps=gaps.flatMap(([l,r])=>o.x>=r||o.x+o.w<=l?[[l,r]]:[[l,Math.min(r,o.x-12)],[Math.max(l,o.x+o.w+12),r]].filter(([a,b])=>b>a));","   for(const [left,end]of gaps){const scale=Math.min(1,(end-left)/440,(height-y-12)/132);if(scale>0)candidates.push({x:left+(end-left-440*scale)/2,y,w:440*scale,h:132*scale,scale});}","  }","  candidates.sort((a,b)=>b.scale-a.scale||a.y-b.y);return candidates[0]||{x:12,y:height-20,w:44,h:13.2,scale:.1};"," };"," d.bindPortrait=id=>{","  const texture=d.texture(id);if(!texture)return false;","  name.text=types[id].Name||id;name.scale.set(1);name.scale.set(Math.min(1,302/Math.max(1,name.width)));","  d.fitPortrait(icon,id,59,67,75,75);d.fitPortrait(outline,id,59,67,75,75);outline.scale.set(icon.scale.x*1.07);d.boundPortrait=id;return true;"," };"," d.begin=id=>{","  if(!d.bindPortrait(id))return false;d.active={id,age:0};d.stats.shown++;","  if(scene.__audio?.play('DiscoveryUnlock'))d.stats.sounds++;return true;"," };"," d.paint=()=>{","  if(!d.active){root.visible=false;mask.visible=false;return;}","  if(d.boundPortrait!==d.active.id)d.bindPortrait(d.active.id);","  const age=d.active.age,smooth=t=>{t=Math.max(0,Math.min(1,t));return t*t*(3-2*t);};","  const enter=smooth(age/.4),exit=smooth((age-3.2)/.8),reveal=smooth((age-.4)/.6),g=d.geometry();d.screenRect=g;","  const maskKey=[g.x,g.y,g.w,g.h,g.scale].join(':');if(maskKey!==d.maskKey){mask.clear().beginFill(0xffffff).drawRect(g.x-6*g.scale,g.y-6*g.scale,g.w+12*g.scale,g.h+12*g.scale).endFill();d.maskKey=maskKey;}mask.visible=true;","  root.visible=true;root.alpha=enter*(1-exit);root.scale.set(g.scale);root.position.set(g.x,g.y-(1-enter)*150*g.scale-exit*150*g.scale);","  const c=Math.round(255*reveal);icon.tint=(c<<16)|(c<<8)|c;name.alpha=smooth((age-1)/.2);","  d.stars.forEach((star,i)=>{const t=age*.8+i*.79;star.position.set(58+Math.cos(t)*(.6+reveal*.4)*(38+i%3*10),65+Math.sin(t)*(.6+reveal*.4)*43);star.alpha=reveal*(.3+.4*Math.sin(age*3+i)**2);});"," };"," d.paintIndex=()=>{","  const index=scene.__unitIndex,visible=sv.get('IndexOpen').getAsBoolean()&&index?.category==='Monsters';","  for(const outline of d.outlines.values())outline.visible=false;","  if(!visible)return;","  for(const card of index.monsterCards||index.cards){const object=card.sprite,locked=object.__discoveryLocked,sprite=object.__golemPortraitRig?.visible?object.__golemPortraitRig:object.getRendererObject();sprite.tint=locked?0:0xffffff;","   const portrait=object.__discoveryPortrait;if(portrait)d.fitPortrait(sprite,portrait.id,portrait.x,portrait.y,portrait.w,portrait.h);","   if(!d.outlines.has(object)){","    const outline=new PIXI.Sprite(sprite.texture);outline.tint=0x3b2351;outline.zIndex=object.getZOrder()-.1;outline.interactive=false;outline.visible=false;","    scene.getLayer(object.getLayer()).getRenderer().getRendererObject().addChild(outline);d.outlines.set(object,outline);","    const cleanup=()=>{if(!outline.destroyed)outline.destroy({texture:false,baseTexture:false});d.outlines.delete(object);object.unregisterDestroyCallback(cleanup);};object.registerDestroyCallback(cleanup);","   }","   const outline=d.outlines.get(object);outline.visible=locked&&!object.isHidden();outline.texture=sprite.texture;outline.anchor.copyFrom(sprite.anchor);outline.position.copyFrom(sprite.position);outline.scale.set(sprite.scale.x*1.06,sprite.scale.y*1.06);outline.rotation=sprite.rotation;","  }"," };"," d.update=()=>{","  if(d.disposed)return;","  const uiLayer=scene.getLayer('DiscoveryUI');uiLayer.setCameraZoom(1);uiLayer.setCameraX(game.getGameResolutionWidth()/2);uiLayer.setCameraY(game.getGameResolutionHeight()/2);","  // Keep queued announcements intact while the encyclopedia owns the screen.","  if(sv.get('IndexOpen').getAsBoolean()){root.visible=false;mask.visible=false;d.paintIndex();return;}","  const dt=Math.max(0,scene.getTimeManager().getElapsedTime()/Math.max(.001,scene.getTimeManager().getTimeScale())/1000);","  if(d.active){d.active.age+=dt;if(d.active.age>=4){d.active=null;d.stats.completed++;}}","  if(!d.active&&d.queue.length){if(d.begin(d.queue[0]))d.queue.shift();}","  d.paint();d.paintIndex();"," };"," d.dispose=()=>{if(d.disposed)return;d.disposed=true;for(const outline of d.outlines.values())if(!outline.destroyed)outline.destroy({texture:false,baseTexture:false});d.outlines.clear();d.textures.clear();root.mask=null;root.destroy({children:true,texture:false,baseTexture:false});mask.destroy();for(const texture of d.ownedTextures)texture.destroy(false);d.ownedTextures.clear();};"," if(!gdjs.__celestialDiscoveryCallbacks){gdjs.__celestialDiscoveryCallbacks=true;gdjs.callbacksRuntimeScenePostEvents.push(s=>s.__monsterDiscovery?.update());gdjs.callbacksRuntimeSceneUnloading.push(s=>s.__monsterDiscovery?.dispose());}","}"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Transactional Pure Fusion. Original towers remain alive until valid placement.","const scene=runtimeScene,sv=scene.getVariables(),game=scene.getGame(),get=n=>scene.getObjects(n),p=scene.__freePlacement,star=scene.__starCannon;","if(!p||!star)return;","let f=scene.__fusion;","if(!f){"," const config=sv.get('StarburstConfig').toJSObject(),layer=scene.getLayer('FusionUI');"," const archive=game.__fusionArchive;if(!archive?.persistent)return;"," f=scene.__fusion={config,archive,active:false,stage:'idle',objects:{},markers:new Map(),footprints:new Map(),wasDown:false,pressed:'',error:'',disposed:false};"," f.graphics=new PIXI.Graphics();layer.getRenderer().getRendererObject().addChild(f.graphics);f.graphics.zIndex=0;"," f.ensure=(key,name,z=2)=>{if(!f.objects[key]){const o=scene.createObject(name);o.setLayer('FusionUI');o.setZOrder(z);f.objects[key]=o;}return f.objects[key];};"," f.ghost=f.ensure('ghost','StarburstGhost',3);f.ghost.hide();"," f.eligible=t=>!!t&&get('StarCannonTower').includes(t)&&!star.isFusion(t)&&((t.getVariables().get('Path1Level').getAsNumber()===5&&t.getVariables().get('Path2Level').getAsNumber()===2)||(t.getVariables().get('Path1Level').getAsNumber()===2&&t.getVariables().get('Path2Level').getAsNumber()===5));"," f.pair=(a,b)=>f.eligible(a)&&f.eligible(b)&&a!==b&&a.getVariables().get('Path1Level').getAsNumber()!==b.getVariables().get('Path1Level').getAsNumber();"," f.alive=(t,id)=>!!t&&t.getUniqueId()===id&&get('StarCannonTower').includes(t);"," f.message=reason=>({region:'Place near either source tower',path:'Monster path is blocked',tower:'Another tower blocks this spot',obstacle:'Obstacle or structure blocks this spot',bounds:'Keep the footprint on the island',gold:'Not enough Gold',ui:'Move the preview onto the map',pair:'Select the opposite max path: 5-2 + 2-5'}[reason]||'Choose a clear placement near either source');"," f.finish=()=>{","  f.active=false;f.stage='idle';f.a=null;f.b=null;f.aId=0;f.bId=0;f.preview=null;f.error='';f.pressed='';sv.get('FusionActive').setBoolean(false);","  f.graphics.clear();f.footprints.clear();for(const m of f.markers.values())m.destroy();f.markers.clear();Object.values(f.objects).forEach(o=>o.hide());layer.show(false);","  scene.getTimeManager().setTimeScale(f.previousScale||1);f.previousScale=undefined;"," };"," f.cancel=()=>{if(!f.active)return false;f.finish();scene.__audio?.play('UIClick');return true;};"," f.begin=t=>{","  if(f.active||!f.eligible(t)||sv.get('GameOver').getAsBoolean()||sv.get('IndexBlocksInput').getAsBoolean())return false;","  f.previousScale=scene.getTimeManager().getTimeScale();f.active=true;f.stage='partner';f.a=t;f.aId=t.getUniqueId();f.b=null;f.error='';f.wasDown=game.getInputManager().isMouseButtonPressed(0);f.pressed='';","  sv.get('FusionActive').setBoolean(true);sv.get('SelectedTower').setNumber(0);sv.get('IndexOpen').setBoolean(false);scene.__obstaclePanel?.close();p.stop();","  if(scene.__audio){scene.__audio.ui.open=false;scene.__audio.ui.pressed='';}scene.getTimeManager().setTimeScale(config.FusionTimeScale);scene.__audio?.play('UIClick');return true;"," };"," f.choose=t=>{if(!f.active||f.stage!=='partner'||!f.pair(f.a,t)){f.error=f.message('pair');scene.__audio?.play('InvalidAction');return false;}f.b=t;f.bId=t.getUniqueId();f.stage='placement';f.error='';scene.__audio?.play('TowerSelect');return true;};"," f.validate=(x,y)=>{","  if(!f.active||f.stage!=='placement'||!f.alive(f.a,f.aId)||!f.alive(f.b,f.bId)||!f.pair(f.a,f.b))return{valid:false,reason:'pair'};","  if(![f.a,f.b].some(t=>{const c=p.center(t);return Math.hypot(x-c[0],y-c[1])<=config.RegionalRadius;}))return{valid:false,reason:'region'};","  const point=scene.getLayer('').convertInverseCoords(x,y,0,[0,0]);","  if([f.bannerRect,f.cancelRect].some(r=>r&&point[0]>=r.x&&point[0]<r.x+r.w&&point[1]>=r.y&&point[1]<r.y+r.h))return{valid:false,reason:'ui'};","  return p.validate('StarCannonTower',x,y,{ignoreTowers:new Set([f.a,f.b]),cost:config.FusionCost});"," };"," f.confirm=(x,y)=>{","  const valid=f.validate(x,y);if(!valid.valid){f.error=f.message(valid.reason);scene.__audio?.play('InvalidAction');return false;}","  const a=f.a,b=f.b,t=scene.createObject('StarCannonTower');if(!t){f.error='Unable to create tower';return false;}","  const v=t.getVariables(),av=a.getVariables(),bv=b.getVariables(),cost=config.FusionCost,investment=av.get('TotalInvestment').getAsNumber()+bv.get('TotalInvestment').getAsNumber()+cost;","  const id=Math.max(sv.get('NextTowerId').getAsNumber(),...get('StarCannonTower').map(o=>o.getVariables().get('TowerId').getAsNumber()))+1;","  for(const [name,value]of Object.entries({TowerId:id,PurchasePrice:investment,TotalInvestment:investment,DamageDealt:av.get('DamageDealt').getAsNumber()+bv.get('DamageDealt').getAsNumber(),Path1Level:5,Path2Level:2,FootprintX:x,FootprintY:y,FootprintRadius:p.config('StarCannonTower').Radius,FootprintOffsetX:0,FootprintOffsetY:0,ShotCounter:0}))v.get(name).setNumber(value);","  v.get('TowerType').setString('StarburstCannon');v.get('TowerName').setString(config.Name);t.setLayer('');","  try{if(!star.apply(t))throw Error('Invalid fusion stats');}catch(e){t.deleteFromScene();f.error='Fusion could not be completed';return false;}","  const discovery=archive.resolve([a,b]);","  sv.get('NextTowerId').setNumber(id);sv.get('Money').sub(cost);a.deleteFromScene();b.deleteFromScene();if(discovery)archive.discover(discovery.id,discovery.variant);","  f.finish();sv.get('SelectedTower').setNumber(id);scene.__audio?.play('TowerMajorUpgrade');return t;"," };"," f.render=()=>{","  const w=game.getGameResolutionWidth(),h=game.getGameResolutionHeight();layer.setCameraZoom(1);layer.setCameraX(w/2);layer.setCameraY(h/2);layer.show(f.active);if(!f.active)return;","  const g=f.graphics,map=scene.getLayer(''),zoom=map.getCameraZoom(),screen=t=>map.convertInverseCoords(...p.center(t),0,[0,0]),area=scene.__towerShopUI.gameArea;","  g.clear().beginFill(0x09051b,config.OverlayOpacity).drawRect(0,0,w,h).endFill();","  const markerIds=new Set(),footprintIds=new Set();","  for(const t of p.towers()){","   const v=t.getVariables(),max=Math.max(v.get('Path1Level').getAsNumber(),v.get('Path2Level').getAsNumber())===5&&!star.isFusion(t);","   const id=t.getUniqueId(),[x,y]=screen(t),valid=f.pair(f.a,t),selected=t===f.a||t===f.b;","   if(f.stage==='placement'){","    const radius=p.radius(t),color=selected?0x9de8f0:0xf49ab1;","    g.lineStyle(2,color,.95).beginFill(color,selected ? .025 : .045).drawCircle(x,y,radius*zoom).endFill();","    const record=f.footprints.get(id)||{};Object.assign(record,{id,x,y,radius,screenRadius:radius*zoom,color,ignored:selected});f.footprints.set(id,record);footprintIds.add(id);","   }else if(max){const color=selected?0xf5d58d:valid?0x9df1ff:0x8a75aa;g.lineStyle(selected||valid?3:1,color,selected||valid?.95:.4).drawCircle(x,y,(p.radius(t)+5)*zoom);}","   if(!(f.stage==='partner'?max:selected))continue;","   markerIds.add(id);const color=selected?0xf5d58d:valid?0x9df1ff:0x8a75aa;","   let marker=f.markers.get(id);if(!marker){marker=new PIXI.Text('FUSION',{fontFamily:'Arial',fontSize:10,fontWeight:'bold',fill:color,stroke:0x211236,strokeThickness:3});marker.anchor.set(.5,1);marker.zIndex=2;layer.getRenderer().getRendererObject().addChild(marker);f.markers.set(id,marker);}marker.position.set(x,y-(p.radius(t)+8)*zoom);marker.style.fill=color;","  }","  for(const [id,m]of f.markers)if(!markerIds.has(id)){m.destroy();f.markers.delete(id);}","  for(const id of f.footprints.keys())if(!footprintIds.has(id))f.footprints.delete(id);","  if(f.stage==='placement'){","   for(const t of [f.a,f.b]){const [x,y]=screen(t);g.lineStyle(2,0xbfa0ff,.5).beginFill(0x9470d0,.07).drawCircle(x,y,config.RegionalRadius*zoom).endFill();}","   const [x,y]=p.cursor(),result=f.validate(x,y),point=map.convertInverseCoords(x,y,0,[0,0]);if(f.preview&&(f.preview.x!==x||f.preview.y!==y))f.error='';f.preview={x,y,...result};","   const size=88*zoom;f.ghost.setWidth(size);f.ghost.setHeight(size);f.ghost.setPosition(point[0]-size/2,point[1]-size/2);f.ghost.setOpacity(185);f.ghost.setColor(result.valid?'180;255;230':'255;80;105');f.ghost.hide(false);","   g.lineStyle(2,result.valid?0x9aedd5:0xff5b79,.95).drawCircle(...point,p.config('StarCannonTower').Radius*zoom);","  }","  const bw=Math.max(180,Math.min(460,area.right-area.left-24)),bx=area.left+(area.right-area.left-bw)/2,by=Math.max(66,h*.08);","  const plaque=f.ensure('banner','SelectedPanelPlaque',4);plaque.setPosition(bx,by);plaque.setWidth(bw);plaque.setHeight(96);plaque.hide(false);","  f.bannerRect={x:bx,y:by,w:bw,h:96};","  const text=(key,value,x,y,width,size=12)=>{const o=f.ensure(key,'IndexText',5);o.setString(value);o.setCharacterSize(size);o.setBold(key==='title');o.setColor('235;222;255');o.setWrapping(true);o.setWrappingWidth(width);o.setPosition(x,y);o.hide(false);return o;};","  text('title','CELESTIAL ASCENSION',bx+16,by+12,bw-32,16);","  text('instruction',f.stage==='partner'?'Choose the opposite max path: 5-2 + 2-5':'Place Starburst near either source tower',bx+16,by+37,bw-32,12);","  text('detail',f.error||(f.preview&&!f.preview.valid?f.message(f.preview.reason):f.stage==='placement'?'Click a valid spot / '+config.FusionCost+' Gold fusion':'Both towers stay until placement is confirmed'),bx+16,by+61,bw-32,11);","  const cy=Math.min(h-50,by+106),button=f.ensure('cancel','SelectedPanelPlaque',4);button.setPosition(bx+(bw-156)/2,cy);button.setWidth(156);button.setHeight(34);button.hide(false);text('cancelText','CANCEL  /  ESC',bx+(bw-156)/2+18,cy+9,130,12);f.cancelRect={x:button.getX(),y:cy,w:156,h:34};"," };"," f.dispose=()=>{if(f.disposed)return;if(f.active)f.finish();for(const o of Object.values(f.objects))o.deleteFromScene();f.objects={};f.graphics.destroy();f.disposed=true;};"," if(!gdjs.__starburstFusionCallbacks){gdjs.__starburstFusionCallbacks=true;gdjs.callbacksRuntimeSceneUnloading.push(s=>s.__fusion?.dispose());}","}","const input=game.getInputManager(),down=input.isMouseButtonPressed(0);","if(f.active){"," if(!f.alive(f.a,f.aId)||!f.eligible(f.a)||(f.b&&(!f.alive(f.b,f.bId)||!f.pair(f.a,f.b)))||sv.get('GameOver').getAsBoolean())f.cancel();"," else if(gdjs.evtTools.input.wasKeyJustPressed(scene,'Escape'))f.cancel();"," else{","  f.render();const x=gdjs.evtTools.input.getCursorX(scene,'FusionUI',0),y=gdjs.evtTools.input.getCursorY(scene,'FusionUI',0),r=f.cancelRect,cancel=x>=r.x&&x<r.x+r.w&&y>=r.y&&y<r.y+r.h;","  if(down&&!f.wasDown)f.pressed=cancel?'cancel':f.stage;","  if(!down&&f.wasDown){","   if(cancel&&f.pressed==='cancel')f.cancel();","   else if(f.pressed===f.stage){const [wx,wy]=p.cursor(),area=scene.__towerShopUI.gameArea,screen=scene.getLayer('').convertInverseCoords(wx,wy,0,[0,0]);","    if(screen[0]>=area.left&&screen[0]<area.right&&screen[1]>=area.top&&screen[1]<area.bottom){","     if(f.stage==='partner'){const target=p.towers().filter(t=>scene.__worldSelection.towerHit(t,wx,wy)).sort((a,b)=>b.getZOrder()-a.getZOrder())[0];f.choose(target);}","     else f.confirm(wx,wy);","    }","   }","   f.pressed='';","  }"," }","}","f.wasDown=down;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// One permanent Fusion discovery source for notification, variants and Index.","// Storage follows the existing audio-settings mechanism; monster session state stays separate.","const scene=runtimeScene,game=scene.getGame(),sv=scene.getVariables(),catalog=sv.get('FusionCatalog').toJSObject();","let archive=game.__fusionArchive;","if(!archive?.persistent){"," const oldFound=[...(archive?.found||[])],key='celestialVoidFusionDiscovery.v1';let state={version:1,entries:{}},storageOK=true,saveNeeded=false;"," try{const raw=JSON.parse(localStorage.getItem(key)||'null');if(raw&&typeof raw==='object'&&!Array.isArray(raw)){state={...raw,entries:raw.entries&&typeof raw.entries==='object'&&!Array.isArray(raw.entries)?raw.entries:{}};state.version=raw.version||1;}}catch(e){storageOK=false;}"," archive=game.__fusionArchive={persistent:true,storageKey:key,state,storageOK,catalog,found:new Set(),revision:0,queue:[],active:null,stats:{unlockedVariants:0,shown:0,completed:0,sounds:0,writes:0}};"," const a=archive;"," a.definition=id=>a.catalog.find(d=>d.Id===id);"," a.recipeKey=parts=>parts.map(p=>{","  if(p?.getVariables){const v=p.getVariables();return(v.get('TowerType').getAsString()==='StarburstCannon'?'StarburstCannon':p.getName())+':'+v.get('Path1Level').getAsNumber()+'-'+v.get('Path2Level').getAsNumber();}","  return p.Type+':'+p.Path1+'-'+p.Path2;"," }).sort().join('|');"," a.resolve=parts=>{const k=a.recipeKey(parts);for(const d of a.catalog)for(const v of d.Variants||[])if(a.recipeKey(v.Recipe)===k)return{id:d.Id,variant:v.Id};return null;};"," a.record=id=>{let r=a.state.entries[id];if(!r||typeof r!=='object'||Array.isArray(r)){r={discovered:r===true,variants:{}};a.state.entries[id]=r;}if(!r.variants||typeof r.variants!=='object'||Array.isArray(r.variants))r.variants={};return r;};"," a.has=id=>a.found.has(id);"," a.hasVariant=(id,variant)=>a.state.entries[id]?.variants?.[variant]===true;"," a.progress=id=>{const d=a.definition(id),variants=d?.Variants||[];return{found:variants.filter(v=>a.hasVariant(id,v.Id)).length,total:variants.length};};"," a.save=()=>{try{localStorage.setItem(key,JSON.stringify(a.state));a.storageOK=true;a.stats.writes++;return true;}catch(e){a.storageOK=false;return false;}};"," const legacy=[...oldFound,...(Array.isArray(state.found)?state.found:[])];"," for(const id of legacy)if(typeof id==='string'){a.record(id).discovered=true;saveNeeded=true;}"," for(const id of Object.keys(state.entries)){","  const r=a.record(id),d=a.definition(id);if(r.discovered===true||Object.values(r.variants).some(v=>v===true)){","   a.found.add(id);r.discovered=true;","   // A legacy Pure unlock implies its sole variant. Hybrid progress never fans out.","   if(d?.Kind==='Pure'&&d.Variants?.length===1&&!Object.keys(r.variants).length){r.variants[d.Variants[0].Id]=true;saveNeeded=true;}","  }"," }"," a.discover=(id,variant)=>{","  const d=a.definition(id);if(!d)return false;","  variant=variant||(d.Kind==='Pure'&&d.Variants.length===1?d.Variants[0].Id:'');","  if(!d.Variants.some(v=>v.Id===variant)||a.hasVariant(id,variant))return false;","  const first=!a.has(id),r=a.record(id);r.discovered=true;r.variants[variant]=true;a.found.add(id);a.revision++;a.stats.unlockedVariants++;a.save();a.queue.push({id,variant,first});return true;"," };"," a.discoverRecipe=parts=>{const r=a.resolve(parts);return r?{...r,unlocked:a.discover(r.id,r.variant)}:null;};"," if(saveNeeded)a.save();","}","let view=scene.__fusionDiscovery;","if(!view){"," // Refresh definitions on scene reload; records and queue remain one shared source."," archive.catalog=catalog;"," view=scene.__fusionDiscovery={archive,disposed:false};"," const layer=scene.getLayer('DiscoveryUI'),parent=layer.getRenderer().getRendererObject(),root=view.root=new PIXI.Container(),mask=view.mask=new PIXI.Graphics();"," root.interactive=false;root.interactiveChildren=false;root.visible=false;root.zIndex=204;mask.zIndex=203;mask.interactive=false;root.mask=mask;parent.addChild(mask,root);"," const panel=new PIXI.Graphics();root.addChild(panel);panel.lineStyle(1.5,0xd1ae70,.95).beginFill(0x1a1030,.98).drawRoundedRect(0,0,440,132,12).endFill();panel.lineStyle(1,0x76609c,.8).drawRoundedRect(5,5,430,122,9);panel.lineStyle(1,0xa8cbee,.4).moveTo(112,29).lineTo(420,29);panel.lineStyle(1,0xc1a46a,.8).drawCircle(59,67,41);"," for(const [x,y]of [[16,16],[424,16],[16,116],[424,116]])panel.beginFill(0xe2c98d).drawPolygon([x,y-4,x+4,y,x,y+4,x-4,y]).endFill();"," const text=(s,x,y,size,color,bold=false)=>{const t=new PIXI.Text(s,{fontFamily:'Arial',fontSize:size,fill:color,fontWeight:bold?'bold':'normal'});t.position.set(x,y);root.addChild(t);return t;};"," text('CELESTIAL ARCHIVE',112,12,10,0xd5bd87,true).style.letterSpacing=2;"," view.heading=text('NEW FUSION DISCOVERED!',112,36,13,0xa6d9ff,true);view.name=text('',112,56,21,0xf3e8ff,true);view.detail=text('',112,85,11,0xb7a6cd);text('Fusion Index Updated',112,103,11,0x97bbdf);"," view.icon=new PIXI.Sprite();view.icon.anchor.set(.5);view.icon.position.set(59,67);root.addChild(view.icon);"," view.stars=[];for(let i=0;i<6;i++){const s=new PIXI.Graphics();s.beginFill(i%2?0xcaa1ff:0xa4dcff).drawPolygon([0,-3,1,-1,3,0,1,1,0,3,-1,1,-3,0,-1,-1]).endFill();root.addChild(s);view.stars.push(s);}"," view.bind=event=>{","  const def=archive.definition(event.id),object=game.getSceneAndExtensionsData(scene.getName()).sceneData.objects.find(o=>o.name==='IndexTowerImage'),animation=object.animations.find(a=>a.name===def.Animation);","  const texture=game.getImageManager().getPIXITexture(animation.directions[0].sprites[0].image);view.icon.texture=texture;view.icon.scale.set(Math.min(76/texture.width,76/texture.height));","  view.heading.text=event.first?'NEW FUSION DISCOVERED!':'NEW VARIANT DISCOVERED!';view.name.text=def.Name;view.name.scale.set(1);view.name.scale.set(Math.min(1,304/Math.max(1,view.name.width)));view.detail.text=def.Kind+' Fusion revealed';view.bound=event;"," };"," view.update=()=>{","  if(view.disposed)return;","  if(sv.get('FusionActive').getAsBoolean()||sv.get('IndexOpen').getAsBoolean()||scene.__monsterDiscovery?.active){root.visible=false;mask.visible=false;return;}","  const dt=Math.max(0,scene.getTimeManager().getElapsedTime()/Math.max(.001,scene.getTimeManager().getTimeScale())/1000);","  if(archive.active){archive.active.age+=dt;if(archive.active.age>=4){archive.active=null;archive.stats.completed++;}}","  if(!archive.active&&archive.queue.length){archive.active={...archive.queue.shift(),age:0};archive.stats.shown++;if(scene.__audio?.play('DiscoveryUnlock'))archive.stats.sounds++;}","  const active=archive.active;if(!active){root.visible=false;mask.visible=false;return;}if(view.bound!==active)view.bind(active);","  layer.setCameraZoom(1);layer.setCameraX(game.getGameResolutionWidth()/2);layer.setCameraY(game.getGameResolutionHeight()/2);","  const g=scene.__monsterDiscovery.geometry(),age=active.age,smooth=x=>{x=Math.max(0,Math.min(1,x));return x*x*(3-2*x);},enter=smooth(age/.4),exit=smooth((age-3.2)/.8),reveal=smooth((age-.4)/.6);","  view.screenRect=g;const maskKey=[g.x,g.y,g.w,g.h,g.scale].join(':');if(view.maskKey!==maskKey){mask.clear().beginFill(0xffffff).drawRect(g.x-6*g.scale,g.y-6*g.scale,g.w+12*g.scale,g.h+12*g.scale).endFill();view.maskKey=maskKey;}","  root.visible=true;mask.visible=true;root.alpha=enter*(1-exit);root.scale.set(g.scale);root.position.set(g.x,g.y-(1-enter)*150*g.scale-exit*150*g.scale);const c=Math.round(255*reveal);view.icon.tint=(c<<16)|(c<<8)|c;view.name.alpha=smooth((age-1)/.2);","  view.stars.forEach((s,i)=>{s.position.set(59+Math.cos(age+i)*43,67+Math.sin(age+i)*40);s.alpha=reveal*.65;});"," };"," view.dispose=()=>{if(view.disposed)return;view.disposed=true;root.mask=null;root.destroy({children:true,texture:false,baseTexture:false});mask.destroy();};"," if(!gdjs.__fusionArchiveCallbacks){gdjs.__fusionArchiveCallbacks=true;gdjs.callbacksRuntimeScenePostEvents.push(s=>s.__fusionDiscovery?.update());gdjs.callbacksRuntimeSceneUnloading.push(s=>s.__fusionDiscovery?.dispose());}","}"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[]},{"colorB":109,"colorG":143,"colorR":90,"creationTime":0,"name":"Unit INDEX modal","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Galactic Archives is presentation-only. Combat and discovery owners stay authoritative.","const scene=runtimeScene,sv=scene.getVariables(),game=scene.getGame(),input=game.getInputManager();","const width=game.getGameResolutionWidth(),height=game.getGameResolutionHeight(),data=game.getSceneAndExtensionsData(scene.getName()).sceneData;","let index=scene.__unitIndex;","if(!index){"," index=scene.__unitIndex={objects:{},cards:[],monsterCards:[],category:'Towers',selected:{},scroll:0,collectionScroll:0,wasDown:false,pressed:'',dragging:null,disposed:false};"," index.ensure=(key,name,layer,z)=>{let o=index.objects[key];if(!o){o=scene.createObject(name);o.setLayer(layer);o.setZOrder(z);index.objects[key]=o;}return o;};"," index.graphics={};index.masks={};"," for(const name of ['IndexUI','IndexList','IndexDetail']){","  const parent=scene.getLayer(name).getRenderer().getRendererObject(),g=new PIXI.Graphics();g.zIndex=-10;g.interactive=false;parent.addChild(g);index.graphics[name]=g;","  if(name!=='IndexUI'){const mask=new PIXI.Graphics();mask.zIndex=-20;parent.addChild(mask);parent.mask=mask;index.masks[name]=mask;}"," }"," index.select=id=>{index.selected[index.category]=id;index.scroll=0;index.renderKey=null;};"," index.dispose=()=>{if(index.disposed)return;index.disposed=true;for(const name of ['IndexUI','IndexList','IndexDetail']){scene.getLayer(name).getRenderer().getRendererObject().mask=null;index.graphics[name].destroy();index.masks[name]?.destroy();}};"," if(!gdjs.__indexShowcaseCallbacks){gdjs.__indexShowcaseCallbacks=true;gdjs.callbacksRuntimeSceneUnloading.push(s=>s.__unitIndex?.dispose());}","}","for(const name of ['IndexUI','IndexList','IndexDetail']){const l=scene.getLayer(name);l.setCameraZoom(1);l.setCameraX(width/2);l.setCameraY(height/2);}","const wasOpen=sv.get('IndexOpen').getAsBoolean(),shop=scene.__towerShopUI;","if(shop?.indexRequested){sv.get('IndexOpen').setBoolean(true);shop.indexRequested=false;}","let open=sv.get('IndexOpen').getAsBoolean();sv.get('IndexBlocksInput').setBoolean(wasOpen||open);","const down=input.isMouseButtonPressed(0);","if(!open){for(const name of ['IndexUI','IndexList','IndexDetail'])scene.getLayer(name).show(false);index.wasDown=down;index.pressed='';index.dragging=null;index.renderKey=null;return;}","const archive=game.__fusionArchive,discovery=scene.__monsterDiscovery,portraits=sv.get('IndexPortraitCatalog').toJSObject(),star=sv.get('StarCannonConfig').toJSObject();","const archetypes=sv.get('EnemyTypes').toJSObject(),catalog=sv.get('TowerShopCatalog').toJSObject(),categories=['Towers','Monsters','Fusion'];","if(!categories.includes(index.category))index.category='Towers';","const entries=index.category==='Towers'?catalog.flatMap(item=>{"," const def=data.objects.find(o=>o.name===item.Type);if(!def)return[];const v=Object.fromEntries(def.variables.map(v=>[v.name,v.value])),isStar=item.Type==='StarCannonTower';"," return[{id:item.Type,type:item.Type,name:v.TowerName||item.Name,price:item.Cost,damage:isStar?star.BaseDamage:v.Damage,range:isStar?star.BaseRange:v.AttackRange,cooldown:isStar?star.BaseInterval:v.AttackInterval,projectileSpeed:isStar?star.ProjectileSpeed:v.ProjectileSpeed,locked:false}];","}):index.category==='Monsters'?discovery.ids.map(id=>({id,typeId:id,name:archetypes[id].Name||id,...archetypes[id],locked:!discovery.has(id),monster:true})):archive.catalog.map(def=>({id:def.Id,type:def.Id,name:def.Name,definition:def,fusion:true,locked:!archive.has(def.Id)}));","index.entries=entries;index.categories=categories;","const categoryChanged=index.lastCategory!==index.category;","if(categoryChanged){index.scroll=0;index.collectionScroll=0;index.lastCategory=index.category;}","if(!entries.some(e=>e.id===index.selected[index.category]))index.selected[index.category]=entries[0]?.id;","const selected=entries.find(e=>e.id===index.selected[index.category]),selectedIndex=entries.indexOf(selected);","const mobile=width<760,w=Math.min(1320,width-32),h=Math.min(900,height-32),x=(width-w)/2,y=(height-h)/2;","const body={x:x+18,y:y+126,w:w-36,h:h-164},cw=Math.min(280,Math.max(196,w*.225));","const collection=mobile?{x:body.x,y:body.y,w:body.w,h:92}:{x:body.x,y:body.y,w:cw,h:body.h};","const detail=mobile?{x:body.x,y:body.y+106,w:body.w,h:body.h-106}:{x:body.x+cw+16,y:body.y,w:body.w-cw-16,h:body.h};","index.geometry={x,y,w,h,content:detail,collection,detail,mobile};","index.tabRects=categories.map((name,i)=>({name,x:x+20+i*(mobile?(w-40)/3:154),y:y+74,w:mobile?(w-56)/3:142,h:34}));","index.closeRect={x:x+w-58,y:y+20,w:36,h:36};","const mx=gdjs.evtTools.input.getCursorX(scene,'IndexUI',0),my=gdjs.evtTools.input.getCursorY(scene,'IndexUI',0),inside=r=>!!r&&mx>=r.x&&mx<r.x+r.w&&my>=r.y&&my<r.y+r.h;","const stride=mobile?182:90,rowWidth=mobile?172:collection.w-14;","index.collectionMaxScroll=Math.max(0,entries.length*stride-(mobile?collection.w:collection.h));","if(categoryChanged&&selectedIndex>=0)index.collectionScroll=Math.max(0,Math.min(index.collectionMaxScroll,selectedIndex*stride+80-(mobile?collection.w:collection.h)));","const wheel=input.getMouseWheelDelta();if(inside(collection))index.collectionScroll-=Math.sign(wheel)*52;else if(inside(detail))index.scroll-=Math.sign(wheel)*60;","index.collectionScroll=Math.max(0,Math.min(index.collectionMaxScroll,index.collectionScroll));","const cardRects=()=>entries.map((e,i)=>({id:e.id,x:collection.x+(mobile?i*stride-index.collectionScroll:0),y:collection.y+(mobile?0:i*stride-index.collectionScroll),w:rowWidth,h:80}));","index.cardRects=cardRects();","const detailTrack={x:detail.x+detail.w-8,y:detail.y,w:8,h:detail.h},collectionTrack=mobile?null:{x:collection.x+collection.w-7,y:collection.y,w:7,h:collection.h};","const hover=index.tabRects.find(inside)?.name||(inside(index.closeRect)?'Close':inside(detailTrack)&&index.maxScroll>0?'DetailTrack':inside(collectionTrack)&&index.collectionMaxScroll>0?'CollectionTrack':inside(collection)?index.cardRects.find(inside)?.id:'')||'';","if(down&&!index.wasDown){index.pressed=hover;if(hover.endsWith('Track'))index.dragging={list:hover==='CollectionTrack',y:my,value:hover==='CollectionTrack'?index.collectionScroll:index.scroll};}","if(down&&index.dragging){const d=index.dragging,r=d.list?collection:detail,max=d.list?index.collectionMaxScroll:index.maxScroll,thumb=Math.max(24,r.h*r.h/(r.h+max)),value=d.value+(my-d.y)*max/Math.max(1,r.h-thumb);if(d.list)index.collectionScroll=value;else index.scroll=value;}","index.collectionScroll=Math.max(0,Math.min(index.collectionMaxScroll,index.collectionScroll));index.cardRects=cardRects();","if(!down&&index.wasDown&&index.pressed===hover){"," if(hover==='Close'){sv.get('IndexOpen').setBoolean(false);open=false;}"," else if(categories.includes(hover)&&index.category!==hover){index.category=hover;index.renderKey=null;index.wasDown=down;index.pressed='';return;}"," else if(entries.some(e=>e.id===hover)){index.select(hover);index.wasDown=down;index.pressed='';return;}","}","if(gdjs.evtTools.input.wasKeyJustPressed(scene,'Escape')){sv.get('IndexOpen').setBoolean(false);open=false;}","if(!down)index.dragging=null;","index.scroll=Math.max(0,Math.min(index.maxScroll||0,index.scroll));","const key=JSON.stringify([index.category,index.selected[index.category],index.scroll,index.collectionScroll,width,height,hover,open,discovery.revision,archive.revision]);","if(index.renderKey===key){index.wasDown=down;if(!down)index.pressed='';return;}index.renderKey=key;index.renderCount=(index.renderCount||0)+1;","Object.values(index.objects).forEach(o=>o.hide());index.cards=[];index.monsterCards=[];index.measuredTexts=[];index.artRects=[];","for(const g of Object.values(index.graphics))g.clear();","for(const [name,r]of [['IndexList',collection],['IndexDetail',detail]])index.masks[name].clear().beginFill(0xffffff).drawRect(r.x,r.y,r.w,r.h).endFill();","const C={border:0x494169,gold:0xc5ab72,white:'242;236;255',muted:'172;166;197'};","const box=(layer,r,fill,border=C.border,radius=10,alpha=1)=>index.graphics[layer].lineStyle(1,border,.8).beginFill(fill,alpha).drawRoundedRect(r.x,r.y,r.w,r.h,radius).endFill();","const line=(layer,a,b,c,d,color=C.border)=>index.graphics[layer].lineStyle(1,color,.6).moveTo(a,b).lineTo(c,d);","const text=(key,value,px,py,ww,size=13,color=C.white,bold=false,layer='IndexUI')=>{"," const o=index.ensure(key,'IndexText',layer,3);o.setString(String(value));o.setCharacterSize(size);o.setBold(bold);o.setColor(color);o.setWrapping(true);o.setWrappingWidth(Math.max(20,ww));o.setPosition(px,py);o.hide(false);index.measuredTexts.push({key,object:o,x:px,y:py,w:ww});return o;","};","const label=(key,value,px,py,ww,layer='IndexDetail',color='192;173;123')=>text(key,value,px,py,ww,10,color,true,layer);","const g=index.graphics.IndexUI;g.beginFill(0x050610,.88).drawRect(0,0,width,height).endFill();box('IndexUI',{x,y,w,h},0x101024,0x797098,15,.99);","line('IndexUI',x+18,y+62,x+w-18,y+62,0x5c4a75);","for(const [sx,sy]of [[x+18,y+18],[x+w-18,y+18],[x+18,y+h-18],[x+w-18,y+h-18]])g.beginFill(C.gold,.9).drawPolygon([sx,sy-3,sx+3,sy,sx,sy+3,sx-3,sy]).endFill();","text('title','GALACTIC ARCHIVES',x+32,y+18,w-112,mobile?20:25,C.white,true);","label('archiveMark','CELESTIAL VOID  /  FIELD ENCYCLOPEDIA',x+34,y+47,w-130,'IndexUI','150;165;192');","box('IndexUI',index.closeRect,hover==='Close'?0x443458:0x211c36);text('buttonTextClose','X',index.closeRect.x+12,index.closeRect.y+9,20,15,C.white,true);","for(const r of index.tabRects){const active=r.name===index.category;box('IndexUI',r,active?0x302446:0x17142b,active?C.gold:C.border,7);text('tabText'+r.name,r.name.toUpperCase(),r.x+15,r.y+10,r.w-20,11,active?'234;216;170':C.muted,true);}","const found=entries.filter(e=>!e.locked).length;","const compact=w<1000;","text('subtitle',(index.category==='Towers'?'TOWER COLLECTION':index.category==='Monsters'?'MONSTER DISCOVERY':'FUSION ARCHIVE')+'  /  '+found+' / '+entries.length+' DISCOVERED',mobile?x+20:compact?x+w-338:x+w-350,compact?y+h-25:y+86,mobile?w-40:320,10,C.muted);","box('IndexUI',{x:collection.x-3,y:collection.y-3,w:collection.w+6,h:collection.h+6},0x121027,0x393152,10);","box('IndexUI',{x:detail.x-3,y:detail.y-3,w:detail.w+6,h:detail.h+6},0x14122b,0x54435f,10);","if(!mobile)text('footer',compact?'SCROLL EACH PANEL / ESC TO CLOSE':'SELECT AN ENTRY   /   SCROLL EACH PANEL   /   ESC TO CLOSE',x+32,y+h-25,compact?w-392:w-52,10,'139;137;167');","const fit=(o,b,r)=>{o.setScale(1);const scale=Math.min(r.w/b[2],r.h/b[3]);o.setScale(scale);o.setPosition(r.x+r.w/2-(b[0]+b[2]/2)*scale,r.y+r.h/2-(b[1]+b[3]/2)*scale);index.artRects.push({id:o.__archiveId,object:o,x:o.getX()+b[0]*scale,y:o.getY()+b[1]*scale,w:b[2]*scale,h:b[3]*scale,frame:r});};","const portrait=(key,e,r,layer)=>{"," if(e.monster){const o=index.ensure(key,'IndexMonsterImage',layer,2);o.setAnimationName(e.Animation);o.setColor(e.locked?'0;0;0':'255;255;255');o.setOpacity(255);o.__discoveryLocked=e.locked;o.__discoveryPortrait={id:e.id,x:r.x+r.w/2,y:r.y+r.h/2,w:r.w,h:r.h};o.setPosition(r.x,r.y);o.hide(false);index.monsterCards.push({sprite:o});return o;}"," const meta=portraits[e.id],animation=meta&&data.objects.find(o=>o.name==='IndexShowcase').animations.find(a=>a.name===meta.Animation);"," if(!animation){label(key+'Pending','PORTRAIT PENDING',r.x+8,r.y+r.h/2-5,r.w-16,layer,'139;133;162');return null;}"," const o=index.ensure(key,'IndexShowcase',layer,2);o.setAnimationName(meta.Animation);o.setColor(e.locked?'0;0;0':'255;255;255');o.setOpacity(255);o.__archiveId=e.id;o.__fusionLocked=e.locked;o.hide(false);fit(o,meta.VisualBounds,r);return o;","};","for(const [i,e]of entries.entries()){"," const r=index.cardRects[i],active=e.id===index.selected[index.category];box('IndexList',r,active?0x302442:0x1a172f,active?C.gold:hover===e.id?0x8c79ba:0x403755,8);"," if(active)index.graphics.IndexList.beginFill(C.gold,.9).drawRoundedRect(r.x+1,r.y+14,3,r.h-28,2).endFill();"," const sprite=portrait('collection'+index.category+i,e,{x:r.x+9,y:r.y+10,w:56,h:60},'IndexList');"," const name=text('collectionName'+i,e.locked?'???':e.name,r.x+74,r.y+14,r.w-82,13,C.white,true,'IndexList');"," const status=text('collectionStatus'+i,e.locked?'UNDISCOVERED':e.monster||e.fusion?'DISCOVERED':'TOWER / AVAILABLE',r.x+74,r.y+48,r.w-82,9,e.locked?'154;139;175':'168;198;218',false,'IndexList');"," index.cards.push({name,status,sprite,locked:e.locked,id:e.id});","}","const scrollBar=(layer,r,max,value,horizontal=false)=>{if(max<=0)return;const g=index.graphics[layer],len=horizontal?r.w:r.h,thumb=Math.max(24,len*len/(len+max)),pos=value/max*(len-thumb);g.beginFill(0x3b3454).drawRoundedRect(r.x,r.y,r.w,r.h,3).endFill();g.beginFill(0x9b89ba).drawRoundedRect(r.x+(horizontal?pos:0),r.y+(horizontal?0:pos),horizontal?thumb:r.w,horizontal?r.h:thumb,3).endFill();};","scrollBar('IndexUI',mobile?{x:collection.x,y:collection.y+86,w:collection.w,h:4}:collectionTrack,index.collectionMaxScroll,index.collectionScroll,mobile);","if(selected){"," const e=selected,locked=e.locked,dx=detail.x+18,dw=detail.w-48,top=detail.y+16-index.scroll,stack=dw<480,artW=stack?Math.min(280,dw):Math.min(350,dw*.43),artH=Math.min(330,Math.max(128,detail.h-48)),artFrame={x:stack?dx+(dw-artW)/2:dx,y:top,w:artW,h:artH};"," box('IndexDetail',artFrame,0x111429,e.fusion?C.gold:0x344360,12);"," const ag=index.graphics.IndexDetail,cx=artFrame.x+artW/2,cy=top+artH*.57;"," ag.lineStyle(1,e.fusion?0x8d734b:0x48617e,.35).drawEllipse(cx,cy,artW*.43,artH*.27).drawEllipse(cx,cy,artW*.34,artH*.21);"," for(let k=0;k<5;k++)ag.beginFill(0x92a4cc,.4).drawCircle(artFrame.x+14+(k*37)%(artW-28),top+18+(k*53)%(artH-36),1).endFill();"," const art=portrait('detail'+index.category,e,{x:artFrame.x+16,y:artFrame.y+16,w:artW-32,h:artH-32},'IndexDetail');"," const tx=stack?dx:dx+artW+22,tw=stack?dw:dw-artW-22,ty=stack?top+artH+20:top+4;"," label('detailType',locked?'UNIDENTIFIED ARCHIVE':e.fusion?e.definition.Kind.toUpperCase()+' FUSION':e.monster?(e.Classification||'COMMON')+' ENEMY':'CELESTIAL ARTILLERY',tx,ty,tw);"," const title=text('detailName',locked?'???':e.name,tx,ty+20,tw,tw<250?24:30,C.white,true,'IndexDetail');"," let yy=ty+20+title.getHeight()+10;"," const desc=locked?(e.fusion?'CRYPTIC HINT\\n'+e.definition.Hint:'An unknown presence moves through the Void. Encounter this enemy to reveal its archive.'):(e.fusion?e.definition.Description:e.monster?(e.Role||(e.id==='Basic'?'A wandering cosmic entity.':'Fast Void creature.')):'A single stellar cannon, forged in ivory and gold. Shape its energy through two upgrade paths.');"," const description=text('detailDescription',desc,tx,yy,tw,13,C.muted,false,'IndexDetail');yy+=description.getHeight()+18;"," const config=e.fusion?(data.variables.some(v=>v.name===e.definition.StatsConfig)?sv.get(e.definition.StatsConfig).toJSObject():e.definition.Stats||{}):null;"," const stats=locked?[]:e.monster?[['HP',e.HP],['ARMOR',e.Armor],['SPEED',e.Speed+' px/s'],['REWARD',e.Reward+' Gold']]:[['DAMAGE',e.fusion?config.Damage:e.damage],['INTERVAL',Number(e.fusion?config.AttackInterval:e.cooldown).toFixed(2)+' s'],['RANGE',(e.fusion?config.AttackRange:e.range)+' px'],[e.fusion?'RATE':'COST',e.fusion?(1/config.AttackInterval).toFixed(2)+' /s':e.price+' Gold']];"," index.statValues=stats;const statsTop=yy,cellW=(tw-10)/2;"," for(const [i,[name,value]]of stats.entries()){","  const sx=tx+i%2*(cellW+10),sy=statsTop+Math.floor(i/2)*64;box('IndexDetail',{x:sx,y:sy,w:cellW,h:54},0x201d38,0x393551,6);","  const icon=index.graphics.IndexDetail,ix=sx+14,iy=sy+13;icon.lineStyle(1,0xa4bedb,.85);","  if(name==='INTERVAL'||name==='RATE')icon.drawCircle(ix,iy,4).moveTo(ix,iy-3).lineTo(ix,iy).lineTo(ix+3,iy+1);","  else if(name==='RANGE')icon.drawCircle(ix,iy,4).moveTo(ix-6,iy).lineTo(ix+6,iy).moveTo(ix,iy-6).lineTo(ix,iy+6);","  else if(name==='HP')icon.moveTo(ix-4,iy).lineTo(ix+4,iy).moveTo(ix,iy-4).lineTo(ix,iy+4);","  else if(name==='ARMOR')icon.drawPolygon([ix-4,iy-4,ix+4,iy-4,ix+3,iy+2,ix,iy+5,ix-3,iy+2,ix-4,iy-4]);","  else icon.drawPolygon([ix,iy-5,ix+4,iy,ix,iy+5,ix-4,iy,ix,iy-5]);","  label('statLabel'+i,name,sx+26,sy+8,cellW-36,'IndexDetail','151;164;192');text('statValue'+i,value,sx+10,sy+24,cellW-20,18,C.white,true,'IndexDetail');"," }"," yy+=stats.length?128:0;"," if(!locked&&!e.monster){const property=e.fusion?(Number.isFinite(config.SplashRadius)&&Number.isFinite(config.SplashRatio)?'SPLASH  /  '+config.SplashRadius+' px  /  '+Math.round(config.SplashRatio*100)+'% damage':''):(Number.isFinite(e.projectileSpeed)?'PROJECTILE SPEED  /  '+e.projectileSpeed+' px/s':'');if(property){const properties=text('detailProperties',property,tx,yy,tw,11,'151;170;198',false,'IndexDetail');yy+=properties.getHeight()+14;}}"," if(locked){label('detailLock','UNDISCOVERED  /  DETAILS LOCKED',tx,yy,tw,'IndexDetail','163;144;188');yy+=32;}"," let sectionY=Math.max(top+artH+24,yy+8);"," const section=(key,title)=>{line('IndexDetail',dx,sectionY,dx+dw,sectionY,0x655470);label(key,title,dx,sectionY+14,dw);sectionY+=40;};"," const paragraph=(key,value)=>{const t=text(key,value,dx,sectionY,dw,13,C.muted,false,'IndexDetail');sectionY+=t.getHeight()+18;return t;};"," index.detail={id:e.id,entry:e,locked,sprite:art,name:title,description,statValues:stats};"," if(e.type==='StarCannonTower'){","  section('upgradesTitle','UPGRADE PATHS');const cols=dw>=580?2:1,colW=cols===2?(dw-16)/2:dw,starts=[];","  for(const [p,path]of star.Paths.entries()){","   const px=dx+(p%cols)*(colW+16);let py=cols===2?sectionY:sectionY+(p?starts[0]:0);const start=py;","   box('IndexDetail',{x:px,y:py,w:colW,h:50},p?0x20203c:0x292038,p?0x586e94:0x8a7052,7);label('pathNumber'+p,'PATH '+(p+1),px+12,py+8,colW-24,'IndexDetail',p?'158;204;229':'225;193;130');text('starPath'+p,path.Name,px+12,py+23,colW-24,12,C.white,true,'IndexDetail');py+=64;","   for(const [n,u]of path.Upgrades.entries()){","    const icon=index.ensure('starUpgrade'+p+n,'StarUpgradeIcon','IndexDetail',2);icon.setAnimationName(u.Icon);icon.setWidth(38);icon.setHeight(38);icon.setPosition(px+8,py+8);icon.hide(false);","    const name=text('upgradeName'+p+n,'0'+(n+1)+'  '+u.Name,px+56,py+8,colW-68,13,C.white,true,'IndexDetail');","    const desc=text('upgradeDesc'+p+n,u.Description,px+56,py+name.getHeight()+14,colW-68,12,C.muted,false,'IndexDetail');","    const rh=Math.max(92,name.getHeight()+desc.getHeight()+48);box('IndexDetail',{x:px,y:py,w:colW,h:rh-8},0x19162e,0x302b45,6);label('upgradeCost'+p+n,u.Cost+' GOLD',px+56,py+rh-30,colW-68,'IndexDetail','195;175;129');py+=rh;","   }","   starts[p]=py-start+18;","  }","  sectionY+=cols===2?Math.max(...starts):starts.reduce((a,b)=>a+b,0);paragraph('starRule','Level 3 specializes one path. The other path can reach level 2. Maximum level '+star.MaxLevel+'.');"," }else if(e.monster&&!locked){","  section('abilityHeading','ENEMY PROFILE');paragraph('monsterProfile',!e.SpecialAbility||e.SpecialAbility==='None'?'No special ability.':'SPECIAL ABILITY  /  '+e.SpecialAbility);","  if(e.id==='VoidGolem'){const skill=sv.get('VoidGolemConfig').toJSObject().Skill;paragraph('golemSkill','Stops to cast '+skill.Name+'. Grants +'+skill.ArmorBonus+' armor within '+skill.Radius+' px for '+skill.Duration+' s. Cooldown: '+skill.Cooldown+' s.');}","  paragraph('monsterFirstWave','FIRST APPEARANCE  /  WAVE '+e.MinimumWave+'+');"," }else if(e.fusion){","  section('recipeHeading',locked?'SEALED COMBINATION':'FUSION COMBINATION');const recipe=v=>v.Recipe.map(p=>p.Label||p.Type+' '+p.Path1+'-'+p.Path2).join(' + '),known=e.definition.Variants.filter(v=>archive.hasVariant(e.id,v.Id));","  paragraph('fusionRecipe'+selectedIndex,locked?'Combination locked':e.definition.AdaptiveVariants?'Each adaptive variant is discovered separately.':known.map(recipe).join('\\n')||'Combination not yet recorded');","  if(e.definition.AdaptiveVariants){const progress=archive.progress(e.id);section('fusionProgress'+selectedIndex,'ADAPTIVE VARIANTS  /  '+progress.found+' / '+progress.total);e.definition.Variants.forEach((v,n)=>paragraph('fusionVariant'+n+selectedIndex,archive.hasVariant(e.id,v.Id)?v.Name+'\\n'+recipe(v):'???  /  UNDISCOVERED'));}","  else if(!locked)paragraph('fusionIdentity','PURE EVOLUTION  /  One canonical recipe. Source order does not change the result.');"," }"," index.detailHeight=sectionY+index.scroll-detail.y;index.maxScroll=Math.max(0,index.detailHeight-detail.h+12);scrollBar('IndexUI',detailTrack,index.maxScroll,index.scroll);","}else{text('emptyArchive','No entries available.',detail.x+20,detail.y+30,detail.w-40,16,C.muted);index.maxScroll=0;}","for(const name of ['IndexUI','IndexList','IndexDetail'])scene.getLayer(name).show(open);","index.wasDown=down;if(!down)index.pressed='';"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// A separate UI overlay. Shop and map geometry stay independent of selection.","const scene=runtimeScene,sv=scene.getVariables(),game=scene.getGame();","let ui=scene.__selectedPanel;","if(!ui) {","  ui=scene.__selectedPanel={objects:{},wasDown:false,pressed:\"\",pressedTower:0,cards:[]};","  ui.ensure=(key,name,z=1)=>{","    if(!ui.objects[key]){const o=scene.createObject(name);o.setLayer(\"SelectedTowerUI\");o.setZOrder(z);ui.objects[key]=o;}","    return ui.objects[key];","  };","}","const towers=scene.getObjects(\"StarCannonTower\");","let selected=towers.find(t=>t.getVariables().get(\"TowerId\").getAsNumber()===sv.get(\"SelectedTower\").getAsNumber());","if(!selected&&sv.get(\"SelectedTower\").getAsNumber()>0)sv.get(\"SelectedTower\").setNumber(0);","const input=game.getInputManager(),down=input.isMouseButtonPressed(0),modal=sv.get(\"IndexBlocksInput\").getAsBoolean()||sv.get(\"AudioUIConsumesClick\").getAsBoolean()||sv.get('FusionActive').getAsBoolean();","const h=680,w=320,layer=scene.getLayer(\"SelectedTowerUI\");","let scale=1,sx=8,sy=8;","const positionPanel=tower=>{"," const area=scene.__towerShopUI.gameArea,margin=8,map=scene.getLayer(\"\");"," const center=tower?(scene.__freePlacement?scene.__freePlacement.center(tower):[tower.getCenterXInScene(),tower.getCenterYInScene()]):[(area.left+area.right)/2,0];"," const screen=tower?map.convertInverseCoords(center[0],center[1],0,[0,0]):center;"," const right=tower&&screen[0]<(area.left+area.right)/2;"," const hud=scene.getObjects(\"HUDPanel\")[0],hudLayer=scene.getLayer(\"UI\");"," const hudBottom=hudLayer.convertInverseCoords(hud.getX(),hud.getY()+hud.getHeight(),0,[0,0])[1];"," sy=Math.max(margin,hudBottom+margin);"," const footprint=tower&&scene.__freePlacement?scene.__freePlacement.radius(tower)*map.getCameraZoom():0;"," const sideRoom=tower?(right?area.right-margin-screen[0]-footprint-margin:screen[0]-footprint-margin-area.left-margin):area.right-area.left-2*margin;"," scale=Math.max(.01,Math.min(1,(game.getGameResolutionHeight()-sy-margin)/h,((area.right-area.left)/2-2*margin)/w,sideRoom/w));"," sx=right?area.right-margin-w*scale:area.left+margin;"," sx=Math.max(area.left+margin,Math.min(area.right-margin-w*scale,sx));"," layer.setCameraZoom(scale);layer.setCameraX(game.getGameResolutionWidth()/2/scale-sx/scale);layer.setCameraY(game.getGameResolutionHeight()/2/scale-sy/scale);"," ui.panelSide=right?\"RIGHT\":\"LEFT\";ui.screenRect=tower?{x:sx,y:sy,w:w*scale,h:h*scale}:null;","};","positionPanel(selected);","const mx=gdjs.evtTools.input.getCursorX(scene,\"SelectedTowerUI\",0),my=gdjs.evtTools.input.getCursorY(scene,\"SelectedTowerUI\",0);","const inside=(x,y,width,height)=>mx>=x&&mx<x+width&&my>=y&&my<y+height;","const pointer=!!selected&&!modal&&inside(0,0,w,h);","sv.get(\"SelectedPanelPointerInside\").setBoolean(pointer);","sv.get(\"TowerUIConsumesClick\").setBoolean(pointer);","ui.screenRect=selected?{x:sx,y:sy,w:w*scale,h:h*scale}:null;","const canFuse=scene.__fusion?.eligible(selected)||false;","const hover=!selected||modal?\"\":canFuse&&inside(16,584,288,26)?'Fusion':inside(16,h-66,w-32,48)?\"Sell\":inside(278,12,26,26)?\"Close\":inside(16,314,140,270)?\"Path1\":inside(164,314,140,270)?\"Path2\":pointer?\"Panel\":\"\";","if(down&&!ui.wasDown){ui.pressed=hover;ui.pressedTower=selected?selected.getVariables().get(\"TowerId\").getAsNumber():0;}","if(!down&&ui.wasDown&&selected&&!modal&&ui.pressed===hover&&ui.pressedTower===selected.getVariables().get(\"TowerId\").getAsNumber()) {","  if(hover===\"Sell\") {","    const v=selected.getVariables(),investment=v.get(\"TotalInvestment\").getAsNumber();","    sv.get(\"Money\").setNumber(sv.get(\"Money\").getAsNumber()+Math.floor(investment*sv.get(\"SellRefundRate\").getAsNumber()+1e-8));","    selected.deleteFromScene();sv.get(\"SelectedTower\").setNumber(0);selected=null;","  } else if(hover==='Fusion'){scene.__fusion?.begin(selected);selected=null;}","  else if(hover===\"Close\") {sv.get(\"SelectedTower\").setNumber(0);selected=null;}","  else if((hover===\"Path1\"||hover===\"Path2\"))scene.__starCannon?.upgrade(selected,hover===\"Path1\"?1:2);","}","if(!down)ui.pressed=\"\";ui.wasDown=down;","ui.render=()=>{","  Object.values(ui.objects).forEach(o=>o.hide());","  const tower=towers.find(t=>t.getVariables().get(\"TowerId\").getAsNumber()===sv.get(\"SelectedTo