PORTRAIT PENDING',r.x+8,r.y+r.h/2-5,r.w-16,layer,'139;133;162');return null;}"," const o=index.ensure(key,'IndexShowcase',layer,2);o.setAnimationName(meta.Animation);o.setColor(e.locked?'0;0;0':'255;255;255');o.setOpacity(255);o.__archiveId=e.id;o.__fusionLocked=e.locked;o.hide(false);fit(o,meta.VisualBounds,r);return o;","};","for(const [i,e]of entries.entries()){"," const r=index.cardRects[i],active=e.id===index.selected[index.category];box('IndexList',r,active?0x302442:0x1a172f,active?C.gold:hover===e.id?0x8c79ba:0x403755,8);"," if(active)index.graphics.IndexList.beginFill(C.gold,.9).drawRoundedRect(r.x+1,r.y+14,3,r.h-28,2).endFill();"," const sprite=portrait('collection'+index.category+i,e,{x:r.x+9,y:r.y+10,w:56,h:60},'IndexList');"," const name=text('collectionName'+i,e.locked?'???':e.name,r.x+74,r.y+14,r.w-82,13,C.white,true,'IndexList');"," const status=text('collectionStatus'+i,e.locked?'UNDISCOVERED':e.monster||e.fusion?'DISCOVERED':'TOWER / AVAILABLE',r.x+74,r.y+48,r.w-82,9,e.locked?'154;139;175':'168;198;218',false,'IndexList');"," index.cards.push({name,status,sprite,locked:e.locked,id:e.id});","}","const scrollBar=(layer,r,max,value,horizontal=false)=>{if(max<=0)return;const g=index.graphics[layer],len=horizontal?r.w:r.h,thumb=Math.max(24,len*len/(len+max)),pos=value/max*(len-thumb);g.beginFill(0x3b3454).drawRoundedRect(r.x,r.y,r.w,r.h,3).endFill();g.beginFill(0x9b89ba).drawRoundedRect(r.x+(horizontal?pos:0),r.y+(horizontal?0:pos),horizontal?thumb:r.w,horizontal?r.h:thumb,3).endFill();};","scrollBar('IndexUI',mobile?{x:collection.x,y:collection.y+86,w:collection.w,h:4}:collectionTrack,index.collectionMaxScroll,index.collectionScroll,mobile);","if(selected){"," const e=selected,locked=e.locked,dx=detail.x+18,dw=detail.w-48,top=detail.y+16-index.scroll,stack=dw<480,artW=stack?Math.min(280,dw):Math.min(350,dw*.43),artH=Math.min(330,Math.max(128,detail.h-48)),artFrame={x:stack?dx+(dw-artW)/2:dx,y:top,w:artW,h:artH};"," box('IndexDetail',artFrame,0x111429,e.fusion?C.gold:0x344360,12);"," const ag=index.graphics.IndexDetail,cx=artFrame.x+artW/2,cy=top+artH*.57;"," ag.lineStyle(1,e.fusion?0x8d734b:0x48617e,.35).drawEllipse(cx,cy,artW*.43,artH*.27).drawEllipse(cx,cy,artW*.34,artH*.21);"," for(let k=0;k<5;k++)ag.beginFill(0x92a4cc,.4).drawCircle(artFrame.x+14+(k*37)%(artW-28),top+18+(k*53)%(artH-36),1).endFill();"," const art=portrait('detail'+index.category,e,{x:artFrame.x+16,y:artFrame.y+16,w:artW-32,h:artH-32},'IndexDetail');"," const tx=stack?dx:dx+artW+22,tw=stack?dw:dw-artW-22,ty=stack?top+artH+20:top+4;"," label('detailType',locked?'UNIDENTIFIED ARCHIVE':e.fusion?e.definition.Kind.toUpperCase()+' FUSION':e.monster?(e.Classification||'COMMON')+' ENEMY':'CELESTIAL ARTILLERY',tx,ty,tw);"," const title=text('detailName',locked?'???':e.name,tx,ty+20,tw,tw<250?24:30,C.white,true,'IndexDetail');"," let yy=ty+20+title.getHeight()+10;"," const desc=locked?(e.fusion?'CRYPTIC HINT\\n'+e.definition.Hint:'An unknown presence moves through the Void. Encounter this enemy to reveal its archive.'):(e.fusion?e.definition.Description:e.monster?(e.Role||(e.id==='Basic'?'A wandering cosmic entity.':'Fast Void creature.')):'A single stellar cannon, forged in ivory and gold. Shape its energy through two upgrade paths.');"," const description=text('detailDescription',desc,tx,yy,tw,13,C.muted,false,'IndexDetail');yy+=description.getHeight()+18;"," const config=e.fusion?(data.variables.some(v=>v.name===e.definition.StatsConfig)?sv.get(e.definition.StatsConfig).toJSObject():e.definition.Stats||{}):null;"," const stats=locked?[]:e.monster?[['HP',e.HP],['ARMOR',e.Armor],['SPEED',e.Speed+' px/s'],['REWARD',e.Reward+' Gold']]:[['DAMAGE',e.fusion?config.Damage:e.damage],['INTERVAL',Number(e.fusion?config.AttackInterval:e.cooldown).toFixed(2)+' s'],['RANGE',(e.fusion?config.AttackRange:e.range)+' px'],[e.fusion?'RATE':'COST',e.fusion?(1/config.AttackInterval).toFixed(2)+' /s':e.price+' Gold']];"," index.statValues=stats;const statsTop=yy,cellW=(tw-10)/2;"," for(const [i,[name,value]]of stats.entries()){","  const sx=tx+i%2*(cellW+10),sy=statsTop+Math.floor(i/2)*64;box('IndexDetail',{x:sx,y:sy,w:cellW,h:54},0x201d38,0x393551,6);","  const icon=index.graphics.IndexDetail,ix=sx+14,iy=sy+13;icon.lineStyle(1,0xa4bedb,.85);","  if(name==='INTERVAL'||name==='RATE')icon.drawCircle(ix,iy,4).moveTo(ix,iy-3).lineTo(ix,iy).lineTo(ix+3,iy+1);","  else if(name==='RANGE')icon.drawCircle(ix,iy,4).moveTo(ix-6,iy).lineTo(ix+6,iy).moveTo(ix,iy-6).lineTo(ix,iy+6);","  else if(name==='HP')icon.moveTo(ix-4,iy).lineTo(ix+4,iy).moveTo(ix,iy-4).lineTo(ix,iy+4);","  else if(name==='ARMOR')icon.drawPolygon([ix-4,iy-4,ix+4,iy-4,ix+3,iy+2,ix,iy+5,ix-3,iy+2,ix-4,iy-4]);","  else icon.drawPolygon([ix,iy-5,ix+4,iy,ix,iy+5,ix-4,iy,ix,iy-5]);","  label('statLabel'+i,name,sx+26,sy+8,cellW-36,'IndexDetail','151;164;192');text('statValue'+i,value,sx+10,sy+24,cellW-20,18,C.white,true,'IndexDetail');"," }"," yy+=stats.length?128:0;"," if(!locked&&!e.monster){const property=e.fusion?(Number.isFinite(config.SplashRadius)&&Number.isFinite(config.SplashRatio)?'SPLASH  /  '+config.SplashRadius+' px  /  '+Math.round(config.SplashRatio*100)+'% damage':''):(Number.isFinite(e.projectileSpeed)?'PROJECTILE SPEED  /  '+e.projectileSpeed+' px/s':'');if(property){const properties=text('detailProperties',property,tx,yy,tw,11,'151;170;198',false,'IndexDetail');yy+=properties.getHeight()+14;}}"," if(locked){label('detailLock','UNDISCOVERED  /  DETAILS LOCKED',tx,yy,tw,'IndexDetail','163;144;188');yy+=32;}"," let sectionY=Math.max(top+artH+24,yy+8);"," const section=(key,title)=>{line('IndexDetail',dx,sectionY,dx+dw,sectionY,0x655470);label(key,title,dx,sectionY+14,dw);sectionY+=40;};"," const paragraph=(key,value)=>{const t=text(key,value,dx,sectionY,dw,13,C.muted,false,'IndexDetail');sectionY+=t.getHeight()+18;return t;};"," index.detail={id:e.id,entry:e,locked,sprite:art,name:title,description,statValues:stats};"," if(e.type==='StarCannonTower'){","  section('upgradesTitle','UPGRADE PATHS');const cols=dw>=580?2:1,colW=cols===2?(dw-16)/2:dw,starts=[];","  for(const [p,path]of star.Paths.entries()){","   const px=dx+(p%cols)*(colW+16);let py=cols===2?sectionY:sectionY+(p?starts[0]:0);const start=py;","   box('IndexDetail',{x:px,y:py,w:colW,h:50},p?0x20203c:0x292038,p?0x586e94:0x8a7052,7);label('pathNumber'+p,'PATH '+(p+1),px+12,py+8,colW-24,'IndexDetail',p?'158;204;229':'225;193;130');text('starPath'+p,path.Name,px+12,py+23,colW-24,12,C.white,true,'IndexDetail');py+=64;","   for(const [n,u]of path.Upgrades.entries()){","    const icon=index.ensure('starUpgrade'+p+n,'StarUpgradeIcon','IndexDetail',2);icon.setAnimationName(u.Icon);icon.setWidth(38);icon.setHeight(38);icon.setPosition(px+8,py+8);icon.hide(false);","    const name=text('upgradeName'+p+n,'0'+(n+1)+'  '+u.Name,px+56,py+8,colW-68,13,C.white,true,'IndexDetail');","    const desc=text('upgradeDesc'+p+n,u.Description,px+56,py+name.getHeight()+14,colW-68,12,C.muted,false,'IndexDetail');","    const rh=Math.max(92,name.getHeight()+desc.getHeight()+48);box('IndexDetail',{x:px,y:py,w:colW,h:rh-8},0x19162e,0x302b45,6);label('upgradeCost'+p+n,u.Cost+' GOLD',px+56,py+rh-30,colW-68,'IndexDetail','195;175;129');py+=rh;","   }","   starts[p]=py-start+18;","  }","  sectionY+=cols===2?Math.max(...starts):starts.reduce((a,b)=>a+b,0);paragraph('starRule','Level 3 specializes one path. The other path can reach level 2. Maximum level '+star.MaxLevel+'.');"," }else if(e.monster&&!locked){","  section('abilityHeading','ENEMY PROFILE');paragraph('monsterProfile',!e.SpecialAbility||e.SpecialAbility==='None'?'No special ability.':'SPECIAL ABILITY  /  '+e.SpecialAbility);","  if(e.id==='VoidGolem'){const skill=sv.get('VoidGolemConfig').toJSObject().Skill;paragraph('golemSkill','Stops to cast '+skill.Name+'. Grants +'+skill.ArmorBonus+' armor within '+skill.Radius+' px for '+skill.Duration+' s. Cooldown: '+skill.Cooldown+' s.');}","  paragraph('monsterFirstWave','FIRST APPEARANCE  /  WAVE '+e.MinimumWave+'+');"," }else if(e.fusion){","  section('recipeHeading',locked?'SEALED COMBINATION':'FUSION COMBINATION');const recipe=v=>v.Recipe.map(p=>p.Label||p.Type+' '+p.Path1+'-'+p.Path2).join(' + '),known=e.definition.Variants.filter(v=>archive.hasVariant(e.id,v.Id));","  paragraph('fusionRecipe'+selectedIndex,locked?'Combination locked':e.definition.AdaptiveVariants?'Each adaptive variant is discovered separately.':known.map(recipe).join('\\n')||'Combination not yet recorded');","  if(e.definition.AdaptiveVariants){const progress=archive.progress(e.id);section('fusionProgress'+selectedIndex,'ADAPTIVE VARIANTS  /  '+progress.found+' / '+progress.total);e.definition.Variants.forEach((v,n)=>paragraph('fusionVariant'+n+selectedIndex,archive.hasVariant(e.id,v.Id)?v.Name+'\\n'+recipe(v):'???  /  UNDISCOVERED'));}","  else if(!locked)paragraph('fusionIdentity','PURE EVOLUTION  /  One canonical recipe. Source order does not change the result.');"," }"," index.detailHeight=sectionY+index.scroll-detail.y;index.maxScroll=Math.max(0,index.detailHeight-detail.h+12);scrollBar('IndexUI',detailTrack,index.maxScroll,index.scroll);","}else{text('emptyArchive','No entries available.',detail.x+20,detail.y+30,detail.w-40,16,C.muted);index.maxScroll=0;}","for(const name of ['IndexUI','IndexList','IndexDetail'])scene.getLayer(name).show(open);","index.wasDown=down;if(!down)index.pressed='';"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// A separate UI overlay. Shop and map geometry stay independent of selection.","const scene=runtimeScene,sv=scene.getVariables(),game=scene.getGame();","let ui=scene.__selectedPanel;","if(!ui) {","  ui=scene.__selectedPanel={objects:{},wasDown:false,pressed:\"\",pressedTower:0,cards:[]};","  ui.ensure=(key,name,z=1)=>{","    if(!ui.objects[key]){const o=scene.createObject(name);o.setLayer(\"SelectedTowerUI\");o.setZOrder(z);ui.objects[key]=o;}","    return ui.objects[key];","  };","}","const towers=scene.getObjects(\"StarCannonTower\");","let selected=towers.find(t=>t.getVariables().get(\"TowerId\").getAsNumber()===sv.get(\"SelectedTower\").getAsNumber());","if(!selected&&sv.get(\"SelectedTower\").getAsNumber()>0)sv.get(\"SelectedTower\").setNumber(0);","const input=game.getInputManager(),down=input.isMouseButtonPressed(0),modal=sv.get(\"IndexBlocksInput\").getAsBoolean()||sv.get(\"AudioUIConsumesClick\").getAsBoolean()||sv.get('FusionActive').getAsBoolean();","const h=680,w=320,layer=scene.getLayer(\"SelectedTowerUI\");","let scale=1,sx=8,sy=8;","const positionPanel=tower=>{"," const area=scene.__towerShopUI.gameArea,margin=8,map=scene.getLayer(\"\");"," const center=tower?(scene.__freePlacement?scene.__freePlacement.center(tower):[tower.getCenterXInScene(),tower.getCenterYInScene()]):[(area.left+area.right)/2,0];"," const screen=tower?map.convertInverseCoords(center[0],center[1],0,[0,0]):center;"," const right=tower&&screen[0]<(area.left+area.right)/2;"," const hud=scene.getObjects(\"HUDPanel\")[0],hudLayer=scene.getLayer(\"UI\");"," const hudBottom=hudLayer.convertInverseCoords(hud.getX(),hud.getY()+hud.getHeight(),0,[0,0])[1];"," sy=Math.max(margin,hudBottom+margin);"," const footprint=tower&&scene.__freePlacement?scene.__freePlacement.radius(tower)*map.getCameraZoom():0;"," const sideRoom=tower?(right?area.right-margin-screen[0]-footprint-margin:screen[0]-footprint-margin-area.left-margin):area.right-area.left-2*margin;"," scale=Math.max(.01,Math.min(1,(game.getGameResolutionHeight()-sy-margin)/h,((area.right-area.left)/2-2*margin)/w,sideRoom/w));"," sx=right?area.right-margin-w*scale:area.left+margin;"," sx=Math.max(area.left+margin,Math.min(area.right-margin-w*scale,sx));"," layer.setCameraZoom(scale);layer.setCameraX(game.getGameResolutionWidth()/2/scale-sx/scale);layer.setCameraY(game.getGameResolutionHeight()/2/scale-sy/scale);"," ui.panelSide=right?\"RIGHT\":\"LEFT\";ui.screenRect=tower?{x:sx,y:sy,w:w*scale,h:h*scale}:null;","};","positionPanel(selected);","const mx=gdjs.evtTools.input.getCursorX(scene,\"SelectedTowerUI\",0),my=gdjs.evtTools.input.getCursorY(scene,\"SelectedTowerUI\",0);","const inside=(x,y,width,height)=>mx>=x&&mx<x+width&&my>=y&&my<y+height;","const pointer=!!selected&&!modal&&inside(0,0,w,h);","sv.get(\"SelectedPanelPointerInside\").setBoolean(pointer);","sv.get(\"TowerUIConsumesClick\").setBoolean(pointer);","ui.screenRect=selected?{x:sx,y:sy,w:w*scale,h:h*scale}:null;","const canFuse=scene.__fusion?.eligible(selected)||false;","const hover=!selected||modal?\"\":canFuse&&inside(16,584,288,26)?'Fusion':inside(16,h-66,w-32,48)?\"Sell\":inside(278,12,26,26)?\"Close\":inside(16,314,140,270)?\"Path1\":inside(164,314,140,270)?\"Path2\":pointer?\"Panel\":\"\";","if(down&&!ui.wasDown){ui.pressed=hover;ui.pressedTower=selected?selected.getVariables().get(\"TowerId\").getAsNumber():0;}","if(!down&&ui.wasDown&&selected&&!modal&&ui.pressed===hover&&ui.pressedTower===selected.getVariables().get(\"TowerId\").getAsNumber()) {","  if(hover===\"Sell\") {","    const v=selected.getVariables(),investment=v.get(\"TotalInvestment\").getAsNumber();","    sv.get(\"Money\").setNumber(sv.get(\"Money\").getAsNumber()+Math.floor(investment*sv.get(\"SellRefundRate\").getAsNumber()+1e-8));","    selected.deleteFromScene();sv.get(\"SelectedTower\").setNumber(0);selected=null;","  } else if(hover==='Fusion'){scene.__fusion?.begin(selected);selected=null;}","  else if(hover===\"Close\") {sv.get(\"SelectedTower\").setNumber(0);selected=null;}","  else if((hover===\"Path1\"||hover===\"Path2\"))scene.__starCannon?.upgrade(selected,hover===\"Path1\"?1:2);","}","if(!down)ui.pressed=\"\";ui.wasDown=down;","ui.render=()=>{","  Object.values(ui.objects).forEach(o=>o.hide());","  const tower=towers.find(t=>t.getVariables().get(\"TowerId\").getAsNumber()===sv.get(\"SelectedTower\").getAsNumber()&&scene.getObjects(t.getName()).includes(t));","  positionPanel(tower);layer.show(!!tower);ui.tower=towe