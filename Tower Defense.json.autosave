:"SetBooleanVariable"},"parameters":["WaveActive","False",""]}],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["Wave",">=","50"]}],"actions":[{"type":{"value":"SetBooleanVariable"},"parameters":["GameOver","True",""]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["MessageText","Text","=","\"YOU WIN!\""]},{"type":{"value":"Show"},"parameters":["MessageText",""]}]},{"type":"BuiltinCommonInstructions::Else","conditions":[],"actions":[{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["MessageText","Text","=","\"Wave \" + ToString(Wave) + \" Complete! Press PLAY\""]},{"type":{"value":"Show"},"parameters":["MessageText",""]}]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["Lives","<=","0"]},{"type":{"value":"BooleanVariable"},"parameters":["GameOver","False",""]}],"actions":[{"type":{"value":"SetBooleanVariable"},"parameters":["GameOver","True",""]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["MessageText","Text","=","\"GAME OVER\""]},{"type":{"value":"Show"},"parameters":["MessageText",""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["MoneyText","Text","=","ToString(Money)"]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["LivesText","Text","=","ToString(Lives)"]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["WaveText","Text","=","ToString(Wave) + \"/50\""]}]}],"parameters":[]},{"colorB":109,"colorG":143,"colorR":90,"creationTime":0,"name":"Asset panel presentation","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"SceneJustBegins"},"parameters":[""]}],"actions":[],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"AnimatableCapability::AnimatableBehavior::Name"},"parameters":["TileType_Button","Animation","=","\"Tower\""]}],"actions":[{"type":{"value":"ButtonStates::ButtonScaleTween::SetIdleScale"},"parameters":["TileType_Button","ButtonScaleTween","=","0.6875"]},{"type":{"value":"ButtonStates::ButtonScaleTween::SetFocusedScale"},"parameters":["TileType_Button","ButtonScaleTween","=","0.6875"]},{"type":{"value":"ButtonStates::ButtonScaleTween::SetPressedScale"},"parameters":["TileType_Button","ButtonScaleTween","=","0.653125"]},{"type":{"value":"ChangeWidth"},"parameters":["TileType_Button","=","44"]},{"type":{"value":"ChangeHeight"},"parameters":["TileType_Button","=","44"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"AnimatableCapability::AnimatableBehavior::Name"},"parameters":["TileType_Button","Animation","=","\"ShotgunTower\""]}],"actions":[{"type":{"value":"ButtonStates::ButtonScaleTween::SetIdleScale"},"parameters":["TileType_Button","ButtonScaleTween","=","0.4444444444444445"]},{"type":{"value":"ButtonStates::ButtonScaleTween::SetFocusedScale"},"parameters":["TileType_Button","ButtonScaleTween","=","0.4444444444444445"]},{"type":{"value":"ButtonStates::ButtonScaleTween::SetPressedScale"},"parameters":["TileType_Button","ButtonScaleTween","=","0.4222222222222222"]},{"type":{"value":"ChangeWidth"},"parameters":["TileType_Button","=","25.77777777777778"]},{"type":{"value":"ChangeHeight"},"parameters":["TileType_Button","=","44"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"AnimatableCapability::AnimatableBehavior::Name"},"parameters":["TileType_Button","Animation","=","\"RocketTower\""]}],"actions":[{"type":{"value":"ButtonStates::ButtonScaleTween::SetIdleScale"},"parameters":["TileType_Button","ButtonScaleTween","=","2.75"]},{"type":{"value":"ButtonStates::ButtonScaleTween::SetFocusedScale"},"parameters":["TileType_Button","ButtonScaleTween","=","2.75"]},{"type":{"value":"ButtonStates::ButtonScaleTween::SetPressedScale"},"parameters":["TileType_Button","ButtonScaleTween","=","2.6125"]},{"type":{"value":"ChangeWidth"},"parameters":["TileType_Button","=","44"]},{"type":{"value":"ChangeHeight"},"parameters":["TileType_Button","=","22"]}]}]}],"parameters":[]},{"colorB":109,"colorG":143,"colorR":90,"creationTime":0,"name":"Selected tower information and range","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetBooleanVariable"},"parameters":["SelectedTowerFound","False",""]}]},{"type":"BuiltinCommonInstructions::ForEach","object":"PlaceableTile","conditions":[{"type":{"value":"NumberObjectVariable"},"parameters":["PlaceableTile","TowerId","=","SelectedTower"]}],"actions":[{"type":{"value":"SetBooleanVariable"},"parameters":["SelectedTowerFound","True",""]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["PlaceableTile","SellValue","=","floor(PlaceableTile.Variable(PurchasePrice) * SellRefundRate)"]},{"type":{"value":"ChangeWidth"},"parameters":["RangeIndicator","=","PlaceableTile.Variable(AttackRange) * 2"]},{"type":{"value":"ChangeHeight"},"parameters":["RangeIndicator","=","PlaceableTile.Variable(AttackRange) * 2"]},{"type":{"value":"SetXY"},"parameters":["RangeIndicator","=","PlaceableTile.CenterX() - PlaceableTile.Variable(AttackRange)","=","PlaceableTile.CenterY() - PlaceableTile.Variable(AttackRange)"]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["TowerInfoName","Text","=","PlaceableTile.VariableString(TowerName)"]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["TowerInfoDamage","Text","=","ToString(PlaceableTile.Variable(Damage))"]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["TowerInfoRate","Text","=","ToString(PlaceableTile.Variable(AttackInterval)) + \" s\""]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["TowerInfoRange","Text","=","ToString(PlaceableTile.Variable(AttackRange)) + \" px\""]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["TowerInfoDealt","Text","=","ToString(PlaceableTile.Variable(DamageDealt))"]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["TowerSellValue","Text","=","ToString(PlaceableTile.Variable(SellValue)) + \" Gold\""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BooleanVariable"},"parameters":["SelectedTowerFound","False",""]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["SelectedTower","=","0"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["SelectedTower",">","0"]}],"actions":[{"type":{"value":"Show"},"parameters":["RangeIndicator",""]},{"type":{"value":"Show"},"parameters":["TowerInfoUI",""]},{"type":{"value":"Hide"},"parameters":["TowerShopContent"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["SelectedTower","=","0"]}],"actions":[{"type":{"value":"Hide"},"parameters":["RangeIndicator"]},{"type":{"value":"Hide"},"parameters":["TowerInfoUI"]},{"type":{"value":"Show"},"parameters":["TowerShopContent",""]}]}],"parameters":[]},{"colorB":109,"colorG":143,"colorR":90,"creationTime":0,"name":"Tower shop visual states","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":"runtimeScene.__towerShopUI.refresh();","parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[]},{"colorB":109,"colorG":143,"colorR":90,"creationTime":0,"name":"Enemy instance health bars","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Display-only pass after movement/damage/removal: one pair per unique enemy lifetime.","// GDevelop gives recycled instances a new unique id. No nearest-enemy selection.","let bars = runtimeScene.__enemyHealthBars;","if (!bars) bars = runtimeScene.__enemyHealthBars = new Map();","for (const enemy of runtimeScene.getObjects(\"Enemy\")) {","  const id = enemy.getUniqueId();","  let pair = bars.get(id);","  if (!pair) {","    const background = runtimeScene.createObject(\"HealthBarBackground\");","    const fill = runtimeScene.createObject(\"HealthBarFill\");","    pair = { enemy, background, fill, width: -1, height: -1, ratio: -1, color: \"\" };","    bars.set(id, pair);","    background.getVariables().get(\"OwnerEnemyId\").setNumber(id);","    fill.getVariables().get(\"OwnerEnemyId\").setNumber(id);","    background.setColor(\"38;47;35\"); background.setOpacity(225);","    // Covers kills, reaching the base, external deletion and scene cleanup.","    const cleanup = () => {","      background.deleteFromScene(); fill.deleteFromScene(); bars.delete(id);","      enemy.unregisterDestroyCallback(cleanup);","    };","    enemy.registerDestroyCallback(cleanup);","  }","  const health = enemy.getBehavior(\"Health\");","  const current = health.Health(), maximum = health.MaxHealth();","  const ratio = maximum > 0 ? Math.max(0, Math.min(1, current / maximum)) : 0;","  const boss = enemy.getVariables().get(\"EnemyType\").getAsString() === \"Boss\";","  const width = Math.round(Math.max(boss ? 48 : 28, Math.min(boss ? 58 : 44, enemy.getWidth() * 0.9)));","  const height = boss ? 7 : 5;","  const x = enemy.getCenterXInScene() - width / 2;","  const y = enemy.getY() - height - Math.max(4, Math.min(7, enemy.getHeight() * 0.12));","  const layer = enemy.getLayer();","  if (pair.background.getLayer() !== layer) pair.background.setLayer(layer);","  if (pair.fill.getLayer() !== layer) pair.fill.setLayer(layer);","  // World layer follows the map camera; UI/HUD layers remain above it.","  const z = Math.max(20, enemy.getZOrder() + 1);","  pair.background.setZOrder(z); pair.fill.setZOrder(z + 1);","  pair.background.setPosition(x, y); pair.fill.setPosition(x + 1, y + 1);","  if (pair.width !== width || pair.height !== height) {","    pair.background.setWidth(width); pair.background.setHeight(height);","    pair.fill.setHeight(height - 2); pair.ratio = -1;","    pair.width = width; pair.height = height;","  }","  if (pair.ratio !== ratio) {","    // Origin is top-left. Only the right edge changes when HP changes.","    pair.fill.setWidth((width - 2) * ratio); pair.ratio = ratio;","  }","  const color = ratio > 0.6 ? \"119;191;84\" : ratio >= 0.3 ? \"238;181;64\" : \"220;79;64\";","  if (pair.color !== color) { pair.fill.setColor(color); pair.color = color; }","  pair.background.hide(enemy.isHidden()); pair.fill.hide(enemy.isHidden() || ratio <= 0);","}"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[]}],"layers":[{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"","renderingType":"","visibility":true,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0.0,"viewportBottom":1.0,"viewportLeft":0.0,"viewportRight":1.0,"viewportTop":0.0,"width":0.0}],"effects":[]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"UI","renderingType":"","visibility":true,"cameras":[],"effects":[]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"TowerShopList","renderingType":"","visibility":true,"cameras":[],"effects":[]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"IndexUI","renderingType":"","visibility":false,"cameras":[],"effects":[]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"IndexList","renderingType":"","visibility":false,"cameras":[],"effects":[]}],"behaviorsSharedData":[{"name":"Animation","type":"AnimatableCapability::AnimatableBehavior"},{"name":"ButtonFSM","type":"ButtonStates::ButtonFSM"},{"name":"ButtonScaleTween","type":"ButtonStates::ButtonScaleTween"},{"name":"Effect","type":"EffectCapability::EffectBehavior"},{"name":"FireBullet","type":"FireBullet::FireBullet"},{"name":"Flippable","type":"FlippableCapability::FlippableBehavior"},{"name":"Health","type":"Health::Health"},{"name":"Opacity","type":"OpacityCapability::OpacityBehavior"},{"name":"Resizable","type":"ResizableCapability::ResizableBehavior"},{"name":"Scale","type":"ScalableCapability::ScalableBehavior"},{"name":"Text","type":"TextContainerCapability::TextContainerBehavior"},{"name":"TileMap","type":"TileMap::TileMapBehavior"},{"name":"Tween","type":"Tween::TweenBehavior"}]}],"externalEvents":[],"tests":[{"description":"Picking a tile type in the toolbar shows what is about to be placed, and picking it again stops placing.","lastRunAt":1791302544077.0,"lastRunDurationMs":370.0,"lastRunFramesExecuted":20,"lastRunStatus":"passed","name":"Picking a tile type","type":"gameplay","source":["// Picking a tile type in the toolbar shows what is about to be placed.","await harness.goToScene('Game Scene');","harness.watch('TilePlacement_Indicator');","","const getIndicator = () => harness.getObjects('TilePlacement_Indicator')[0];","await harness.stepFrames(5);","","harness.assert(","  getIndicator().hidden === true,","  'Nothing is about to be placed before a tile type is picked.'",");","","const buttons = harness.getObjects('TileType_Button');","harness.assert(buttons.length > 0, 'The toolbar has tile types to pick from.');","const button = buttons[0];","console.log(","  'buttons=' + JSON.stringify(buttons.map((one) => one.animation)) +","    ' layer=' + JSON.stringify(button.layer)",");","","/** Click on a position of a layer. */","const clickAt = async (x, y, layerName) => {","  harness.setMousePosition(x, y, layerName);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false);","  await harness.stepFrames(3);","};","","await clickAt(button.centerX, button.centerY, button.layer);","const selected = getIndicator();","console.log(","  'afterPicking: hidden=' + selected.hidden + ' animation=' + JSON.stringify(selected.animation)",");","harness.assert(","  selected.hidden === false,","  'Picking a tile type shows what is about to be placed.'",");","harness.assert(","  selected.animation === button.animation,","  'What is about to be placed is the tile type that was picked (the indicator shows \"' +","    selected.animation + '\", the button is \"' + button.animation + '\").'",");","","// Picking it again turns it off.","await clickAt(button.centerX, button.centerY, button.layer);","console.log('afterPickingAgain: hidden=' + getIndicator().hidden);","harness.assert(","  getIndicator().hidden === true,","  'Picking the same tile type again stops placing.'",");"]},{"description":"With a tile type picked, clicking a buildable cell places that tile on the grid, and clicking it again does not stack a second one.","lastRunAt":1791302545389.0,"lastRunDurationMs":545.0,"lastRunFramesExecuted":27,"lastRunStatus":"passed","name":"Placing a tile on the board","type":"gameplay","source":["await harness.goToScene('Game Scene');","harness.watch('TilePlacement_Indicator');","const getIndicator = () => harness.getObjects('TilePlacement_Indicator')[0];","const placedTiles = () => ['Tower','ShotgunTower','RocketTower'].reduce((t,n)=>t+harness.getObjects(n).length,0);","await harness.stepFrames(5);","// Pick cheapest affordable tower (Tower 100) so starting Money 200 always allows placement","let button = harness.getObjects('TileType_Button').find(b=>b.animation==='Tower') || harness.getObjects('TileType_Button')[0];","const tileType = button.animation;","harness.assert(placedTiles()===0, 'The board starts empty.');","const clickAt = async (x,y,layer)=>{ harness.setMousePosition(x,y,layer); await harness.stepFrames(2); harness.setMouseButtonPressed(true); await harness.stepFrames(2); harness.setMouseButtonPressed(false); await harness.stepFrames(3); };","await clickAt(button.centerX, button.centerY, button.layer);","harness.assert(getIndicator().hidden===false, 'A tile type is picked ('+tileType+').');","let placedAtX=null, placedAtY=null;","for(let x=320;x<=960 && placedAtX===null;x+=64){ for(let y=192;y<=448 && placedAtX===null;y+=64){ await clickAt(x,y,''); if(placedTiles()>0){placedAtX=x;placedAtY=y;} } }","console.log('placedAt='+placedAtX+','+placedAtY+' tiles='+placedTiles());","harness.assert(placedAtX!==null, 'Clicking a buildable cell of the board places the picked tile there.');","harness.assert(harness.getObjects(tileType).length===1, 'Placed type matches picked type');","const placed = harness.getObjects(tileType)[0];","harness.assert(placed.x%64===0 && placed.y%64===0, 'Tile placed on grid at '+Math.round(placed.x)+','+Math.round(placed.y));","await clickAt(placedAtX,placedAtY,'');","console.log('afterSecondClick: tiles='+placedTiles());","harness.assert(placedTiles()===1, 'Clicking occupied cell does not stack ('+placedTiles()+' tiles)');"]},{"description":"Place a basic tower, start wave 1, verify towers auto-shoot and kill all enemies.","lastRunAt":1791302547074.0,"lastRunDurationMs":1047.0,"lastRunFramesExecuted":645,"lastRunStatus":"passed","name":"TowerDefenseCore","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(5);","const money0 = harness.getSceneVariable('Money')?.value;","harness.assert(money0 === 200, 'Money starts at 200, got '+money0);","const btns = harness.getObjects('TileType_Button');","const towerBtn = btns.find(b=>b.animation==='Tower');","harness.assert(!!towerBtn, 'Tower button exists');","const clickAt = async (x,y,layer)=>{ harness.setMousePosition(x,y,layer); await harness.stepFrames(2); harness.setMouseButtonPressed(true); await harness.stepFrames(2); harness.setMouseButtonPressed(false); await harness.stepFrames(3); };","await clickAt(towerBtn.centerX, towerBtn.centerY, towerBtn.layer);","let ind = harness.getObjects('TilePlacement_Indicator')[0];","harness.assert(ind.hidden===false, 'Indicator visible after Tower pick');","// find buildable cell","let px=null, py=null;","for(let x=320;x<=960 && px===null;x+=64){ for(let y=192;y<=448 && px===null;y+=64){ await clickAt(x,y,''); if(harness.getObjects('Tower').length>0){px=x;py=y;} } }","harness.assert(px!==null, 'Tower placed on buildable cell');","harness.assert(harness.getSceneVariable('Money')?.value===100, 'Money 200-100=100 after Tower, got '+harness.getSceneVariable('Money')?.value);","harness.setKeyPressed('Space', true); await harness.stepFrames(2); harness.setKeyPressed('Space', false); await harness.stepFrames(2);","harness.assert(harness.getSceneVariable('Wave')?.value===1, 'Wave 1 started');","const moneyBeforeWave = harness.getSceneVariable('Money')?.value;","const killed = await harness.stepUntil(()=>harness.getObjects('Enemy').length===0 && harness.getSceneVariable('EnemiesToSpawn')?.value===0, {maxFrames:2400});","harness.assert(killed, 'Wave 1 enemies all killed by towers');","harness.assert(harness.getSceneVariable('Money')?.value>moneyBeforeWave, 'Money increased from kills (+15 each)');","harness.assert(harness.getSceneVariable('WaveActive')?.value===false, 'Wave ended');","harness.takeScreenshot && await harness.takeScreenshot('core-done');"]},{"description":"Shotgun placement and cost, rocket cost gate, S-path movement, wave cleared by shotgun.","lastRunAt":1791302570228.0,"lastRunDurationMs":1211.0,"lastRunFramesExecuted":657,"lastRunStatus":"passed","name":"TowerTypesAndSPath","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(5);","const btns = harness.getObjects('TileType_Button');","const sgBtn = btns.find(b=>b.animation==='ShotgunTower');","harness.assert(!!sgBtn, 'Shotgun button exists');","const clickAt = async (x,y,layer)=>{ harness.setMousePosition(x,y,layer); await harness.stepFrames(2); harness.setMouseButtonPressed(true); await harness.stepFrames(2); harness.setMouseButtonPressed(false); await harness.stepFrames(3); };","await clickAt(sgBtn.centerX, sgBtn.centerY, sgBtn.layer);","let ind = harness.getObjects('TilePlacement_Indicator')[0];","harness.assert(ind.hidden===false, 'Indicator visible after shotgun pick');","await clickAt(600,192,'');","// if blocked (path), scan for a free cell","if(harness.getObjects('ShotgunTower').length===0){"," for(let x=320;x<=960 && harness.getObjects('ShotgunTower').length===0;x+=64){ for(let y=192;y<=448 && harness.getObjects('ShotgunTower').length===0;y+=64){ await clickAt(x,y,''); } }","}","harness.assert(harness.getObjects('ShotgunTower').length===1, 'ShotgunTower placed');","harness.assert(harness.getSceneVariable('Money')?.value===50, 'Money 200-150=50 after shotgun, got '+harness.getSceneVariable('Money')?.value);","const rkBtn = harness.getObjects('TileType_Button').find(b=>b.animation==='RocketTower');","await clickAt(rkBtn.centerX, rkBtn.centerY, rkBtn.layer);","await clickAt(300,380,'');","harness.assert(harness.getObjects('RocketTower').length===0, 'Rocket too expensive with 50g');","harness.setKeyPressed('Space', true); await harness.stepFrames(2); harness.setKeyPressed('Space', false); await harness.stepFrames(2);","await harness.stepFrames(80);","const enemies = harness.getObjects('Enemy');","harness.assert(enemies.length>0, 'Enemies spawned');","const e = enemies[0];","harness.assert(e.y<160, 'Enemy on top path segment, y='+e.y);","harness.assert(e.x>-40, 'Enemy moving right, x='+e.x);","const cleared = await harness.stepUntil(()=>harness.getObjects('Enemy').length===0 && harness.getSceneVariable('EnemiesToSpawn')?.value===0, {maxFrames:2500});","harness.assert(cleared, 'Wave cleared by shotgun tower');","harness.assert(harness.getSceneVariable('Lives')?.value===10, 'No lives lost');"]},{"description":"Final placement verification.","lastRunAt":1791302495695.0,"lastRunDurationMs":556.0,"lastRunFramesExecuted":39,"lastRunStatus":"passed","name":"PathPlaceCheck","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(10);","await harness.takeScreenshot('final-map');","const btns=harness.getObjects('TileType_Button');","const towerBtn=btns.find(b=>b.animation==='Tower');","const clickAt=async(x,y,layer)=>{harness.setMousePosition(x,y,layer);await harness.stepFrames(2);harness.setMouseButtonPressed(true);await harness.stepFrames(2);harness.setMouseButtonPressed(false);await harness.stepFrames(3);};","await clickAt(towerBtn.centerX,towerBtn.centerY,towerBtn.layer);","await clickAt(448,192,'');","harness.assert(harness.getObjects('Tower').length===1,'tower places on grass');","const n0=harness.getObjects('Tower').length;","await clickAt(448,64,'');","harness.assert(harness.getObjects('Tower').length===n0,'dirt path blocked');","await clickAt(448,192,'');","harness.assert(harness.getObjects('Tower').length===n0,'stacking blocked');","await harness.takeScreenshot('final-placement');"]}],"eventsFunctionsExtensions":[{"author":"","category":"User interface","dimension":"2D","extensionNamespace":"","fullName":"Button states and effects","gdevelopVersion":">=5.5.222","helpPath":"/objects/button","iconUrl":"data:image/svg+xml;base64,","name":"ButtonStates","previewIconUrl":"https://asset-resources.gdevelop.io/public-resources/Icons/753a9a794bd885058159b7509f06f5a8f67f72decfccb9a1b0efee26f41c3c4c_gesture-tap-button.svg","shortDescription":"Use any object as a button and change appearance according to user interactions.","version":"1.4.1","description":["Use the \"Button states\" behavior to track user interactions with an object, including:","","- Hovered","- Pressed","- Clicked","- Idle","","Add additional behaviors to make juicy buttons with animated responses to user input:","","- Size","- Color","- Animation","- Object effects"],"origin":{"identifier":"ButtonStates","name":"gdevelop-extension-store"},"tags":["ui","button"],"authorIds":["IWykYNRvhCZBN3vEgKEbBPOR3Oc2","gqDaZjCfevOOxBYkK6zlhtZnXCg1"],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[],"eventsFunctionsFolderStructure":{"folderName":"__ROOT"},"eventsBasedBehaviors":[{"description":"Use objects as buttons.","fullName":"Button states","helpPath":"","iconUrl":"","name":"ButtonFSM","objectType":"","previewIconUrl":"","eventsFunctions":[{"fullName":"","functionType":"Action","name":"doStepPreEvents","sentence":"","events":[{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"name":"Finite state machine","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comm